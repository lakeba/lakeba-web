---
import { createHash } from 'node:crypto';
import Auth from '../../layouts/Auth.astro';
import Alert from '../../components/Alert.astro';
import { serviceClient } from '../../lib/admin';
import { recordSignIn } from '../../lib/sign-in';
import { safeNext } from '../../lib/supabase';

// One-time sign-in link from a reply to a shareholder email. Opening the link
// only shows this page (email link scanners open links too); the click on
// "Continue" uses the link and signs the person in.
const { t } = Astro.locals;
const svc = serviceClient();
const tokenHash = createHash('sha256').update(Astro.params.token ?? '').digest('hex');
const { data: link } = await svc.from('email_sign_in_links').select('user_id, next_path, expires_at, used_at').eq('token_hash', tokenHash).maybeSingle();
const valid = Boolean(link && !link.used_at && new Date(link.expires_at) > new Date());
const next = safeNext(link?.next_path);
let error = '';

if (Astro.request.method === 'POST' && valid) {
  // Use it once: only the request that marks it used goes on.
  const { data: claimed } = await svc.from('email_sign_in_links').update({ used_at: new Date().toISOString() }).eq('token_hash', tokenHash).is('used_at', null).select('user_id');
  if (claimed?.length) {
    const { data: user } = await svc.auth.admin.getUserById(link!.user_id);
    const email = user?.user?.email;
    const generated = email ? await svc.auth.admin.generateLink({ type: 'magiclink', email }) : null;
    const hashed = generated?.data?.properties?.hashed_token;
    const { error: e } = hashed ? await Astro.locals.supabase.auth.verifyOtp({ token_hash: hashed, type: 'magiclink' }) : { error: new Error('no link') };
    if (!e) {
      await recordSignIn({ supabase: Astro.locals.supabase, userId: link!.user_id, method: 'email_reply_link', request: Astro.request, origin: Astro.url.origin });
      return Astro.redirect(next, 303);
    }
    error = t('This link couldn’t sign you in. Please sign in with your email and password.');
  } else error = t('This link has already been used.');
}
---

<Auth title={t('Open the investor portal')} subtitle={valid ? t('From the email we sent you.') : undefined}>
  {error && <div class="mb-5"><Alert tone="error">{error}</Alert></div>}
  {valid && !error ? (
    <form method="post" class="space-y-4">
      <p class="text-sm text-white/60">{t('Continue to sign in and open what you asked for. This link works once.')}</p>
      <button class="btn-primary w-full">{t('Continue to the portal')}</button>
    </form>
  ) : (
    <div class="space-y-4">
      {!error && <Alert>{t('This link has expired or was already used. Links in our emails work once, for a limited time.')}</Alert>}
      <a href={`/login?next=${encodeURIComponent(next)}`} class="btn-primary w-full">{t('Sign in')}</a>
    </div>
  )}
</Auth>
