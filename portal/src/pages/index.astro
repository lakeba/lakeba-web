---
import { meetingPhase } from '../lib/meetings';
import Portal from '../layouts/Portal.astro';
import { fyOf } from '../lib/tax-pack';
import Sparkline from '../components/Sparkline.astro';
import HoldingNote from '../components/HoldingNote.astro';
import { holdingAnchor } from '../lib/note-banner';
import { inCompany, isShareClass, latestPrices, loadPositions, loadPrices, sourceLabels } from '../lib/holdings';
import { myHolderIds, onBoardOf, onlyMyDocuments } from '../lib/scope';
import { loadNews } from '../lib/news';
import { brandName, legalName } from '../lib/companies';
import { categoryLabels, holderKinds } from '../lib/format';

const supabase = Astro.locals.supabase;
const userId = Astro.locals.user!.id;
const role = Astro.locals.profile?.role;
const { company, companies, t, fmt } = Astro.locals;
const { aud, audPrecise, longDate, percent, shares, shortDate } = fmt;
const isGroup = company?.relationship === 'group';
const entityId = company?.id ?? '00000000-0000-0000-0000-000000000000';
const [allPositions, holderIds, onBoard, allPrices] = await Promise.all([
  loadPositions(supabase, userId), myHolderIds(supabase, userId), onBoardOf(supabase, userId, company, role), latestPrices(supabase),
]);
// The dashboard shows the company being viewed; "My ownership" sums up all of them.
const positions = inCompany(allPositions, company?.id);
const classIds = [...new Set(positions.filter(isShareClass).map((p) => p.row.share_class_id))];

const [priceSeries, { data: announcements }, { data: settings }, { data: docs }, posts, { data: meetings }, { data: video }, { count: openQueries }] = await Promise.all([
  Promise.all(classIds.map(async (id) => [id, await loadPrices(supabase, id)] as const)),
  supabase.from('announcements').select('id, title, body, link_url, link_label, tone').eq('entity_id', entityId).order('starts_at', { ascending: false }).limit(2),
  isGroup ? supabase.from('portal_settings').select('value').eq('key', 'liquidity').maybeSingle() : Promise.resolve({ data: null }),
  onlyMyDocuments(supabase.from('documents').select('id, title, category, published_at, entity_id, document_reads(user_id)').neq('category', 'video'), { holderIds, onBoard, company }).order('published_at', { ascending: false }).limit(5),
  loadNews(supabase, 3, company),
  supabase.from('meetings').select('id, title, starts_at, proxy_deadline, status').eq('entity_id', entityId).in('status', ['upcoming', 'open']).gte('starts_at', new Date().toISOString()).order('starts_at').limit(1),
  onlyMyDocuments(supabase.from('documents').select('id, title, summary, published_at').eq('category', 'video'), { holderIds, onBoard, company }).order('published_at', { ascending: false }).limit(1).maybeSingle(),
  supabase.from('queries').select('id', { count: 'exact', head: true }).eq('status', 'open').eq('user_id', userId).eq('entity_id', entityId),
]);

// Each share class is valued at its own latest reference price, if it has one.
// Options and similar have no price here (their value depends on exercise terms).
const valueAt = (p: (typeof positions)[number]) => {
  const pr = isShareClass(p) ? allPrices.get(p.row.share_class_id) : undefined;
  return pr ? p.row.shares * pr.price : null;
};
const value = valueAt;
const sharePositions = positions.filter(isShareClass);
const totalShares = sharePositions.reduce((sum, p) => sum + p.row.shares, 0);
const pricedValues = sharePositions.map(value).filter((v): v is number => v !== null);
const totalValue = pricedValues.reduce((a, b) => a + b, 0);
const unpricedClasses = [...new Set(sharePositions.filter((p) => value(p) === null).map((p) => p.row.share_classes?.name))];

// My ownership: one line per company with holdings.
const ownership = companies.map((c) => {
  const ps = inCompany(allPositions, c.id).filter((p) => p.row.shares > 0);
  const values = ps.filter(isShareClass).map(valueAt);
  return { company: c, positions: ps, shares: ps.filter(isShareClass).reduce((a, p) => a + p.row.shares, 0), options: ps.filter((p) => !isShareClass(p)).reduce((a, p) => a + p.row.shares, 0), value: values.reduce<number>((a, v) => a + (v ?? 0), 0), priced: values.some((v) => v !== null) };
}).filter((o) => o.positions.length);
const pricesByClass = new Map(priceSeries);
// The chart shows the class with the longest price history (normally Ordinary).
const chartClass = [...pricesByClass].sort((a, b) => b[1].length - a[1].length)[0];
const prices = chartClass?.[1] ?? [];
const price = prices.at(-1);
const chartClassName = positions.find((p) => p.row.share_class_id === chartClass?.[0])?.row.share_classes?.name;
const liquidity = settings?.value as { title: string; body: string; url: string; label: string } | undefined;
// The price card spans both columns when it would otherwise sit alone in its row.
const priceWide = positions.length > 0 && positions.length % 2 === 0;
const meeting = meetings?.[0];
const firstName = Astro.locals.profile?.first_name;
// A short welcome for new investors: their first 30 days, until they close it (remembered on this device).
const { data: me } = await supabase.from('profiles').select('first_signed_in_at').eq('id', userId).maybeSingle();
const showWelcome = !Astro.locals.access.staff && !Astro.cookies.get('welcome_done') && Boolean(me?.first_signed_in_at) && Date.now() - new Date(me!.first_signed_in_at!).getTime() < 30 * 86_400_000;
const toneStyles = { info: 'border-lk-blue/30 bg-lk-blue/10', success: 'border-lk-green/30 bg-lk-green/10', warning: 'border-lk-orange/40 bg-lk-orange/10' };
const lastClosedFy = fyOf(new Date().toISOString().slice(0, 10)) - 1;
const fyShort = String(lastClosedFy).slice(2);
// Same as fyLabel() from tax-pack, with the dates in the reader's language.
const fyTitle = t('Holdings and changes for FY{yy} ({start} – {end})', {
  yy: fyShort,
  start: longDate.format(new Date(`${lastClosedFy - 1}-07-01T12:00:00Z`)),
  end: longDate.format(new Date(`${lastClosedFy}-06-30T12:00:00Z`)),
});
// News labels come from loadNews(): 'Shareholders', '<company> shareholders' or a venture name.
const newsLabel = (label: string) =>
  label === 'Shareholders' ? t('Shareholders') : label.endsWith(' shareholders') ? t('{company} shareholders', { company: label.slice(0, -' shareholders'.length) }) : label;
// Sentences with a link inside are split around the {link} placeholder.
const [noHoldingsBefore, noHoldingsAfter] = t('If you are a shareholder, ask a question in {link} or email {email} and we\'ll link your holding to this account.', { email: 'info@lakeba.com' }).split('{link}');
---

<Portal title={t('Dashboard')}>
  {(announcements ?? []).map((a) => (
    <div class:list={['mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border px-5 py-3.5 text-sm', toneStyles[a.tone as keyof typeof toneStyles]]}>
      <p><span class="font-semibold text-white">{a.title}</span>{a.body && <span class="text-white/65"> · {a.body}</span>}</p>
      {a.link_url && <a href={a.link_url} class="font-semibold text-white underline-offset-4 hover:underline">{a.link_label ?? t('Learn more')} →</a>}
    </div>
  ))}

  {showWelcome && (
    <section class="card mt-6 bg-gradient-to-br from-lk-blue/15 to-transparent" data-welcome>
      <div class="flex items-start justify-between gap-4">
        <div><h2 class="font-display text-xl font-bold">{t('Welcome to the {brand} investor portal', { brand: company && company.relationship !== 'group' ? company.display_name : 'Lakeba' })}</h2>
          <p class="mt-1 text-sm text-white/60">{t('Everything about your shareholding in one place. A quick guide:')}</p></div>
        <button type="button" class="text-sm text-white/50 hover:text-white" data-welcome-close aria-label={t('Close the guide')}>{t('Close')} ✕</button>
      </div>
      <ul class="mt-5 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <li class="rounded-xl border border-white/10 p-4"><p class="font-semibold text-white">{t('Your holdings')}</p><p class="mt-1 text-white/60">{t('Below: your shares, their indicative value, your holding statement and tax-time pack.')}</p></li>
        <li class="rounded-xl border border-white/10 p-4"><a href="/documents" class="font-semibold text-white hover:underline">{t('Documents')} →</a><p class="mt-1 text-white/60">{t('Annual reports, shareholder updates and meeting papers.')}</p></li>
        <li class="rounded-xl border border-white/10 p-4"><a href="/agm" class="font-semibold text-white hover:underline">{t('Meetings')} →</a><p class="mt-1 text-white/60">{t('Notices of meeting, proxy voting online and results.')}</p></li>
        {(Astro.locals.features.boardQa || (Astro.locals.features.ask && company)) && <li class="rounded-xl border border-white/10 p-4"><a href={Astro.locals.features.ask && company ? '/ask' : '/board'} class="font-semibold text-white hover:underline">{t('Questions')} →</a><p class="mt-1 text-white/60">{Astro.locals.features.ask && company && Astro.locals.features.boardQa ? t('Ask Lakeba (AI) answers from the documents; Board Q&A reaches the board.') : Astro.locals.features.boardQa ? t('Board Q&A reaches the board.') : t('Ask Lakeba (AI) answers from the documents.')}</p></li>}
      </ul>
      <p class="mt-4 text-sm text-white/55">{t('Tip: add a passkey for a quicker, safer sign-in')} · <a href="/account/security" class="text-lk-blue hover:underline">{t('Security')}</a></p>
    </section>
  )}
  <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow">{t('Investor portal')}</p>
      <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">{firstName ? t('Welcome, {name}', { name: firstName }) : t('Welcome, there')}</h1>
      <p class="mt-3 text-white/55">{company ? t('Your investment in {company}.', { company: legalName(company) }) : t('Your investor account.')}</p>
    </div>
    {sharePositions.length > 1 && (
      <div>
        <div class="flex flex-wrap gap-x-8 gap-y-4">
          <div><p class="text-xs uppercase tracking-widest text-white/40">{t('Total shares')}</p><p class="font-display text-2xl sm:text-3xl font-bold text-white">{shares.format(totalShares)}</p></div>
          {pricedValues.length > 0 && <div><p class="text-xs uppercase tracking-widest text-white/40">{t('Indicative value')}</p><p class="font-display text-2xl sm:text-3xl font-bold text-white">{aud.format(totalValue)}</p></div>}
        </div>
        <p class="mt-1 text-xs text-white/40">{t('Across your {n} holdings', { n: sharePositions.length })}{unpricedClasses.length > 0 && pricedValues.length > 0 && ` · ${t('value excludes {classes} (no reference price)', { classes: unpricedClasses.join(', ') })}`}</p>
      </div>
    )}
  </div>

  {ownership.length > 1 && (
    <section class="mt-10" aria-label={t('My ownership')}>
      <h2 class="text-xs uppercase tracking-widest text-white/40">{t('My ownership')}</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {ownership.map((o) => (
          <a href={`/company/${o.company.code}?next=/`} class:list={['card block p-5 transition hover:bg-white/[0.07]', o.company.id === company?.id && 'ring-1 ring-white/20']}>
            <p class="flex items-center gap-2 text-sm font-semibold text-white"><span class="size-2.5 rounded-full" style={`background:${o.company.brand_color ?? '#2563EB'}`}></span>{o.company.display_name}{o.company.id === company?.id && <span class="ml-auto text-[11px] font-normal text-white/40">{t('Viewing')}</span>}</p>
            <p class="mt-3 font-display text-2xl font-bold text-white">{shares.format(o.shares)} <span class="text-sm font-normal text-white/45">{t.n(o.shares, 'share', 'shares')}</span></p>
            <p class="text-sm text-white/55">{o.priced ? t('{value} indicative', { value: aud.format(o.value) }) : t('No reference price yet')}{o.options > 0 && ` · ${t.n(o.options, '{n} option', '{n} options', { n: shares.format(o.options) })}`}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Holdings, reference price and secondary trading share one two-column grid,
       so a single holding sits next to the price chart. -->
  <div class="mt-10 grid gap-4 lg:grid-cols-2">
    {positions.length ? positions.map((p) => (
      <article class="card scroll-mt-36" id={holdingAnchor(p.holder.id, p.row.share_class_id)} aria-label={t('Holding: {name}', { name: p.holder.name })}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold">{p.holder.name}</h2>
            <p class="text-sm text-white/45">{t(holderKinds[p.holder.kind])} · {p.row.share_classes?.name}</p>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <a href={`/statement/${p.holder.id}?class=${p.row.share_class_id}`} class="btn-ghost px-3 py-2 text-xs">{t('Holding statement')} ↓</a>
            <a href={`/statement/${p.holder.id}/tax/${lastClosedFy}`} class="btn-ghost px-3 py-2 text-xs" title={fyTitle}>{t('Tax pack FY{yy}', { yy: fyShort })} ↓</a>
          </div>
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
          <div><dt class="text-xs uppercase tracking-widest text-white/40">{isShareClass(p) ? t('Shares') : t('Options')}</dt><dd class="mt-1 flex items-center gap-1.5 font-display text-lg font-bold text-white sm:text-xl xl:text-2xl">{shares.format(p.row.shares)}<HoldingNote note={p.note} class="text-base" /></dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-white/40">{t('Of total')}</dt><dd class="mt-1 font-display text-lg font-bold text-white sm:text-xl xl:text-2xl">{p.total ? percent.format(p.row.shares / p.total) : '—'}</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-white/40">{t('Indicative')}</dt><dd class="mt-1 font-display text-lg font-bold text-white sm:text-xl xl:text-2xl">{value(p) !== null ? aud.format(value(p)!) : '—'}</dd></div>
        </dl>
        <p class="mt-6 border-t border-white/5 pt-4 text-xs text-white/40">{t('As at {date}', { date: longDate.format(new Date(p.row.as_at)) })} · {t('{n} {class} on issue', { n: shares.format(p.total), class: p.row.share_classes?.name.toLowerCase() ?? '' })}{p.row.exercise_price != null && ` · ${t('exercise price {price}', { price: audPrecise.format(Number(p.row.exercise_price)) })}`}{p.row.expires_on && ` · ${t('expires {date}', { date: longDate.format(new Date(p.row.expires_on)) })}`}{!isShareClass(p) && ` · ${t('not included in ownership %')}`}</p>
      </article>
    )) : (
      <div class="card lg:col-span-2">
        <h2 class="text-lg font-bold">{t('No holdings linked yet')}</h2>
        <p class="mt-2 text-sm text-white/55">{noHoldingsBefore}<a class="text-lk-blue hover:underline" href="/board">{t('Board Q&A')}</a>{noHoldingsAfter}</p>
      </div>
    )}

    <!-- Reference price -->
    {prices.length > 0 && price && (
      <section class:list={['card', priceWide && 'lg:col-span-2']}>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold">{t('Reference price')}</h2>
            {chartClassName && <p class="text-xs text-white/40">{chartClassName}</p>}
            <p class="text-sm text-white/45">{t(sourceLabels[price.source] ?? price.source)} · {shortDate.format(new Date(price.priced_on))}</p>
          </div>
          <p class="font-display text-3xl font-bold text-white">{audPrecise.format(price.price)}</p>
        </div>
        <Sparkline class="mt-6 h-28 w-full" points={prices.map((pr) => ({ label: `${shortDate.format(new Date(pr.priced_on))}: ${audPrecise.format(pr.price)} (${t(sourceLabels[pr.source] ?? pr.source)})`, value: pr.price }))} />
        <p class="mt-3 text-xs text-white/35">{t('Indicative only. {company} shares are unlisted; values use the latest capital raise, secondary trade or directors’ valuation and are not financial advice.', { company: brandName(company) })}</p>
      </section>
    )}

    {/* Liquidity: one card with the ways to buy or sell (the portal's trading board, an outside market). */}
    {(Astro.locals.features.trading || liquidity) && (
      <section class="card lg:col-span-2">
        <p class="eyebrow w-fit">{t('Liquidity')}</p>
        <div class:list={['mt-4 grid gap-6', Astro.locals.features.trading && liquidity && 'sm:grid-cols-2 sm:divide-x sm:divide-white/5']}>
          {Astro.locals.features.trading && (
            <div class="flex flex-col">
              <h2 class="text-base font-bold">{t('Secondary trading board')}</h2>
              <p class="mt-1 flex-1 text-sm text-white/60">{t('Register your interest to buy or sell {company} shares. The company pairs sellers with buyers and arranges the transfer.', { company: company?.display_name ?? '' })}</p>
              <a href="/trading" class="btn-ghost mt-4 w-fit text-sm">{t('Open the trading board')}</a>
            </div>
          )}
          {liquidity && (
            <div class:list={['flex flex-col', Astro.locals.features.trading && 'sm:pl-6']}>
              <h2 class="text-base font-bold">{liquidity.title}</h2>
              <p class="mt-1 flex-1 text-sm text-white/60">{liquidity.body}</p>
              <a href={liquidity.url} target="_blank" rel="noopener" class="btn-ghost mt-4 w-fit text-sm">{liquidity.label} ↗</a>
            </div>
          )}
        </div>
      </section>
    )}
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <!-- Latest documents -->
    <section class="card lg:col-span-2">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">{t('Latest documents')}</h2>
        <a href="/documents" class="text-sm text-lk-blue hover:underline">{t('All documents')} →</a>
      </div>
      <ul class="mt-4 divide-y divide-white/5">
        {(docs ?? []).map((d) => {
          const unread = !(d.document_reads as { user_id: string }[]).some((r) => r.user_id === userId) && Boolean(d.published_at) && Date.now() - new Date(d.published_at!).getTime() < 30 * 86_400_000;
          return (
            <li>
              <a href={`/documents/${d.id}`} class="flex flex-col gap-1 py-3 hover:text-white sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <span class="flex items-center gap-3">
                  {unread ? <span class="size-2 shrink-0 rounded-full bg-lk-orange" title={t('New')} /> : <span class="size-2 shrink-0" />}
                  <span class:list={[unread ? 'font-semibold text-white' : 'text-white/75']}>{d.title}</span>
                </span>
                <span class="pl-5 text-xs text-white/40 sm:shrink-0 sm:pl-0">{t(categoryLabels[d.category] ?? d.category)} · {shortDate.format(new Date(d.published_at!))}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- AGM + Q&A -->
    <div class="grid gap-4">
      {meeting && (
        <a href={`/agm/${meeting.id}`} class="card block transition hover:bg-white/[0.07]">
          <p class="text-xs uppercase tracking-widest text-lk-orange">{t('Upcoming meeting')}</p>
          <h2 class="mt-2 text-lg font-bold">{meeting.title}</h2>
          <p class="mt-1 text-sm text-white/55">{longDate.format(new Date(meeting.starts_at))}</p>
          <p class="mt-4 text-sm text-white/70">{meetingPhase(meeting) === 'voting' ? t('Lodge your proxy by {date}', { date: shortDate.format(new Date(meeting.proxy_deadline)) }) : t('Proxy voting has closed. See the meeting details')} →</p>
        </a>
      )}
      {Astro.locals.features.boardQa && (
        <a href="/board" class="card block transition hover:bg-white/[0.07]">
          <p class="text-xs uppercase tracking-widest text-white/40">{t('Board Q&A')}</p>
          <p class="mt-2 font-display text-3xl font-bold text-white">{openQueries ?? 0}</p>
          <p class="text-sm text-white/55">{t.n(openQueries ?? 0, 'question awaiting a reply', 'questions awaiting a reply')} · {t('the board replies within 7 working days')}</p>
        </a>
      )}
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <!-- Shareholder update video -->
    {video && (
      <section class="card lg:col-span-2">
        <h2 class="text-lg font-bold">{video.title}</h2>
        {video.summary && <p class="mt-1 text-sm text-white/55">{video.summary}</p>}
        <video class="mt-5 aspect-video w-full rounded-2xl bg-black" controls preload="none" src={`/documents/${video.id}`}></video>
      </section>
    )}
    <!-- News -->
    <section class:list={['card', !video && 'lg:col-span-3']}>
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">{t('News')}</h2>
        <a href="/news" class="text-sm text-lk-blue hover:underline">{t('All news')} →</a>
      </div>
      <ul class="mt-4 space-y-4">
        {(posts ?? []).map((n) => (
          <li><a href={n.href} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined} class="group block">
            <p class="text-xs text-white/40">{newsLabel(n.label)} · {shortDate.format(n.date)}</p>
            <p class="font-semibold text-white group-hover:underline">{n.title}</p>
            <p class="line-clamp-2 text-sm text-white/55">{n.excerpt}</p>
          </a></li>
        ))}
      </ul>
    </section>
  </div>
</Portal>

<script>
  // Arriving from the notes banner ("Read the note"): show that holding's note.
  if (location.hash.startsWith('#holding-')) {
    const card = document.getElementById(location.hash.slice(1));
    const note = card?.querySelector<HTMLElement>('.holding-note');
    if (card) card.scrollIntoView({ block: 'center' });
    note?.focus({ preventScroll: true });
  }
</script>

<script>
  // Closing the welcome guide: remembered for a year on this device.
  document.querySelector('[data-welcome-close]')?.addEventListener('click', () => {
    document.cookie = 'welcome_done=1; max-age=31536000; path=/; samesite=lax';
    document.querySelector('[data-welcome]')?.remove();
  });
</script>
