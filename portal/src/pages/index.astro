---
import Portal from '../layouts/Portal.astro';
import Sparkline from '../components/Sparkline.astro';
import LinkedInCard from '../components/LinkedInCard.astro';
import { inCompany, isShareClass, latestPrices, loadPositions, loadPrices, sourceLabels } from '../lib/holdings';
import { myHolderIds, onBoardOf, onlyMyDocuments } from '../lib/scope';
import { loadNews } from '../lib/news';
import { legalName } from '../lib/companies';
import { aud, audPrecise, categoryLabels, holderKinds, longDate, percent, shares, shortDate } from '../lib/format';

const supabase = Astro.locals.supabase;
const userId = Astro.locals.user!.id;
const role = Astro.locals.profile?.role;
const { company, companies } = Astro.locals;
const isGroup = company?.relationship === 'group';
const entityId = company?.id ?? '00000000-0000-0000-0000-000000000000';
const [allPositions, holderIds, onBoard, allPrices] = await Promise.all([
  loadPositions(supabase, userId), myHolderIds(supabase, userId), onBoardOf(supabase, userId, company, role), latestPrices(supabase),
]);
// The dashboard shows the company being viewed; "My ownership" sums up all of them.
const positions = inCompany(allPositions, company?.id);
const classIds = [...new Set(positions.filter(isShareClass).map((p) => p.row.share_class_id))];

const [priceSeries, { data: announcements }, { data: settings }, { data: docs }, posts, { data: meetings }, { data: video }, { count: openQueries }] = await Promise.all([
  Promise.all(classIds.map(async (id) => [id, await loadPrices(supabase, id)] as const)),
  supabase.from('announcements').select('id, title, body, link_url, link_label, tone').eq('entity_id', entityId).order('starts_at', { ascending: false }).limit(2),
  isGroup ? supabase.from('portal_settings').select('value').eq('key', 'liquidity').maybeSingle() : Promise.resolve({ data: null }),
  onlyMyDocuments(supabase.from('documents').select('id, title, category, published_at, entity_id, document_reads(user_id)').neq('category', 'video'), { holderIds, onBoard, company }).order('published_at', { ascending: false }).limit(5),
  loadNews(supabase, 3, company),
  supabase.from('meetings').select('id, title, starts_at, proxy_deadline, status').eq('entity_id', entityId).in('status', ['upcoming', 'open']).order('starts_at').limit(1),
  onlyMyDocuments(supabase.from('documents').select('id, title, summary, published_at').eq('category', 'video'), { holderIds, onBoard, company }).order('published_at', { ascending: false }).limit(1).maybeSingle(),
  supabase.from('queries').select('id', { count: 'exact', head: true }).eq('status', 'open').eq('user_id', userId).eq('entity_id', entityId),
]);

// Each share class is valued at its own latest reference price, if it has one.
// Options and similar have no price here (their value depends on exercise terms).
const valueAt = (p: (typeof positions)[number]) => {
  const pr = isShareClass(p) ? allPrices.get(p.row.share_class_id) : undefined;
  return pr ? p.row.shares * pr.price : null;
};
const value = valueAt;
const sharePositions = positions.filter(isShareClass);
const totalShares = sharePositions.reduce((sum, p) => sum + p.row.shares, 0);
const pricedValues = sharePositions.map(value).filter((v): v is number => v !== null);
const totalValue = pricedValues.reduce((a, b) => a + b, 0);
const unpricedClasses = [...new Set(sharePositions.filter((p) => value(p) === null).map((p) => p.row.share_classes?.name))];

// My ownership: one line per company with holdings.
const ownership = companies.map((c) => {
  const ps = inCompany(allPositions, c.id).filter((p) => p.row.shares > 0);
  const values = ps.filter(isShareClass).map(valueAt);
  return { company: c, positions: ps, shares: ps.filter(isShareClass).reduce((a, p) => a + p.row.shares, 0), options: ps.filter((p) => !isShareClass(p)).reduce((a, p) => a + p.row.shares, 0), value: values.reduce<number>((a, v) => a + (v ?? 0), 0), priced: values.some((v) => v !== null) };
}).filter((o) => o.positions.length);
const pricesByClass = new Map(priceSeries);
// The chart shows the class with the longest price history (normally Ordinary).
const chartClass = [...pricesByClass].sort((a, b) => b[1].length - a[1].length)[0];
const prices = chartClass?.[1] ?? [];
const price = prices.at(-1);
// Cards before the liquidity card in the two-column grid (the "no holdings" card spans both columns).
const cardsBefore = (positions.length || 2) + (prices.length > 0 && price ? 1 : 0);
const liquidityWide = cardsBefore % 2 === 0;
const chartClassName = positions.find((p) => p.row.share_class_id === chartClass?.[0])?.row.share_classes?.name;
const liquidity = settings?.value as { title: string; body: string; url: string; label: string } | undefined;
// The price card spans both columns when it would otherwise sit alone in its row.
const priceWide = positions.length > 0 && positions.length % 2 === 0 && !liquidity;
const meeting = meetings?.[0];
const firstName = Astro.locals.profile?.first_name || 'there';
const toneStyles = { info: 'border-lk-blue/30 bg-lk-blue/10', success: 'border-lk-green/30 bg-lk-green/10', warning: 'border-lk-orange/40 bg-lk-orange/10' };
---

<Portal title="Dashboard">
  {(announcements ?? []).map((a) => (
    <div class:list={['mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border px-5 py-3.5 text-sm', toneStyles[a.tone as keyof typeof toneStyles]]}>
      <p><span class="font-semibold text-white">{a.title}</span>{a.body && <span class="text-white/65"> · {a.body}</span>}</p>
      {a.link_url && <a href={a.link_url} class="font-semibold text-white underline-offset-4 hover:underline">{a.link_label ?? 'Learn more'} →</a>}
    </div>
  ))}

  <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow">Investor portal</p>
      <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">Welcome, {firstName}</h1>
      <p class="mt-3 text-white/55">{company ? `Your investment in ${legalName(company)}.` : 'Your investor account.'}</p>
    </div>
    {sharePositions.length > 1 && (
      <div>
        <div class="flex flex-wrap gap-x-8 gap-y-4">
          <div><p class="text-xs uppercase tracking-widest text-white/40">Total shares</p><p class="font-display text-2xl sm:text-3xl font-bold text-white">{shares.format(totalShares)}</p></div>
          {pricedValues.length > 0 && <div><p class="text-xs uppercase tracking-widest text-white/40">Indicative value</p><p class="font-display text-2xl sm:text-3xl font-bold text-white">{aud.format(totalValue)}</p></div>}
        </div>
        <p class="mt-1 text-xs text-white/40">Across your {sharePositions.length} holdings{unpricedClasses.length > 0 && pricedValues.length > 0 && ` · value excludes ${unpricedClasses.join(', ')} (no reference price)`}</p>
      </div>
    )}
  </div>

  {ownership.length > 1 && (
    <section class="mt-10" aria-label="My ownership">
      <h2 class="text-xs uppercase tracking-widest text-white/40">My ownership</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {ownership.map((o) => (
          <a href={`/company/${o.company.code}?next=/`} class:list={['card block p-5 transition hover:bg-white/[0.07]', o.company.id === company?.id && 'ring-1 ring-white/20']}>
            <p class="flex items-center gap-2 text-sm font-semibold text-white"><span class="size-2.5 rounded-full" style={`background:${o.company.brand_color ?? '#2563EB'}`}></span>{o.company.display_name}{o.company.id === company?.id && <span class="ml-auto text-[11px] font-normal text-white/40">Viewing</span>}</p>
            <p class="mt-3 font-display text-2xl font-bold text-white">{shares.format(o.shares)} <span class="text-sm font-normal text-white/45">shares</span></p>
            <p class="text-sm text-white/55">{o.priced ? `${aud.format(o.value)} indicative` : 'No reference price yet'}{o.options > 0 && ` · ${shares.format(o.options)} options`}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Holdings, reference price and secondary trading share one two-column grid,
       so a single holding sits next to the price chart. -->
  <div class="mt-10 grid gap-4 lg:grid-cols-2">
    {positions.length ? positions.map((p) => (
      <article class="card" aria-label={`Holding: ${p.holder.name}`}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold">{p.holder.name}</h2>
            <p class="text-sm text-white/45">{holderKinds[p.holder.kind]} · {p.row.share_classes?.name}</p>
          </div>
          <a href={`/statement/${p.holder.id}?class=${p.row.share_class_id}`} class="btn-ghost px-3 py-2 text-xs">Holding statement ↓</a>
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
          <div><dt class="text-xs uppercase tracking-widest text-white/40">{isShareClass(p) ? 'Shares' : 'Options'}</dt><dd class="mt-1 font-display text-xl font-bold text-white sm:text-2xl xl:text-3xl">{shares.format(p.row.shares)}</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-white/40">Of total</dt><dd class="mt-1 font-display text-xl font-bold text-white sm:text-2xl xl:text-3xl">{p.total ? percent.format(p.row.shares / p.total) : '—'}</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-white/40">Indicative</dt><dd class="mt-1 font-display text-xl font-bold text-white sm:text-2xl xl:text-3xl">{value(p) !== null ? aud.format(value(p)!) : '—'}</dd></div>
        </dl>
        <p class="mt-6 border-t border-white/5 pt-4 text-xs text-white/40">As at {longDate.format(new Date(p.row.as_at))} · {shares.format(p.total)} {p.row.share_classes?.name.toLowerCase()} on issue{p.row.exercise_price != null && ` · exercise price ${audPrecise.format(Number(p.row.exercise_price))}`}{p.row.expires_on && ` · expires ${longDate.format(new Date(p.row.expires_on))}`}{!isShareClass(p) && ' · not included in ownership %'}</p>
      </article>
    )) : (
      <div class="card lg:col-span-2">
        <h2 class="text-lg font-bold">No holdings linked yet</h2>
        <p class="mt-2 text-sm text-white/55">If you are a shareholder, ask a question in <a class="text-lk-blue hover:underline" href="/board">Board Q&amp;A</a> or email info@lakeba.com and we'll link your holding to this account.</p>
      </div>
    )}

    <!-- Reference price -->
    {prices.length > 0 && price && (
      <section class:list={['card', priceWide && 'lg:col-span-2']}>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold">Reference price</h2>
            {chartClassName && <p class="text-xs text-white/40">{chartClassName}</p>}
            <p class="text-sm text-white/45">{sourceLabels[price.source]} · {shortDate.format(new Date(price.priced_on))}</p>
          </div>
          <p class="font-display text-3xl font-bold text-white">{audPrecise.format(price.price)}</p>
        </div>
        <Sparkline class="mt-6 h-28 w-full" points={prices.map((pr) => ({ label: `${shortDate.format(new Date(pr.priced_on))}: ${audPrecise.format(pr.price)} (${sourceLabels[pr.source]})`, value: pr.price }))} />
        <p class="mt-3 text-xs text-white/35">Indicative only. Lakeba shares are unlisted; values use the latest capital raise, secondary trade or directors’ valuation and are not financial advice.</p>
      </section>
    )}

    <!-- Secondary trading: full width when it would otherwise sit alone in a row -->
    {liquidity && (
      <section class:list={['card flex flex-col bg-gradient-to-br from-lk-green/15 to-transparent', liquidityWide && 'lg:col-span-2 lg:flex-row lg:items-center lg:gap-8']}>
        <div class="flex-1">
          <p class="eyebrow w-fit">Liquidity</p>
          <h2 class="mt-4 text-lg font-bold">{liquidity.title}</h2>
          <p class="mt-2 text-sm text-white/60">{liquidity.body}</p>
        </div>
        <a href={liquidity.url} target="_blank" rel="noopener" class:list={['btn-primary mt-6 shrink-0', liquidityWide && 'lg:mt-0']}>{liquidity.label} ↗</a>
      </section>
    )}
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <!-- Latest documents -->
    <section class="card lg:col-span-2">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">Latest documents</h2>
        <a href="/documents" class="text-sm text-lk-blue hover:underline">All documents →</a>
      </div>
      <ul class="mt-4 divide-y divide-white/5">
        {(docs ?? []).map((d) => {
          const unread = !(d.document_reads as { user_id: string }[]).some((r) => r.user_id === userId);
          return (
            <li>
              <a href={`/documents/${d.id}`} class="flex flex-col gap-1 py-3 hover:text-white sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <span class="flex items-center gap-3">
                  {unread ? <span class="size-2 shrink-0 rounded-full bg-lk-orange" title="New" /> : <span class="size-2 shrink-0" />}
                  <span class:list={[unread ? 'font-semibold text-white' : 'text-white/75']}>{d.title}</span>
                </span>
                <span class="pl-5 text-xs text-white/40 sm:shrink-0 sm:pl-0">{categoryLabels[d.category]} · {shortDate.format(new Date(d.published_at!))}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- AGM + Q&A -->
    <div class="grid gap-4">
      {meeting && (
        <a href={`/agm/${meeting.id}`} class="card block transition hover:bg-white/[0.07]">
          <p class="text-xs uppercase tracking-widest text-lk-orange">Upcoming meeting</p>
          <h2 class="mt-2 text-lg font-bold">{meeting.title}</h2>
          <p class="mt-1 text-sm text-white/55">{longDate.format(new Date(meeting.starts_at))}</p>
          <p class="mt-4 text-sm text-white/70">Lodge your proxy by {shortDate.format(new Date(meeting.proxy_deadline))} →</p>
        </a>
      )}
      <a href="/board" class="card block transition hover:bg-white/[0.07]">
        <p class="text-xs uppercase tracking-widest text-white/40">Board Q&amp;A</p>
        <p class="mt-2 font-display text-3xl font-bold text-white">{openQueries ?? 0}</p>
        <p class="text-sm text-white/55">{openQueries === 1 ? 'question' : 'questions'} awaiting a reply · the board replies within 7 working days</p>
      </a>
      {isGroup && <LinkedInCard src="card" />}
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <!-- Shareholder update video -->
    {video && (
      <section class="card lg:col-span-2">
        <h2 class="text-lg font-bold">{video.title}</h2>
        {video.summary && <p class="mt-1 text-sm text-white/55">{video.summary}</p>}
        <video class="mt-5 aspect-video w-full rounded-2xl bg-black" controls preload="none" src={`/documents/${video.id}`}></video>
      </section>
    )}
    <!-- News -->
    <section class:list={['card', !video && 'lg:col-span-3']}>
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">News</h2>
        <a href="/news" class="text-sm text-lk-blue hover:underline">All news →</a>
      </div>
      <ul class="mt-4 space-y-4">
        {(posts ?? []).map((n) => (
          <li><a href={n.href} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined} class="group block">
            <p class="text-xs text-white/40">{n.label} · {shortDate.format(n.date)}</p>
            <p class="font-semibold text-white group-hover:underline">{n.title}</p>
            <p class="line-clamp-2 text-sm text-white/55">{n.excerpt}</p>
          </a></li>
        ))}
      </ul>
    </section>
  </div>
</Portal>
