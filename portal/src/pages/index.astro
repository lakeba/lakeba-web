---
import Portal from '../layouts/Portal.astro';

type Holding = { shares: number; as_at: string; share_class_id: string; share_classes: { code: string; name: string } | null };
type Holder = { id: string; name: string; kind: string; holdings: Holding[] };

const supabase = Astro.locals.supabase;
// Row-level security limits these to the holders this user is linked to.
const [{ data: holders }, { data: onIssue }] = await Promise.all([
  supabase.from('holders').select('id, name, kind, holdings(shares, as_at, share_class_id, share_classes(code, name))').order('name'),
  supabase.rpc('shares_on_issue'),
]);
const totals = new Map<string, number>((onIssue ?? []).map((r: { share_class_id: string; total: number }) => [r.share_class_id, Number(r.total)]));

/** Latest holding for each share class of a holder. */
const latest = (h: Holder) =>
  Object.values(
    h.holdings.reduce<Record<string, Holding>>((acc, row) => {
      if (!acc[row.share_class_id] || acc[row.share_class_id].as_at < row.as_at) acc[row.share_class_id] = row;
      return acc;
    }, {}),
  );

const fmt = new Intl.NumberFormat('en-AU');
const pct = new Intl.NumberFormat('en-AU', { style: 'percent', minimumFractionDigits: 2, maximumFractionDigits: 2 });
const date = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const kindLabel: Record<string, string> = { individual: 'Individual', company: 'Company', trust: 'Trust', super_fund: 'Super fund' };
const firstName = Astro.locals.profile?.first_name || 'there';
---

<Portal title="Dashboard">
  <p class="eyebrow">Investor portal</p>
  <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">Welcome, {firstName}</h1>
  <p class="mt-3 text-white/55">Your holdings in Lakeba Group Limited.</p>

  <section class="mt-10 grid gap-4 lg:grid-cols-2">
    {(holders as Holder[] | null)?.length ? (
      (holders as Holder[]).flatMap((h) =>
        latest(h).map((row) => {
          const total = totals.get(row.share_class_id) ?? 0;
          return (
            <article class="card">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class="text-lg font-bold">{h.name}</h2>
                  <p class="text-sm text-white/45">{kindLabel[h.kind]} · {row.share_classes?.name}</p>
                </div>
                <span class="rounded-full bg-lk-blue/15 px-3 py-1 font-mono text-xs text-lk-blue">{row.share_classes?.code}</span>
              </div>
              <dl class="mt-8 grid grid-cols-2 gap-6">
                <div>
                  <dt class="text-xs uppercase tracking-widest text-white/40">Your shares</dt>
                  <dd class="mt-1 font-display text-3xl font-bold text-white">{fmt.format(row.shares)}</dd>
                </div>
                <div>
                  <dt class="text-xs uppercase tracking-widest text-white/40">Of total on issue</dt>
                  <dd class="mt-1 font-display text-3xl font-bold text-white">{total ? pct.format(row.shares / total) : '—'}</dd>
                </div>
              </dl>
              <p class="mt-6 border-t border-white/5 pt-4 text-xs text-white/40">
                As at {date.format(new Date(row.as_at))} · {fmt.format(total)} {row.share_classes?.name.toLowerCase()} on issue
              </p>
            </article>
          );
        }),
      )
    ) : (
      <div class="card lg:col-span-2">
        <h2 class="text-lg font-bold">No holdings linked yet</h2>
        <p class="mt-2 text-sm text-white/55">If you are a shareholder, contact <a class="text-lk-blue hover:underline" href="mailto:info@lakeba.com">info@lakeba.com</a> and we'll link your holding to this account.</p>
      </div>
    )}
  </section>
</Portal>
