---
import Auth from '../../../layouts/Auth.astro';
import Alert from '../../../components/Alert.astro';
import { serviceClient } from '../../../lib/admin';
import { guestForToken, requestIp } from '../../../lib/data-rooms';
import { field } from '../../../lib/forms';
import { fileSize } from '../../../lib/format';

// A prospective investor's data room: confidentiality terms first, then the
// documents. No portal account; the personal link is the key.
const { t, fmt } = Astro.locals;
const svc = serviceClient();
const token = Astro.params.token ?? '';
const found = await guestForToken(svc, token);
let error = '';
let guest = 'guest' in found ? found.guest : null;
const room = 'room' in found ? found.room : null;

if (guest && room && Astro.request.method === 'POST' && !guest.nda_accepted_at) {
  const form = await Astro.request.formData();
  if (form.get('agree') !== 'yes' || field(form, 'name').toLowerCase() !== guest.name.trim().toLowerCase()) {
    error = t('Tick the box and type your name exactly as “{name}” to continue.', { name: guest.name });
  } else {
    const now = new Date().toISOString();
    await svc.from('data_room_guests').update({ nda_accepted_at: now, nda_accepted_ip: requestIp(Astro.request, Astro.clientAddress) }).eq('id', guest.id).is('nda_accepted_at', null).throwOnError();
    await svc.from('audit_log').insert({ action: 'data_room_nda_accepted', detail: { room_id: room.id, guest_id: guest.id, email: guest.email } });
    return Astro.redirect(`/room/${token}`, 303);
  }
}

const [{ data: company }, { data: items }] = room ? await Promise.all([
  svc.from('entities').select('display_name, legal_name').eq('id', room.entity_id).single(),
  guest?.nda_accepted_at ? svc.from('data_room_documents').select('sort, documents(id, title, summary, size_bytes, published_at, mime_type)').eq('room_id', room.id).order('sort') : Promise.resolve({ data: [] }),
]) : [{ data: null }, { data: [] }];
if (guest?.nda_accepted_at) await svc.from('data_room_guests').update({ last_seen_at: new Date().toISOString() }).eq('id', guest.id);
type Doc = { id: string; title: string; summary: string | null; size_bytes: number | null; published_at: string | null; mime_type: string };
const docs = (items ?? []).map((i) => i.documents as unknown as Doc).filter((d) => d && d.mime_type === 'application/pdf');
const companyName = company?.legal_name || company?.display_name || 'Lakeba';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

{!guest || !room ? (
  <Auth title={t('Data room')}>
    <Alert tone="error">{'problem' in found && found.problem === 'expired' ? t('This data room link has expired.') : t('This data room link is not valid or has been closed.')} {t('Please contact the person who invited you.')}</Alert>
  </Auth>
) : !guest.nda_accepted_at ? (
  <Auth title={room.name} subtitle={t('{company} · Confidential data room for {name}', { company: companyName, name: guest.name })} wide>
    {error && <div class="mb-5"><Alert tone="error">{error}</Alert></div>}
    <h2 class="text-sm font-semibold uppercase tracking-widest text-white/45">{t('Confidentiality')}</h2>
    <div class="mt-3 max-h-80 overflow-y-auto whitespace-pre-line rounded-xl border border-white/10 bg-white/[0.03] p-4 text-sm leading-relaxed text-white/75">{room.nda_text}</div>
    <form method="post" class="mt-5 space-y-4">
      <label class="flex items-start gap-3 text-sm text-white/75"><input type="checkbox" name="agree" value="yes" required class="mt-0.5 size-4 accent-lk-blue" /> {guest.organisation ? t('I have read and agree to these terms, on my own behalf and for {organisation}.', { organisation: guest.organisation }) : t('I have read and agree to these terms, on my own behalf.')}</label>
      <div><label class="label" for="name">{t('Type your full name to sign')}</label><input id="name" name="name" required autocomplete="name" class="field" placeholder={guest.name} /></div>
      <button class="btn-primary">{t('Agree and open the data room')}</button>
    </form>
  </Auth>
) : (
  <Auth title={room.name} subtitle={t('{company} · Confidential · for {name}', { company: companyName, name: guest.name })} wide>
    {room.description && <p class="mb-5 whitespace-pre-line text-sm text-white/65">{room.description}</p>}
    <ul class="divide-y divide-white/5 rounded-xl border border-white/10">
      {docs.map((d) => (
        <li><a href={`/room/${token}/doc/${d.id}`} target="_blank" rel="noopener" class="flex items-center justify-between gap-4 px-4 py-3 transition hover:bg-white/[0.04]">
          <span><span class="font-medium text-white">{d.title}</span>{d.summary && <span class="block text-xs text-white/45">{d.summary}</span>}</span>
          <span class="shrink-0 text-xs text-white/40">PDF{d.size_bytes ? ` · ${fileSize(d.size_bytes)}` : ''}{d.published_at && ` · ${fmt.shortDate.format(new Date(d.published_at))}`}</span>
        </a></li>
      ))}
      {!docs.length && <li class="px-4 py-6 text-center text-sm text-white/45">{t('No documents yet.')}</li>}
    </ul>
    <p class="mt-5 text-xs text-white/40">{t('Each document opens marked with your name and email, and every view is recorded. Access ends {date}.', { date: fmt.shortDate.format(new Date(guest.expires_at)) })}</p>
  </Auth>
)}
