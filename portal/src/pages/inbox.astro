---
import Portal from '../layouts/Portal.astro';
import PageHeader from '../components/PageHeader.astro';
import Empty from '../components/Empty.astro';
import { dateTime } from '../lib/format';

const supabase = Astro.locals.supabase;
if (Astro.request.method === 'POST') {
  await supabase.from('notifications').update({ read_at: new Date().toISOString() }).is('read_at', null);
  return Astro.redirect('/inbox');
}
const { data: items } = await supabase.from('notifications').select('id, title, body, link, created_at, read_at').order('created_at', { ascending: false }).limit(100);
const unread = (items ?? []).filter((n) => !n.read_at).length;
---

<Portal title="Inbox">
  <PageHeader eyebrow="Inbox" title="Notifications" subtitle="New documents, meetings and replies from the board.">
    {unread > 0 && <form method="post"><button class="btn-ghost">Mark all as read</button></form>}
  </PageHeader>
  {items?.length ? (
    <ul class="grid max-w-3xl gap-3">
      {items.map((n) => (
        <li><a href={n.link ?? '#'} class:list={['card flex gap-4 p-5 transition hover:bg-white/[0.07]', n.read_at && 'opacity-60']}>
          <span class:list={['mt-2 size-2 shrink-0 rounded-full', n.read_at ? 'bg-white/20' : 'bg-lk-orange']}></span>
          <span><span class="block font-semibold text-white">{n.title}</span>{n.body && <span class="block text-sm text-white/55">{n.body}</span>}<span class="mt-1 block text-xs text-white/35">{dateTime.format(new Date(n.created_at))}</span></span>
        </a></li>
      ))}
    </ul>
  ) : <Empty title="You're all caught up">Notifications about new documents, meetings and replies will appear here.</Empty>}
</Portal>
