---
import Portal from '../layouts/Portal.astro';
import AccountNav from '../components/AccountNav.astro';
import Empty from '../components/Empty.astro';
import { serviceClient } from '../lib/admin';
import { ADMIN_KINDS } from '../lib/view-mode';

const { supabase, t, fmt } = Astro.locals;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // Delete all: only this person's own notifications (people may only mark theirs as read, so the server deletes them).
  if (form.get('intent') === 'delete-all') await serviceClient().from('notifications').delete().eq('user_id', Astro.locals.user!.id);
  else await supabase.from('notifications').update({ read_at: new Date().toISOString() }).is('read_at', null);
  return Astro.redirect('/inbox', 303);
}
// Show which company a notification is from when someone has more than one.
const companyOf = (id: string | null) => (Astro.locals.companies.length > 1 ? Astro.locals.companies.find((c) => c.id === id)?.display_name : undefined);
const listed = supabase.from('notifications').select('id, title, body, link, created_at, read_at, entity_id').order('created_at', { ascending: false }).limit(100);
// View as investor: admin notifications stay out of sight.
const { data: items } = await (Astro.locals.viewMode.on ? listed.not('kind', 'in', ADMIN_KINDS) : listed);
const unread = (items ?? []).filter((n) => !n.read_at).length;
---

<Portal title={t('Inbox')}>
  <AccountNav title={t('Inbox')} subtitle={t('New documents, meetings and replies from the board.')}>
    {(items?.length ?? 0) > 0 && (
      <div class="flex flex-wrap gap-2">
        {unread > 0 && <form method="post"><button name="intent" value="read-all" class="btn-ghost">{t('Mark all as read')}</button></form>}
        <form method="post" data-confirm={t('Delete all notifications? This can’t be undone.')} onsubmit="return confirm(this.dataset.confirm)"><button name="intent" value="delete-all" class="btn-ghost text-lk-red">{t('Delete all')}</button></form>
      </div>
    )}
  </AccountNav>
  {items?.length ? (
    <ul class="grid max-w-3xl gap-3">
      {items.map((n) => (
        <li><a href={n.link ?? '#'} class:list={['card flex gap-4 p-5 transition hover:bg-white/[0.07]', n.read_at && 'opacity-60']}>
          <span class:list={['mt-2 size-2 shrink-0 rounded-full', n.read_at ? 'bg-white/20' : 'bg-lk-orange']}></span>
          <span><span class="block font-semibold text-white">{n.title}</span>{n.body && <span class="block text-sm text-white/55">{n.body}</span>}<span class="mt-1 block text-xs text-white/35">{companyOf(n.entity_id) && `${companyOf(n.entity_id)} · `}{fmt.dateTime.format(new Date(n.created_at))}</span></span>
        </a></li>
      ))}
    </ul>
  ) : <Empty title={t('You\'re all caught up')}>{t('Notifications about new documents, meetings and replies will appear here.')}</Empty>}
</Portal>
