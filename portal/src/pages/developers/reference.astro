---
import '@scalar/api-reference/style.css';
import Auth from '../../layouts/Auth.astro';
import PageHeader from '../../components/PageHeader.astro';

// The interactive API reference (Scalar), public, in the same frame as the /developers guide: made from
// /api/v1/openapi.json. "Try it" sends requests from the browser straight to this portal (no outside relay), with
// a key that isn't saved. On a venture's own domain it moves to the central address, where the API is.
const central = Astro.locals.site?.central;
if (central && central !== Astro.url.origin) return Astro.redirect(`${central}/developers/reference`);
---

<Auth title="API reference" page>
  <PageHeader eyebrow="Developers" title="API reference" subtitle="Every request and answer, with examples and code. “Try it” sends real requests with the key you enter; the key isn’t saved.">
    <div class="flex flex-wrap gap-2 text-sm">
      <a href="/developers" class="btn-ghost px-4 py-2">← Guide</a>
      <a href="/api/v1/openapi.json" class="btn-ghost px-4 py-2">OpenAPI ↗</a>
    </div>
  </PageHeader>
  <div id="reference" class="lk-reference"></div>
</Auth>

<script>
  import { createApiReference } from '@scalar/api-reference';

  // Light or dark: the portal's own choice (the theme button), else the device's; Scalar follows it.
  const dark = () => {
    const choice = document.documentElement.dataset.theme;
    return choice ? choice === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  // Scalar's colours are the portal's (its variables change with the theme), so the reference looks like the guide.
  const portal = `
    .light-mode, .dark-mode {
      --scalar-background-1: var(--color-ink);
      --scalar-background-2: color-mix(in oklab, var(--color-white) 4%, var(--color-ink));
      --scalar-background-3: color-mix(in oklab, var(--color-white) 9%, var(--color-ink));
      --scalar-background-accent: color-mix(in oklab, var(--color-lk-blue) 12%, transparent);
      --scalar-color-1: var(--color-white);
      --scalar-color-2: color-mix(in oklab, var(--color-white) 72%, transparent);
      --scalar-color-3: color-mix(in oklab, var(--color-white) 50%, transparent);
      --scalar-color-accent: var(--color-lk-blue);
      --scalar-border-color: var(--color-line);
      --scalar-sidebar-background-1: var(--color-ink);
      --scalar-sidebar-border-color: transparent;
      --scalar-sidebar-color-1: var(--color-white);
      --scalar-sidebar-color-2: color-mix(in oklab, var(--color-white) 55%, transparent);
      --scalar-sidebar-color-active: var(--color-white);
      --scalar-sidebar-item-hover-color: var(--color-white);
      --scalar-sidebar-item-hover-background: color-mix(in oklab, var(--color-white) 5%, transparent);
      --scalar-sidebar-item-active-background: color-mix(in oklab, var(--color-white) 10%, transparent);
      --scalar-sidebar-search-background: color-mix(in oklab, var(--color-white) 4%, transparent);
      --scalar-sidebar-search-border-color: color-mix(in oklab, var(--color-white) 10%, transparent);
      --scalar-sidebar-search-color: color-mix(in oklab, var(--color-white) 45%, transparent);
      --scalar-radius: 0.5rem; --scalar-radius-lg: 0.75rem; --scalar-radius-xl: 1rem;
      --scalar-font: var(--font-sans); --scalar-font-code: var(--font-mono);
    }
    .scalar-api-reference h1, .scalar-api-reference h2, .section-header { font-family: var(--font-display); }
  `;
  const config = {
    url: '/api/v1/openapi.json',
    forceDarkModeState: (dark() ? 'dark' : 'light') as 'dark' | 'light',
    hideDarkModeToggle: true,
    withDefaultFonts: false,
    // Nothing leaves the portal: no relay, no telemetry, no AI chat or MCP buttons, the key isn't kept.
    persistAuth: false,
    telemetry: false,
    agent: { disabled: true },
    mcp: { disabled: true },
    showDeveloperTools: 'never' as const,
    hideClientButton: true,
    documentDownloadType: 'json' as const,
    authentication: { preferredSecurityScheme: 'key' },
    defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
    metaData: { title: 'API reference · Lakeba Investor Portal' },
    customCss: portal,
  };
  const reference = createApiReference('#reference', config);
  const follow = () => {
    const mode = dark() ? 'dark' : 'light';
    if (mode !== config.forceDarkModeState) { config.forceDarkModeState = mode; reference.updateConfiguration({ ...config }); }
  };
  new MutationObserver(follow).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', follow);
</script>

<style is:global>
  /* Scalar sits in the page like the guide's content: its own full-height frame becomes part of the page. */
  .lk-reference { --scalar-custom-header-height: 0px; }
  .lk-reference .scalar-app, .lk-reference .scalar-api-reference { min-height: 0; }
  /* A compact menu, as wide as the guide's (14rem). */
  .lk-reference .scalar-app { --scalar-sidebar-width: 14rem; --scalar-sidebar-padding: 4px; --scalar-sidebar-indent: 12px; }
  .lk-reference .scalar-app aside ul { gap: 0; }
  .lk-reference .scalar-app aside li > div > :is(a, button) { padding: 5px 8px; font-size: 13px; line-height: 18px; }
  .lk-reference .scalar-app aside li > div > :is(a, button) > .scalar-sidebar-indent { margin-top: -5px; margin-bottom: -5px; }
</style>
