---
import Portal from '../../layouts/Portal.astro';
import PageHeader from '../../components/PageHeader.astro';
import Empty from '../../components/Empty.astro';
import { serviceClient } from '../../lib/admin';
import { fileSize, shortDate } from '../../lib/format';
import { EMPLOYMENT, GRANT_COLUMNS, myRecords, policiesFor, position, type Grant } from '../../lib/hr';

// My HR: an employee's own space: the policies to read and accept, their
// option grants, the documents HR shared with them, and HR Ask.
const svc = serviceClient();
const records = (await myRecords(svc, Astro.locals.user!.id)).filter((r) => r.status !== 'left');
if (!records.length) return Astro.redirect('/');
const ids = records.map((r) => r.id);
const [policyLists, { data: acks }, { data: grantRows }, { data: docs }] = await Promise.all([
  Promise.all(records.map((r) => policiesFor(svc, r.entity_id))),
  svc.from('policy_acks').select('policy_id, version, person_id').in('person_id', ids),
  svc.from('equity_grants').select(`${GRANT_COLUMNS}, equity_plans(name, kind), equity_exercises(number, status)`).in('person_id', ids).in('status', ['granted', 'lapsed']).order('grant_date'),
  svc.from('person_documents').select('id, title, kind, file_path, size_bytes, created_at').in('person_id', ids).eq('visible_to_employee', true).order('created_at', { ascending: false }),
]);
const policies = policyLists.flat().filter((p, i, all) => all.findIndex((x) => x.id === p.id) === i);
const accepted = (id: string, v: number) => (acks ?? []).some((a) => a.policy_id === id && a.version === v);
const toAccept = policies.filter((p) => p.requires_ack && !accepted(p.id, p.version));
const grants = (grantRows ?? []) as unknown as (Grant & { equity_plans: { name: string; kind: string } | null; equity_exercises: { number: number; status: 'requested' | 'approved' | 'issued' | 'rejected' }[] })[];
const n = (v: number) => new Intl.NumberFormat('en-AU').format(v);
const day = (s: string) => shortDate.format(new Date(s.length === 10 ? `${s}T12:00:00+10:00` : s));
---

<Portal title="My HR">
  <PageHeader title="My HR" subtitle={records.map((r) => `${r.job_title || EMPLOYMENT[r.employment_type]} at ${r.entities?.display_name}`).join(' · ')}>
    <a class="btn-ghost" href="/my-hr/ask" data-tour="myhr-ask">Ask about a policy</a>
  </PageHeader>
  {toAccept.length > 0 && (
    <section class="card mb-6 p-0" data-tour="myhr-accept">
      <h2 class="px-5 pt-5 font-display text-lg font-bold">To read and accept</h2>
      <ul class="mt-2 divide-y divide-white/5">{toAccept.map((p) => <li><a class="flex justify-between gap-3 px-5 py-3 hover:bg-white/[0.04]" href={`/my-hr/policies/${p.id}`}><span class="text-white">{p.title}</span><span class="text-sm text-lk-orange">{p.version > 1 ? 'Updated' : 'New'}</span></a></li>)}</ul>
    </section>
  )}
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="card p-0" data-tour="myhr-grants">
      <h2 class="px-5 pt-5 font-display text-lg font-bold">Option grants</h2>
      {grants.length ? (
        <ul class="mt-2 divide-y divide-white/5">{grants.map((g) => { const pos = position(g, g.equity_exercises); return (
          <li><a class="block px-5 py-3 hover:bg-white/[0.04]" href={`/my-hr/grants/${g.id}`}><span class="text-white">{n(g.number)} {g.equity_plans?.kind} · {g.equity_plans?.name}</span><span class="block text-xs text-white/50">{n(pos.vested)} vested · {n(pos.exercisable)} you can exercise now{!g.accepted_at && g.status === 'granted' && <span class="text-lk-orange"> · to accept</span>}</span></a></li>
        ); })}</ul>
      ) : <p class="px-5 pb-5 pt-2 text-sm text-white/55">None.</p>}
    </section>
    <section class="card p-0" data-tour="myhr-docs">
      <h2 class="px-5 pt-5 font-display text-lg font-bold">Documents</h2>
      {(docs ?? []).length ? <ul class="mt-2 divide-y divide-white/5 text-sm">{(docs ?? []).map((d) => <li class="flex justify-between gap-3 px-5 py-2.5"><a class="text-lk-blue hover:underline" href={`/my-hr/file?path=${encodeURIComponent(d.file_path)}`}>{d.title}</a><span class="text-white/45">{fileSize(d.size_bytes)} · {day(d.created_at)}</span></li>)}</ul> : <p class="px-5 pb-5 pt-2 text-sm text-white/55">None shared with you.</p>}
    </section>
    <section class="card p-0 lg:col-span-2" data-tour="myhr-policies">
      <h2 class="px-5 pt-5 font-display text-lg font-bold">Policies</h2>
      {policies.length ? <ul class="mt-2 divide-y divide-white/5 text-sm">{policies.map((p) => <li><a class="flex justify-between gap-3 px-5 py-2.5 hover:bg-white/[0.04]" href={`/my-hr/policies/${p.id}`}><span class="text-white">{p.title}</span><span class:list={[!p.requires_ack ? 'text-white/40' : accepted(p.id, p.version) ? 'text-lk-green' : 'text-lk-orange']}>{!p.requires_ack ? 'for reference' : accepted(p.id, p.version) ? 'accepted' : 'to accept'}</span></a></li>)}</ul> : <div class="p-5"><Empty title="No policies yet">Your employer hasn't published any.</Empty></div>}
    </section>
  </div>
</Portal>
