---
import Auth from '../../layouts/Auth.astro';
import Alert from '../../components/Alert.astro';
import { passwordProblem } from '../../lib/forms';

let error = '';
let done = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  error = passwordProblem(password) ?? (password !== String(form.get('confirm') ?? '') ? 'The two passwords do not match.' : '');
  if (!error) {
    const { error: updateError } = await Astro.locals.supabase.auth.updateUser({ password });
    if (updateError) {
      error = updateError.code === 'reauthentication_needed'
        ? 'For your security, sign in again (or use the emailed link) before changing your password.'
        : updateError.code === 'same_password' ? 'Choose a password you have not used here before.' : updateError.message;
    } else {
      await Astro.locals.supabase.rpc('log_event', { event_action: 'password_changed' });
      done = true;
    }
  }
}
---

<Auth title="Choose a password" subtitle="At least 12 characters, with upper- and lower-case letters and a number.">
  {error && <div class="mb-5"><Alert tone="error">{error}</Alert></div>}
  {done ? (
    <div class="space-y-5">
      <Alert tone="success">Your password has been updated.</Alert>
      <a href="/" class="btn-primary w-full">Go to the portal</a>
    </div>
  ) : (
    <form method="post" class="space-y-4">
      <input type="email" name="username" autocomplete="username" value={Astro.locals.user?.email} hidden />
      <div>
        <label for="password" class="label">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required class="field" />
      </div>
      <div>
        <label for="confirm" class="label">Confirm new password</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required class="field" />
      </div>
      <button class="btn-primary w-full">Save password</button>
    </form>
  )}
</Auth>
