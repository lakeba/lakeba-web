---
import Auth from '../../layouts/Auth.astro';
import Alert from '../../components/Alert.astro';
import { passwordProblem } from '../../lib/forms';
import { notifySecurity } from '../../lib/notify';

const { t } = Astro.locals;
let error = '';
let done = false;
// Supabase requires the authenticator code (not just a passkey) to change the password when two-step is on.
const needsCode = Astro.locals.mfaEnrolled && !Astro.locals.user?.codeVerified;
if (Astro.request.method === 'POST' && !needsCode) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const problem = passwordProblem(password);
  error = problem ? t(problem) : password !== String(form.get('confirm') ?? '') ? t('The two passwords do not match.') : '';
  if (!error) {
    const { error: updateError } = await Astro.locals.supabase.auth.updateUser({ password });
    if (updateError) {
      error = updateError.code === 'reauthentication_needed'
        ? t('For your security, sign in again (or use the emailed link) before changing your password.')
        : updateError.code === 'same_password' ? t('Choose a password you have not used here before.') : updateError.message;
    } else {
      await Astro.locals.supabase.rpc('log_event', { event_action: 'password_changed' });
      await notifySecurity({ userId: Astro.locals.user!.id, origin: Astro.url.origin, title: 'Your password was changed', body: 'The password for your Lakeba investor account was just changed. If this wasn’t you, reset it from the sign-in page and contact info@lakeba.com.' });
      done = true;
    }
  }
}
---

<Auth title={t('Choose a password')} subtitle={t('At least 12 characters, with upper- and lower-case letters and a number.')}>
  {error && <div class="mb-5"><Alert tone="error">{error}</Alert></div>}
  {needsCode ? (
    <div class="space-y-5">
      <Alert>{t('You signed in with a passkey. To change your password, first enter the code from your authenticator app.')}</Alert>
      <a href="/mfa/verify?next=/account/password" class="btn-primary w-full">{t('Enter code')}</a>
    </div>
  ) : done ? (
    <div class="space-y-5">
      <Alert tone="success">{t('Your password has been updated.')}</Alert>
      <a href="/" class="btn-primary w-full">{t('Go to the portal')}</a>
    </div>
  ) : (
    <form method="post" class="space-y-4">
      <input type="email" name="username" autocomplete="username" value={Astro.locals.user?.email} hidden />
      <div>
        <label for="password" class="label">{t('New password')}</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required class="field" />
      </div>
      <div>
        <label for="confirm" class="label">{t('Confirm new password')}</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required class="field" />
      </div>
      <button class="btn-primary w-full">{t('Save password')}</button>
    </form>
  )}
</Auth>
