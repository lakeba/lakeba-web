---
import Portal from '../layouts/Portal.astro';
import Mark from '../../../src/components/Mark.astro';
import { askEnabled } from '../lib/ask';
import { clientStrings } from '../lib/i18n';

const { company, features, t } = Astro.locals;
if (!company) return Astro.redirect('/');
const off = !features.ask;
const isGroup = company.relationship === 'group';
const title = t('Ask {brand}', { brand: isGroup ? 'Lakeba' : company.display_name });
const name = company.display_name;
const examples = isGroup ? [
  t('What were the FY24 revenue and profit?'),
  t('How many shares are on issue, and what is the latest price?'),
  t('What has Bricklet announced recently?'),
  t('Who audits Lakeba and when did that change?'),
] : [
  t('What were {company}’s latest results?', { company: name }),
  t('How many shares are on issue, and what is the latest price?'),
  t('When is the next shareholder meeting?'),
  t('What has {company} announced recently?', { company: name }),
];
// Texts the browser script shows.
const i18n = clientStrings(t, ['No conversations yet.', 'Delete', 'Delete this conversation?', 'Thanks for the feedback.', 'Could not save your feedback.', 'Sources', '+{n} more', '{name} is unavailable right now.', 'Stopped.', 'That answer didn’t finish. Your question is back in the box: send it again.']);
const isAdmin = Astro.locals.access.groupAdmin;
---

<Portal title={title}>
  {off ? (
    <div class="mx-auto max-w-xl py-16 text-center">
      <p class="eyebrow">{title}</p>
      <h1 class="mt-4 text-3xl font-extrabold">{t('Not available for your account')}</h1>
      <p class="mt-3 text-white/60">{t('Ask isn’t switched on for your account.')} {t('For help, email')} <a href="mailto:info@lakeba.com" class="text-lk-blue hover:underline">info@lakeba.com</a>.</p>
    </div>
  ) : (
  <div class="mx-auto flex min-h-[calc(100dvh-14rem)] max-w-3xl flex-col" data-chat data-company={company.code} data-name={title} data-i18n={i18n}>
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="eyebrow">{title} · AI</p>
        <h1 class="mt-3 text-3xl font-extrabold">{isGroup ? t('Ask about your company') : t('Ask about {company}', { company: name })}</h1>
      </div>
      <div class="flex shrink-0 gap-2">
        <button type="button" data-history-open class="btn-ghost px-4 py-2 text-sm" aria-expanded="false" aria-controls="ask-history">{t('Your conversations')}</button>
        <button type="button" data-new-chat class="btn-ghost px-4 py-2 text-sm" hidden>{t('New chat')}</button>
      </div>
    </div>

    {/* Earlier conversations (kept 12 months): open one to read it and carry on. */}
    <div id="ask-history" data-history-panel class="fixed inset-0 z-50" hidden>
      <div class="absolute inset-0 bg-black/40" data-history-close></div>
      <aside class="absolute inset-y-0 right-0 flex w-full max-w-sm flex-col border-l border-white/10 bg-ink shadow-2xl" aria-label={t('Your conversations')}>
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
          <h2 class="font-display text-lg font-bold">{t('Your conversations')}</h2>
          <button type="button" class="text-sm text-white/55 hover:text-white" data-history-close>{t('Close')} ✕</button>
        </div>
        <ul class="flex-1 divide-y divide-white/5 overflow-y-auto" data-history-list></ul>
        <p class="border-t border-white/10 px-5 py-3 text-xs text-white/40">{t('Kept for 12 months. Only you can see your conversations here.')}</p>
      </aside>
    </div>

    <div data-empty class="flex flex-1 flex-col items-center justify-center py-12 text-center">
      <Mark class="size-14" animated />
      <p class="mt-6 max-w-md text-white/60">{isGroup ? t('Answers come only from the documents in this portal and the news on Lakeba’s website, with links to the sources.') : t('Answers come only from {company}’s documents in this portal and news about {company}, with links to the sources.', { company: name })}</p>
      <div class="mt-8 grid w-full gap-2 sm:grid-cols-2">
        {examples.map((e) => <button type="button" data-example class="glass rounded-2xl px-4 py-3 text-left text-sm text-white/75 transition hover:text-white">{e}</button>)}
      </div>
      {Astro.locals.features.boardQa && <p class="mt-8 text-sm text-white/50">{t('Need a person to answer?')} <a href="/board" class="text-lk-blue hover:underline">{t('Ask the board in Board Q&A')} →</a></p>}
    </div>

    <ol data-messages class="flex-1 space-y-6 py-8" aria-live="polite"></ol>

    <form data-form class="sticky bottom-4 mt-4">
      <div class="glass flex items-end gap-2 rounded-3xl p-2 shadow-2xl shadow-black/30">
        <label for="question" class="sr-only">{t('Your question')}</label>
        <textarea id="question" data-input rows="1" maxlength="4000" placeholder={isGroup ? t('Ask about results, shares, meetings or ventures…') : t('Ask about results, shares or meetings…')} class="max-h-48 min-h-11 flex-1 resize-none bg-transparent px-3 py-2.5 text-white outline-none placeholder:text-white/35"></textarea>
        <button type="submit" data-send class="btn-primary size-11 shrink-0 rounded-2xl p-0" aria-label={t('Send')}>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
        </button>
        <button type="button" data-stop class="btn-ghost size-11 shrink-0 rounded-2xl p-0" aria-label={t('Stop')} hidden>
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
        </button>
      </div>
      <p class="mt-2 text-center text-xs text-white/35">
        {t('AI answers from company documents. Check the sources; this is not financial advice.')}
        {!askEnabled && isAdmin && ` ${t('AI answers are off: set ANTHROPIC_API_KEY.')}`}
      </p>
    </form>
  </div>

  <template data-user-template>
    <li class="flex justify-end"><div class="max-w-[85%] whitespace-pre-line rounded-3xl rounded-br-md bg-lk-blue/20 px-5 py-3 text-white/90" data-text></div></li>
  </template>
  <template data-assistant-template>
    <li class="flex gap-3">
      <div class="mt-1 grid size-8 shrink-0 place-items-center rounded-full bg-white/5"><Mark class="size-5" /></div>
      <div class="min-w-0 flex-1">
        <div class="ask-answer leading-relaxed text-white/85" data-text><span class="typing"><i></i><i></i><i></i></span></div>
        <div class="mt-3 flex flex-wrap gap-2 text-xs" data-sources hidden></div>
        <div class="mt-2 flex items-center gap-1 text-white/40" data-rate hidden>
          <button type="button" data-rating="1" class="rate-btn" aria-label={t('Good answer')} title={t('Good answer')}>👍</button>
          <button type="button" data-rating="-1" class="rate-btn" aria-label={t('Not helpful')} title={t('Not helpful')}>👎</button>
          <span class="ml-1 text-xs" data-rate-status></span>
        </div>
        <form class="mt-2 flex gap-2" data-rate-note hidden>
          <input maxlength="1000" placeholder={t('What was wrong? (optional)')} aria-label={t('What was wrong?')} class="field !py-2 text-sm" />
          <button class="btn-ghost shrink-0 !px-3 !py-2 text-sm">{t('Send')}</button>
        </form>
      </div>
    </li>
  </template>
  )}
</Portal>

<style>
  .ask-answer :global(p), .ask-answer :global(ul), .ask-answer :global(ol) { margin: 0 0 0.8rem; }
  .ask-answer :global(> :last-child) { margin-bottom: 0; }
  .ask-answer :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .ask-answer :global(ol) { list-style: decimal; padding-left: 1.25rem; }
  .ask-answer :global(li) { margin: 0.2rem 0; }
  .ask-answer :global(strong) { color: var(--color-white); }
  .ask-answer :global(h3), .ask-answer :global(h4) { margin: 0.8rem 0 0.4rem; font-weight: 700; color: var(--color-white); }
  .ask-answer :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 0.8rem; font-size: 0.9rem; }
  .ask-answer :global(th), .ask-answer :global(td) { border-bottom: 1px solid var(--color-line); padding: 0.4rem; text-align: left; }
  .ask-answer :global(.cursor)::after { content: '▍'; margin-left: 1px; color: var(--color-lk-blue); animation: blink 1s steps(1) infinite; }
  .rate-btn { border-radius: 9999px; padding: 0.15rem 0.45rem; filter: grayscale(1); opacity: 0.6; transition: all 150ms; }
  .rate-btn:hover, .rate-btn[aria-pressed='true'] { filter: none; opacity: 1; background: color-mix(in oklab, var(--color-white) 8%, transparent); }
  .typing { display: inline-flex; gap: 4px; padding: 0.5rem 0; }
  .typing i { width: 6px; height: 6px; border-radius: 9999px; background: color-mix(in oklab, var(--color-white) 45%, transparent); animation: bounce 1.2s infinite; }
  .typing i:nth-child(2) { animation-delay: 0.15s; }
  .typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); opacity: 0.5; } 30% { transform: translateY(-4px); opacity: 1; } }
  @keyframes blink { 50% { opacity: 0; } }
</style>

<script>
  import { Marked } from 'marked';

  type Source = { title: string; detail: string | null; href: string | null };
  type Turn = { role: 'user' | 'assistant'; content: string; sources?: Source[]; exchange?: string; rating?: number };

  // Markdown from the model; any raw HTML is shown as text.
  const escape = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const marked = new Marked({ renderer: { html: ({ text }) => escape(text) } });
  const render = (md: string) => marked.parse(md, { async: false }) as string;

  // The chat isn't on the page when Ask is switched off for this account.
  const chatEl = document.querySelector<HTMLElement>('[data-chat]');
  if (chatEl) {
  const COMPANY = chatEl.dataset.company ?? '';
  const NAME = chatEl.dataset.name ?? 'Ask Lakeba';
  // Interface texts in the reader's language (English when missing).
  const L: Record<string, string> = JSON.parse(chatEl.dataset.i18n ?? '{}');
  const tr = (s: string, vars: Record<string, string | number> = {}) => (L[s] ?? s).replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
  // One saved conversation per company.
  const STORE = `lakeba-ask-chat:${COMPANY}`;
  const root = document.querySelector<HTMLElement>('[data-chat]')!;
  const list = root.querySelector<HTMLOListElement>('[data-messages]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const input = root.querySelector<HTMLTextAreaElement>('[data-input]')!;
  const send = root.querySelector<HTMLButtonElement>('[data-send]')!;
  const stop = root.querySelector<HTMLButtonElement>('[data-stop]')!;
  const newChat = root.querySelector<HTMLButtonElement>('[data-new-chat]')!;
  const userTpl = document.querySelector<HTMLTemplateElement>('[data-user-template]')!;
  const botTpl = document.querySelector<HTMLTemplateElement>('[data-assistant-template]')!;

  // The conversation is kept in this browser tab, and on the server: coming back
  // (another page, a reload, a new tab) shows it again, including an answer
  // that was still being written.
  let turns: Turn[] = [];
  let conversationId = crypto.randomUUID();
  let controller: AbortController | null = null;
  let hasSession = false;
  try {
    const saved = JSON.parse(sessionStorage.getItem(STORE) ?? 'null');
    if (saved?.turns) { ({ turns, conversationId } = saved); hasSession = true; }
  } catch {}
  const save = () => { try { sessionStorage.setItem(STORE, JSON.stringify({ turns, conversationId })); } catch {} };

  // 👍 / 👎 under an answer; 👎 asks (optionally) what was wrong.
  const setupRating = (li: HTMLElement, turn: Turn) => {
    if (!turn.exchange) return;
    const row = li.querySelector<HTMLElement>('[data-rate]')!;
    const status = row.querySelector<HTMLElement>('[data-rate-status]')!;
    const noteForm = li.querySelector<HTMLFormElement>('[data-rate-note]')!;
    const buttons = [...row.querySelectorAll<HTMLButtonElement>('[data-rating]')];
    const mark = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.rating) === turn.rating)));
    const rate = async (rating: number, note?: string) => {
      const res = await fetch('/api/ask-feedback', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: turn.exchange, rating, note }) });
      status.textContent = res.ok ? tr('Thanks for the feedback.') : tr('Could not save your feedback.');
      if (res.ok) { turn.rating = rating; save(); mark(); }
    };
    buttons.forEach((b) => b.addEventListener('click', async () => {
      const rating = Number(b.dataset.rating);
      await rate(rating);
      noteForm.hidden = rating !== -1;
      if (rating === -1) noteForm.querySelector('input')!.focus();
    }));
    noteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      await rate(-1, noteForm.querySelector('input')!.value);
      noteForm.hidden = true;
    });
    mark();
    row.hidden = false;
  };

  const showSources = (el: HTMLElement, sources: Source[]) => {
    if (!sources.length) return;
    const LIMIT = 4;
    const chip = (s: Source) => {
      const a = document.createElement(s.href ? 'a' : 'span');
      a.className = 'inline-flex max-w-full items-center gap-1 rounded-full border border-white/10 px-3 py-1 text-white/60 transition hover:border-white/30 hover:text-white';
      if (s.href && a instanceof HTMLAnchorElement) { a.href = s.href; a.target = '_blank'; a.rel = 'noopener'; }
      a.innerHTML = `<span class="truncate">${escape(s.title)}</span>${s.detail ? `<span class="shrink-0 text-white/35">· ${escape(s.detail)}</span>` : ''}`;
      return a;
    };
    const label = document.createElement('span');
    label.className = 'py-1 text-white/35';
    label.textContent = tr('Sources');
    el.append(label, ...sources.slice(0, LIMIT).map(chip));
    if (sources.length > LIMIT) {
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'rounded-full px-3 py-1 text-white/45 hover:text-white';
      more.textContent = tr('+{n} more', { n: sources.length - LIMIT });
      more.onclick = () => more.replaceWith(...sources.slice(LIMIT).map(chip));
      el.append(more);
    }
    el.hidden = false;
  };

  const addUser = (text: string) => {
    const li = userTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    li.querySelector('[data-text]')!.textContent = text;
    list.append(li);
  };
  const addAssistant = (turn?: Turn) => {
    const li = botTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const text = li.querySelector<HTMLElement>('[data-text]')!;
    const sources = li.querySelector<HTMLElement>('[data-sources]')!;
    if (turn) { text.innerHTML = render(turn.content); showSources(sources, turn.sources ?? []); setupRating(li, turn); }
    list.append(li);
    return { li, text, sources };
  };

  const refresh = () => { empty.hidden = turns.length > 0; newChat.hidden = turns.length === 0; };
  const busy = (on: boolean) => { send.hidden = on; stop.hidden = !on; input.disabled = on; };
  const scrollDown = () => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });

  const renderAll = () => { list.replaceChildren(); for (const t of turns) t.role === 'user' ? addUser(t.content) : addAssistant(t); refresh(); };
  renderAll();

  // Pick the conversation up from the server when this tab has none yet, or its last question has no answer here.
  let polling = false;
  async function resume() {
    const waiting = turns.at(-1)?.role === 'user' ? turns.at(-1)!.content : null;
    if (hasSession && !waiting) return;
    const data = await fetch(`/api/ask-history?company=${encodeURIComponent(COMPANY)}${hasSession ? `&conversation=${conversationId}` : ''}`).then((r) => r.json()).catch(() => null);
    if (!data?.conversationId) {
      if (waiting) { turns.pop(); renderAll(); input.value = waiting; }
      return;
    }
    conversationId = data.conversationId;
    turns = (data.turns as Turn[]).map((t) => (t.role === 'assistant' && t.content === 'Stopped.' ? { ...t, content: tr('Stopped.') } : t));
    if (data.pending) {
      turns.push({ role: 'user', content: data.pending.question });
      renderAll();
      const view = addAssistant();
      view.text.innerHTML = render(data.pending.answer || '');
      view.text.lastElementChild?.classList.add('cursor');
      busy(true); polling = true;
      while (polling) {
        await new Promise((r) => setTimeout(r, 1500));
        const next = await fetch(`/api/ask-history?company=${encodeURIComponent(COMPANY)}&conversation=${conversationId}`).then((r) => r.json()).catch(() => null);
        if (!next) continue;
        if (next.pending) { view.text.innerHTML = render(next.pending.answer || ''); view.text.lastElementChild?.classList.add('cursor'); continue; }
        turns = next.turns; polling = false;
      }
      busy(false);
    } else if (waiting && turns.at(-2)?.content !== waiting) {
      // The answer never arrived (for example the server restarted): offer the question again.
      input.value = waiting;
      const note = document.createElement('p'); note.className = 'text-sm text-white/50'; note.setAttribute('data-unfinished', ''); note.textContent = tr('That answer didn’t finish. Your question is back in the box: send it again.');
      queueMicrotask(() => list.after(note));
    }
    renderAll(); save(); scrollDown();
  }
  resume();

  async function ask(question: string) {
    turns.push({ role: 'user', content: question });
    save();
    addUser(question);
    refresh();
    const view = addAssistant();
    scrollDown();
    busy(true);
    controller = new AbortController();

    let answer = '';
    let sources: Source[] = [];
    let exchange: string | undefined;
    let frame = 0;
    const paint = () => { frame = 0; view.text.innerHTML = render(answer); view.text.lastElementChild?.classList.add('cursor'); };
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ company: COMPANY, conversationId, turns: turns.map(({ role, content }) => ({ role, content })) }),
        signal: controller.signal,
      });
      if (!res.ok || !res.body) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error ?? tr('{name} is unavailable right now.', { name: NAME }));
      }
      const reader = res.body.pipeThrough(new TextDecoderStream()).getReader();
      let buffer = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += value;
        let cut;
        while ((cut = buffer.indexOf('\n\n')) >= 0) {
          const msg = JSON.parse(buffer.slice(0, cut).replace(/^data: /, ''));
          buffer = buffer.slice(cut + 2);
          if (msg.text) { answer += msg.text; frame ||= requestAnimationFrame(paint); }
          if (msg.sources) sources = msg.sources;
          if (msg.exchange) exchange = msg.exchange;
          if (msg.error) throw new Error(msg.error);
        }
      }
    } catch (error) {
      if ((error as Error).name !== 'AbortError') answer += `${answer ? '\n\n' : ''}*${(error as Error).message}*`;
    } finally {
      cancelAnimationFrame(frame);
      view.text.innerHTML = render(answer || `*${tr('Stopped.')}*`);
      showSources(view.sources, sources);
      const turn: Turn = { role: 'assistant', content: answer || tr('Stopped.'), sources, exchange };
      turns.push(turn);
      setupRating(view.li, turn);
      save();
      busy(false);
      controller = null;
      input.focus();
    }
  }

  // Your conversations: list, open (and carry on), delete.
  const panel = document.querySelector<HTMLElement>('[data-history-panel]')!;
  const listEl = panel.querySelector<HTMLUListElement>('[data-history-list]')!;
  const openBtn = root.querySelector<HTMLButtonElement>('[data-history-open]')!;
  const when = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
  const closePanel = () => { panel.hidden = true; openBtn.setAttribute('aria-expanded', 'false'); openBtn.focus(); };
  async function loadList() {
    const data = await fetch(`/api/ask-history?company=${encodeURIComponent(COMPANY)}&list=1`).then((r) => r.json()).catch(() => null);
    const items = (data?.conversations ?? []) as { id: string; title: string; updatedAt: string; questions: number }[];
    listEl.replaceChildren(...(items.length ? items.map((c) => {
      const li = document.createElement('li');
      li.className = 'flex items-start gap-2 px-5 py-3' + (c.id === conversationId ? ' bg-white/5' : '');
      const open = document.createElement('button');
      open.type = 'button'; open.className = 'min-w-0 flex-1 text-left';
      open.innerHTML = `<span class="block truncate text-sm text-white/85">${escape(c.title)}</span><span class="text-xs text-white/40">${escape(when.format(new Date(c.updatedAt)))} · ${c.questions}</span>`;
      open.addEventListener('click', async () => {
        if (controller || polling) return;
        const d = await fetch(`/api/ask-history?company=${encodeURIComponent(COMPANY)}&conversation=${c.id}`).then((r) => r.json()).catch(() => null);
        if (!d?.conversationId) return;
        conversationId = d.conversationId;
        turns = (d.turns as Turn[]).map((t) => (t.role === 'assistant' && t.content === 'Stopped.' ? { ...t, content: tr('Stopped.') } : t));
        save(); renderAll(); closePanel(); scrollDown(); input.focus();
        if (d.pending) { hasSession = true; turns.push({ role: 'user', content: d.pending.question }); save(); resume(); }
      });
      const del = document.createElement('button');
      del.type = 'button'; del.className = 'shrink-0 px-1 text-xs text-white/35 hover:text-lk-red'; del.textContent = tr('Delete'); del.setAttribute('aria-label', `${tr('Delete')}: ${c.title}`);
      del.addEventListener('click', async () => {
        if (!confirm(tr('Delete this conversation?'))) return;
        await fetch(`/api/ask-history?company=${encodeURIComponent(COMPANY)}&conversation=${c.id}`, { method: 'DELETE' });
        if (c.id === conversationId) newChat.click();
        loadList();
      });
      li.append(open, del);
      return li;
    }) : [Object.assign(document.createElement('li'), { className: 'px-5 py-6 text-sm text-white/45', textContent: tr('No conversations yet.') })]));
  }
  openBtn.addEventListener('click', () => { panel.hidden = false; openBtn.setAttribute('aria-expanded', 'true'); loadList(); });
  panel.querySelectorAll('[data-history-close]').forEach((x) => x.addEventListener('click', closePanel));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) closePanel(); });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q || controller || polling) return;
    input.value = '';
    input.style.height = '';
    ask(q);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); form.requestSubmit(); }
  });
  input.addEventListener('input', () => { input.style.height = 'auto'; input.style.height = `${input.scrollHeight}px`; });
  // Stop: the server stops writing (leaving the page doesn't), then this page stops listening.
  stop.addEventListener('click', () => {
    fetch('/api/ask-stop', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conversationId }) }).catch(() => {});
    polling = false;
    controller?.abort();
  });
  newChat.addEventListener('click', () => { turns = []; conversationId = crypto.randomUUID(); save(); list.replaceChildren(); refresh(); input.focus(); });
  root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) => b.addEventListener('click', () => { input.value = b.textContent ?? ''; form.requestSubmit(); }));
  input.focus();
  }
</script>
