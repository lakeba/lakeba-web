---
import Portal from '../../layouts/Portal.astro';
import { notifyAdmins } from '../../lib/notify';
import Alert from '../../components/Alert.astro';
import { field } from '../../lib/forms';
import { loadPositions } from '../../lib/holdings';

const { supabase, t, fmt } = Astro.locals;
const userId = Astro.locals.user!.id;
const id = Astro.params.id!;
let notice: { tone: 'success' | 'error'; text: string } | null = null;

const { data: meeting } = await supabase
  .from('meetings')
  .select('id, entity_id, title, kind, starts_at, location, livestream_url, proxy_deadline, status, notice_document_id, minutes_document_id')
  .eq('id', id)
  .maybeSingle();
if (!meeting) return new Response('Not found', { status: 404 });

const { data: resolutions } = await supabase.from('resolutions').select('id, number, title, description, kind, outcome').eq('meeting_id', id).order('number');
// Only owners can vote; read-only (viewer) access cannot lodge proxies.
// …and only for holders with voting shares in this meeting's company.
const [{ data: ownedLinks }, positions] = await Promise.all([
  supabase.from('holder_members').select('holder_id, holders(name)').eq('user_id', userId).eq('access', 'owner'),
  loadPositions(supabase, userId),
]);
const votesHere = (holderId: string) => positions.some((p) => p.holder.id === holderId && p.row.shares > 0 && p.row.share_classes?.entity_id === meeting.entity_id && p.row.share_classes.voting);
const owned = (ownedLinks ?? []).filter((o) => votesHere(o.holder_id));
const votingOpen = ['upcoming', 'open'].includes(meeting.status) && new Date(meeting.proxy_deadline) > new Date();

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (field(form, 'intent') === 'proxy' && votingOpen) {
    const rows = (owned ?? []).flatMap((o) =>
      (resolutions ?? []).map((r) => ({ resolution_id: r.id, holder_id: o.holder_id, vote: field(form, `vote-${o.holder_id}-${r.id}`), lodged_by: userId })),
    ).filter((r) => ['for', 'against', 'abstain'].includes(r.vote));
    const { error } = rows.length ? await supabase.from('proxy_votes').upsert(rows, { onConflict: 'resolution_id,holder_id' }) : { error: null };
    if (!error && rows.length) await supabase.rpc('log_event', { event_action: 'proxy_lodged', event_detail: { meeting_id: id, votes: rows.length } });
    notice = error ? { tone: 'error', text: t('Your proxy could not be lodged. The deadline may have passed.') } : { tone: 'success', text: t.n(rows.length, 'Proxy lodged for {n} vote. You can change it until the deadline.', 'Proxy lodged for {n} votes. You can change it until the deadline.') };
  }
  if (field(form, 'intent') === 'question') {
    const body = field(form, 'body');
    const { error } = await supabase.from('meeting_questions').insert({ meeting_id: id, user_id: userId, body });
    if (!error) {
      const { data: mt } = await supabase.from('meetings').select('title, entity_id').eq('id', id).maybeSingle();
      await notifyAdmins({ kind: 'admin_agm_question', entityId: mt?.entity_id, origin: Astro.url.origin, link: `/admin/agm/${id}`, title: `New question for ${mt?.title ?? 'a meeting'}`, body: `${Astro.locals.profile?.email ?? 'An investor'} sent a question for ${mt?.title ?? 'the meeting'}.` });
    }
    notice = error ? { tone: 'error', text: t('Your question could not be sent.') } : { tone: 'success', text: t('Thanks — your question has been sent to the board for the meeting.') };
  }
}

const [{ data: votes }, { data: questions }] = await Promise.all([
  supabase.from('proxy_votes').select('resolution_id, holder_id, vote').in('resolution_id', (resolutions ?? []).map((r) => r.id)).in('holder_id', (owned ?? []).map((o) => o.holder_id)),
  supabase.from('meeting_questions').select('body, answer, created_at').eq('meeting_id', id).eq('user_id', userId).order('created_at'),
]);
const voteOf = (holderId: string, resolutionId: string) => votes?.find((v) => v.holder_id === holderId && v.resolution_id === resolutionId)?.vote;
const outcomeLabel: Record<string, string> = { carried: 'Carried', not_carried: 'Not carried', withdrawn: 'Withdrawn' };
const choices = [['for', 'For'], ['against', 'Against'], ['abstain', 'Abstain']] as const;
---

<Portal title={meeting.title}>
  <a href="/agm" class="text-sm text-white/50 hover:text-white">← {t('Meetings')}</a>
  <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_22rem]">
    <div>
      <p class="eyebrow">{meeting.kind === 'agm' ? t('Annual General Meeting') : t('General meeting')}</p>
      <h1 class="mt-4 text-4xl font-extrabold">{meeting.title}</h1>
      <p class="mt-3 text-white/60">{fmt.dateTime.format(new Date(meeting.starts_at))}{meeting.location && ` · ${meeting.location}`}</p>
      {notice && <div class="mt-6"><Alert tone={notice.tone}>{notice.text}</Alert></div>}

      <section class="mt-10">
        <h2 class="text-xl font-bold">{t('Resolutions')}</h2>
        {votingOpen && owned?.length ? (
          <form method="post" class="mt-5 space-y-4">
            <input type="hidden" name="intent" value="proxy" />
            {(resolutions ?? []).map((r) => (
              <fieldset class="card p-5">
                <legend class="sr-only">{t('Resolution {n}', { n: r.number })}</legend>
                <p class="text-xs uppercase tracking-widest text-white/40">{t('Resolution {n}', { n: r.number })} · {r.kind === 'special' ? t('Special') : t('Ordinary')}</p>
                <p class="mt-1 font-semibold text-white">{r.title}</p>
                {r.description && <p class="mt-1 text-sm text-white/55">{r.description}</p>}
                {(owned ?? []).map((o) => (
                  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-white/5 pt-4">
                    <p class="text-sm text-white/70">{(o.holders as unknown as { name: string }).name}</p>
                    <div class="flex gap-2" role="radiogroup">
                      {choices.map(([value, label]) => (
                        <label class="cursor-pointer">
                          <input type="radio" name={`vote-${o.holder_id}-${r.id}`} value={value} checked={voteOf(o.holder_id, r.id) === value} class="peer sr-only" />
                          <span class="block rounded-lg border border-white/10 px-3 py-1.5 text-sm text-white/60 peer-checked:border-lk-blue peer-checked:bg-lk-blue/20 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-lk-blue">{t(label)}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                ))}
              </fieldset>
            ))}
            <div class="flex flex-wrap items-center justify-between gap-4">
              <p class="text-sm text-white/50">{t('Your proxy directs the chair to vote as shown. Deadline: {date}.', { date: fmt.dateTime.format(new Date(meeting.proxy_deadline)) })}</p>
              <button class="btn-primary">{t('Lodge proxy')}</button>
            </div>
          </form>
        ) : (
          <ol class="mt-5 space-y-3">
            {(resolutions ?? []).map((r) => (
              <li class="card flex flex-wrap items-start justify-between gap-4 p-5">
                <div>
                  <p class="text-xs uppercase tracking-widest text-white/40">{t('Resolution {n}', { n: r.number })}</p>
                  <p class="mt-1 font-semibold text-white">{r.title}</p>
                  {r.description && <p class="mt-1 text-sm text-white/55">{r.description}</p>}
                </div>
                {r.outcome && <span class:list={['rounded-full px-3 py-1 text-xs font-semibold', r.outcome === 'carried' ? 'bg-lk-green/15 text-lk-green' : 'bg-white/10 text-white/60']}>{t(outcomeLabel[r.outcome] ?? r.outcome)}</span>}
              </li>
            ))}
          </ol>
        )}
        {!votingOpen && meeting.status !== 'results' && <p class="mt-4 text-sm text-white/50">{t('Proxy voting is closed.')}</p>}
      </section>
    </div>

    <aside class="space-y-4">
      <section class="card">
        <h2 class="text-lg font-bold">{t('Papers')}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {meeting.notice_document_id && <li><a href={`/documents/${meeting.notice_document_id}`} class="text-lk-blue hover:underline">{t('Notice of meeting')} ↗</a></li>}
          {meeting.minutes_document_id && <li><a href={`/documents/${meeting.minutes_document_id}`} class="text-lk-blue hover:underline">{t('Minutes')} ↗</a></li>}
          {meeting.livestream_url && <li><a href={meeting.livestream_url} target="_blank" rel="noopener" class="text-lk-blue hover:underline">{t('Join the livestream')} ↗</a></li>}
          {!meeting.notice_document_id && !meeting.minutes_document_id && !meeting.livestream_url && <li class="text-white/45">{t('Papers will be published here.')}</li>}
        </ul>
      </section>
      <section class="card">
        <h2 class="text-lg font-bold">{t('Ask before the meeting')}</h2>
        <form method="post" class="mt-4 space-y-3">
          <input type="hidden" name="intent" value="question" />
          <textarea name="body" rows="4" maxlength="2000" required aria-label={t('Your question')} class="field" placeholder={t('Your question for the board')}></textarea>
          <button class="btn-ghost w-full">{t('Send question')}</button>
        </form>
        {(questions ?? []).length > 0 && (
          <ul class="mt-5 space-y-3 border-t border-white/5 pt-4 text-sm">
            {(questions ?? []).map((q) => (
              <li><p class="text-white/80">{q.body}</p><p class="mt-1 text-white/50">{q.answer ? t('Answer: {answer}', { answer: q.answer }) : t('Awaiting answer')}</p></li>
            ))}
          </ul>
        )}
      </section>
      <p class="px-2 text-xs text-white/35">{t('Meeting date: {date}', { date: fmt.longDate.format(new Date(meeting.starts_at)) })}</p>
    </aside>
  </div>
</Portal>
