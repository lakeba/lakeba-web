---
import Portal from '../../layouts/Portal.astro';
import { notifyAdmins } from '../../lib/notify';
import Alert from '../../components/Alert.astro';
import { field } from '../../lib/forms';
import { brandName } from '../../lib/companies';

const { supabase, t, fmt } = Astro.locals;
const userId = Astro.locals.user!.id;
const id = Astro.params.id!;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const body = field(form, 'body');
  const { error: insertError } = body
    ? await supabase.from('query_messages').insert({ query_id: id, author_id: userId, body })
    : { error: new Error('empty') };
  if (!insertError) {
    const { data: q } = await supabase.from('queries').select('subject, entity_id').eq('id', id).maybeSingle();
    if (q) await notifyAdmins({ kind: 'admin_query', entityId: q.entity_id, origin: Astro.url.origin, link: `/admin/queries/${id}`, title: `New reply on a board question: ${q.subject}`, body: `${Astro.locals.profile?.email ?? 'An investor'} replied on “${q.subject}”.` });
    return Astro.redirect(`/board/${id}`);
  }
  error = t('Your reply could not be sent.');
}

// Only the user's own question, without internal notes (admins could read them via RLS).
const [{ data: query }, { data: messages }] = await Promise.all([
  supabase.from('queries').select('subject, status, due_at, created_at, entity_id').eq('id', id).eq('user_id', userId).maybeSingle(),
  supabase.from('query_messages').select('id, body, created_at, author_id, profiles(first_name, last_name, role)').eq('query_id', id).eq('internal', false).order('created_at'),
]);
if (!query) return new Response('Not found', { status: 404 });
// Replies are signed with the company the question went to.
const answeredBy = brandName(Astro.locals.companies.find((c) => c.id === query.entity_id) ?? null);
const sent = Astro.url.searchParams.get('sent') === '1';
---

<Portal title={query.subject}>
  <div class="mx-auto max-w-3xl">
    <a href="/board" class="text-sm text-white/50 hover:text-white">← {t('Board Q&A')}</a>
    <h1 class="mt-6 text-3xl font-extrabold">{query.subject}</h1>
    <p class="mt-2 text-sm text-white/45">
      {t('Asked {date}', { date: fmt.shortDate.format(new Date(query.created_at)) })} ·
      {query.status === 'open' ? t('Reply due by {date}', { date: fmt.shortDate.format(new Date(query.due_at)) }) : query.status === 'answered' ? t('Answered') : t('Closed')}
    </p>
    {sent && <div class="mt-6"><Alert tone="success">{t('Your question has been sent. The board aims to reply by {date}.', { date: fmt.shortDate.format(new Date(query.due_at)) })}</Alert></div>}

    <ol class="mt-8 space-y-4">
      {(messages ?? []).map((m) => {
        const mine = m.author_id === userId;
        const author = m.profiles as unknown as { first_name: string; last_name: string; role: string } | null;
        return (
          <li class:list={['flex', mine ? 'justify-end' : 'justify-start']}>
            <div class:list={['max-w-[85%] rounded-3xl p-5', mine ? 'bg-lk-blue/20 rounded-br-md' : 'glass rounded-bl-md']}>
              <p class="text-xs text-white/45">{mine ? t('You') : `${author?.first_name ?? ''} ${author?.last_name ?? ''}`.trim() || answeredBy}{!mine && ` · ${answeredBy}`} · {fmt.dateTime.format(new Date(m.created_at))}</p>
              <p class="mt-2 whitespace-pre-line text-white/85">{m.body}</p>
            </div>
          </li>
        );
      })}
    </ol>

    {query.status !== 'closed' && Astro.locals.features.boardQa && (
      <form method="post" class="card mt-8 space-y-4">
        {error && <Alert tone="error">{error}</Alert>}
        <label for="body" class="label">{t('Add a reply')}</label>
        <textarea id="body" name="body" rows="4" maxlength="10000" required class="field"></textarea>
        <button class="btn-primary">{t('Send reply')}</button>
      </form>
    )}
  </div>
</Portal>
