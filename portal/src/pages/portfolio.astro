---
import Portal from '../layouts/Portal.astro';
import PageHeader from '../components/PageHeader.astro';
import Empty from '../components/Empty.astro';
import { inCompany, isShareClass, loadPositions } from '../lib/holdings';

// The group's portfolio view is for Lakeba Group shareholders (RLS enforces it too).
const { group, user, t, fmt } = Astro.locals;
const { percent, shortDate, smallPercent } = fmt;
if (!group) return Astro.redirect('/');
const supabase = Astro.locals.supabase;
const [positions, { data: stakes }, { data: groupClasses }, { data: onIssue }] = await Promise.all([
  loadPositions(supabase, user!.id), supabase.rpc('lakeba_stakes'),
  supabase.from('share_classes').select('id').eq('entity_id', group.id).eq('counts_toward_pct', true),
  supabase.rpc('shares_on_issue'),
]);
// Look-through: your share of Lakeba (all classes that count toward %) × Lakeba's share of each company.
const counted = new Set((groupClasses ?? []).map((c) => c.id));
const groupOnIssue = ((onIssue ?? []) as { share_class_id: string; total: number }[]).filter((c) => counted.has(c.share_class_id)).reduce((a, c) => a + Number(c.total), 0);
const myGroupShares = inCompany(positions, group.id).filter(isShareClass).reduce((a, p) => a + p.row.shares, 0);
const myGroupPct = groupOnIssue ? myGroupShares / groupOnIssue : 0;
type Stake = { entity_id: string; code: string; display_name: string; register_pct: number | null; stated_pct: number | null; stated_as_at: string | null };
const stakeOf = new Map(((stakes ?? []) as Stake[]).map((s) => [s.entity_id, s]));
const lakebaPct = (entityId: string | null) => {
  const st = entityId ? stakeOf.get(entityId) : undefined;
  return st ? Number(st.register_pct ?? st.stated_pct ?? NaN) : NaN;
};

const { data: ventures } = await supabase
  .from('ventures')
  .select('slug, name, tagline, stage, lakeba_stake, website, status, entity_id, entities(website, logo_url), venture_updates(title, body, happened_on)')
  .order('sort');
// The venture's website, else the company's (from the investor data workbook).
const siteOf = (v: { website: string | null; entities: unknown }) => v.website || (v.entities as { website: string | null } | null)?.website || null;
const logoOf = (v: { entities: unknown }) => (v.entities as { logo_url: string | null } | null)?.logo_url || null;
const domain = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const groups = [
  { status: 'active', title: 'Active ventures' },
  { status: 'building', title: 'Building with LakebaOS', note: 'Ventures co-founded through LakebaOS, where Lakeba holds up to 49%.' },
  { status: 'exited', title: 'Exits' },
];
// The look-through sentence has two highlighted parts, split around {pct} and {term}.
const [lookBefore, lookRest = ''] = t('You hold {pct} of Lakeba Group. Each row shows your indicative {term} interest: your share of Lakeba × Lakeba’s share of that company. It is indirect ownership through Lakeba, not shares you hold yourself.').split('{pct}');
const [lookMiddle, lookAfter = ''] = lookRest.split('{term}');
const updatesOf = (v: { venture_updates: unknown }) => [...(v.venture_updates as { title: string; body: string; happened_on: string }[])].sort((a, b) => b.happened_on.localeCompare(a.happened_on));
---

<Portal title={t('Portfolio')}>
  <PageHeader eyebrow={t('Portfolio')} title={t('What your shares own')} subtitle={t('Lakeba’s ventures, its stake in each, and their latest milestones.')} />
  {myGroupPct > 0 && (
    <p class="mb-8 max-w-3xl rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-sm text-white/65">
      {lookBefore}<span class="font-semibold text-white">{percent.format(myGroupPct)}</span>{lookMiddle}<span class="font-semibold text-white">{t('look-through')}</span>{lookAfter}
    </p>
  )}
  {ventures?.length ? groups.map((g) => {
    const items = ventures.filter((v) => v.status === g.status);
    const anyUpdates = items.some((v) => updatesOf(v).length > 0);
    // Lakeba stake: the stated figure, else Lakeba's share of the register.
    const stakeText = (v: (typeof items)[number]) => v.lakeba_stake != null ? `${Number(v.lakeba_stake)}%` : Number.isFinite(lakebaPct(v.entity_id)) ? `${Math.round(lakebaPct(v.entity_id) * 1000) / 10}%` : null;
    return items.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold">{t(g.title)}</h2>
        {g.note && <p class="mt-1 text-sm text-white/50">{t(g.note)}</p>}
        <div class="card mt-5 overflow-x-auto !p-0">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40">
              <tr>
                <th class="py-3 pl-5 font-medium"><span class="sr-only">{t('Logo')}</span></th>
                <th class="px-5 py-3 font-medium">{t('Company')}</th>
                <th class="px-5 py-3 font-medium">{t('Type')}</th>
                <th class="px-5 py-3 text-right font-medium">{t('Lakeba stake')}</th>
                {myGroupPct > 0 && <th class="px-5 py-3 text-right font-medium">{t('Your look-through')}</th>}
                {anyUpdates && <th class="px-5 py-3 font-medium">{t('Latest update')}</th>}              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {items.map((v) => {
                const latest = updatesOf(v)[0];
                const site = siteOf(v);
                const logo = logoOf(v);
                return (
                  <tr class="align-top">
                    <td class="py-3 pl-5">
                      {/* Always-white tile (the theme swaps the white token) so dark logos stay visible; links to the website. */}
                      {site ? (
                        <a href={site} target="_blank" rel="noopener" title={t('{domain} (opens in a new tab)', { domain: domain(site) })} aria-label={t('{name} website, {domain}', { name: v.name, domain: domain(site) })} class="flex h-12 w-28 items-center justify-center rounded-lg bg-[#fff] px-2 py-1.5 ring-1 ring-[#0f172a]/10 transition hover:ring-2 hover:ring-lk-blue focus-visible:ring-2 focus-visible:ring-lk-blue">
                          {logo ? <img src={logo} alt="" class="max-h-full max-w-full object-contain" loading="lazy" /> : <span class="font-display text-lg font-bold text-[#94a3b8]">{v.name.slice(0, 1)}</span>}
                        </a>
                      ) : (
                        <div class="flex h-12 w-28 items-center justify-center rounded-lg bg-[#fff] px-2 py-1.5 ring-1 ring-[#0f172a]/10">
                          {logo ? <img src={logo} alt={t('{name} logo', { name: v.name })} class="max-h-full max-w-full object-contain" loading="lazy" /> : <span class="font-display text-lg font-bold text-[#94a3b8]" aria-hidden="true">{v.name.slice(0, 1)}</span>}
                        </div>
                      )}
                    </td>
                    <td class="px-5 py-4"><p class="font-semibold text-white">{v.name}</p>{v.tagline && <p class="mt-0.5 text-xs text-white/50">{v.tagline}</p>}</td>
                    <td class="whitespace-nowrap px-5 py-4 text-white/60">{v.stage}</td>
                    <td class="px-5 py-4 text-right font-semibold text-white">{stakeText(v) ?? <span class="font-normal text-white/30">—</span>}</td>
                    {myGroupPct > 0 && <td class="px-5 py-4 text-right">{Number.isFinite(lakebaPct(v.entity_id)) ? smallPercent.format(myGroupPct * lakebaPct(v.entity_id)) : <span class="text-white/30">—</span>}</td>}
                    {anyUpdates && <td class="px-5 py-4">{latest ? <><p class="text-white/85">{latest.title}</p><p class="text-xs text-white/40">{shortDate.format(new Date(latest.happened_on))}</p></> : <span class="text-white/30">—</span>}</td>}                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    );
  }) : <Empty title={t('No ventures listed yet')}>{t('The portfolio will appear here once it is published.')}</Empty>}
</Portal>
