---
import Portal from '../layouts/Portal.astro';
import PageHeader from '../components/PageHeader.astro';
import Empty from '../components/Empty.astro';
import { percent, shortDate, smallPercent } from '../lib/format';
import { inCompany, isShareClass, loadPositions } from '../lib/holdings';

// The group's portfolio view is for Lakeba Group shareholders (RLS enforces it too).
const { group, user } = Astro.locals;
if (!group) return Astro.redirect('/');
const supabase = Astro.locals.supabase;
const [positions, { data: stakes }, { data: groupClasses }, { data: onIssue }] = await Promise.all([
  loadPositions(supabase, user!.id), supabase.rpc('lakeba_stakes'),
  supabase.from('share_classes').select('id').eq('entity_id', group.id).eq('counts_toward_pct', true),
  supabase.rpc('shares_on_issue'),
]);
// Look-through: your share of Lakeba (all classes that count toward %) × Lakeba's share of each company.
const counted = new Set((groupClasses ?? []).map((c) => c.id));
const groupOnIssue = ((onIssue ?? []) as { share_class_id: string; total: number }[]).filter((c) => counted.has(c.share_class_id)).reduce((a, c) => a + Number(c.total), 0);
const myGroupShares = inCompany(positions, group.id).filter(isShareClass).reduce((a, p) => a + p.row.shares, 0);
const myGroupPct = groupOnIssue ? myGroupShares / groupOnIssue : 0;
type Stake = { entity_id: string; code: string; display_name: string; register_pct: number | null; stated_pct: number | null; stated_as_at: string | null };
const stakeOf = new Map(((stakes ?? []) as Stake[]).map((s) => [s.entity_id, s]));
const lakebaPct = (entityId: string | null) => {
  const st = entityId ? stakeOf.get(entityId) : undefined;
  return st ? Number(st.register_pct ?? st.stated_pct ?? NaN) : NaN;
};

const { data: ventures } = await supabase
  .from('ventures')
  .select('slug, name, tagline, stage, lakeba_stake, website, status, entity_id, entities(website), venture_updates(title, body, happened_on)')
  .order('sort');
// The card's website, else the company's (from the investor data workbook).
const siteOf = (v: { website: string | null; entities: unknown }) => v.website || (v.entities as { website: string | null } | null)?.website || null;
const domain = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const groups = [
  { status: 'active', title: 'Active ventures' },
  { status: 'building', title: 'Building with LakebaOS', note: 'Ventures co-founded through LakebaOS, where Lakeba holds up to 49%.' },
  { status: 'exited', title: 'Exits' },
];
const accents = ['from-lk-blue/25', 'from-lk-orange/25', 'from-lk-green/25', 'from-lk-red/25'];
---

<Portal title="Portfolio">
  <PageHeader eyebrow="Portfolio" title="What your shares own" subtitle="Lakeba’s ventures, its stake in each, and their latest milestones." />
  {myGroupPct > 0 && (
    <p class="mb-8 max-w-3xl rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-sm text-white/65">
      You hold <span class="font-semibold text-white">{percent.format(myGroupPct)}</span> of Lakeba Group. Each card shows your indicative <span class="font-semibold text-white">look-through</span> interest: your share of Lakeba × Lakeba’s share of that company. It is indirect ownership through Lakeba, not shares you hold yourself.
    </p>
  )}
  {ventures?.length ? groups.map((g) => {
    const items = ventures.filter((v) => v.status === g.status);
    return items.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold">{g.title}</h2>
        {g.note && <p class="mt-1 text-sm text-white/50">{g.note}</p>}
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {items.map((v, i) => {
            const updates = [...(v.venture_updates as { title: string; body: string; happened_on: string }[])].sort((a, b) => b.happened_on.localeCompare(a.happened_on));
            return (
              <article class="card relative overflow-hidden">
                <div class:list={['pointer-events-none absolute inset-0 bg-gradient-to-br to-transparent opacity-50', accents[i % accents.length]]}></div>
                <div class="relative">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="text-2xl font-bold">{v.name}</h3>
                      <p class="mt-1 text-sm text-white/60">{v.tagline}</p>
                      {siteOf(v) && <a href={siteOf(v)} target="_blank" rel="noopener" class="mt-2 inline-block text-sm font-medium text-lk-blue hover:underline">{domain(siteOf(v)!)} ↗</a>}
                    </div>
                    {v.lakeba_stake != null && (
                      <div class="text-right"><p class="font-display text-3xl font-bold text-white">{Number(v.lakeba_stake)}%</p><p class="text-[11px] uppercase tracking-widest text-white/40">Lakeba stake</p></div>
                    )}
                  </div>
                  <p class="mt-4 inline-block rounded-full border border-white/10 px-3 py-1 text-xs text-white/60">{v.stage}</p>
                  {myGroupPct > 0 && Number.isFinite(lakebaPct(v.entity_id)) && (
                    <p class="mt-3 text-sm text-white/60">Your look-through interest: <span class="font-semibold text-white">{smallPercent.format(myGroupPct * lakebaPct(v.entity_id))}</span></p>
                  )}
                  {updates.length > 0 && (
                    <ol class="mt-6 space-y-3 border-l border-white/10 pl-4">
                      {updates.slice(0, 3).map((u) => (
                        <li><p class="text-xs text-white/40">{shortDate.format(new Date(u.happened_on))}</p><p class="text-sm font-semibold text-white">{u.title}</p>{u.body && <p class="text-sm text-white/55">{u.body}</p>}</li>
                      ))}
                    </ol>
                  )}                </div>
              </article>
            );
          })}
        </div>
      </section>
    );
  }) : <Empty title="No ventures listed yet">The portfolio will appear here once it is published.</Empty>}
</Portal>
