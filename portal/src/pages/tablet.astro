---
import '../styles/portal.css';

// The boardroom tablet's home (lib/tablets.ts), in the Lex app or any browser: it shows a six-digit code,
// the company secretary enters it on the meeting's page, and the tablet opens that meeting's Observer.
// Nobody signs in on the tablet. ?finished=1: the meeting just ended, so it says so before a new code.
const finished = Astro.url.searchParams.get('finished') === '1';
const portal = Astro.url.host;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#050b16" />
    <title>Lex · Boardroom tablet</title>
  </head>
  <body class="min-h-dvh bg-ink">
    <main class="mx-auto flex min-h-dvh max-w-6xl flex-col px-6 py-8 sm:px-12 sm:py-10" id="tablet" data-finished={finished ? '1' : ''}>
      <header class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="size-9 rounded-full bg-[radial-gradient(circle_at_35%_35%,#9fc2ff,#276ae7_60%,#0b3a8f)]" aria-hidden="true"></span>
          <span class="font-display text-xl font-bold text-white">Lex</span>
          <span class="text-sm text-white/55">Lakeba boardroom tablet</span>
        </div>
        <span class="flex items-center gap-2 text-sm text-white/55"><span class="size-2 rounded-full bg-lk-green" id="online"></span><span id="online-text">Online</span></span>
      </header>

      <section class="hidden flex-1 flex-col items-center justify-center gap-6 text-center" id="done">
        <span class="flex size-20 items-center justify-center rounded-full bg-lk-green/15"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#35a954" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span>
        <h1 class="font-display text-4xl font-bold text-white">Meeting finished</h1>
        <p class="max-w-xl text-lg text-white/70">The full transcript, with speakers, is being prepared in the portal for the minutes. This tablet has let go of the meeting; nothing from it stays here.</p>
        <button type="button" class="btn-ghost px-6 py-3 text-base" id="again">Connect to another meeting</button>
      </section>

      <section class="flex flex-1 flex-col items-center justify-center gap-10 lg:flex-row lg:gap-20" id="pair">
        <div class="flex max-w-xl flex-1 flex-col gap-6">
          <h1 class="font-display text-4xl font-bold leading-tight text-white sm:text-5xl">Connect this tablet to a meeting</h1>
          <p class="text-lg leading-relaxed text-white/75">In the portal, open the meeting and choose <strong class="text-white">Connect a tablet</strong>. Enter the code shown here.</p>
          <ol class="list-decimal space-y-1 pl-6 text-base text-white/55">
            <li>Admin › Boardroom › the meeting</li>
            <li>Connect a tablet</li>
            <li>Enter the code. The meeting opens here.</li>
          </ol>
          <p class="text-sm text-white/45">Nobody signs in on this tablet. It reaches only the meeting it is connected to, until the meeting ends.</p>
        </div>
        <div class="flex w-full max-w-md flex-col items-center gap-6 rounded-3xl border border-white/10 bg-navy px-8 py-10">
          <span class="text-sm font-semibold uppercase tracking-[0.16em] text-white/55">Pairing code</span>
          <p class="font-display text-6xl font-bold tracking-[0.12em] text-white tabular-nums" id="code" aria-live="polite">— — —</p>
          <p class="text-base text-white/70" id="countdown">Getting a code…</p>
          <button type="button" class="btn-ghost px-5 py-2.5 text-sm" id="renew">New code</button>
          <p class="text-sm text-lk-orange" id="problem" role="alert"></p>
        </div>
      </section>

      <footer class="flex flex-wrap justify-between gap-2 text-xs text-white/40">
        <span id="released"></span>
        <span>{portal}</span>
      </footer>
    </main>

    <script>
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
      const root = $('tablet')!;
      let expiresAt = 0, asking = false;
      // The app tells the page the tablet's name (?device=…); a browser is just "Boardroom tablet".
      const device = new URLSearchParams(location.search).get('device') ?? '';

      const showCode = (code: string) => { $('code')!.textContent = `${code.slice(0, 3)} ${code.slice(3)}`; };
      const newCode = async () => {
        if (asking) return;
        asking = true; $('problem')!.textContent = '';
        try {
          const r = await fetch('/api/tablet/pair', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'code', device_name: device }) });
          const j = await r.json();
          if (!r.ok) throw new Error(j.error ?? 'Couldn’t get a code.');
          showCode(j.code); expiresAt = Date.parse(j.expiresAt);
        } catch (e) { $('problem')!.textContent = (e as Error).message; $('code')!.textContent = '— — —'; expiresAt = 0; }
        asking = false;
      };
      const tick = () => {
        const left = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
        $('countdown')!.textContent = expiresAt ? (left ? `New code in ${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}` : 'Getting a new code…') : $('countdown')!.textContent;
        if (expiresAt && !left) void newCode();
      };
      // Every two seconds: has the secretary connected it yet?
      const check = async () => {
        if (!$('done')!.classList.contains('hidden')) return;
        try {
          const s = await fetch('/api/tablet/pair', { cache: 'no-store' }).then((r) => r.json());
          $('online')!.className = 'size-2 rounded-full bg-lk-green'; $('online-text')!.textContent = 'Online';
          if (s.status === 'connected') { location.href = s.url; return; }
          if (s.status === 'released' && s.why) $('released')!.textContent = s.why;
          if ((s.status === 'new' || s.status === 'expired' || s.status === 'released') && !asking) await newCode();
          else if (s.status === 'waiting' && !expiresAt) { expiresAt = Date.parse(s.expiresAt); await newCode(); }
        } catch {
          $('online')!.className = 'size-2 rounded-full bg-lk-orange'; $('online-text')!.textContent = 'No connection';
        }
      };
      $('renew')?.addEventListener('click', () => void newCode());
      $('again')?.addEventListener('click', () => { history.replaceState(null, '', '/tablet'); $('done')!.classList.add('hidden'); $('pair')!.classList.replace('hidden', 'flex'); void check(); });
      if (root.dataset.finished) { $('pair')!.classList.replace('flex', 'hidden'); $('done')!.classList.replace('hidden', 'flex'); }
      else void check();
      setInterval(tick, 1000);
      setInterval(() => void check(), 2000);
    </script>
  </body>
</html>
