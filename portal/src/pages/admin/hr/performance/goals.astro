---
import Admin from '../../../../layouts/Admin.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Alert from '../../../../components/Alert.astro';
import Empty from '../../../../components/Empty.astro';
import HrNav from '../../../../components/HrNav.astro';
import GoalRow from '../../../../components/KpiGoal.astro';
import { serviceClient } from '../../../../lib/admin';
import { field } from '../../../../lib/forms';
import { hrCompanies, todayIn } from '../../../../lib/hr';
import { GOAL_COLUMNS, PERIOD_COLUMNS, PERIOD_STATES, UNITS, readNumber, type Goal, type Period } from '../../../../lib/kpis';

// Admin → People → Performance → Goals: a company's goals for a period, with team goals under them.
// A scorecard's KPI can say which goal it serves.
const svc = serviceClient();
const access = Astro.locals.access;
const companies = await hrCompanies(svc, access);
const q = Astro.url.searchParams;
const company = companies.find((c) => c.code === q.get('company')?.toUpperCase()) ?? companies[0] ?? null;
const mayDo = company ? access.can('hr.do', company.id) : false;
const { data: periodRows } = await svc.from('kpi_periods').select(PERIOD_COLUMNS).eq('entity_id', company?.id ?? '00000000-0000-0000-0000-000000000000').order('starts_on', { ascending: false });
const periods = (periodRows ?? []) as Period[];
const today = todayIn();
const period = periods.find((p) => p.id === q.get('period')) ?? periods.find((p) => p.status === 'open' && p.starts_on <= today && p.ends_on >= today) ?? periods[0] ?? null;
let error = '', ok = '';

if (Astro.request.method === 'POST' && company && period && mayDo) {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  try {
    if (intent === 'goal-save') {
      const { data: old } = field(form, 'id') ? await svc.from('kpi_goals').select('id').eq('id', field(form, 'id')).eq('period_id', period.id).maybeSingle() : { data: null };
      if (field(form, 'id') && !old) throw new Error('That goal isn’t in this period.');
      const title = field(form, 'title').slice(0, 300);
      if (title.length < 2) throw new Error('Say what the goal is.');
      const { data: parent } = field(form, 'parent_id') ? await svc.from('kpi_goals').select('id, parent_id').eq('id', field(form, 'parent_id')).eq('period_id', period.id).maybeSingle() : { data: null };
      if (field(form, 'parent_id') && (!parent || parent.parent_id || parent.id === old?.id)) throw new Error('A team goal sits under a company goal.');
      const unit = field(form, 'unit') in UNITS ? field(form, 'unit') : null;
      const row = { title, description: field(form, 'description').slice(0, 2000), team: field(form, 'team').slice(0, 100), target: readNumber(field(form, 'target')), unit };
      if (old) await svc.from('kpi_goals').update(row).eq('id', old.id).throwOnError();
      else await svc.from('kpi_goals').insert({ ...row, entity_id: company.id, period_id: period.id, parent_id: parent?.id ?? null, created_by: Astro.locals.user!.id }).throwOnError();
      await Astro.locals.supabase.rpc('log_event', { event_action: old ? 'admin_saved_kpi_goal' : 'admin_added_kpi_goal', event_detail: { entity_id: company.id, period_id: period.id, title } });
      ok = old ? 'Saved.' : 'Goal added.';
    } else if (intent === 'goal-delete') {
      const { data: g } = await svc.from('kpi_goals').select('id, title').eq('id', field(form, 'id')).eq('period_id', period.id).maybeSingle();
      if (!g) throw new Error('That goal isn’t in this period.');
      await svc.from('kpi_goals').delete().eq('id', g.id).throwOnError();
      await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_deleted_kpi_goal', event_detail: { entity_id: company.id, period_id: period.id, title: g.title } });
      ok = 'Deleted (with its team goals). KPIs that served it no longer point at a goal.';
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

const { data: goalRows } = await svc.from('kpi_goals').select(GOAL_COLUMNS).eq('period_id', period?.id ?? '00000000-0000-0000-0000-000000000000').order('sort').order('created_at');
const goals = (goalRows ?? []) as Goal[];
const { data: links } = goals.length ? await svc.from('kpi_scorecard_items').select('goal_id').in('goal_id', goals.map((g) => g.id)) : { data: [] };
const served = (id: string) => (links ?? []).filter((l) => l.goal_id === id).length;
const top = goals.filter((g) => !g.parent_id);
const teamOf = (id: string) => goals.filter((g) => g.parent_id === id);
const href = (extra: Record<string, string>) => `?${new URLSearchParams({ ...(company ? { company: company.code } : {}), ...extra })}`;
---

<Admin title="HR · Goals">
  <HrNav />
  <PageHeader eyebrow="Performance" title="Goals" subtitle="What the company is aiming for in a period, broken into team goals. Each KPI on a scorecard can say which goal it serves.">
    <a class="btn-ghost" href={`/admin/hr/performance${href(period ? { period: period.id } : {})}`}>Scorecards</a>
  </PageHeader>
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {ok && <div class="mb-6"><Alert tone="success">{ok}</Alert></div>}
  {company && (
    <form method="get" class="mb-4 flex flex-wrap items-center gap-2 text-sm" data-tour="goals-pick">
      {companies.length > 1 && <select class="field !w-auto" name="company" aria-label="Company">{companies.map((c) => <option value={c.code} selected={c.id === company.id}>{c.display_name}</option>)}</select>}
      {periods.length > 0 && <select class="field !w-auto" name="period" aria-label="Period">{periods.map((p) => <option value={p.id} selected={p.id === period?.id}>{p.label} · {PERIOD_STATES[p.status]}</option>)}</select>}
      <button class="btn-ghost !py-1.5">Show</button>
    </form>
  )}

  {!period ? <Empty title="No periods yet">Add a period on the Performance page first.</Empty> : (
    <>
      {top.length ? (
        <div class="mb-6 grid gap-4" data-tour="goals-list">
          {top.map((g) => (
            <section class="card !p-5">
              <GoalRow goal={g} served={served(g.id)} mayDo={mayDo} />
              {teamOf(g.id).length > 0 && <ul class="mt-3 grid gap-2 border-l border-white/10 pl-4">{teamOf(g.id).map((t) => <li><GoalRow goal={t} served={served(t.id)} mayDo={mayDo} /></li>)}</ul>}
            </section>
          ))}
        </div>
      ) : <div class="mb-6"><Empty title="No goals yet">{mayDo ? `Add the company’s goals for ${period.label} below.` : 'None set for this period.'}</Empty></div>}
      {mayDo && (
        <details class="card" open={!top.length} data-tour="goals-add">
          <summary class="cursor-pointer font-display text-lg font-bold">New goal</summary>
          <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="sm:col-span-2"><label class="label" for="title">Goal</label><input class="field" id="title" name="title" placeholder="e.g. Grow recurring revenue to A$2m" required /></div>
            <div><label class="label" for="parent_id">Under</label><select class="field" id="parent_id" name="parent_id"><option value="">Nothing: a company goal</option>{top.map((g) => <option value={g.id}>{g.title}</option>)}</select></div>
            <div><label class="label" for="team">Team</label><input class="field" id="team" name="team" placeholder="For a team goal, e.g. Sales" /></div>
            <div><label class="label" for="target">Target</label><input class="field" id="target" name="target" inputmode="decimal" placeholder="Optional" /></div>
            <div><label class="label" for="unit">Unit</label><select class="field" id="unit" name="unit"><option value="">—</option>{Object.entries(UNITS).map(([k, l]) => <option value={k}>{l}</option>)}</select></div>
            <div class="sm:col-span-2"><label class="label" for="description">More about it</label><textarea class="field min-h-16" id="description" name="description"></textarea></div>
            <div class="sm:col-span-2"><button class="btn-primary" name="intent" value="goal-save">Add the goal</button></div>
          </form>
        </details>
      )}
    </>
  )}
</Admin>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-confirm]').forEach((b) => b.addEventListener('click', (e) => { if (!confirm(b.dataset.confirm!)) e.preventDefault(); }));
</script>
