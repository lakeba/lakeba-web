---
import Admin from '../../../../layouts/Admin.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Alert from '../../../../components/Alert.astro';
import Empty from '../../../../components/Empty.astro';
import HrNav from '../../../../components/HrNav.astro';
import { serviceClient } from '../../../../lib/admin';
import { field } from '../../../../lib/forms';
import { shortDate } from '../../../../lib/format';
import { FREQUENCY, GRANT_COLUMNS, GRANT_STATES, PLAN_COLUMNS, addMonths, hrCompanies, position, todayIn, type Grant, type Plan } from '../../../../lib/hr';

// Admin → HR → Equity plans: each company's plans and how much of each pool
// is used, every grant, and new plans and grants (a grant starts as a draft).
const svc = serviceClient();
const access = Astro.locals.access;
const companies = await hrCompanies(svc, access);
const doCompanies = companies.filter((c) => access.can('hr.do', c.id));
const ids = companies.map((c) => c.id);
const forPerson = Astro.url.searchParams.get('person');
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const num = (n: string) => Number(field(form, n).replace(/[^\d.]/g, ''));
  const d = (n: string) => (/^\d{4}-\d{2}-\d{2}$/.test(field(form, n)) ? field(form, n) : null);
  try {
    if (intent === 'plan') {
      const company = doCompanies.find((c) => c.id === field(form, 'entity_id'));
      if (!company) throw new Error('Choose the company.');
      if (field(form, 'name').length < 3) throw new Error('Name the plan.');
      const { data: pl } = await svc.from('equity_plans').insert({
        entity_id: company.id, name: field(form, 'name').slice(0, 200), kind: ['options', 'rights', 'shares'].includes(field(form, 'kind')) ? field(form, 'kind') : 'options',
        share_class_id: field(form, 'share_class_id') || null, pool_size: Math.round(num('pool_size')) || 0, adopted_on: d('adopted_on'),
        vesting_months: Math.round(num('vesting_months')), cliff_months: Math.round(num('cliff_months')), frequency: field(form, 'frequency') in FREQUENCY ? field(form, 'frequency') : 'monthly',
        expiry_years: Math.round(num('expiry_years')) || 10, leaver_exercise_days: Math.round(num('leaver_exercise_days')), created_by: Astro.locals.user!.id,
      }).select('id').single().throwOnError();
      await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_added_equity_plan', event_detail: { entity_id: company.id, plan_id: pl!.id } });
    } else if (intent === 'grant') {
      const { data: plRow } = await svc.from('equity_plans').select(PLAN_COLUMNS).eq('id', field(form, 'plan_id')).single();
      const plan = plRow as Plan | null;
      if (!plan || !access.can('hr.do', plan.entity_id)) throw new Error('Choose a plan you look after.');
      const { data: person } = field(form, 'person_id') ? await svc.from('people').select('id, full_name, entity_id, start_date').eq('id', field(form, 'person_id')).eq('entity_id', plan.entity_id).maybeSingle() : { data: null };
      const holder = person?.full_name ?? field(form, 'holder_name');
      if (!holder) throw new Error('Choose the person, or type the holder’s name (for an advisor not in People).');
      const number = Math.round(num('number'));
      if (!(number > 0)) throw new Error('How many?');
      const grantDate = d('grant_date') ?? todayIn();
      const start = d('vesting_start') ?? person?.start_date ?? grantDate;
      const { data: g } = await svc.from('equity_grants').insert({
        plan_id: plan.id, entity_id: plan.entity_id, person_id: person?.id ?? null, holder_name: holder.slice(0, 200), number, exercise_price: num('exercise_price') || 0,
        grant_date: grantDate, vesting_start: start, vesting_months: field(form, 'vesting_months') ? Math.round(num('vesting_months')) : plan.vesting_months,
        cliff_months: field(form, 'cliff_months') ? Math.round(num('cliff_months')) : plan.cliff_months, frequency: field(form, 'frequency') in FREQUENCY ? field(form, 'frequency') : plan.frequency,
        expiry_date: d('expiry_date') ?? addMonths(grantDate, plan.expiry_years * 12), created_by: Astro.locals.user!.id,
      }).select('id').single().throwOnError();
      await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_drafted_equity_grant', event_detail: { entity_id: plan.entity_id, grant_id: g!.id } });
      return Astro.redirect(`/admin/hr/equity/${g!.id}`);
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

const [{ data: planRows }, { data: grantRows }, { data: people }, { data: classes }] = await Promise.all([
  svc.from('equity_plans').select(PLAN_COLUMNS).in('entity_id', ids.length ? ids : ['00000000-0000-0000-0000-000000000000']).order('name'),
  svc.from('equity_grants').select(`${GRANT_COLUMNS}, equity_exercises(number, status)`).in('entity_id', ids.length ? ids : ['00000000-0000-0000-0000-000000000000']).order('grant_date', { ascending: false }),
  svc.from('people').select('id, entity_id, full_name').in('entity_id', ids.length ? ids : ['00000000-0000-0000-0000-000000000000']).neq('status', 'left').order('full_name'),
  svc.from('share_classes').select('id, entity_id, name').in('entity_id', ids.length ? ids : ['00000000-0000-0000-0000-000000000000']),
]);
const plans = (planRows ?? []) as Plan[];
const grants = (grantRows ?? []) as unknown as (Grant & { equity_exercises: { number: number; status: 'requested' | 'approved' | 'issued' | 'rejected' }[] })[];
const nameOf = new Map(companies.map((c) => [c.id, c.display_name]));
const usage = (planId: string) => {
  let used = 0, vested = 0, exercised = 0;
  for (const g of grants.filter((x) => x.plan_id === planId)) {
    const pos = position(g, g.equity_exercises);
    exercised += pos.exercised;
    if (g.status === 'granted') { used += g.number - pos.forfeited; vested += pos.vested; } else if (g.status === 'lapsed') used += pos.exercised;
  }
  return { used, vested, exercised };
};
const n = (v: number) => new Intl.NumberFormat('en-AU').format(v);
const day = (s: string) => shortDate.format(new Date(`${s}T12:00:00+10:00`));
const person = forPerson ? (people ?? []).find((x) => x.id === forPerson) : null;
---

<Admin title="HR · Equity plans">
  <PageHeader title="HR" subtitle="People, their onboarding and leaving, equity grants, policies and documents. Pay, leave and tax details stay in the payroll system." />
  <HrNav />
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}

  {plans.length ? (
    <div class="mb-6 grid gap-4 md:grid-cols-2">
      {plans.map((pl) => { const u = usage(pl.id); return (
        <section class="card !p-5">
          <p class="font-display text-lg font-bold text-white">{pl.name}</p>
          <p class="text-xs text-white/45">{nameOf.get(pl.entity_id)} · {pl.kind} · {pl.vesting_months} months, {pl.cliff_months}-month cliff, {FREQUENCY[pl.frequency].toLowerCase()}</p>
          <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/10" role="img" aria-label={`${n(u.used)} of ${n(pl.pool_size)} in use`}><div class="h-full bg-lk-blue" style={`width:${pl.pool_size ? Math.min(100, (u.used / pl.pool_size) * 100) : 0}%`}></div></div>
          <p class="mt-2 text-sm text-white/65">{n(u.used)} of {n(pl.pool_size)} in use · {n(u.vested)} vested · {n(u.exercised)} exercised · <span class:list={[pl.pool_size - u.used < 0 && 'text-lk-red']}>{n(pl.pool_size - u.used)} left</span></p>
        </section>
      ); })}
    </div>
  ) : <div class="mb-6"><Empty title="No plans yet">Add the company's employee share option (or rights) plan below.</Empty></div>}

  {grants.length > 0 && (
    <section class="card mb-6 overflow-x-auto p-0">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/5 text-xs uppercase tracking-wider text-white/40"><tr><th class="px-5 py-3">Holder</th><th class="px-5 py-3">Plan</th><th class="px-5 py-3 text-right">Granted</th><th class="px-5 py-3 text-right">Vested</th><th class="px-5 py-3 text-right">Exercised</th><th class="px-5 py-3">State</th></tr></thead>
        <tbody class="divide-y divide-white/5">
          {grants.map((g) => { const pos = position(g, g.equity_exercises); return (
            <tr>
              <td class="px-5 py-3"><a class="font-medium text-white hover:text-lk-blue" href={`/admin/hr/equity/${g.id}`}>{g.holder_name}</a><span class="block text-xs text-white/45">{day(g.grant_date)}{g.status === 'granted' && !g.accepted_at && ' · not accepted yet'}{g.equity_exercises.some((e) => e.status === 'requested') && ' · exercise requested'}</span></td>
              <td class="px-5 py-3 text-white/65">{plans.find((pl) => pl.id === g.plan_id)?.name}</td>
              <td class="px-5 py-3 text-right tabular-nums">{n(g.number)}</td>
              <td class="px-5 py-3 text-right tabular-nums">{n(pos.vested)}</td>
              <td class="px-5 py-3 text-right tabular-nums">{n(pos.exercised)}</td>
              <td class:list={['px-5 py-3', g.status === 'draft' ? 'text-lk-orange' : 'text-white/60']}>{GRANT_STATES[g.status]}{g.vesting_stopped_on && g.status === 'granted' && ' (left)'}</td>
            </tr>
          ); })}
        </tbody>
      </table>
    </section>
  )}

  {doCompanies.length > 0 && (
    <div class="grid gap-6 lg:grid-cols-2">
      {plans.some((pl) => access.can('hr.do', pl.entity_id)) && (
        <form method="post" id="new-grant" class="card grid scroll-mt-32 content-start gap-3 sm:grid-cols-2">
          <h2 class="font-display text-lg font-bold sm:col-span-2">New grant{person && ` for ${person.full_name}`}</h2>
          <div class="sm:col-span-2"><label class="label" for="plan_id">Plan</label><select class="field" id="plan_id" name="plan_id" required>{plans.filter((pl) => access.can('hr.do', pl.entity_id)).map((pl) => <option value={pl.id} selected={person?.entity_id === pl.entity_id}>{pl.name} · {nameOf.get(pl.entity_id)}</option>)}</select></div>
          <div><label class="label" for="person_id">Person</label><select class="field" id="person_id" name="person_id"><option value="">Someone not in People</option>{(people ?? []).map((x) => <option value={x.id} selected={x.id === forPerson}>{x.full_name} · {nameOf.get(x.entity_id)}</option>)}</select></div>
          <div><label class="label" for="holder_name">…or holder's name</label><input class="field" id="holder_name" name="holder_name" placeholder="e.g. an advisor" /></div>
          <div><label class="label" for="number">Number</label><input class="field" id="number" name="number" inputmode="numeric" required /></div>
          <div><label class="label" for="exercise_price">Exercise price (A$)</label><input class="field" id="exercise_price" name="exercise_price" inputmode="decimal" placeholder="0.10" /></div>
          <div><label class="label" for="grant_date">Grant date</label><input class="field" type="date" id="grant_date" name="grant_date" value={todayIn()} /></div>
          <div><label class="label" for="vesting_start">Vesting starts</label><input class="field" type="date" id="vesting_start" name="vesting_start" /><p class="mt-1 text-xs text-white/40">Empty: their start date, else the grant date.</p></div>
          <div><label class="label" for="g-vm">Vesting months</label><input class="field" id="g-vm" name="vesting_months" inputmode="numeric" placeholder="Plan's" /></div>
          <div><label class="label" for="g-cm">Cliff months</label><input class="field" id="g-cm" name="cliff_months" inputmode="numeric" placeholder="Plan's" /></div>
          <div><label class="label" for="g-f">Vests</label><select class="field" id="g-f" name="frequency"><option value="">Plan's</option>{Object.entries(FREQUENCY).map(([k, l]) => <option value={k}>{l}</option>)}</select></div>
          <div><label class="label" for="expiry_date">Expiry</label><input class="field" type="date" id="expiry_date" name="expiry_date" /></div>
          <div class="sm:col-span-2"><button class="btn-primary" name="intent" value="grant">Draft the grant</button></div>
        </form>
      )}
      <details class="card content-start" open={!plans.length}>
        <summary class="cursor-pointer font-display text-lg font-bold">New plan</summary>
        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
          <div><label class="label" for="p-entity">Company</label><select class="field" id="p-entity" name="entity_id" required>{doCompanies.map((c) => <option value={c.id}>{c.display_name}</option>)}</select></div>
          <div><label class="label" for="p-name">Name</label><input class="field" id="p-name" name="name" placeholder="Employee Share Option Plan" required /></div>
          <div><label class="label" for="p-kind">Grants</label><select class="field" id="p-kind" name="kind"><option value="options">Options</option><option value="rights">Rights</option><option value="shares">Shares</option></select></div>
          <div><label class="label" for="p-class">Over the class</label><select class="field" id="p-class" name="share_class_id"><option value="">—</option>{(classes ?? []).map((c) => <option value={c.id}>{c.name} · {nameOf.get(c.entity_id)}</option>)}</select></div>
          <div><label class="label" for="p-pool">Pool size</label><input class="field" id="p-pool" name="pool_size" inputmode="numeric" required /></div>
          <div><label class="label" for="p-adopted">Adopted on</label><input class="field" type="date" id="p-adopted" name="adopted_on" /></div>
          <div><label class="label" for="p-vm">Usual vesting (months)</label><input class="field" id="p-vm" name="vesting_months" value="48" inputmode="numeric" /></div>
          <div><label class="label" for="p-cm">Cliff (months)</label><input class="field" id="p-cm" name="cliff_months" value="12" inputmode="numeric" /></div>
          <div><label class="label" for="p-f">Vests</label><select class="field" id="p-f" name="frequency">{Object.entries(FREQUENCY).map(([k, l]) => <option value={k}>{l}</option>)}</select></div>
          <div><label class="label" for="p-exp">Expiry (years after grant)</label><input class="field" id="p-exp" name="expiry_years" value="10" inputmode="numeric" /></div>
          <div class="sm:col-span-2"><label class="label" for="p-leaver">A leaver may exercise vested options within (days)</label><input class="field" id="p-leaver" name="leaver_exercise_days" value="90" inputmode="numeric" /></div>
          <div class="sm:col-span-2"><button class="btn-ghost" name="intent" value="plan">Add the plan</button></div>
        </form>
      </details>
    </div>
  )}
</Admin>
