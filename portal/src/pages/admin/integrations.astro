---
import Admin from '../../layouts/Admin.astro';
import { serviceClient } from '../../lib/admin';
import { isCompanyAdmin } from '../../lib/integrations/admin';

// Admin → Settings → Integrations: the companies whose integrations this person runs (their Admins, and the
// group's), each opening its own page. Someone who runs only one goes straight there.
const svc = serviceClient();
const access = Astro.locals.access;
const { data: entities } = await svc.from('entities').select('id, code, display_name, integrations_enabled').order('sort');
const mine = (entities ?? []).filter((e) => isCompanyAdmin(access, e.id));
if (mine.length === 1) return Astro.redirect(`/admin/companies/${mine[0].code}/integrations`);
const ids = mine.map((e) => e.id);
const [{ data: keys }, { data: hooks }, { data: conns }] = ids.length ? await Promise.all([
  svc.from('api_keys').select('entity_id').in('entity_id', ids).eq('kind', 'key').is('revoked_at', null),
  svc.from('webhook_endpoints').select('entity_id').in('entity_id', ids).eq('active', true),
  svc.from('connections').select('entity_id, provider').in('entity_id', ids).eq('status', 'connected'),
]) : [{ data: [] }, { data: [] }, { data: [] }];
const countOf = (rows: { entity_id: string | null }[] | null, id: string) => (rows ?? []).filter((r) => r.entity_id === id).length;
const connected = (id: string) => (conns ?? []).filter((c) => c.entity_id === id).map((c) => (c.provider === 'hubspot' ? 'HubSpot' : c.provider === 'xero' ? 'Xero' : c.provider));
---

<Admin title="Integrations">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div><h1 class="font-display text-3xl font-bold">Integrations</h1>
      <p class="mt-1 max-w-3xl text-sm text-white/55">API keys, webhooks, HubSpot, Xero and apps, per company. Open a company to manage them; the <a href="/developers" class="text-white hover:text-lk-blue">developers docs</a> explain how they work.</p></div>
    <a href="/developers/reference" class="btn-ghost text-sm">APIs reference</a>
  </div>
  {mine.length === 0 ? (
    <p class="card mt-6 text-sm text-white/55">Integrations are run by a company’s Admins. You aren’t an Admin of any company.</p>
  ) : (
    <section class="card mt-6 overflow-x-auto p-0">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/5 text-xs uppercase tracking-wider text-white/40"><tr><th class="px-5 py-3">Company</th><th class="px-5 py-3 text-right">API keys</th><th class="px-5 py-3 text-right">Webhooks</th><th class="px-5 py-3">Connected</th><th class="px-5 py-3"></th></tr></thead>
        <tbody class="divide-y divide-white/5">
          {mine.map((e) => (
            <tr>
              <td class="px-5 py-3"><a href={`/admin/companies/${e.code}/integrations`} class="font-medium text-white hover:text-lk-blue">{e.display_name}</a><span class="block text-xs text-white/40">{e.code}{!e.integrations_enabled && ' · switched off'}</span></td>
              <td class="px-5 py-3 text-right tabular-nums">{countOf(keys, e.id)}</td>
              <td class="px-5 py-3 text-right tabular-nums">{countOf(hooks, e.id)}</td>
              <td class="px-5 py-3 text-white/65">{connected(e.id).join(', ') || '—'}</td>
              <td class="px-5 py-3 text-right"><a href={`/admin/companies/${e.code}/integrations`} class="btn-ghost !px-3 !py-1.5 text-xs">Open</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}
</Admin>
