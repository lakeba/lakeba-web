---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import Empty from '../../components/Empty.astro';
import { field } from '../../lib/forms';
import { parseLocal } from '../../lib/admin-forms';
import { categoryLabels, dateTime, fileSize } from '../../lib/format';
import { notifyMembers } from '../../lib/notify';
import { pdfChunks } from '../../lib/pdf-text';
import { buildKnowledgeBase, NEWS_FROM } from '../../lib/knowledge';
import { askEnabled, askName } from '../../lib/ask';
import { adminScope, formCompany } from '../../lib/admin-company';
import { serviceClient } from '../../lib/admin';
import { approvalHref, approvalsFor, getApproval, heldBack, requestApproval } from '../../lib/approvals';
import ApprovalChip from '../../components/ApprovalChip.astro';
import AdminCompanyFilter from '../../components/AdminCompanyFilter.astro';
import CompanySelect from '../../components/CompanySelect.astro';

const supabase = Astro.locals.supabase;
const scope = await adminScope(Astro.locals, Astro.url);
const categories = Object.keys(categoryLabels);
const audiences = { all_investors: 'All investors', board: 'Board only', holder: 'One holder' };
let error = '';
let notice = '';

const safeName = (name: string) => name.toLowerCase().replace(/[^a-z0-9.]+/g, '-').replace(/^-+|-+$/g, '').slice(-80) || 'file';

/** Stores the extracted text of a PDF so "Ask Lakeba" and search can use it. */
async function indexPdf(documentId: string, bytes: Uint8Array) {
  try {
    const chunks = await pdfChunks(bytes);
    if (chunks.length) {
      await supabase.from('document_chunks').insert(chunks.map((c, i) => ({ document_id: documentId, chunk_index: i, page: c.page, content: c.content }))).throwOnError();
    }
    return chunks.length;
  } catch {
    return 0; // Scanned or protected PDFs have no extractable text.
  }
}

// Tells that company's shareholders (and the group's, when shared with the group).
const announce = async (title: string, summary: string | null, entityId: string, shared: boolean) => {
  const note = { kind: 'document', title: `New document: ${title}`, body: summary || `“${title}” has been added to your documents.`, link: '/documents', origin: Astro.url.origin, pushDetail: title };
  await notifyMembers({ ...note, entityId });
  const group = scope.companies.find((c) => c.relationship === 'group');
  if (shared && group && group.id !== entityId) await notifyMembers({ ...note, entityId: group.id });
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const id = field(form, 'id');

  if (intent === 'upload') {
    const file = form.get('file');
    const title = field(form, 'title');
    const category = field(form, 'category');
    const audience = field(form, 'audience');
    const holderId = field(form, 'holder_id');
    const when = field(form, 'publish');
    const company = formCompany(scope, field(form, 'entity_id'));
    const shared = company?.relationship !== 'group' && form.get('shared_with_group') === 'on';
    if (!company) error = 'Choose the company this document belongs to.';
    else if (!(file instanceof File) || !file.size) error = 'Choose a file to upload.';
    else if (!title || !categories.includes(category) || !(audience in audiences)) error = 'Fill in the title, category and audience.';
    else if (audience === 'holder' && !holderId) error = 'Choose the holder this document is for.';
    else if (audience === 'holder' && !(await serviceClient().rpc('holder_in_entity', { target_holder: holderId, target_entity: company.id })).data) error = 'That holder has no shares in this company.';
    else {
      // Optional approval: the document waits as a draft until it's approved.
      const needsApproval = form.get('needs_approval') === 'on';
      const publishedAt = needsApproval ? null : when === 'now' ? new Date().toISOString() : when === 'schedule' ? parseLocal(field(form, 'publish_at')) : null;
      const path = `entity/${company.id}/${category}/${new Date().getFullYear()}/${crypto.randomUUID()}-${safeName(file.name)}`;
      const bytes = new Uint8Array(await file.arrayBuffer());
      const { error: uploadError } = await supabase.storage.from('documents').upload(path, bytes, { contentType: file.type || 'application/octet-stream' });
      if (uploadError) error = uploadError.message;
      else {
        const summary = field(form, 'summary') || null;
        const { data: doc, error: insertError } = await supabase.from('documents').insert({
          entity_id: company.id, shared_with_group: shared,
          title, summary, category, audience, holder_id: audience === 'holder' ? holderId : null,
          file_path: path, mime_type: file.type || 'application/octet-stream', size_bytes: file.size,
          published_at: publishedAt, created_by: Astro.locals.user!.id,
          in_knowledge_base: category !== 'register' && form.get('in_knowledge_base') === 'on',
        }).select('id').single();
        if (insertError || !doc) {
          await supabase.storage.from('documents').remove([path]);
          error = insertError?.message ?? 'Could not save the document.';
        } else {
          const passages = file.type === 'application/pdf' ? await indexPdf(doc.id, bytes) : 0;
          await supabase.rpc('log_event', { event_action: 'admin_uploaded_document', event_detail: { document_id: doc.id, title } });
          if (when === 'now' && audience === 'all_investors' && !needsApproval) await announce(title, summary, company.id, shared);
          const asked = needsApproval ? await requestApproval(serviceClient(), Astro.locals.access, Astro.locals.user!.id, { type: 'document', id: doc.id, entityId: company.id, title, note: field(form, 'approval_note'), origin: Astro.url.origin }) : null;
          if (needsApproval && !asked) await supabase.rpc('log_event', { event_action: 'approval_requested', event_detail: { item_type: 'document', item_id: doc.id, title } });
          notice = `Uploaded “${title}”${passages ? ` (${passages} passages indexed for search)` : ''}.${needsApproval ? (asked ? ` It’s a draft: ${asked}` : ' It’s a draft until it’s approved; approvers have been told.') : ''}`;
        }
      }
    }
  } else if (intent === 'kb-on' || intent === 'kb-off') {
    const { data: doc, error: kbError } = await supabase.from('documents').update({ in_knowledge_base: intent === 'kb-on' }).eq('id', id).select('title').single();
    if (kbError) error = kbError.code === '23514' ? 'Registers contain shareholders’ personal details and can’t be used by Ask Lakeba.' : kbError.message;
    else {
      await supabase.rpc('log_event', { event_action: intent === 'kb-on' ? 'admin_added_to_ask' : 'admin_removed_from_ask', event_detail: { document_id: id, title: doc.title } });
      notice = intent === 'kb-on' ? `“${doc.title}” is now used by Ask Lakeba.` : `Ask Lakeba no longer uses “${doc.title}”.`;
    }
  } else if (intent === 'publish' && heldBack(await getApproval(serviceClient(), 'document', id), 'document')) {
    error = heldBack(await getApproval(serviceClient(), 'document', id), 'document')!;
  } else if (intent === 'publish' || intent === 'unpublish') {
    const { data: doc } = await supabase.from('documents')
      .update({ published_at: intent === 'publish' ? new Date().toISOString() : null }).eq('id', id).select('title, summary, audience, entity_id, shared_with_group').single();
    if (doc) {
      await supabase.rpc('log_event', { event_action: `admin_${intent}ed_document`, event_detail: { document_id: id, title: doc.title } });
      if (intent === 'publish' && doc.audience === 'all_investors') await announce(doc.title, doc.summary, doc.entity_id, doc.shared_with_group);
      notice = intent === 'publish' ? `Published “${doc.title}”.` : `“${doc.title}” is now a draft.`;
    }
  } else if (intent === 'share-on' || intent === 'share-off') {
    const { data: doc } = await supabase.from('documents').update({ shared_with_group: intent === 'share-on' }).eq('id', id).select('title').single();
    if (doc) {
      await supabase.rpc('log_event', { event_action: intent === 'share-on' ? 'admin_shared_document_with_group' : 'admin_unshared_document', event_detail: { document_id: id, title: doc.title } });
      notice = intent === 'share-on' ? `Lakeba Group shareholders can now see “${doc.title}”.` : `“${doc.title}” is no longer shared with Lakeba Group shareholders.`;
    }
  } else if (intent === 'delete') {
    const { data: doc } = await supabase.from('documents').select('title, file_path').eq('id', id).single();
    if (doc) {
      await supabase.storage.from('documents').remove([doc.file_path]);
      await supabase.from('documents').delete().eq('id', id).throwOnError();
      await supabase.rpc('log_event', { event_action: 'admin_deleted_document', event_detail: { document_id: id, title: doc.title } });
      notice = `Deleted “${doc.title}”.`;
    }
  }
}

const [{ data: docs }, { data: reads }, { data: holders }] = await Promise.all([
  supabase.from('documents').select('id, entity_id, shared_with_group, title, category, audience, size_bytes, published_at, created_at, in_knowledge_base, holders(name)').in('entity_id', scope.ids).order('created_at', { ascending: false }),
  supabase.from('document_reads').select('document_id'),
  supabase.from('holders').select('id, name').order('name'),
]);
const readCount = new Map<string, number>();
for (const r of reads ?? []) readCount.set(r.document_id, (readCount.get(r.document_id) ?? 0) + 1);
const now = new Date();
const status = (p: string | null) => (!p ? 'Draft' : new Date(p) > now ? 'Scheduled' : 'Published');
const statusStyle: Record<string, string> = { Draft: 'bg-white/10 text-white/60', Scheduled: 'bg-lk-orange/15 text-lk-orange', Published: 'bg-lk-green/15 text-lk-green' };
// Ask Lakeba knowledge base summary. Costs: Claude Opus 5.5 at $4/M input,
// $20/M output, cache reads $0.20/M; a cache write with 1-hour TTL is 2× input.
const kbCompany = scope.selected ?? scope.defaultCompany;
const kb = await buildKnowledgeBase(kbCompany);
const companyName = (id: string) => scope.companies.find((c) => c.id === id)?.display_name ?? '';
const groupCompany = scope.companies.find((c) => c.relationship === 'group');
const kbCost = { warm: (kb.approxTokens * 0.2 + 1500 * 20) / 1e6, cold: (kb.approxTokens * 8 + 1500 * 20) / 1e6 };
const usd = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
const docApprovals = await approvalsFor(serviceClient(), 'document', (docs ?? []).map((d) => d.id));
---

<Admin title="Documents">
  <PageHeader title="Documents" subtitle="Files are stored privately; investors get short-lived links only for documents they are allowed to see." />
  <AdminCompanyFilter scope={scope} />
  <section class="card mb-6 !p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-bold">{askName(kbCompany)} knowledge base</h2>
      <span class:list={['rounded-full px-3 py-1 text-xs font-semibold', askEnabled ? 'bg-lk-green/15 text-lk-green' : 'bg-lk-orange/15 text-lk-orange']}>{askEnabled ? 'AI answers on (Claude Opus 5.5)' : 'AI answers off: ANTHROPIC_API_KEY not set'}</span>
    </div>
    <p class="mt-2 text-sm text-white/60">
      Facts sheet + {kb.documentCount} documents + {kb.articleCount} news articles (from {NEWS_FROM.slice(0, 4)}) · about {Math.round(kb.approxTokens / 1000)}k tokens, sent in full and cached for an hour.
      Registers are never included; drafts, scheduled, board-only and holder documents are left out.
    </p>
    <p class="mt-1 text-xs text-white/40">Estimated cost per question: about {usd.format(kbCost.warm)} when the cache is warm, {usd.format(kbCost.cold)} for the first question after an hour without questions.</p>
  </section>
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}

  <details class="card mb-6" open={Boolean(error)}>
    <summary class="cursor-pointer font-display text-lg font-bold text-white">Upload a document</summary>
    <form method="post" enctype="multipart/form-data" class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2"><CompanySelect scope={scope} /></div>
      <div class="sm:col-span-2"><input type="file" name="file" required class="block text-sm text-white/70 file:mr-4 file:rounded-lg file:border-0 file:bg-white/10 file:px-4 file:py-2 file:text-white" /></div>
      <div class="sm:col-span-2"><label class="label" for="title">Title</label><input class="field" id="title" name="title" required /></div>
      <div class="sm:col-span-2"><label class="label" for="summary">Summary (shown in the list and the notification)</label><textarea class="field" id="summary" name="summary" rows="2"></textarea></div>
      <div><label class="label" for="category">Category</label><select class="field" id="category" name="category">{categories.map((c) => <option value={c}>{categoryLabels[c]}</option>)}</select></div>
      <div><label class="label" for="audience">Who can see it</label><select class="field" id="audience" name="audience">{Object.entries(audiences).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
      <div><label class="label" for="holder_id">Holder (for “One holder”)</label><select class="field" id="holder_id" name="holder_id"><option value="">—</option>{(holders ?? []).map((h) => <option value={h.id}>{h.name}</option>)}</select></div>
      <div><label class="label" for="publish">Publishing</label>
        <select class="field" id="publish" name="publish"><option value="now">Publish now and notify</option><option value="schedule">Schedule</option><option value="draft">Save as draft</option></select></div>
      <div><label class="label" for="publish_at">Scheduled time</label><input class="field" id="publish_at" name="publish_at" type="datetime-local" /></div>
      <label class="flex items-center gap-3 text-sm text-white/70 sm:col-span-2"><input type="checkbox" name="in_knowledge_base" checked class="size-4 accent-lk-blue" /> Use in Ask (ignored for registers, which are never used)</label>
      {groupCompany && scope.companies.length > 1 && <label class="flex items-center gap-3 text-sm text-white/70 sm:col-span-2"><input type="checkbox" name="shared_with_group" class="size-4 accent-lk-blue" /> Also share with Lakeba Group shareholders (venture documents only, e.g. a venture’s annual report)</label>}
      <label class="flex items-center gap-3 text-sm text-white/70 sm:col-span-2"><input type="checkbox" name="needs_approval" class="size-4 accent-lk-blue" /> Ask for approval before it’s published (optional; it stays a draft until approved)</label>
      <div class="sm:col-span-2"><label class="label" for="approval_note">Note for the approver (optional)</label><input class="field" id="approval_note" name="approval_note" maxlength="1000" /></div>
      <div class="sm:col-span-2"><button name="intent" value="upload" class="btn-primary">Upload</button></div>
    </form>
  </details>

  {docs?.length ? (
    <div class="card overflow-x-auto !p-0">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40"><tr><th class="px-5 py-3 font-medium">Document</th><th class="px-5 py-3 font-medium">Audience</th><th class="px-5 py-3 font-medium">Status</th><th class="px-5 py-3 text-right font-medium">Readers</th><th class="px-5 py-3"></th></tr></thead>
        <tbody class="divide-y divide-white/5">
          {docs.map((d) => {
            const s = status(d.published_at);
            return (
              <tr>
                <td class="px-5 py-3"><a href={`/documents/${d.id}`} class="font-medium text-white hover:underline">{d.title}</a><span class="block text-xs text-white/40">{scope.companies.length > 1 && `${companyName(d.entity_id)} · `}{categoryLabels[d.category]} · {fileSize(d.size_bytes)}{d.in_knowledge_base && d.audience === 'all_investors' && <span class="ml-1 rounded-full bg-lk-blue/15 px-2 py-0.5 text-lk-blue">Ask</span>}{d.shared_with_group && <span class="ml-1 rounded-full bg-white/10 px-2 py-0.5 text-white/60">Shared with group</span>}</span></td>
                <td class="px-5 py-3 text-white/60">{d.audience === 'holder' ? (d.holders as { name: string } | null)?.name : audiences[d.audience as keyof typeof audiences]}</td>
                <td class="px-5 py-3"><span class={`rounded-full px-2.5 py-0.5 text-xs ${statusStyle[s]}`}>{s}</span> <ApprovalChip type="document" id={d.id} approval={docApprovals.get(d.id) ?? null} compact />{d.published_at && <span class="mt-1 block text-xs text-white/40">{dateTime.format(new Date(d.published_at))}</span>}</td>
                <td class="px-5 py-3 text-right text-white/70">{readCount.get(d.id) ?? 0}</td>
                <td class="px-5 py-3">
                  <form method="post" class="flex justify-end gap-3 text-xs">
                    <input type="hidden" name="id" value={d.id} />
                    {s === 'Published' ? <button name="intent" value="unpublish" class="text-white/50 hover:text-white">Unpublish</button> : <button name="intent" value="publish" class="text-lk-blue hover:underline">Publish now</button>}
                    {s !== 'Published' && !docApprovals.get(d.id) && <a href={approvalHref('document', d.id)} class="text-white/50 hover:text-white">Ask for approval</a>}
                    {d.category !== 'register' && (d.in_knowledge_base
                      ? <button name="intent" value="kb-off" class="text-white/50 hover:text-white">Remove from Ask</button>
                      : <button name="intent" value="kb-on" class="text-lk-blue hover:underline">Use in Ask</button>)}
                    {groupCompany && d.entity_id !== groupCompany.id && (d.shared_with_group
                      ? <button name="intent" value="share-off" class="text-white/50 hover:text-white">Stop sharing with group</button>
                      : <button name="intent" value="share-on" class="text-lk-blue hover:underline">Share with group</button>)}
                    <button name="intent" value="delete" class="text-white/50 hover:text-lk-red" onclick="return confirm('Delete this document for everyone?')">Delete</button>
                  </form>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  ) : <Empty title="No documents yet">Upload the first report, notice or update above.</Empty>}
</Admin>
