---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import Empty from '../../components/Empty.astro';
import Markdown from '../../components/Markdown.astro';
import { field } from '../../lib/forms';
import { shortDate, dateTime } from '../../lib/format';
import { buildKnowledgeBase } from '../../lib/knowledge';
import { askEnabled, askName, buildMessages, client, coreRules, HOUSE_RULES_MAX, houseRulesKey, loadHouseRules, MODEL, systemPrompt } from '../../lib/ask';
import { adminScope } from '../../lib/admin-company';
import AdminCompanyFilter from '../../components/AdminCompanyFilter.astro';
import { serviceClient } from '../../lib/admin';
import { DEFAULT_LIMITS, loadLimits, spendToday } from '../../lib/ask-limits';
import { ensureIndex, loadRetrieval } from '../../lib/retrieval';

const supabase = Astro.locals.supabase;
const userId = Astro.locals.user!.id;
// One company at a time: its knowledge base, house rules and approved answers.
const scope = await adminScope(Astro.locals, Astro.url);
const company = scope.selected ?? scope.defaultCompany;
const companyId = company?.id ?? '00000000-0000-0000-0000-000000000000';
let notice = '';
let error = '';
let exactTokens: number | null = null;

const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Sydney' }).format(new Date());
const plusMonths = (n: number) => { const d = new Date(); d.setMonth(d.getMonth() + n); return d.toISOString().slice(0, 10); };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const id = field(form, 'id');
  const log = (action: string, detail: object = {}) => supabase.rpc('log_event', { event_action: action, event_detail: detail });

  // Usage limits, pauses and the answer mode are portal-wide: group admins only.
  if (['limits', 'restore', 'pause', 'retrieval', 'reindex'].includes(intent) && !scope.isGroupAdmin) return new Response('Forbidden', { status: 403 });
  if (intent === 'retrieval') {
    const passages = Math.round(Number(field(form, 'passages')));
    if (!(passages >= 10 && passages <= 80)) error = 'Passages per question: 10–80.';
    else {
      const value = { enabled: field(form, 'mode') === 'retrieval', passages };
      const { error: e } = await supabase.from('ask_settings').upsert({ key: 'retrieval', value, updated_by: userId, updated_at: new Date().toISOString() });
      if (e) error = e.message; else { await log('admin_updated_ask_retrieval', value); notice = value.enabled ? `Ask now answers from the ${passages} best-matching passages.` : 'Ask now answers from the full documents.'; }
    }
  } else if (intent === 'reindex') {
    try {
      const done = await ensureIndex(serviceClient(), true);
      notice = `Search index up to date (${done.documents} document passages and ${done.news} news articles indexed now).`;
    } catch (e) {
      error = `The search index could not be built: ${e instanceof Error ? e.message : String(e)}`;
    }
  } else if (intent === 'limits') {
    const num = (name: string, min: number, max: number) => {
      const v = Number(field(form, name));
      return Number.isFinite(v) && v >= min && v <= max ? v : null;
    };
    const value = {
      perHour: num('perHour', 1, 100), perDay: num('perDay', 1, 500),
      dailyBudgetUsd: num('dailyBudgetUsd', 1, 10000), maxAnswerTokens: num('maxAnswerTokens', 1000, 16000),
      precheck: form.get('precheck') === 'on',
    };
    if (Object.values(value).some((v) => v === null)) error = 'Check the limits: questions per hour 1–100, per day 1–500, budget USD 1–10,000, answer length 1,000–16,000 tokens.';
    else {
      const { error: e } = await supabase.from('ask_settings').upsert({ key: 'limits', value, updated_by: userId, updated_at: new Date().toISOString() });
      if (e) error = e.message; else { await log('admin_updated_ask_limits', value); notice = 'Usage limits saved.'; }
    }
  } else if (intent === 'restore') {
    const { error: e } = await supabase.from('ask_user_pauses').delete().eq('user_id', field(form, 'user_id'));
    if (e) error = e.message; else { await log('admin_restored_ask_access', { user_id: field(form, 'user_id') }); notice = 'Ask Lakeba access restored.'; }
  } else if (intent === 'pause') {
    const { data: p } = await supabase.from('profiles').select('id').eq('email', field(form, 'email').toLowerCase()).maybeSingle();
    if (!p) error = 'No account with that email.';
    else {
      const { error: e } = await supabase.from('ask_user_pauses').upsert({ user_id: p.id, reason: field(form, 'reason') || 'Paused by an admin', paused_by: userId });
      if (e) error = e.message; else { await log('admin_paused_ask_access', { user_id: p.id }); notice = 'Ask Lakeba paused for that account.'; }
    }
  } else if (intent === 'house-rules') {
    const text = field(form, 'house_rules');
    if (text.length > HOUSE_RULES_MAX) error = `House rules can be at most ${HOUSE_RULES_MAX.toLocaleString()} characters.`;
    else {
      const { error: e } = await supabase.from('ask_settings').upsert({ key: houseRulesKey(company), value: { text }, updated_by: userId, updated_at: new Date().toISOString() });
      if (e) error = e.message; else { await log('admin_updated_ask_house_rules', { length: text.length }); notice = 'House rules saved. Ask Lakeba uses them from the next question.'; }
    }
  } else if (intent === 'add' || intent === 'save') {
    const values = { question: field(form, 'question'), answer: field(form, 'answer'), review_by: field(form, 'review_by') || plusMonths(6), updated_by: userId, updated_at: new Date().toISOString() };
    if (values.question.length < 3 || !values.answer) error = 'Write both the question and the answer.';
    else {
      const { error: e } = intent === 'add'
        ? await supabase.from('ask_approved_answers').insert({ ...values, entity_id: companyId, created_by: userId })
        : await supabase.from('ask_approved_answers').update(values).eq('id', id);
      if (e) error = e.message; else { await log(intent === 'add' ? 'admin_added_approved_answer' : 'admin_updated_approved_answer', { id }); notice = intent === 'add' ? 'Approved answer added.' : 'Approved answer saved.'; }
    }
  } else if (intent === 'extend') {
    const { error: e } = await supabase.from('ask_approved_answers').update({ review_by: plusMonths(6), active: true, updated_by: userId, updated_at: new Date().toISOString() }).eq('id', id);
    if (e) error = e.message; else { await log('admin_extended_approved_answer', { id }); notice = 'Checked and extended for 6 months.'; }
  } else if (intent === 'deactivate' || intent === 'activate') {
    const { error: e } = await supabase.from('ask_approved_answers').update({ active: intent === 'activate', updated_by: userId, updated_at: new Date().toISOString() }).eq('id', id);
    if (e) error = e.message; else { await log(`admin_${intent}d_approved_answer`, { id }); notice = intent === 'activate' ? 'Approved answer switched on.' : 'Approved answer switched off.'; }
  } else if (intent === 'test') {
    const { data: a } = await supabase.from('ask_approved_answers').select('question, answer').eq('id', id).single();
    const { data: dup } = await supabase.from('ask_test_cases').select('id').eq('question', a?.question ?? '').maybeSingle();
    if (dup) notice = 'This question is already in the test set.';
    else {
      const { error: e } = await supabase.from('ask_test_cases').insert({ entity_id: companyId, question: a!.question, expected_answer: a!.answer, notes: 'From approved answers', created_by: userId });
      if (e) error = e.message; else notice = 'Added to the test set.';
    }
  } else if (intent === 'delete') {
    const { error: e } = await supabase.from('ask_approved_answers').delete().eq('id', id);
    if (e) error = e.message; else { await log('admin_deleted_approved_answer', { id }); notice = 'Approved answer deleted.'; }
  } else if (intent === 'count' && client) {
    // Token counting is free; it also checks the request is well-formed.
    const [kb, rules] = await Promise.all([buildKnowledgeBase(company), loadHouseRules(serviceClient(), company)]);
    try {
      const counted = await client.beta.messages.countTokens({ model: MODEL, system: systemPrompt(rules, company), messages: buildMessages(kb, [{ role: 'user', content: 'Example question' }]) });
      exactTokens = counted.input_tokens;
    } catch (e) {
      error = `Could not count tokens: ${e instanceof Error ? e.message : String(e)}`;
    }
  }
}

const view = Astro.url.searchParams.get('view') ?? 'live';
const soon = (() => { const d = new Date(); d.setDate(d.getDate() + 14); return d.toISOString().slice(0, 10); })();
let query = supabase.from('ask_approved_answers').select('id, question, answer, review_by, active, source_exchange_id, updated_at').eq('entity_id', companyId).order('updated_at', { ascending: false });
if (view === 'live') query = query.eq('active', true).gte('review_by', today);
if (view === 'due') query = query.eq('active', true).lte('review_by', soon);
if (view === 'inactive') query = query.eq('active', false);
const svcRead = serviceClient();
const [limits, spent, { data: pauses }, retrieval, { count: unindexed }] = await Promise.all([
  loadLimits(svcRead),
  spendToday(svcRead),
  supabase.from('ask_user_pauses').select('user_id, reason, paused_by, paused_at, profiles!ask_user_pauses_user_id_fkey(email)').order('paused_at', { ascending: false }),
  loadRetrieval(svcRead),
  svcRead.from('document_chunks').select('id', { count: 'exact', head: true }).is('embedding', null),
]);
const usd = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'USD' });
const budgetPct = Math.min(100, Math.round((spent / limits.dailyBudgetUsd) * 100));
const [{ data: answers }, rules, kb, { count: liveCount }, { count: dueCount }] = await Promise.all([
  query,
  loadHouseRules(serviceClient(), company),
  buildKnowledgeBase(company),
  supabase.from('ask_approved_answers').select('id', { count: 'exact', head: true }).eq('entity_id', companyId).eq('active', true).gte('review_by', today),
  supabase.from('ask_approved_answers').select('id', { count: 'exact', head: true }).eq('entity_id', companyId).eq('active', true).lte('review_by', soon),
]);
const tabs = [
  { id: 'live', label: `Live (${liveCount ?? 0})` },
  { id: 'due', label: `Due for review (${dueCount ?? 0})` },
  { id: 'inactive', label: 'Switched off' },
  { id: 'all', label: 'All' },
];
const expired = (d: string) => d < today;
---

<Admin title="Ask knowledge">
  <PageHeader title={`${askName(company)} knowledge`} subtitle={`Approved answers and house rules shape what ${askName(company)} says. Changes apply from the next question.`} />
  <AdminCompanyFilter scope={scope} allowAll={false} />
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}

  <section class="card mb-6 !p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-white/70">
        Knowledge base now: {kb.documentCount} documents, {kb.articleCount} news articles, the facts sheet and <strong class="text-white">{kb.approvedCount} approved answers</strong> ·
        {exactTokens !== null ? <strong class="text-white"> exactly {exactTokens.toLocaleString()} tokens</strong> : ` about ${Math.round(kb.approxTokens / 1000)}k tokens`}
      </p>
      {askEnabled && <form method="post"><button name="intent" value="count" class="btn-ghost !px-3 !py-2 text-sm">Check exact size (free)</button></form>}
    </div>
  </section>

  {scope.isGroupAdmin && (
  <section class="card mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-bold">Usage and costs</h2>
      <span class:list={['rounded-full px-3 py-1 text-xs font-semibold', budgetPct >= 100 ? 'bg-lk-red/15 text-lk-red' : budgetPct >= 80 ? 'bg-lk-orange/15 text-lk-orange' : 'bg-lk-green/15 text-lk-green']}>
        Today: {usd.format(spent)} of {usd.format(limits.dailyBudgetUsd)} budget{budgetPct >= 100 && ' — AI answers paused until midnight'}
      </span>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/10"><div class:list={['h-full rounded-full', budgetPct >= 100 ? 'bg-lk-red' : budgetPct >= 80 ? 'bg-lk-orange' : 'bg-lk-green']} style={`width:${budgetPct}%`}></div></div>
    <form method="post" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label><span class="label">Questions per hour, per account</span><input type="number" name="perHour" min="1" max="100" value={limits.perHour} class="field" /></label>
      <label><span class="label">Questions per day, per account</span><input type="number" name="perDay" min="1" max="500" value={limits.perDay} class="field" /></label>
      <label><span class="label">Daily budget, all accounts (USD)</span><input type="number" name="dailyBudgetUsd" min="1" max="10000" step="1" value={limits.dailyBudgetUsd} class="field" /></label>
      <label><span class="label">Longest answer (tokens)</span><input type="number" name="maxAnswerTokens" min="1000" max="16000" step="500" value={limits.maxAnswerTokens} class="field" /></label>
      <label class="flex items-center gap-2 text-sm text-white/70 sm:col-span-2 lg:col-span-3"><input type="checkbox" name="precheck" checked={limits.precheck} class="size-4 accent-lk-blue" /> Screen out clearly off-topic questions with Claude Haiku 5.5 before the knowledge base is sent (costs a fraction of a cent)</label>
      <button name="intent" value="limits" class="btn-primary !py-2">Save limits</button>
    </form>
    <p class="mt-3 text-xs text-white/40">
      Defaults: {DEFAULT_LIMITS.perHour}/hour, {DEFAULT_LIMITS.perDay}/day, {usd.format(DEFAULT_LIMITS.dailyBudgetUsd)} a day, {DEFAULT_LIMITS.maxAnswerTokens.toLocaleString()} tokens.
      When the budget is reached, Ask shows matching passages until midnight (Sydney) and admins get an alert. An account that reaches its daily limit two days in a row is paused automatically.
    </p>
    <p class="mt-2 rounded-xl border border-lk-orange/30 bg-lk-orange/10 px-3 py-2 text-xs text-white/80">
      <strong>Hard stop:</strong> also set a monthly spend limit for this API key’s workspace in the Anthropic Console (your organisation’s limits settings), with email alerts. It applies even if something in the portal goes wrong.
    </p>

    <h3 class="mt-6 font-bold">Paused accounts</h3>
    {(pauses ?? []).length ? (
      <ul class="mt-2 divide-y divide-white/5 text-sm">
        {(pauses ?? []).map((p) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-2.5">
            <span><span class="text-white">{(p.profiles as unknown as { email: string } | null)?.email}</span> <span class="text-white/45">· {p.reason} · {dateTime.format(new Date(p.paused_at))}{p.paused_by ? '' : ' · automatic'}</span></span>
            <form method="post"><input type="hidden" name="user_id" value={p.user_id} /><button name="intent" value="restore" class="text-lk-blue hover:underline">Restore access</button></form>
          </li>
        ))}
      </ul>
    ) : <p class="mt-2 text-sm text-white/45">No accounts are paused.</p>}
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer text-white/55">Pause an account by hand</summary>
      <form method="post" class="mt-2 flex flex-wrap gap-2">
        <input name="email" type="email" placeholder="Email" class="field !w-auto !py-2" />
        <input name="reason" placeholder="Reason (optional)" class="field !w-auto !py-2" />
        <button name="intent" value="pause" class="btn-ghost !py-2">Pause</button>
      </form>
    </details>
  </section>
  )}

  {scope.isGroupAdmin && (
    <section class="card mb-6">
      <h2 class="text-lg font-bold">How Ask answers</h2>
      <p class="mt-1 text-sm text-white/55">Full documents: every question carries the whole knowledge base (cached for an hour; about US$1.57 for the first question after a quiet hour, then about US$0.06). Best-matching passages: the facts sheet, approved answers and only the passages that best match the question (about US$0.08 every time). Passages are found on this server; no document text goes to another provider for that.</p>
      <form method="post" class="mt-4 flex flex-wrap items-end gap-4">
        <label class="flex items-center gap-2 text-sm text-white/80"><input type="radio" name="mode" value="full" checked={!retrieval.enabled} class="accent-lk-blue" /> Full documents</label>
        <label class="flex items-center gap-2 text-sm text-white/80"><input type="radio" name="mode" value="retrieval" checked={retrieval.enabled} class="accent-lk-blue" /> Best-matching passages</label>
        <div><label class="label" for="passages">Passages per question</label><input class="field w-24" id="passages" name="passages" type="number" min="10" max="80" value={retrieval.passages} /></div>
        <button name="intent" value="retrieval" class="btn-ghost">Save</button>
        <button name="intent" value="reindex" class="btn-ghost">Rebuild search index</button>
      </form>
      <p class="mt-3 text-xs text-white/40">{unindexed ? `${unindexed} document passages are waiting to be indexed (done automatically on the next question).` : 'All document passages are indexed.'}</p>
    </section>
  )}

  <section class="card mb-6">
    <h2 class="text-lg font-bold">House rules</h2>
    <p class="mt-1 text-sm text-white/55">Guidance in plain English, e.g. “Always mention that F class shares are non-voting.” They are added after the core rules, which always win.</p>
    <form method="post" class="mt-4 space-y-3">
      <textarea name="house_rules" rows="6" maxlength={HOUSE_RULES_MAX} class="field font-mono text-sm" placeholder="- Use “Lakeba Group”, not “Lakeba”.&#10;- For questions about selling shares, mention the secondary trading windows.">{rules}</textarea>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <details class="text-sm text-white/55">
          <summary class="cursor-pointer">Core rules (locked)</summary>
          <pre class="mt-2 max-h-72 overflow-auto whitespace-pre-wrap rounded-xl bg-white/[0.03] p-3 text-xs text-white/60">{coreRules(company)}</pre>
        </details>
        <button name="intent" value="house-rules" class="btn-primary !py-2">Save house rules</button>
      </div>
    </form>
  </section>

  <section>
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <h2 class="mr-2 text-lg font-bold">Approved answers</h2>
      {tabs.map((t) => <a href={`?view=${t.id}`} class:list={['rounded-full border px-3 py-1.5 text-sm', view === t.id ? 'border-lk-blue bg-lk-blue/15 text-white' : 'border-white/10 text-white/60 hover:text-white']}>{t.label}</a>)}
    </div>

    <details class="card mb-4 !p-5">
      <summary class="cursor-pointer font-semibold text-lk-blue">+ Add an approved answer</summary>
      <form method="post" class="mt-4 space-y-3">
        <input name="question" maxlength="1000" placeholder="Question, as a shareholder would ask it" class="field" />
        <textarea name="answer" rows="5" maxlength="8000" placeholder="The approved answer (Markdown allowed). Include the date or period of any figures." class="field"></textarea>
        <div class="flex flex-wrap items-end gap-3">
          <label class="text-sm"><span class="label">Review by</span><input type="date" name="review_by" value={plusMonths(6)} class="field" /></label>
          <button name="intent" value="add" class="btn-primary !py-2">Add</button>
        </div>
      </form>
    </details>

    {answers?.length ? (
      <ol class="space-y-3">
        {answers.map((a) => (
          <li class="card !p-5">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              {!a.active ? <span class="rounded-full bg-white/10 px-2 py-0.5 text-white/60">switched off</span>
                : expired(a.review_by) ? <span class="rounded-full bg-lk-red/15 px-2 py-0.5 text-lk-red">expired — not used until checked</span>
                : a.review_by <= soon ? <span class="rounded-full bg-lk-orange/15 px-2 py-0.5 text-lk-orange">review soon</span>
                : <span class="rounded-full bg-lk-green/15 px-2 py-0.5 text-lk-green">live</span>}
              <span class="text-white/45">Review by {shortDate.format(new Date(a.review_by))} · updated {dateTime.format(new Date(a.updated_at))}</span>
              {a.source_exchange_id && <a href="/admin/ask-review?view=reviewed" class="text-white/45 hover:text-white">from Ask review</a>}
            </div>
            <p class="mt-3 font-semibold text-white">{a.question}</p>
            <div class="mt-2 rounded-2xl bg-white/[0.03] p-4 text-sm"><Markdown source={a.answer} /></div>
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer text-lk-blue">Edit</summary>
              <form method="post" class="mt-3 space-y-3">
                <input type="hidden" name="id" value={a.id} />
                <input name="question" value={a.question} maxlength="1000" class="field" />
                <textarea name="answer" rows="5" maxlength="8000" class="field">{a.answer}</textarea>
                <div class="flex flex-wrap items-end gap-3">
                  <label><span class="label">Review by</span><input type="date" name="review_by" value={a.review_by} class="field !py-2" /></label>
                  <button name="intent" value="save" class="btn-primary !py-2">Save</button>
                </div>
              </form>
            </details>
            <form method="post" class="mt-3 flex flex-wrap gap-3 text-sm">
              <input type="hidden" name="id" value={a.id} />
              <button name="intent" value="extend" class="text-lk-blue hover:underline">Still correct — extend 6 months</button>
              <button name="intent" value="test" class="text-white/55 hover:text-white">🧪 Add to test set</button>
              {a.active ? <button name="intent" value="deactivate" class="text-white/55 hover:text-white">Switch off</button> : <button name="intent" value="activate" class="text-white/55 hover:text-white">Switch on</button>}
              <button name="intent" value="delete" class="text-white/45 hover:text-lk-red" onclick="return confirm('Delete this approved answer?')">Delete</button>
            </form>
          </li>
        ))}
      </ol>
    ) : (
      <Empty title="No approved answers here">Mark answers ✅ Good or save a correction in Ask review, or add one above.</Empty>
    )}
  </section>
</Admin>
