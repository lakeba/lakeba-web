---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import { serviceClient } from '../../lib/admin';
import { adminScope, formCompany, withCompany } from '../../lib/admin-company';
import { DEFAULT_NDA, inviteGuest, newGuestToken } from '../../lib/data-rooms';
import { field } from '../../lib/forms';
import { dateTime, shortDate } from '../../lib/format';

// Data rooms for prospective investors (see the data_rooms migration). All
// reads and writes use the service key, limited to the companies this admin manages.
const svc = serviceClient();
const scope = await adminScope(Astro.locals, Astro.url, true);
const userId = Astro.locals.user!.id;
let notice = '';
let error = '';
let inviteLink = '';

/** A room this admin may manage, or null. */
async function myRoom(id: string) {
  if (!id) return null;
  const { data } = await svc.from('data_rooms').select('id, entity_id, name, description, nda_text, closed_at, created_at').eq('id', id).maybeSingle();
  return data && scope.companies.some((c) => c.id === data.entity_id) ? data : null;
}
const log = (action: string, detail: Record<string, unknown>) => Astro.locals.supabase.rpc('log_event', { event_action: action, event_detail: detail });
/** Only Admins (the group's, or this company's) may delete a room. */
const isAdminFor = (entityId: string) => Astro.locals.access.groupAdmin
  || (Astro.locals.access.roles.some((r) => r.role_key === 'admin' && r.entity_id === entityId) && Astro.locals.access.can('documents.do', entityId));

/**
 * The room's TEST link for its admins: a test guest in the signed-in admin's name.
 * Each time it's opened it gets a new token and asks for the terms again, so the
 * room can be checked exactly as a guest sees it. No email is sent.
 */
async function testLink(room: { id: string }) {
  const { token, tokenHash } = newGuestToken();
  const { data: me } = await svc.from('profiles').select('first_name, last_name, email').eq('id', userId).single();
  const guest = { name: `${me?.first_name ?? ''} ${me?.last_name ?? ''}`.trim() || 'Test', email: me?.email ?? Astro.locals.user!.email ?? '', organisation: '', token_hash: tokenHash, expires_at: new Date(Date.now() + 30 * 86_400_000).toISOString(), nda_accepted_at: null, nda_accepted_ip: null, revoked_at: null };
  const { data: existing } = await svc.from('data_room_guests').select('id').eq('room_id', room.id).eq('is_test', true).maybeSingle();
  if (existing) await svc.from('data_room_guests').update(guest).eq('id', existing.id).throwOnError();
  else await svc.from('data_room_guests').insert({ ...guest, room_id: room.id, is_test: true, invited_by: userId }).throwOnError();
  return `/room/${token}`;
}

const invite = (room: { id: string; entity_id: string; name: string }, guest: { name: string; email: string; organisation: string }, days: number) =>
  inviteGuest(svc, { room, company: scope.companies.find((c) => c.id === room.entity_id) ?? null, guest, days, origin: Astro.url.origin, invitedBy: userId, log });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  if (intent === 'create') {
    const company = formCompany(scope, field(form, 'entity_id'));
    const name = field(form, 'name');
    if (!company) error = 'Choose a company.';
    else if (name.length < 2) error = 'Give the room a name.';
    else {
      const { data: room, error: e } = await svc.from('data_rooms').insert({ entity_id: company.id, name, description: field(form, 'description'), nda_text: field(form, 'nda_text') || DEFAULT_NDA, created_by: userId }).select('id').single();
      if (e || !room) error = e?.message ?? 'Could not create the room.';
      else {
        await testLink(room);
        await log('data_room_created', { room_id: room.id, entity_id: company.id });
        return Astro.redirect(withCompany(scope, `/admin/data-rooms?room=${room.id}&created=1`), 303);
      }
    }
  } else {
    const room = await myRoom(field(form, 'room_id'));
    if (!room) error = 'That data room was not found.';
    else if (intent === 'test') {
      if (room.closed_at) error = 'Reopen the room first.';
      else return Astro.redirect(await testLink(room), 303);
    } else if (intent === 'delete') {
      if (!room.closed_at) error = 'Close the room before deleting it.';
      else if (!isAdminFor(room.entity_id)) error = 'Only Admins can delete a data room.';
      else {
        await svc.from('data_rooms').delete().eq('id', room.id).throwOnError();
        await log('data_room_deleted', { room_id: room.id, entity_id: room.entity_id, name: room.name });
        return Astro.redirect(withCompany(scope, `/admin/data-rooms?deleted=${encodeURIComponent(room.name)}`), 303);
      }
    } else if (intent === 'save') {
      await svc.from('data_rooms').update({ name: field(form, 'name') || room.name, description: field(form, 'description'), nda_text: field(form, 'nda_text') || DEFAULT_NDA }).eq('id', room.id).throwOnError();
      notice = 'Saved. Guests who already agreed are not asked again.';
    } else if (intent === 'documents') {
      const wanted = form.getAll('document_id').map(String);
      // Only this company's PDFs that aren't personal to one holder.
      const { data: allowed } = await svc.from('documents').select('id').eq('entity_id', room.entity_id).eq('mime_type', 'application/pdf').neq('audience', 'holder');
      const ok = new Set((allowed ?? []).map((d) => d.id));
      const ids = wanted.filter((id) => ok.has(id));
      await svc.from('data_room_documents').delete().eq('room_id', room.id).throwOnError();
      if (ids.length) await svc.from('data_room_documents').insert(ids.map((document_id, sort) => ({ room_id: room.id, document_id, sort }))).throwOnError();
      await log('data_room_documents_set', { room_id: room.id, count: ids.length });
      notice = `The room now has ${ids.length} document${ids.length === 1 ? '' : 's'}.`;
    } else if (intent === 'invite') {
      const email = field(form, 'email').toLowerCase();
      const name = field(form, 'name');
      const days = Math.min(180, Math.max(1, Number(field(form, 'days')) || 30));
      if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) error = 'Enter the guest’s name and email.';
      else if (room.closed_at) error = 'Reopen the room first.';
      else {
        const r = await invite(room, { name, email, organisation: field(form, 'organisation') }, days);
        if (r.error) error = r.error; else { notice = `Invitation sent to ${email}.`; inviteLink = r.link!; }
      }
    } else if (intent === 'resend' || intent === 'revoke') {
      const { data: g } = await svc.from('data_room_guests').select('id, name, email, organisation, expires_at').eq('id', field(form, 'guest_id')).eq('room_id', room.id).eq('is_test', false).maybeSingle();
      if (!g) error = 'Guest not found.';
      else {
        // Either way the old link stops working.
        await svc.from('data_room_guests').update({ revoked_at: new Date().toISOString() }).eq('id', g.id).throwOnError();
        await log('data_room_guest_revoked', { room_id: room.id, guest_id: g.id, email: g.email, resent: intent === 'resend' });
        if (intent === 'resend') {
          const r = await invite(room, { name: g.name, email: g.email, organisation: g.organisation }, 30);
          if (r.error) error = r.error; else { notice = `A new link was sent to ${g.email}; the old one no longer works.`; inviteLink = r.link!; }
        } else notice = `${g.email} can no longer open the room.`;
      }
    } else if (intent === 'close' || intent === 'reopen') {
      await svc.from('data_rooms').update({ closed_at: intent === 'close' ? new Date().toISOString() : null }).eq('id', room.id).throwOnError();
      await log(`data_room_${intent === 'close' ? 'closed' : 'reopened'}`, { room_id: room.id });
      notice = intent === 'close' ? 'Room closed: no guest can open it.' : 'Room reopened.';
    }
  }
}

const { data: rooms } = await svc.from('data_rooms').select('id, entity_id, name, closed_at, created_at, data_room_guests(id, revoked_at, is_test), data_room_documents(document_id)').in('entity_id', scope.ids.length ? scope.ids : ['00000000-0000-0000-0000-000000000000']).order('created_at', { ascending: false });
const current = await myRoom(Astro.url.searchParams.get('room') ?? '');
const companyOf = (id: string) => scope.companies.find((c) => c.id === id);

let candidates: { id: string; title: string; category: string; published_at: string | null }[] = [];
let chosen = new Set<string>();
let guests: { id: string; name: string; email: string; organisation: string; expires_at: string; nda_accepted_at: string | null; revoked_at: string | null; last_seen_at: string | null; created_at: string; is_test: boolean }[] = [];
let views: { guest_id: string; document_id: string | null; viewed_at: string }[] = [];
if (current) {
  const [{ data: docs }, { data: inRoom }, { data: g }] = await Promise.all([
    svc.from('documents').select('id, title, category, published_at').eq('entity_id', current.entity_id).eq('mime_type', 'application/pdf').neq('audience', 'holder').order('created_at', { ascending: false }),
    svc.from('data_room_documents').select('document_id').eq('room_id', current.id),
    svc.from('data_room_guests').select('id, name, email, organisation, expires_at, nda_accepted_at, revoked_at, last_seen_at, created_at, is_test').eq('room_id', current.id).order('is_test', { ascending: false }).order('created_at', { ascending: false }),
  ]);
  candidates = docs ?? [];
  chosen = new Set((inRoom ?? []).map((d) => d.document_id));
  guests = g ?? [];
  if (guests.length) views = (await svc.from('data_room_views').select('guest_id, document_id, viewed_at').in('guest_id', guests.map((x) => x.id)).order('viewed_at', { ascending: false }).limit(500)).data ?? [];
}
const titleOf = new Map(candidates.map((d) => [d.id, d.title]));
const viewsBy = Map.groupBy(views, (v) => v.guest_id);
const status = (g: (typeof guests)[number]) => g.is_test ? (g.nda_accepted_at ? 'Opened' : 'Not opened yet') : g.revoked_at ? 'Revoked' : new Date(g.expires_at) < new Date() ? 'Expired' : g.nda_accepted_at ? 'Agreed' : 'Invited';
---

<Admin filter={{ scope }} title="Data rooms">
  <PageHeader title="Data rooms" subtitle="Share chosen PDFs with prospective investors. Guests agree to confidentiality terms, every page is marked with their name, and each view is recorded." />
  {notice && <div class="mb-4"><Alert tone="success">{notice}</Alert></div>}
  {error && <div class="mb-4"><Alert tone="error">{error}</Alert></div>}
  {Astro.url.searchParams.get('deleted') && <div class="mb-4"><Alert tone="success">Deleted the data room “{Astro.url.searchParams.get('deleted')}”.</Alert></div>}
  {current && Astro.url.searchParams.get('created') && !notice && !error && <div class="mb-4"><Alert tone="success">Room created. Add its documents, then use the TEST link to check it as a guest will see it before you invite anyone.</Alert></div>}
  {inviteLink && <div class="mb-4"><Alert>Their personal link (only share it with them): <span class="break-all font-mono text-xs">{inviteLink}</span></Alert></div>}

  {!current ? (
    <>
      <section class="card overflow-hidden p-0">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40"><tr><th class="px-5 py-3 font-medium">Room</th><th class="px-5 py-3 font-medium">Company</th><th class="px-5 py-3 text-right font-medium">Documents</th><th class="px-5 py-3 text-right font-medium">Guests</th><th class="px-5 py-3 font-medium">Created</th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {(rooms ?? []).map((r) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="px-5 py-3"><a class="font-medium text-white hover:underline" href={withCompany(scope, `/admin/data-rooms?room=${r.id}`)}>{r.name}</a>{r.closed_at && <span class="ml-2 rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/55">Closed</span>}</td>
                <td class="px-5 py-3 text-white/60">{companyOf(r.entity_id)?.display_name}</td>
                <td class="px-5 py-3 text-right tabular-nums text-white/75">{(r.data_room_documents as unknown[]).length}</td>
                <td class="px-5 py-3 text-right tabular-nums text-white/75">{(r.data_room_guests as { revoked_at: string | null; is_test: boolean }[]).filter((g) => !g.revoked_at && !g.is_test).length}</td>
                <td class="px-5 py-3 text-white/50">{shortDate.format(new Date(r.created_at))}</td>
              </tr>
            ))}
            {!rooms?.length && <tr><td colspan="5" class="px-5 py-6 text-center text-white/45">No data rooms yet.</td></tr>}
          </tbody>
        </table>
      </section>
      <details class="card mt-6" open={!rooms?.length || Boolean(error)}>
        <summary class="cursor-pointer font-display text-lg font-bold text-white">New data room</summary>
        <form method="post" class="mt-6 grid gap-4 sm:grid-cols-2">
          <input type="hidden" name="intent" value="create" />
          <div><label class="label" for="entity_id">Company</label><select id="entity_id" name="entity_id" class="field">{scope.companies.map((c) => <option value={c.id} selected={c.id === scope.defaultCompany?.id}>{c.display_name}</option>)}</select></div>
          <div><label class="label" for="name">Name</label><input id="name" name="name" required class="field" placeholder="Series A – 2026" /></div>
          <div class="sm:col-span-2"><label class="label" for="description">Note for guests (optional)</label><textarea id="description" name="description" rows="2" class="field"></textarea></div>
          <div class="sm:col-span-2"><label class="label" for="nda_text">Confidentiality terms</label><textarea id="nda_text" name="nda_text" rows="8" class="field text-sm">{DEFAULT_NDA}</textarea><p class="mt-1 text-xs text-white/40">A plain-English starting point: have your lawyer check it before you use it.</p></div>
          <div class="sm:col-span-2"><button class="btn-primary">Create room</button></div>
        </form>
      </details>
    </>
  ) : (
    <>
      <p class="mb-4 text-sm"><a class="text-lk-blue hover:underline" href={withCompany(scope, '/admin/data-rooms')}>← All data rooms</a></p>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-2xl font-bold">{current.name} <span class="text-base font-normal text-white/45">· {companyOf(current.entity_id)?.display_name}</span></h2>
        <div class="flex flex-wrap gap-2">
          {!current.closed_at && <form method="post" target="_blank"><input type="hidden" name="room_id" value={current.id} /><button name="intent" value="test" class="btn-ghost px-3 py-2 text-xs" title="Opens the room as a guest sees it, in your name. No email is sent.">Open TEST link</button></form>}
          <form method="post"><input type="hidden" name="room_id" value={current.id} /><button name="intent" value={current.closed_at ? 'reopen' : 'close'} class="btn-ghost px-3 py-2 text-xs">{current.closed_at ? 'Reopen room' : 'Close room'}</button></form>
          {current.closed_at && isAdminFor(current.entity_id) && <form method="post" onsubmit="return confirm('Delete this data room, its guest list and its record of views? The documents themselves stay in Documents. This can’t be undone.')"><input type="hidden" name="room_id" value={current.id} /><button name="intent" value="delete" class="btn-ghost px-3 py-2 text-xs text-lk-red">Delete room</button></form>}
        </div>
      </div>
      {current.closed_at && <div class="mb-4"><Alert>Closed {shortDate.format(new Date(current.closed_at))}: guests can't open it.{isAdminFor(current.entity_id) ? ' You can delete it.' : ' Admins can delete it.'}</Alert></div>}

      <div class="grid gap-6 xl:grid-cols-2">
        <section class="card">
          <h3 class="text-lg font-bold">Guests</h3>
          <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
            <input type="hidden" name="intent" value="invite" /><input type="hidden" name="room_id" value={current.id} />
            <div><label class="label" for="g_name">Name</label><input id="g_name" name="name" required class="field" /></div>
            <div><label class="label" for="g_email">Email</label><input id="g_email" name="email" type="email" required class="field" /></div>
            <div><label class="label" for="g_org">Organisation (optional)</label><input id="g_org" name="organisation" class="field" /></div>
            <div><label class="label" for="g_days">Access for (days)</label><input id="g_days" name="days" type="number" min="1" max="180" value="30" class="field" /></div>
            <div class="sm:col-span-2"><button class="btn-primary">Invite guest</button></div>
          </form>
          <ul class="mt-6 divide-y divide-white/5">
            {guests.map((g) => {
              const vs = viewsBy.get(g.id) ?? [];
              const st = status(g);
              return (
                <li class="py-3 text-sm">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <p class="font-medium text-white">{g.is_test && <span class="mr-2 rounded-full bg-lk-orange/15 px-2 py-0.5 text-[11px] font-semibold text-lk-orange">TEST</span>}{g.name}{!g.is_test && g.organisation && <span class="font-normal text-white/50"> · {g.organisation}</span>}</p>
                      <p class="text-xs text-white/45">{g.is_test ? (current.closed_at ? 'The admins’ TEST link (reopen the room to use it). Not counted as a guest; no email is sent.' : 'The admins’ TEST link: the “Open TEST link” button above. Not counted as a guest; no email is sent.') : <>{g.email} · invited {shortDate.format(new Date(g.created_at))} · until {shortDate.format(new Date(g.expires_at))}</>}</p>
                      <p class="mt-1 text-xs text-white/55"><span class:list={['rounded-full px-2 py-0.5', st === 'Agreed' || st === 'Opened' ? 'bg-lk-green/15 text-lk-green' : st === 'Invited' || st === 'Not opened yet' ? 'bg-white/10 text-white/60' : 'bg-lk-red/15 text-lk-red']}>{st}</span>
                        {g.nda_accepted_at && ` agreed ${dateTime.format(new Date(g.nda_accepted_at))}`}{g.last_seen_at && ` · last seen ${dateTime.format(new Date(g.last_seen_at))}`} · {vs.length} view{vs.length === 1 ? '' : 's'}</p>
                    </div>
                    {!g.revoked_at && !g.is_test && (
                      <form method="post" class="flex gap-2"><input type="hidden" name="room_id" value={current.id} /><input type="hidden" name="guest_id" value={g.id} />
                        <button name="intent" value="resend" class="btn-ghost px-3 py-1.5 text-xs">New link</button>
                        <button name="intent" value="revoke" class="btn-ghost px-3 py-1.5 text-xs text-lk-red">Revoke</button>
                      </form>
                    )}
                  </div>
                  {vs.length > 0 && (
                    <details class="mt-2"><summary class="cursor-pointer text-xs text-white/45">Views</summary>
                      <ul class="mt-1 space-y-0.5 text-xs text-white/55">{vs.slice(0, 30).map((v) => <li>{dateTime.format(new Date(v.viewed_at))} · {(v.document_id && titleOf.get(v.document_id)) ?? 'Removed document'}</li>)}</ul>
                    </details>
                  )}
                </li>
              );
            })}
            {!guests.some((g) => !g.is_test) && <li class="py-4 text-sm text-white/45">No guests yet.</li>}
          </ul>
        </section>

        <section class="card">
          <h3 class="text-lg font-bold">Documents</h3>
          <p class="mt-1 text-sm text-white/55">PDFs of {companyOf(current.entity_id)?.display_name} (not personal ones). Upload new ones in <a class="text-lk-blue hover:underline" href={withCompany(scope, '/admin/documents')}>Documents</a>; they don't need to be published to investors.</p>
          <form method="post" class="mt-4">
            <input type="hidden" name="intent" value="documents" /><input type="hidden" name="room_id" value={current.id} />
            <ul class="max-h-96 divide-y divide-white/5 overflow-y-auto rounded-xl border border-white/10">
              {candidates.map((d) => (
                <li><label class="flex items-center gap-3 px-4 py-2 text-sm"><input type="checkbox" name="document_id" value={d.id} checked={chosen.has(d.id)} class="size-4 accent-lk-blue" /><span class="flex-1 text-white/85">{d.title}</span><span class="text-xs text-white/40">{d.published_at ? shortDate.format(new Date(d.published_at)) : 'Not published'}</span></label></li>
              ))}
              {!candidates.length && <li class="px-4 py-6 text-center text-sm text-white/45">No PDFs for this company yet.</li>}
            </ul>
            <button class="btn-primary mt-4">Save documents</button>
          </form>
        </section>
      </div>

      <details class="card mt-6">
        <summary class="cursor-pointer font-display text-lg font-bold text-white">Room details and confidentiality terms</summary>
        <form method="post" class="mt-6 grid gap-4">
          <input type="hidden" name="intent" value="save" /><input type="hidden" name="room_id" value={current.id} />
          <div><label class="label" for="r_name">Name</label><input id="r_name" name="name" value={current.name} class="field" /></div>
          <div><label class="label" for="r_desc">Note for guests</label><textarea id="r_desc" name="description" rows="2" class="field">{current.description}</textarea></div>
          <div><label class="label" for="r_nda">Confidentiality terms</label><textarea id="r_nda" name="nda_text" rows="8" class="field text-sm">{current.nda_text}</textarea></div>
          <div><button class="btn-primary">Save</button></div>
        </form>
      </details>
    </>
  )}
</Admin>
