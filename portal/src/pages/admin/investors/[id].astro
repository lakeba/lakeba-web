---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import { serviceClient } from '../../../lib/admin';
import { sendPasswordReset } from '../../../lib/admin-auth';
import { field } from '../../../lib/forms';
import { displayName } from '../../../lib/admin-forms';
import { aud, audPrecise, dateTime, holderKinds, percent, shares, shortDate } from '../../../lib/format';
import { latestPrices, loadHolderPositions, sourceLabels } from '../../../lib/holdings';
import type { Passkey } from '../../../lib/passkeys';
import { notifyAdmins, notifyMembers, notifySecurity } from '../../../lib/notify';

const { id } = Astro.params;
const supabase = Astro.locals.supabase;
const svc = serviceClient();
const self = Astro.locals.user?.id === id;
let error = '';
let notice = '';
let shareLink = '';

const { data: target } = await supabase.from('profiles').select('id, email, first_name, last_name, role, phone').eq('id', id!).single();
if (!target) return new Response('Not found', { status: 404 });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const log = (action: string, detail: Record<string, unknown> = {}) =>
    supabase.rpc('log_event', { event_action: action, event_detail: { user_id: id, email: target.email, ...detail } });

  if (self && ['disable', 'reset-mfa', 'delete-user'].includes(intent)) {
    error = 'You cannot change your own access or two-step verification here.';
  } else if (intent === 'link') {
    const { error: linkError } = await supabase.from('holder_members').upsert({ holder_id: field(form, 'holder_id'), user_id: id, access: field(form, 'access') === 'viewer' ? 'viewer' : 'owner' });
    if (linkError) error = linkError.message;
    else { await log('admin_linked_holder', { holder_id: field(form, 'holder_id') }); notice = 'Holder linked.'; }
  } else if (intent === 'unlink') {
    await supabase.from('holder_members').delete().eq('user_id', id!).eq('holder_id', field(form, 'holder_id')).throwOnError();
    await log('admin_unlinked_holder', { holder_id: field(form, 'holder_id') });
    notice = 'Holder unlinked.';
  } else if (intent === 'disable' || intent === 'enable') {
    const { error: banError } = await svc.auth.admin.updateUserById(id!, { ban_duration: intent === 'disable' ? '876000h' : 'none' });
    if (banError) error = banError.message;
    else { await log(intent === 'disable' ? 'admin_disabled_user' : 'admin_enabled_user'); notice = intent === 'disable' ? 'Access disabled.' : 'Access restored.'; }
  } else if (intent === 'remove-passkey') {
    // For a lost or replaced device; the person can still sign in with their password.
    const { error: e } = await svc.auth.admin.passkey.deletePasskey({ userId: id!, passkeyId: field(form, 'passkeyId') });
    if (e) error = e.message;
    else {
      await log('admin_removed_passkey', { passkey_id: field(form, 'passkeyId') });
      await notifySecurity({ userId: id!, origin: Astro.url.origin, title: 'A passkey was removed from your account', body: 'A Lakeba administrator removed one of your passkeys. You can still sign in with your password, and add a new passkey under Profile → Security.' });
      notice = 'Passkey removed.';
    }
  } else if (intent === 'reset-mfa') {
    const { data } = await svc.auth.admin.mfa.listFactors({ userId: id! });
    for (const f of data?.factors ?? []) await svc.auth.admin.mfa.deleteFactor({ userId: id!, id: f.id });
    await log('admin_reset_mfa');
    await notifySecurity({ userId: id!, origin: Astro.url.origin, title: 'Two-step verification was reset on your account', body: 'A Lakeba administrator reset two-step verification on your account. Set it up again under Profile → Security. If you didn’t ask for this, contact info@lakeba.com.' });
    await notifyAdmins({ kind: 'admin_security', origin: Astro.url.origin, link: `/admin/investors/${id}`, title: `Two-step verification reset for ${target?.email ?? 'an account'}`, body: `${Astro.locals.user!.email} reset two-step verification for ${target?.email ?? 'an account'}.` });
    notice = 'Two-step verification removed. They can set it up again after signing in.';
  } else if (intent === 'ask-off' || intent === 'ask-on') {
    // Same switch as the automatic pause in Ask's cost protection.
    const { error: e } = intent === 'ask-off'
      ? await supabase.from('ask_user_pauses').upsert({ user_id: id, reason: 'Turned off by an admin', paused_by: Astro.locals.user!.id })
      : await supabase.from('ask_user_pauses').delete().eq('user_id', id!);
    if (e) error = e.message; else { await log(intent === 'ask-off' ? 'admin_disabled_ask' : 'admin_enabled_ask'); notice = intent === 'ask-off' ? 'Ask turned off for this person.' : 'Ask turned on for this person.'; }
  } else if (intent === 'board-off' || intent === 'board-on') {
    // Profiles' columns are locked for signed-in users (people may only edit their name and phone),
    // so, like role changes, this goes through the service key; this page is for group admins only.
    const { error: e } = await svc.from('profiles').update({ board_qa_enabled: intent === 'board-on' }).eq('id', id!);
    if (e) error = e.message; else { await log(intent === 'board-off' ? 'admin_disabled_board_qa' : 'admin_enabled_board_qa'); notice = intent === 'board-off' ? '“Ask the board” turned off for this person.' : '“Ask the board” turned on for this person.'; }
  } else if (intent === 'note') {
    const note = String(form.get('note') ?? '').trim();
    const key = { holder_id: field(form, 'holder_id'), share_class_id: field(form, 'class_id') };
    if (note.length > 1000) error = 'Notes can be at most 1,000 characters.';
    else {
      const { error: e } = note
        ? await supabase.from('holding_notes').upsert({ ...key, note, updated_by: Astro.locals.user!.id, updated_at: new Date().toISOString() })
        : await supabase.from('holding_notes').delete().match(key);
      if (e) error = e.message;
      else {
        await log(note ? 'admin_saved_holding_note' : 'admin_removed_holding_note', key);
        notice = note ? 'Note saved. It shows next to the shares, for the shareholder too.' : 'Note removed.';
        if (note) {
          const [{ data: people }, { data: cls }] = await Promise.all([svc.from('holder_members').select('user_id').eq('holder_id', key.holder_id), svc.from('share_classes').select('entity_id').eq('id', key.share_class_id).single()]);
          if (people?.length) await notifyMembers({ kind: 'holding_note', userIds: people.map((p) => p.user_id), entityId: cls?.entity_id, title: 'A note was added to one of your holdings', body: 'There’s a new note next to one of your holdings. Open your dashboard to read it.', link: '/', origin: Astro.url.origin });
        }
      }
    }
  } else if (intent === 'delete-user') {
    // Only people with no holdings: anyone tied to the share register stays.
    const { data: memberLinks } = await svc.from('holder_members').select('holder_id').eq('user_id', id!);
    const holderIds = (memberLinks ?? []).map((m) => m.holder_id);
    const { count: holdingRows } = holderIds.length ? await svc.from('holdings').select('id', { count: 'exact', head: true }).in('holder_id', holderIds) : { count: 0 };
    const { count: votes } = await svc.from('proxy_votes').select('resolution_id', { count: 'exact', head: true }).eq('lodged_by', id!);
    if (holdingRows) error = 'This person is linked to holdings, so they can’t be deleted. Unlink the holders first if that’s really intended.';
    else if (votes) error = 'This person has lodged proxy votes, which are kept as meeting records, so they can’t be deleted. Disable their access instead.';
    else if (field(form, 'confirm_email').toLowerCase() !== target.email.toLowerCase()) error = 'Type the person’s email address to confirm.';
    else {
      await log('admin_deleted_user', { role: target.role, name: displayName(target) });
      const { error: delError } = await svc.auth.admin.deleteUser(id!);
      if (delError) error = delError.message;
      else return Astro.redirect(`/admin/investors?deleted=${encodeURIComponent(target.email)}`, 303);
    }
  } else if (intent === 'reset-password') {
    const { error: resetError, url: resetUrl } = await sendPasswordReset(target.email, Astro.url.origin);
    if (resetError) error = resetError;
    else { await log('admin_sent_password_reset'); notice = `Password reset email sent to ${target.email}.`; shareLink = resetUrl ?? ''; }
  }
}

const [{ data: profile }, { data: authData }, { data: factorData }, { data: links }, { data: holders }, { data: events }, { data: askPause }, { data: passkeyData }] = await Promise.all([
  supabase.from('profiles').select('id, email, first_name, last_name, role, phone, board_qa_enabled').eq('id', id!).single(),
  svc.auth.admin.getUserById(id!),
  svc.auth.admin.mfa.listFactors({ userId: id! }),
  supabase.from('holder_members').select('holder_id, access, holders(name)').eq('user_id', id!),
  supabase.from('holders').select('id, name').order('name'),
  supabase.from('audit_log').select('action, created_at').eq('user_id', id!).order('created_at', { ascending: false }).limit(15),
  supabase.from('ask_user_pauses').select('reason, paused_by, paused_at').eq('user_id', id!).maybeSingle(),
  svc.auth.admin.passkey.listPasskeys({ userId: id! }),
]);
const { count: pushDevices } = await svc.from('push_subscriptions').select('id', { count: 'exact', head: true }).eq('user_id', id!);
const passkeys = (passkeyData ?? []) as Passkey[];
const askOn = !askPause;
// Deleting: only without holdings and proxy votes; their own Board Q&A and AGM questions go with them.
const [{ count: ownQueries }, { count: ownMeetingQuestions }, { count: lodgedVotes }] = await Promise.all([
  svc.from('queries').select('id', { count: 'exact', head: true }).eq('user_id', id!),
  svc.from('meeting_questions').select('id', { count: 'exact', head: true }).eq('user_id', id!),
  svc.from('proxy_votes').select('resolution_id', { count: 'exact', head: true }).eq('lodged_by', id!),
]);
const boardOn = profile?.board_qa_enabled !== false;
const auth = authData?.user;
const banned = Boolean(auth?.banned_until && new Date(auth.banned_until) > new Date());
const mfaOn = (factorData?.factors ?? []).some((f) => f.status === 'verified');
const linked = new Set((links ?? []).map((l) => l.holder_id));
const [positions, prices] = await Promise.all([loadHolderPositions(supabase, [...linked]), latestPrices(supabase)]);
const positionsByHolder = Map.groupBy(positions, (p) => p.holder.id);
const valueOf = (classId: string, n: number) => { const pr = prices.get(classId); return pr ? n * pr.price : null; };
const pricedTotal = positions.reduce((a, p) => a + (valueOf(p.row.share_class_id, p.row.shares) ?? 0), 0);
import ShareLink from '../../../components/ShareLink.astro';
import HoldingNote from '../../../components/HoldingNote.astro';
// Their roles (managed in System → Users).
const { data: roleRows } = await svc.from('user_roles').select('role_key, entity_id, roles(name), entities(display_name)').eq('user_id', id!);
const heldRoles = ((roleRows ?? []) as unknown as { roles: { name: string } | null; entities: { display_name: string } | null }[]).map((r) => `${r.roles?.name ?? ''}${r.entities ? ` (${r.entities.display_name})` : ''}`);
// People who only see the register get this page without its actions.
const readOnly = !Astro.locals.access.groupAdmin;
---

<Admin title={displayName(profile)}>
  {readOnly && <style is:inline>{'[data-investor-page] form[method="post"]{display:none}'}</style>}
  <div data-investor-page>
  <a href="/admin/investors" class="text-sm text-white/50 hover:text-white">← Investors</a>
  <PageHeader title={displayName(profile)} subtitle={`${profile?.email}${profile?.phone ? ` · ${profile.phone}` : ''}`} />
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}
  {shareLink && <ShareLink url={shareLink} label="Password reset link" />}

  <div class="grid gap-4 xl:grid-cols-2">
    <section class="card">
      <h2 class="text-lg font-bold">Account</h2>
      <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
        <div><dt class="text-white/40">Status</dt><dd class:list={[banned ? 'text-lk-red' : 'text-white/80']}>{banned ? 'Disabled' : auth?.last_sign_in_at ? 'Active' : 'Invited'}</dd></div>
        <div><dt class="text-white/40">Two-step</dt><dd class:list={[mfaOn ? 'text-lk-green' : 'text-white/50']}>{mfaOn ? 'On' : 'Off'}</dd></div>
        <div><dt class="text-white/40">Browser notifications</dt><dd class:list={[pushDevices ? 'text-lk-green' : 'text-white/50']}>{pushDevices ? `On (${pushDevices} device${pushDevices === 1 ? '' : 's'})` : 'Off'}</dd></div>
        <div><dt class="text-white/40">Passkeys</dt><dd class:list={[passkeys.length ? 'text-lk-green' : 'text-white/50']}>{passkeys.length || 'None'}</dd></div>
        <div><dt class="text-white/40">Last sign-in</dt><dd class="text-white/80">{auth?.last_sign_in_at ? dateTime.format(new Date(auth.last_sign_in_at)) : '—'}</dd></div>
        <div><dt class="text-white/40">Created</dt><dd class="text-white/80">{auth?.created_at ? dateTime.format(new Date(auth.created_at)) : '—'}</dd></div>
      </dl>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm">
        <span><span class="text-white/45">Roles:</span> {heldRoles.length ? heldRoles.join(', ') : 'none (an investor only)'}</span>
        <a href={`/admin/system/users/${id}`} class="btn-ghost !py-1.5 text-sm">Roles and permissions</a>
      </div>
      <form method="post" class="mt-6 flex flex-wrap gap-3 border-t border-white/5 pt-6">
        <button name="intent" value="reset-password" class="btn-ghost">Send password reset</button>
        {!self && mfaOn && <button name="intent" value="reset-mfa" class="btn-ghost">Reset two-step</button>}
        {!self && (banned
          ? <button name="intent" value="enable" class="btn-ghost">Restore access</button>
          : <button name="intent" value="disable" class="btn-ghost !border-lk-red/40 !text-lk-red">Disable access</button>)}
      </form>
      {passkeys.length > 0 && (
        <div class="mt-6 border-t border-white/5 pt-6">
          <h3 class="text-sm font-semibold text-white">Passkeys</h3>
          <ul class="mt-3 divide-y divide-white/5 text-sm">
            {passkeys.map((pk) => (
              <li class="flex flex-wrap items-center justify-between gap-3 py-2.5">
                <span><span class="text-white/85">{pk.friendly_name || 'Passkey'}</span>
                  <span class="block text-xs text-white/40">Added {shortDate.format(new Date(pk.created_at))}{pk.last_used_at ? ` · last used ${shortDate.format(new Date(pk.last_used_at))}` : ' · not used yet'}</span></span>
                <form method="post"><input type="hidden" name="passkeyId" value={pk.id} /><button name="intent" value="remove-passkey" class="btn-ghost !px-3 !py-1.5 text-xs" onclick="return confirm('Remove this passkey? They can still sign in with their password.')">Remove</button></form>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="mt-6 border-t border-white/5 pt-6">
        <h3 class="text-sm font-semibold text-white">Access to features</h3>
        <ul class="mt-3 divide-y divide-white/5 text-sm">
          <li class="flex flex-wrap items-center justify-between gap-3 py-2.5">
            <span><span class="text-white/85">Ask (AI questions)</span>
              <span class:list={['ml-2 rounded-full px-2 py-0.5 text-[11px]', askOn ? 'bg-lk-green/15 text-lk-green' : 'bg-lk-red/15 text-lk-red']}>{askOn ? 'On' : 'Off'}</span>
              {askPause && <span class="block text-xs text-white/40">{askPause.paused_by ? 'Turned off by an admin' : askPause.reason} · {shortDate.format(new Date(askPause.paused_at))}</span>}</span>
            <form method="post"><button name="intent" value={askOn ? 'ask-off' : 'ask-on'} class="btn-ghost !px-3 !py-1.5 text-xs">{askOn ? 'Turn off' : 'Turn on'}</button></form>
          </li>
          <li class="flex flex-wrap items-center justify-between gap-3 py-2.5">
            <span><span class="text-white/85">Ask the board (Board Q&amp;A)</span>
              <span class:list={['ml-2 rounded-full px-2 py-0.5 text-[11px]', boardOn ? 'bg-lk-green/15 text-lk-green' : 'bg-lk-red/15 text-lk-red']}>{boardOn ? 'On' : 'Off'}</span>
              {!boardOn && <span class="block text-xs text-white/40">Can read past answers; cannot send new questions or replies</span>}</span>
            <form method="post"><button name="intent" value={boardOn ? 'board-off' : 'board-on'} class="btn-ghost !px-3 !py-1.5 text-xs">{boardOn ? 'Turn off' : 'Turn on'}</button></form>
          </li>
        </ul>
      </div>
      {!self && (
        <div class="mt-6 border-t border-white/5 pt-6">
          <h3 class="text-sm font-semibold text-white">Delete user</h3>
          {positions.length ? (
            <p class="mt-2 text-sm text-white/50">Linked to holdings, so this person can’t be deleted. Use “Disable access” instead.</p>
          ) : lodgedVotes ? (
            <p class="mt-2 text-sm text-white/50">Has lodged proxy votes, which are kept as meeting records, so this person can’t be deleted. Use “Disable access” instead.</p>
          ) : (
            <form method="post" class="mt-2 space-y-3" onsubmit="return confirm('Permanently delete this user? This can’t be undone.')">
              <p class="text-sm text-white/55">
                No holdings. Deleting removes the account, its sign-in and two-step, links to holders, notifications and settings{(ownQueries || ownMeetingQuestions) ? <>, <span class="text-lk-orange">and {[ownQueries ? `${ownQueries} Board Q&A question${ownQueries === 1 ? '' : 's'}` : '', ownMeetingQuestions ? `${ownMeetingQuestions} AGM question${ownMeetingQuestions === 1 ? '' : 's'}` : ''].filter(Boolean).join(' and ')}</span></> : ''}. The audit log and anything they uploaded stay, without their name. This can’t be undone.
              </p>
              <div class="flex flex-wrap items-end gap-3">
                <div class="grow"><label class="label" for="confirm_email">Type {target.email} to confirm</label><input class="field" id="confirm_email" name="confirm_email" autocomplete="off" required /></div>
                <button name="intent" value="delete-user" class="btn-ghost !border-lk-red/40 !text-lk-red">Delete user</button>
              </div>
            </form>
          )}
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="text-lg font-bold">Holding entities</h2>
      <ul class="mt-4 divide-y divide-white/5 text-sm">
        {(links ?? []).map((l) => (
          <li class="flex items-center justify-between gap-4 py-3">
            <span><span class="text-white/85">{(l.holders as { name: string } | null)?.name}</span> <span class="text-xs capitalize text-white/40">{l.access}</span>
              <span class="block text-xs text-white/45">{shares.format((positionsByHolder.get(l.holder_id) ?? []).reduce((a, p) => a + p.row.shares, 0))} shares {(positionsByHolder.get(l.holder_id) ?? []).some((p) => p.note) && <HoldingNote note={(positionsByHolder.get(l.holder_id) ?? []).filter((p) => p.note).map((p) => `${p.row.share_classes?.name}: ${p.note}`).join('\n')} />}</span></span>
            <form method="post"><input type="hidden" name="holder_id" value={l.holder_id} /><button name="intent" value="unlink" class="text-xs text-white/50 hover:text-white">Unlink</button></form>
          </li>
        ))}
        {!links?.length && <li class="py-3 text-white/45">Not linked to any holder.</li>}
      </ul>
      <form method="post" class="mt-4 flex flex-wrap items-end gap-3 border-t border-white/5 pt-4">
        <div class="grow"><label class="label" for="holder_id">Holder</label>
          <select class="field" id="holder_id" name="holder_id" required>{(holders ?? []).filter((h) => !linked.has(h.id)).map((h) => <option value={h.id}>{h.name}</option>)}</select></div>
        <div><label class="label" for="access">Access</label>
          <select class="field" id="access" name="access"><option value="owner">Owner</option><option value="viewer">Viewer</option></select></div>
        <button name="intent" value="link" class="btn-ghost">Link</button>
      </form>
    </section>
  </div>

  <section class="card mt-4 overflow-x-auto">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-bold">Holdings</h2>
      {positions.length > 0 && <p class="text-sm text-white/55">Indicative value <span class="font-semibold text-white">{aud.format(pricedTotal)}</span></p>}
    </div>
    {positions.length ? (
      <table class="mt-4 w-full min-w-[880px] text-left text-sm">
        <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40">
          <tr><th class="py-2 pr-4 font-medium">Holder</th><th class="py-2 pr-4 font-medium">Class</th><th class="py-2 pr-4 text-right font-medium">Shares</th><th class="py-2 pr-4 text-right font-medium">% of class</th><th class="py-2 pr-4 text-right font-medium">Indicative value</th><th class="py-2 pr-4 font-medium">History</th><th class="py-2 font-medium">Note</th></tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {positions.map((p) => {
            const value = valueOf(p.row.share_class_id, p.row.shares);
            const price = prices.get(p.row.share_class_id);
            return (
              <tr class="align-top">
                <td class="py-3 pr-4"><span class="text-white/85">{p.holder.name}</span><span class="block text-xs text-white/40">{holderKinds[p.holder.kind] ?? p.holder.kind}{p.holder.registry_ref && ` · ${p.holder.registry_ref}`}</span></td>
                <td class="py-3 pr-4 text-white/70">{p.row.share_classes?.name ?? '—'}</td>
                <td class="py-3 pr-4 text-right tabular-nums text-white/85"><HoldingNote note={p.note} class="mr-1.5" />{shares.format(p.row.shares)}<span class="block text-xs text-white/40">as at {shortDate.format(new Date(p.row.as_at))}</span></td>
                <td class="py-3 pr-4 text-right tabular-nums text-white/70">{p.total > 0 ? percent.format(p.row.shares / p.total) : '—'}</td>
                <td class="py-3 pr-4 text-right tabular-nums text-white/85">{value !== null ? aud.format(value) : '—'}{price && <span class="block text-xs text-white/40">{audPrecise.format(price.price)} · {sourceLabels[price.source] ?? price.source}</span>}</td>
                <td class="py-3 pr-4 text-xs text-white/50">{p.history.length > 1 ? p.history.slice().reverse().map((h) => <span class="block">{shortDate.format(new Date(h.as_at))}: {shares.format(h.shares)}</span>) : 'No changes recorded'}</td>
                <td class="py-3 align-top">
                  <form method="post" class="flex min-w-56 flex-col gap-1.5">
                    <input type="hidden" name="holder_id" value={p.holder.id} /><input type="hidden" name="class_id" value={p.row.share_class_id} />
                    <label class="sr-only" for={`note-${p.holder.id}-${p.row.share_class_id}`}>Note for {p.holder.name}, {p.row.share_classes?.name}</label>
                    <textarea id={`note-${p.holder.id}-${p.row.share_class_id}`} name="note" rows="2" maxlength="1000" placeholder="Add a note (shown to the shareholder)" class="field !py-1.5 text-xs">{p.note ?? ''}</textarea>
                    <button name="intent" value="note" class="btn-ghost self-start !px-3 !py-1 text-xs">{p.note ? 'Save note' : 'Add note'}</button>
                  </form>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    ) : <p class="mt-3 text-sm text-white/45">{links?.length ? 'No holdings recorded for the linked holders.' : 'Link a holder to see holdings.'}</p>}
    <p class="mt-4 text-xs text-white/35">Percentages use shares on issue (the official figure where recorded). Values use each class’s latest reference price and are indicative only.</p>
  </section>

  <section class="card mt-4">
    <h2 class="text-lg font-bold">Recent activity</h2>
    <ul class="mt-4 divide-y divide-white/5 text-sm">
      {(events ?? []).map((e) => <li class="flex justify-between py-2.5"><span class="font-mono text-white/80">{e.action}</span><span class="text-white/40">{dateTime.format(new Date(e.created_at))}</span></li>)}
      {!events?.length && <li class="py-2.5 text-white/45">No activity yet.</li>}
    </ul>
  </section>
  </div>
</Admin>
