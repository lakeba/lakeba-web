---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import { serviceClient } from '../../../lib/admin';
import { sendWelcome } from '../../../lib/admin-auth';
import { addInvestor } from '../../../lib/people';
import { brandOf } from '../../../lib/brand';
import { adminScope } from '../../../lib/admin-company';
import { memberIds } from '../../../lib/notify';
import AdminCompanyFilter from '../../../components/AdminCompanyFilter.astro';
import HoldingNote from '../../../components/HoldingNote.astro';
import { field } from '../../../lib/forms';
import { displayName } from '../../../lib/admin-forms';
import { loadRoles } from '../../../lib/roles-admin';
import { aud, percent, shares, shortDate } from '../../../lib/format';
import { latestPrices, loadHolderPositions, type Position } from '../../../lib/holdings';

const supabase = Astro.locals.supabase;
const svc = serviceClient();
const scope = await adminScope(Astro.locals, Astro.url);
// Batch welcomes are sent for one company at a time.
const welcomeCompany = scope.selected ?? (scope.companies.length === 1 ? scope.companies[0] : null);
const BATCH = 50;
let error = '';
let notice = '';
let shareLink = '';

/** People with a holding in this company who have never signed in, and whether they were already welcomed. */
async function welcomeCandidates(entityId: string) {
  const ids = await memberIds(entityId);
  if (!ids.length) return [];
  const [{ data: people }, { data: authUsers }, { data: welcomed }] = await Promise.all([
    svc.from('profiles').select('id, email, first_name, last_name, role').in('id', ids).neq('role', 'admin'),
    svc.auth.admin.listUsers({ perPage: 1000 }),
    svc.from('audit_log').select('detail, created_at').eq('action', 'investor_welcomed'),
  ]);
  const signedIn = new Set((authUsers?.users ?? []).filter((u) => u.last_sign_in_at).map((u) => u.id));
  const lastWelcome = new Map<string, string>();
  for (const w of welcomed ?? []) {
    const d = w.detail as { user_id?: string; entity_id?: string };
    if (d.user_id && d.entity_id === entityId) lastWelcome.set(d.user_id, w.created_at);
  }
  return (people ?? []).filter((p) => !signedIn.has(p.id) && !p.email.endsWith('@lakeba.test'))
    .map((p) => ({ ...p, welcomedAt: lastWelcome.get(p.id) ?? null }))
    .sort((a, b) => Number(Boolean(a.welcomedAt)) - Number(Boolean(b.welcomedAt)) || a.email.localeCompare(b.email));
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent') || 'invite';
  const email = field(form, 'email').toLowerCase();
  // Investors only, linked to their holder (company admins: a holder in their company). Staff are added in System → Users.
  const holderId = field(form, 'holder_id');
  if (intent === 'welcome') {
    if (!welcomeCompany) error = 'Choose a company first.';
    else {
      const allowed = new Map((await welcomeCandidates(welcomeCompany.id)).map((p) => [p.id, p]));
      const chosen = form.getAll('user_id').map(String).filter((id) => allowed.has(id)).slice(0, BATCH);
      let sent = 0;
      for (const id of chosen) {
        const p = allowed.get(id)!;
        const { error: e } = await sendWelcome(p.email, Astro.url.origin, brandOf(welcomeCompany));
        if (!e) {
          sent++;
          await svc.from('audit_log').insert({ user_id: Astro.locals.user!.id, action: 'investor_welcomed', detail: { user_id: id, email: p.email, entity_id: welcomeCompany.id } });
        }
      }
      notice = chosen.length ? `Sent ${sent} welcome email${sent === 1 ? '' : 's'} for ${welcomeCompany.display_name}.${sent < chosen.length ? ` ${chosen.length - sent} could not be sent.` : ''}` : 'Tick at least one person.';
    }
  } else if (!scope.isGroupAdmin && !(holderId && welcomeCompany && (await svc.rpc('holder_in_entity', { target_holder: holderId, target_entity: welcomeCompany.id })).data)) {
    error = 'Choose your company and a holder in it.';
  } else if (!email) {
    error = 'Enter their email address.';
  } else if (!holderId) {
    error = 'Choose the holder they invest through. To add staff (Admin, Board, Marketing…), use System → Users.';
  } else {
    // Added with or without the invitation (later: their page, or the welcome emails above).
    const r = await addInvestor(svc, {
      email, firstName: field(form, 'first_name'), lastName: field(form, 'last_name'), holderId, access: field(form, 'access') === 'viewer' ? 'viewer' : 'owner',
      invite: field(form, 'send') !== 'later', origin: Astro.url.origin, brand: brandOf(welcomeCompany),
      log: (action, detail) => supabase.rpc('log_event', { event_action: action, event_detail: detail }),
    });
    if ('error' in r) error = r.error;
    else if (r.existing) notice = `${email} already had an account; they can now see this holder too. No email was sent.`;
    else if (r.invited) { notice = `Invitation sent to ${email}.`; shareLink = r.inviteUrl ?? ''; }
    else notice = `Added ${email}. No email was sent: invite them when you’re ready, from their page or with the welcome emails.`;
  }
}

const [{ data: profiles }, { data: links }, { data: holders }, { data: authUsers }] = await Promise.all([
  supabase.from('profiles').select('id, email, first_name, last_name, role, board_qa_enabled').order('last_name'),
  supabase.from('holder_members').select('user_id, holder_id, access'),
  supabase.from('holders').select('id, name').order('name'),
  svc.auth.admin.listUsers({ perPage: 1000 }),
]);
// Staff roles (System → Users), shown and filtered here; everyone else is an investor.
const [allRoles, { data: roleRows }] = await Promise.all([loadRoles(svc), svc.from('user_roles').select('user_id, role_key').or(`expires_at.is.null,expires_at.gt.${new Date().toISOString()}`)]);
const roleNames = new Map(allRoles.map((r) => [r.key, r.name]));
const rolesOf = new Map<string, string[]>();
for (const r of roleRows ?? []) rolesOf.set(r.user_id, [...(rolesOf.get(r.user_id) ?? []), r.role_key]);
const roleLabel = (id: string) => (rolesOf.get(id) ?? []).map((k) => roleNames.get(k) ?? k).sort().join(', ') || 'Investor';
const candidates = welcomeCompany ? await welcomeCandidates(welcomeCompany.id) : [];
const { data: pauses } = await supabase.from('ask_user_pauses').select('user_id');
const askOff = new Set((pauses ?? []).map((x) => x.user_id));
// With a company picked, list only its people (company admins only ever see theirs, via RLS).
const inCompany = scope.selected ? new Set(await memberIds(scope.selected.id)) : null;
const people = (profiles ?? []).filter((p) => !inCompany || inCompany.has(p.id));
const notYet = candidates.filter((c) => !c.welcomedAt);
const authById = new Map((authUsers?.users ?? []).map((u) => [u.id, u]));
const [positions, prices] = await Promise.all([
  loadHolderPositions(supabase, [...new Set((links ?? []).map((l) => l.holder_id))]),
  latestPrices(supabase),
]);
const positionsByHolder = Map.groupBy(positions, (p) => p.holder.id);
type HolderSummary = { id: string; name: string; access: string; positions: Position[] };
const holdersOf = (id: string): HolderSummary[] => (links ?? []).filter((l) => l.user_id === id).map((l) => {
  const ps = positionsByHolder.get(l.holder_id) ?? [];
  return { id: l.holder_id, name: ps[0]?.holder.name ?? (holders ?? []).find((h) => h.id === l.holder_id)?.name ?? '—', access: l.access, positions: ps };
});
const valueOf = (p: Position) => { const pr = prices.get(p.row.share_class_id); return pr ? p.row.shares * pr.price : null; };
// Per person: total shares and indicative value across every holder they can see.
const totalsOf = (hs: HolderSummary[]) => {
  const ps = hs.flatMap((h) => h.positions);
  const values = ps.map(valueOf);
  return { shares: ps.reduce((a, p) => a + p.row.shares, 0), value: values.reduce<number>((a, v) => a + (v ?? 0), 0), unpriced: values.some((v) => v === null), priced: values.some((v) => v !== null) };
};
const factorsOf = (id: string) => (authById.get(id)?.factors ?? []).filter((f) => f.status === 'verified').length;
const isBanned = (id: string) => {
  const until = authById.get(id)?.banned_until;
  return Boolean(until && new Date(until) > new Date());
};

// Search, filters and sorting for the people table (all in the address, so a view can be shared).
const params = Astro.url.searchParams;
const f = {
  q: (params.get('q') ?? '').trim().toLowerCase(),
  role: params.get('role') ?? '', status: params.get('status') ?? '', mfa: params.get('mfa') ?? '',
  ask: params.get('ask') ?? '', board: params.get('board') ?? '', note: params.get('note') ?? '',
};
const SORTS = ['name', 'role', 'shares', 'value', 'mfa', 'signin'] as const;
type SortKey = (typeof SORTS)[number];
const sort: SortKey = (SORTS as readonly string[]).includes(params.get('sort') ?? '') ? (params.get('sort') as SortKey) : 'name';
const dir = params.get('dir') === 'desc' ? -1 : 1;
const statusOf = (id: string) => {
  const a = authById.get(id);
  if (isBanned(id)) return 'disabled';
  if (a?.last_sign_in_at) return 'active';
  return a?.invited_at ? 'invited' : 'never';
};
const statusLabels: Record<string, string> = { active: 'Active', invited: 'Invited, not signed in', never: 'Never invited', disabled: 'Disabled' };
const allRows = people.map((p) => {
  const hs = holdersOf(p.id);
  return {
    p, hs, t: totalsOf(hs), status: statusOf(p.id), mfa: factorsOf(p.id) > 0, askOff: askOff.has(p.id), boardOff: p.board_qa_enabled === false,
    hasNote: hs.some((h) => h.positions.some((x) => x.note)), signIn: authById.get(p.id)?.last_sign_in_at ?? null,
    text: [displayName(p), p.email, ...hs.map((h) => h.name)].join(' ').toLowerCase(),
  };
});
const rows = allRows.filter((r) =>
  (!f.q || r.text.includes(f.q)) && (!f.role || (f.role === 'investor' ? !rolesOf.has(r.p.id) : (rolesOf.get(r.p.id) ?? []).includes(f.role))) && (!f.status || r.status === f.status)
  && (!f.mfa || (f.mfa === 'on') === r.mfa) && (!f.ask || (f.ask === 'off') === r.askOff)
  && (!f.board || (f.board === 'off') === r.boardOff) && (!f.note || (f.note === 'yes') === r.hasNote),
).sort((a, b) => {
  const by: Record<SortKey, number> = {
    name: displayName(a.p).localeCompare(displayName(b.p), 'en', { sensitivity: 'base' }),
    role: roleLabel(a.p.id).localeCompare(roleLabel(b.p.id)),
    shares: a.t.shares - b.t.shares,
    value: a.t.value - b.t.value,
    mfa: Number(a.mfa) - Number(b.mfa),
    signin: (a.signIn ? Date.parse(a.signIn) : 0) - (b.signIn ? Date.parse(b.signIn) : 0),
  };
  return (by[sort] || displayName(a.p).localeCompare(displayName(b.p))) * dir;
});
const filtered = Object.values(f).some(Boolean);
/** The current address with some parameters changed (empty removes them). */
const withParams = (changes: Record<string, string>) => {
  const next = new URLSearchParams(params);
  for (const [k, v] of Object.entries(changes)) if (v) next.set(k, v); else next.delete(k);
  return `/admin/investors${next.size ? `?${next}` : ''}`;
};
// Clicking a column sorts by it; clicking it again reverses. Numbers and dates start with the largest.
const sortHref = (key: SortKey) => withParams({ sort: key, dir: sort === key ? (dir === 1 ? 'desc' : 'asc') : ['shares', 'value', 'signin'].includes(key) ? 'desc' : 'asc' });
const sortMark = (key: SortKey) => (sort === key ? (dir === 1 ? '▲' : '▼') : '');
const ariaSort = (key: SortKey) => (sort === key ? (dir === 1 ? 'ascending' : 'descending') : undefined);
import ShareLink from '../../../components/ShareLink.astro';
---

<Admin title="Investors">
  <PageHeader title="Investors" subtitle="Shareholders’ accounts and which holding entities each person can see. Staff and their roles are managed in System → Users." />
  <AdminCompanyFilter scope={scope} />
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}
  {Astro.url.searchParams.get('deleted') && <div class="mb-6"><Alert tone="success">Deleted {Astro.url.searchParams.get('deleted')}.</Alert></div>}
  {shareLink && <ShareLink url={shareLink} label="Invitation link" />}

  {welcomeCompany ? (
    <details class="card mb-6" open={notYet.length > 0}>
      <summary class="cursor-pointer font-display text-lg font-bold text-white">Welcome {welcomeCompany.display_name} shareholders <span class="ml-2 text-sm font-normal text-white/50">{notYet.length} not yet invited · {candidates.length - notYet.length} invited, not signed in</span></summary>
      <p class="mt-3 text-sm text-white/55">People with a {welcomeCompany.display_name} holding who have never signed in. Each gets an email{welcomeCompany.relationship !== 'group' && ` in ${welcomeCompany.display_name}’s name`} with a link to choose a password (valid for 1 hour; after that, “Forgot password” on the sign-in page). Up to {BATCH} per send; start with a few friendly shareholders.</p>
      {candidates.length ? (
        <form method="post" class="mt-4" onsubmit="return confirm('Send welcome emails to the people ticked?')">
          <div class="max-h-80 overflow-auto rounded-xl border border-white/5">
            <table class="w-full text-left text-sm">
              <tbody class="divide-y divide-white/5">
                {candidates.map((c, i) => (
                  <tr>
                    <td class="w-10 px-4 py-2"><input type="checkbox" name="user_id" value={c.id} checked={!c.welcomedAt && i < BATCH} aria-label={`Welcome ${c.email}`} class="size-4 accent-lk-blue" /></td>
                    <td class="px-2 py-2"><span class="text-white/85">{displayName(c)}</span> <span class="text-xs text-white/40">{c.email}</span></td>
                    <td class="px-4 py-2 text-right text-xs text-white/45">{c.welcomedAt ? `Invited ${shortDate.format(new Date(c.welcomedAt))}` : 'Not invited'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <button name="intent" value="welcome" class="btn-primary mt-4">Send welcome emails</button>
        </form>
      ) : <p class="mt-4 text-sm text-white/50">Everyone with a {welcomeCompany.display_name} holding has signed in.</p>}
    </details>
  ) : scope.companies.length > 1 && <p class="mb-6 text-sm text-white/50">Pick a company above to send welcome emails to its shareholders.</p>}

  <details class="card mb-6" open={Boolean(error)}>
    <summary class="cursor-pointer font-display text-lg font-bold text-white">Add an investor</summary>
    <p class="mt-2 text-sm text-white/55">Adding staff (Admin, Board, Marketing, Legal, Compliance…)? Use <a href="/admin/system/users/new" class="text-lk-blue hover:underline">System → Users → Add person</a>.</p>
    <form method="post" class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2"><label class="label" for="email">Email</label><input class="field" id="email" name="email" type="email" required /></div>
      <div><label class="label" for="first_name">First name</label><input class="field" id="first_name" name="first_name" /></div>
      <div><label class="label" for="last_name">Last name</label><input class="field" id="last_name" name="last_name" /></div>
      <div><label class="label" for="holder_id">Holder they invest through</label>
        <select class="field" id="holder_id" name="holder_id" required><option value="">Choose…</option>{(holders ?? []).map((h) => <option value={h.id}>{h.name}</option>)}</select></div>
      <div><label class="label" for="access">Access</label>
        <select class="field" id="access" name="access"><option value="owner">Owner (can vote)</option><option value="viewer">Viewer (read only)</option></select></div>
      <div class="flex flex-wrap items-center gap-3 sm:col-span-2"><button class="btn-primary">Add and send invitation</button><button name="send" value="later" class="btn-ghost">Add without inviting</button>
        <span class="text-xs text-white/45">Without inviting, no email is sent: invite them later from their page or with the welcome emails.</span></div>
    </form>
  </details>

  <form method="get" action="/admin/investors" class="card mb-4 grid gap-3 !p-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-8" role="search" aria-label="Filter people">
    {scope.selected && scope.companies.length > 1 && <input type="hidden" name="company" value={scope.selected.code} />}
    {sort !== 'name' && <input type="hidden" name="sort" value={sort} />}
    {dir === -1 && <input type="hidden" name="dir" value="desc" />}
    <div class="sm:col-span-2"><label class="label" for="f-q">Search</label><input class="field !py-2 text-sm" id="f-q" name="q" type="search" value={params.get('q') ?? ''} placeholder="Name, email or holder" /></div>
        <div><label class="label" for="f-role">Role</label><select class="field !py-2 text-sm" id="f-role" name="role"><option value="" selected={f.role === ''}>Any</option><option value="investor" selected={f.role === 'investor'}>Investor only</option>{allRoles.map((r) => <option value={r.key} selected={f.role === r.key}>{r.name}</option>)}</select></div>
        <div><label class="label" for="f-status">Status</label><select class="field !py-2 text-sm" id="f-status" name="status"><option value="" selected={f.status === ''}>Any</option><option value="active" selected={f.status === 'active'}>Active</option><option value="invited" selected={f.status === 'invited'}>Invited, not signed in</option><option value="never" selected={f.status === 'never'}>Never invited</option><option value="disabled" selected={f.status === 'disabled'}>Disabled</option></select></div>
        <div><label class="label" for="f-mfa">Two-step</label><select class="field !py-2 text-sm" id="f-mfa" name="mfa"><option value="" selected={f.mfa === ''}>Any</option><option value="on" selected={f.mfa === 'on'}>On</option><option value="off" selected={f.mfa === 'off'}>Off</option></select></div>
        <div><label class="label" for="f-ask">Ask</label><select class="field !py-2 text-sm" id="f-ask" name="ask"><option value="" selected={f.ask === ''}>Any</option><option value="on" selected={f.ask === 'on'}>On</option><option value="off" selected={f.ask === 'off'}>Off</option></select></div>
        <div><label class="label" for="f-board">Board Q&amp;A</label><select class="field !py-2 text-sm" id="f-board" name="board"><option value="" selected={f.board === ''}>Any</option><option value="on" selected={f.board === 'on'}>On</option><option value="off" selected={f.board === 'off'}>Off</option></select></div>
        <div><label class="label" for="f-note">Holding notes</label><select class="field !py-2 text-sm" id="f-note" name="note"><option value="" selected={f.note === ''}>Any</option><option value="yes" selected={f.note === 'yes'}>Has a note</option><option value="no" selected={f.note === 'no'}>No note</option></select></div>
    <div class="flex items-end gap-3 sm:col-span-2 lg:col-span-4 xl:col-span-8">
      <button class="btn-ghost !py-2 text-sm">Apply</button>
      {filtered && <a href={withParams({ q: '', role: '', status: '', mfa: '', ask: '', board: '', note: '' })} class="text-sm text-white/55 hover:text-white">Clear filters</a>}
      <p class="ml-auto text-sm text-white/45" aria-live="polite">{rows.length === allRows.length ? `${allRows.length} people` : `${rows.length} of ${allRows.length} people`}</p>
    </div>
  </form>

  <div class="card overflow-x-auto !p-0">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40">
        <tr><th class="px-5 py-3 font-medium" aria-sort={ariaSort('name')}><a href={sortHref('name')} class="inline-flex items-center gap-1 hover:text-white">Name<span class="text-[10px]">{sortMark('name')}</span></a></th><th class="px-5 py-3 font-medium" aria-sort={ariaSort('role')}><a href={sortHref('role')} class="inline-flex items-center gap-1 hover:text-white">Role<span class="text-[10px]">{sortMark('role')}</span></a></th><th class="px-5 py-3 font-medium">Holdings</th><th class="px-5 py-3 font-medium text-right" aria-sort={ariaSort('shares')}><a href={sortHref('shares')} class="inline-flex items-center gap-1 hover:text-white">Shares<span class="text-[10px]">{sortMark('shares')}</span></a></th><th class="px-5 py-3 font-medium text-right" aria-sort={ariaSort('value')}><a href={sortHref('value')} class="inline-flex items-center gap-1 hover:text-white">Indicative value<span class="text-[10px]">{sortMark('value')}</span></a></th><th class="px-5 py-3 font-medium" aria-sort={ariaSort('mfa')}><a href={sortHref('mfa')} class="inline-flex items-center gap-1 hover:text-white">Two-step<span class="text-[10px]">{sortMark('mfa')}</span></a></th><th class="px-5 py-3 font-medium" aria-sort={ariaSort('signin')}><a href={sortHref('signin')} class="inline-flex items-center gap-1 hover:text-white">Last sign-in<span class="text-[10px]">{sortMark('signin')}</span></a></th></tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {rows.map(({ p, hs, t }) => {
          const auth = authById.get(p.id);
          return (
            <tr class="hover:bg-white/[0.02]">
              <td class="px-5 py-3">
                {scope.isGroupAdmin ? <a href={`/admin/investors/${p.id}`} class="font-medium text-white hover:underline">{displayName(p)}</a> : <span class="font-medium text-white">{displayName(p)}</span>}
                <span class="block text-xs text-white/40">{p.email}</span>
                {isBanned(p.id) && <span class="mt-1 inline-block rounded-full bg-lk-red/15 px-2 py-0.5 text-[11px] text-lk-red">Disabled</span>}
                {askOff.has(p.id) && <span class="mt-1 mr-1 inline-block rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/60">Ask off</span>}
                {p.board_qa_enabled === false && <span class="mt-1 inline-block rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/60">Board Q&amp;A off</span>}
              </td>
              <td class="px-5 py-3 text-white/70">{rolesOf.has(p.id) ? <a href={`/admin/system/users/${p.id}`} class="hover:text-white hover:underline">{roleLabel(p.id)}</a> : hs.length ? 'Investor' : <span class="text-white/40">No holder</span>}</td>
              <td class="px-5 py-3 text-white/60">
                {hs.length ? hs.map((h) => (
                  <div class="py-0.5">
                    <a href={`/admin/holders/${h.id}`} class="text-white/80 hover:text-lk-blue">{h.name}</a>{h.access === 'viewer' && <span class="ml-1 text-[11px] text-white/40">viewer</span>}
                    {h.positions.length ? h.positions.map((pos) => (
                      <span class="block text-xs text-white/45"><HoldingNote note={pos.note} class="mr-1" />{shares.format(pos.row.shares)} {pos.row.share_classes?.code}{pos.total > 0 && ` · ${percent.format(pos.row.shares / pos.total)}`} · as at {shortDate.format(new Date(pos.row.as_at))}</span>
                    )) : <span class="block text-xs text-white/35">No holdings recorded</span>}
                  </div>
                )) : '—'}
              </td>
              <td class="whitespace-nowrap px-5 py-3 text-right tabular-nums text-white/80">{t.shares ? shares.format(t.shares) : '—'}</td>
              <td class="whitespace-nowrap px-5 py-3 text-right tabular-nums text-white/80">{t.shares ? <>{t.priced ? aud.format(t.value) : <span class="text-white/40">not priced</span>}{t.unpriced && t.priced && <span class="block text-[11px] text-white/40">some classes not priced</span>}</> : '—'}</td>
              <td class="px-5 py-3">{factorsOf(p.id) ? <span class="text-lk-green">On</span> : <span class="text-white/40">Off</span>}</td>
              <td class="px-5 py-3 text-white/50">{auth?.last_sign_in_at ? shortDate.format(new Date(auth.last_sign_in_at)) : auth?.invited_at ? 'Invited' : 'Never'}</td>
            </tr>
          );
        })}
        {!rows.length && <tr><td colspan="7" class="px-5 py-8 text-center text-sm text-white/50">No one matches these filters.</td></tr>}
      </tbody>
    </table>
  </div>
</Admin>
