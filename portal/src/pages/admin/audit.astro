---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Empty from '../../components/Empty.astro';
import { auditQuery, emailsFor, readFilters } from '../../lib/admin-audit';
import { dateTime } from '../../lib/format';

const PAGE = 50;
const supabase = Astro.locals.supabase;
const filters = readFilters(Astro.url.searchParams);
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1);
const audit = await auditQuery(supabase, filters);
const { data: rows, count } = audit ? await audit.query.range((page - 1) * PAGE, page * PAGE - 1) : { data: [], count: 0 };
const emails = await emailsFor(supabase, (rows ?? []).map((r) => r.user_id));
const pages = Math.max(1, Math.ceil((count ?? 0) / PAGE));
const withPage = (p: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('page', String(p));
  return `?${params}`;
};
const csvHref = `/admin/audit.csv?${new URLSearchParams(Object.entries(filters).filter(([, v]) => v))}`;
---

<Admin title="Audit log">
  <PageHeader title="Audit log" subtitle="Sign-ins, document opens and every admin change." >
    <a href={csvHref} class="btn-ghost">Export CSV</a>
  </PageHeader>

  <form method="get" class="card mb-6 grid gap-4 sm:grid-cols-5">
    <div><label class="label" for="action">Action</label><input class="field" id="action" name="action" value={filters.action} placeholder="sign_in" /></div>
    <div class="sm:col-span-2"><label class="label" for="email">User email</label><input class="field" id="email" name="email" value={filters.email} /></div>
    <div><label class="label" for="from">From</label><input class="field" id="from" name="from" type="date" value={filters.from} /></div>
    <div><label class="label" for="to">To</label><input class="field" id="to" name="to" type="date" value={filters.to} /></div>
    <div class="flex gap-3 sm:col-span-5"><button class="btn-ghost">Filter</button><a href="/admin/audit" class="btn text-white/50 hover:text-white">Clear</a></div>
  </form>

  {rows?.length ? (
    <>
      <div class="card overflow-x-auto !p-0">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40"><tr><th class="px-5 py-3 font-medium">When</th><th class="px-5 py-3 font-medium">User</th><th class="px-5 py-3 font-medium">Action</th><th class="px-5 py-3 font-medium">Details</th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {rows.map((r) => (
              <tr>
                <td class="whitespace-nowrap px-5 py-2.5 text-white/50">{dateTime.format(new Date(r.created_at))}</td>
                <td class="px-5 py-2.5 text-white/70">{r.user_id ? emails.get(r.user_id) ?? 'deleted user' : 'system'}</td>
                <td class="px-5 py-2.5 font-mono text-white/85">{r.action}</td>
                <td class="max-w-md truncate px-5 py-2.5 font-mono text-xs text-white/45" title={JSON.stringify(r.detail)}>{Object.keys(r.detail ?? {}).length ? JSON.stringify(r.detail) : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-4 flex items-center justify-between text-sm text-white/50">
        <span>{count} event(s) · page {page} of {pages}</span>
        <span class="flex gap-3">
          {page > 1 && <a href={withPage(page - 1)} class="hover:text-white">← Newer</a>}
          {page < pages && <a href={withPage(page + 1)} class="hover:text-white">Older →</a>}
        </span>
      </div>
    </>
  ) : <Empty title="No events">Nothing matches these filters.</Empty>}
</Admin>
