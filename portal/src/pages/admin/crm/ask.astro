---
import Crm from '../../../layouts/Crm.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import { serviceClient } from '../../../lib/admin';
import { field } from '../../../lib/forms';
import { crmHref, crmScope } from '../../../lib/crm';
import { aiBudget, askCrm, type Source } from '../../../lib/crm-ai';

// CRM → Ask: a question about the company's own CRM ("what did Harbour say about security?", "who should I call
// today?"), answered by Lakeba AI from its deals, people, companies and timelines, with the records it used.
const svc = serviceClient();
const scope = await crmScope(svc, Astro.locals, Astro.url);
const company = scope.current;
const me = Astro.locals.user!.id;
let error = '';
let result: { answer: string; sources: Source[] } | null = null;
let question = Astro.url.searchParams.get('q') ?? '';
if (Astro.request.method === 'POST' && company) {
  const form = await Astro.request.formData();
  question = field(form, 'question');
  try { if (question.length < 3) throw new Error('Type a question.'); result = await askCrm(svc, { entityId: company.id, userId: me, question }); } catch (e) { error = (e as Error).message; }
}
const budget = company ? await aiBudget(svc, company.id) : null;
const { data: recent } = company ? await svc.from('crm_ask_log').select('question, created_at').eq('entity_id', company.id).eq('user_id', me).order('created_at', { ascending: false }).limit(8) : { data: [] };
const href = (s: Source) => crmHref(scope, `/admin/crm/${s.kind === 'deal' ? 'deals' : s.kind === 'person' ? 'people' : 'companies'}/${s.id}`);
---
<Crm title="Ask" scope={scope}>
  <PageHeader title="Ask the CRM" subtitle="Lakeba AI answers from this company’s deals, people, companies and their timelines, and shows what it used." />
  {!budget?.ok && <div class="mb-4"><Alert tone="info">Lakeba AI is paused for this CRM (switched off in Settings, or this month’s budget is used).</Alert></div>}
  <form method="post" class="card mb-6 flex flex-wrap gap-2" data-tour="crm-ask">
    <input class="field flex-1" name="question" value={question} placeholder="e.g. What did Harbour say about data residency? Who should I call today?" aria-label="Question" />
    <button class="btn-primary" disabled={!budget?.ok}>Ask</button>
  </form>
  {error && <div class="mb-4"><Alert tone="error">{error}</Alert></div>}
  {result && (
    <section class="card mb-6">
      <p class="whitespace-pre-line text-white">{result.answer}</p>
      {result.sources.length > 0 && <p class="mt-3 text-xs text-white/45">From: {result.sources.map((s, i) => <>{i > 0 && ' · '}<a class="text-lk-blue hover:underline" href={href(s)}>{s.label}</a></>)}</p>}
    </section>
  )}
  {(recent ?? []).length > 0 && <section class="card"><h2 class="mb-2 font-display text-lg font-bold">Your recent questions</h2><ul class="divide-y divide-white/5 text-sm">{(recent ?? []).map((r) => <li class="py-1.5"><a class="text-white/75 hover:text-white" href={crmHref(scope, `/admin/crm/ask?q=${encodeURIComponent(r.question)}`)}>{r.question}</a></li>)}</ul></section>}
</Crm>
