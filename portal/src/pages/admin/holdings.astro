---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import { field } from '../../lib/forms';
import { holderKindValues } from '../../lib/admin-forms';
import { applyImport, parseHoldingsCsv, previewImport, type Preview } from '../../lib/admin-import';
import { holderKinds, shares, shortDate } from '../../lib/format';

const supabase = Astro.locals.supabase;
let error = '';
let notice = '';
let preview: Preview | null = null;
let csvText = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  if (intent === 'set-official') {
    const raw = field(form, 'official_on_issue').replace(/[,\s]/g, '');
    const asAt = field(form, 'official_as_at');
    const clear = raw === '';
    if (!clear && (!/^\d+$/.test(raw) || !/^\d{4}-\d{2}-\d{2}$/.test(asAt))) error = 'Enter a whole number of shares and the date it is correct as at.';
    else {
      const { error: updateError } = await supabase.from('share_classes')
        .update({ official_on_issue: clear ? null : Number(raw), official_as_at: clear ? null : asAt })
        .eq('id', field(form, 'class_id'));
      if (updateError) error = updateError.message;
      else {
        await supabase.rpc('log_event', { event_action: 'admin_set_official_on_issue', event_detail: { class_id: field(form, 'class_id'), official_on_issue: clear ? null : Number(raw), as_at: asAt || null } });
        notice = clear ? 'Official figure removed; the portal total is used.' : 'Official shares on issue saved.';
      }
    }
  } else if (intent === 'create-holder') {
    const kind = field(form, 'kind');
    const { error: insertError } = await supabase.from('holders').insert({ name: field(form, 'name'), kind, registry_ref: field(form, 'registry_ref') || null });
    if (insertError) error = insertError.code === '23505' ? 'That registry reference is already used.' : insertError.message;
    else { await supabase.rpc('log_event', { event_action: 'admin_created_holder', event_detail: { name: field(form, 'name') } }); notice = 'Holder created.'; }
  } else if (intent === 'preview' || intent === 'confirm') {
    const file = form.get('file');
    csvText = file instanceof File && file.size ? await file.text() : String(form.get('csv') ?? '');
    // The confirm step re-parses the same CSV, so nothing is trusted from the preview page.
    const { rows, errors } = parseHoldingsCsv(csvText);
    preview = await previewImport(supabase, rows, errors);
    if (intent === 'confirm') {
      if (preview.errors.length) error = 'Fix the errors before importing.';
      else {
        const result = await applyImport(supabase, preview.rows);
        await supabase.rpc('log_event', { event_action: 'admin_imported_holdings', event_detail: result });
        notice = `Imported: ${result.holders} new holder(s), ${result.holdings} holding row(s) written.`;
        preview = null;
        csvText = '';
      }
    }
  }
}

const [{ data: holders }, { data: onIssue }] = await Promise.all([
  supabase.from('holders').select('id, name, kind, registry_ref, holdings(shares, as_at, share_class_id, share_classes(code))').order('name'),
  supabase.rpc('shares_on_issue'),
]);
type H = { shares: number; as_at: string; share_class_id: string; share_classes: { code: string } | null };
const latestOf = (rows: H[]) => Object.values(rows.reduce<Record<string, H>>((acc, r) => {
  if (!acc[r.share_class_id] || acc[r.share_class_id].as_at < r.as_at) acc[r.share_class_id] = r;
  return acc;
}, {}));
const changeLabels = { 'new-holder': 'New holder', added: 'New class', changed: 'Changed', unchanged: 'Unchanged' };
---

<Admin title="Holders & holdings">
  <PageHeader title="Holders & holdings" subtitle="Holding entities, their latest positions, and imports from the share registry." />
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}

  <div class="mb-6 grid gap-4 lg:grid-cols-2">
    {(onIssue ?? []).map((c: { share_class_id: string; code: string; name: string; total: number; computed_total: number; official_as_at: string | null; is_official: boolean }) => {
      const gap = Number(c.total) - Number(c.computed_total);
      return (
        <div class="card !p-5">
          <p class="text-xs uppercase tracking-widest text-white/40">{c.name} on issue</p>
          <p class="mt-2 font-display text-3xl font-bold text-white">{shares.format(Number(c.total))}</p>
          <p class="mt-1 text-xs text-white/45">
            {c.is_official ? `Official figure as at ${shortDate.format(new Date(c.official_as_at!))}` : 'No official figure: sum of holdings in the portal'}
          </p>
          <p class="mt-3 text-sm text-white/60">
            Held by portal holders: {shares.format(Number(c.computed_total))}
            {c.is_official && gap !== 0 && <span class:list={['ml-1', gap > 0 ? 'text-white/50' : 'text-lk-red']}>({gap > 0 ? `${shares.format(gap)} held outside the portal` : `${shares.format(-gap)} more than the official figure`})</span>}
          </p>
          <form method="post" class="mt-4 flex flex-wrap items-end gap-2">
            <input type="hidden" name="intent" value="set-official" />
            <input type="hidden" name="class_id" value={c.share_class_id} />
            <label class="grow"><span class="label">Official shares on issue</span><input class="field" name="official_on_issue" inputmode="numeric" placeholder="from the share register" /></label>
            <label><span class="label">As at</span><input class="field" type="date" name="official_as_at" value={c.official_as_at ?? ''} /></label>
            <button class="btn-ghost">Save</button>
          </form>
        </div>
      );
    })}
  </div>

  <section class="card mb-6">
    <h2 class="text-lg font-bold">Import from the share registry</h2>
    <p class="mt-1 text-sm text-white/55">CSV columns: <code class="font-mono text-white/75">registry_ref, holder_name, kind, share_class_code, shares, as_at</code>. Rows add a dated holding; earlier history is kept.</p>
    <form method="post" enctype="multipart/form-data" class="mt-5 space-y-4">
      <input type="file" name="file" accept=".csv,text/csv" class="block text-sm text-white/70 file:mr-4 file:rounded-lg file:border-0 file:bg-white/10 file:px-4 file:py-2 file:text-white" />
      <textarea name="csv" rows="5" class="field font-mono text-xs" placeholder="…or paste CSV here">{csvText}</textarea>
      <button name="intent" value="preview" class="btn-ghost">Preview changes</button>
    </form>

    {preview && (
      <div class="mt-8 border-t border-white/5 pt-6">
        <h3 class="font-display text-base font-bold text-white">Preview</h3>
        {preview.errors.length > 0 && (
          <div class="mt-3"><Alert tone="error">{preview.errors.length} problem(s): <ul class="mt-2 list-disc pl-5">{preview.errors.slice(0, 20).map((e) => <li>{e}</li>)}</ul></Alert></div>
        )}
        <div class="mt-4 flex flex-wrap gap-3 text-xs">
          {Object.entries(changeLabels).map(([k, label]) => <span class="rounded-full bg-white/5 px-3 py-1 text-white/70">{label}: {preview!.rows.filter((r) => r.change === k).length}</span>)}
          {preview.totals.map((t) => <span class="rounded-full bg-lk-blue/15 px-3 py-1 text-lk-blue">{t.code} on issue: {shares.format(t.before)} → {shares.format(t.after)}</span>)}
        </div>
        <div class="mt-4 max-h-96 overflow-auto rounded-xl border border-white/5">
          <table class="w-full text-left text-sm">
            <thead class="sticky top-0 bg-ink text-xs uppercase tracking-widest text-white/40"><tr><th class="px-4 py-2 font-medium">Holder</th><th class="px-4 py-2 font-medium">Class</th><th class="px-4 py-2 font-medium">As at</th><th class="px-4 py-2 text-right font-medium">Shares</th><th class="px-4 py-2 font-medium">Change</th></tr></thead>
            <tbody class="divide-y divide-white/5">
              {preview.rows.map((r) => (
                <tr>
                  <td class="px-4 py-2"><span class="text-white/85">{r.holder_name}</span> <span class="text-xs text-white/40">{r.registry_ref}</span></td>
                  <td class="px-4 py-2 font-mono text-xs">{r.share_class_code}</td>
                  <td class="px-4 py-2 text-white/60">{r.as_at}</td>
                  <td class="px-4 py-2 text-right">{r.previous !== null && r.previous !== r.shares && <span class="text-white/40">{shares.format(r.previous)} → </span>}{shares.format(r.shares)}</td>
                  <td class:list={['px-4 py-2 text-xs', r.change === 'unchanged' ? 'text-white/40' : 'text-lk-orange']}>{changeLabels[r.change]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {!preview.errors.length && preview.rows.length > 0 && (
          <form method="post" class="mt-5">
            <input type="hidden" name="csv" value={csvText} />
            <button name="intent" value="confirm" class="btn-primary">Import {preview.rows.filter((r) => r.change !== 'unchanged').length} change(s)</button>
          </form>
        )}
      </div>
    )}
  </section>

  <details class="card mb-6">
    <summary class="cursor-pointer font-display text-lg font-bold text-white">Add a holder</summary>
    <form method="post" class="mt-6 grid gap-4 sm:grid-cols-3">
      <div><label class="label" for="name">Name</label><input class="field" id="name" name="name" required /></div>
      <div><label class="label" for="kind">Type</label><select class="field" id="kind" name="kind">{holderKindValues.map((k) => <option value={k}>{holderKinds[k]}</option>)}</select></div>
      <div><label class="label" for="registry_ref">Registry reference</label><input class="field" id="registry_ref" name="registry_ref" /></div>
      <div><button name="intent" value="create-holder" class="btn-ghost">Create holder</button></div>
    </form>
  </details>

  <div class="card overflow-x-auto !p-0">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40"><tr><th class="px-5 py-3 font-medium">Holder</th><th class="px-5 py-3 font-medium">Type</th><th class="px-5 py-3 font-medium">Latest holdings</th></tr></thead>
      <tbody class="divide-y divide-white/5">
        {(holders ?? []).map((h) => (
          <tr>
            <td class="px-5 py-3"><span class="font-medium text-white">{h.name}</span><span class="block text-xs text-white/40">{h.registry_ref ?? 'No registry ref'}</span></td>
            <td class="px-5 py-3 text-white/60">{holderKinds[h.kind]}</td>
            <td class="px-5 py-3 text-white/70">
              {latestOf(h.holdings as unknown as H[]).map((r) => <span class="block">{shares.format(r.shares)} {r.share_classes?.code} <span class="text-xs text-white/40">as at {shortDate.format(new Date(r.as_at))}</span></span>)}
              {!h.holdings.length && <span class="text-white/40">—</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Admin>
