---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Empty from '../../components/Empty.astro';
import { dateTime, shortDate } from '../../lib/format';
import { displayName } from '../../lib/admin-forms';
import { adminScope } from '../../lib/admin-company';
import AdminCompanyFilter from '../../components/AdminCompanyFilter.astro';

const supabase = Astro.locals.supabase;
const scope = await adminScope(Astro.locals, Astro.url);
const now = new Date().toISOString();
const [investors, holders, open, overdue, published, { data: queue }, { data: events }, { data: reads }] = await Promise.all([
  supabase.from('profiles').select('id', { count: 'exact', head: true }).eq('role', 'investor'),
  supabase.from('holders').select('id', { count: 'exact', head: true }),
  supabase.from('queries').select('id', { count: 'exact', head: true }).eq('status', 'open').in('entity_id', scope.ids),
  supabase.from('queries').select('id', { count: 'exact', head: true }).eq('status', 'open').lt('due_at', now).in('entity_id', scope.ids),
  supabase.from('documents').select('id', { count: 'exact', head: true }).lte('published_at', now).in('entity_id', scope.ids),
  supabase.from('queries').select('id, subject, due_at, profiles!queries_user_id_fkey(first_name, last_name, email)').eq('status', 'open').in('entity_id', scope.ids).order('due_at').limit(8),
  supabase.from('audit_log').select('action, created_at, user_id').order('created_at', { ascending: false }).limit(15),
  supabase.from('document_reads').select('last_read_at, documents(title), profiles(first_name, last_name, email)').order('last_read_at', { ascending: false }).limit(8),
]);

const userIds = [...new Set((events ?? []).map((e) => e.user_id).filter(Boolean))];
const { data: actors } = userIds.length ? await supabase.from('profiles').select('id, email').in('id', userIds) : { data: [] };
const emailOf = new Map((actors ?? []).map((a) => [a.id, a.email]));

const stats = [
  { label: 'Investor accounts', value: investors.count ?? 0 },
  { label: 'Holding entities', value: holders.count ?? 0 },
  { label: 'Open queries', value: open.count ?? 0 },
  { label: 'Overdue queries', value: overdue.count ?? 0, alert: (overdue.count ?? 0) > 0 },
  { label: 'Published documents', value: published.count ?? 0 },
];
---

<Admin title="Overview">
  <PageHeader title="Portal administration" subtitle={scope.isGroupAdmin ? 'Investors, holdings, documents and shareholder questions.' : `Administration for ${scope.companies.map((c) => c.display_name).join(', ')}.`} />
  <AdminCompanyFilter scope={scope} />

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    {stats.map((s) => (
      <div class="card !p-5">
        <p class="text-xs uppercase tracking-widest text-white/40">{s.label}</p>
        <p class:list={['mt-2 font-display text-3xl font-bold', s.alert ? 'text-lk-orange' : 'text-white']}>{s.value}</p>
      </div>
    ))}
  </div>

  <div class="mt-4 grid gap-4 xl:grid-cols-2">
    <section class="card">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">Open questions</h2>
        <a href="/admin/queries" class="text-sm text-lk-blue hover:underline">All questions</a>
      </div>
      {queue?.length ? (
        <ul class="mt-4 divide-y divide-white/5 text-sm">
          {queue.map((q) => {
            const late = q.due_at < now;
            return (
              <li class="flex items-center justify-between gap-4 py-3">
                <a href={`/admin/queries/${q.id}`} class="min-w-0 hover:text-white">
                  <span class="block truncate font-medium text-white/85">{q.subject}</span>
                  <span class="text-xs text-white/40">{displayName(q.profiles as never)}</span>
                </a>
                <span class:list={['shrink-0 rounded-full px-2.5 py-0.5 text-xs', late ? 'bg-lk-orange/15 text-lk-orange' : 'bg-white/5 text-white/55']}>
                  {late ? 'Overdue' : 'Due'} {shortDate.format(new Date(q.due_at))}
                </span>
              </li>
            );
          })}
        </ul>
      ) : <p class="mt-4 text-sm text-white/45">No open questions.</p>}
    </section>

    <section class="card">
      <h2 class="text-lg font-bold">Recently opened documents</h2>
      {reads?.length ? (
        <ul class="mt-4 divide-y divide-white/5 text-sm">
          {reads.map((r) => (
            <li class="flex justify-between gap-4 py-3">
              <span class="min-w-0"><span class="block truncate text-white/85">{(r.documents as { title: string } | null)?.title}</span><span class="text-xs text-white/40">{displayName(r.profiles as never)}</span></span>
              <span class="shrink-0 text-xs text-white/40">{dateTime.format(new Date(r.last_read_at))}</span>
            </li>
          ))}
        </ul>
      ) : <p class="mt-4 text-sm text-white/45">No documents opened yet.</p>}
    </section>
  </div>

  {scope.isGroupAdmin && (
  <section class="card mt-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold">Recent activity</h2>
      <a href="/admin/audit" class="text-sm text-lk-blue hover:underline">Audit log</a>
    </div>
    {events?.length ? (
      <ul class="mt-4 divide-y divide-white/5 text-sm">
        {events.map((e) => (
          <li class="flex justify-between gap-4 py-2.5">
            <span><span class="font-mono text-white/80">{e.action}</span> <span class="text-white/40">{e.user_id ? emailOf.get(e.user_id) : 'system'}</span></span>
            <span class="shrink-0 text-white/40">{dateTime.format(new Date(e.created_at))}</span>
          </li>
        ))}
      </ul>
    ) : <Empty title="No activity yet">Sign-ins and changes will appear here.</Empty>}
  </section>
  )}
</Admin>
