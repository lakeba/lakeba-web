---
import { actionLabel } from '../../lib/audit-labels';
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Empty from '../../components/Empty.astro';
import { dateTime, shortDate } from '../../lib/format';
import { displayName } from '../../lib/admin-forms';
import { adminScope } from '../../lib/admin-company';
import { serviceClient } from '../../lib/admin';
import { waitingFor } from '../../lib/approvals';
import { staffBanners } from '../../lib/announcements';
import GettingStarted from '../../components/GettingStarted.astro';
import { gettingStarted, venturesGettingStarted } from '../../lib/getting-started';

const supabase = Astro.locals.supabase;
const scope = await adminScope(Astro.locals, Astro.url, true);
const now = new Date().toISOString();
const [{ data: held }, { data: members }, open, overdue, published, { data: queue }, { data: events }, { data: reads }] = await Promise.all([
  // Holding entities with shares in the companies shown, and the investor accounts linked to them.
  supabase.from('holdings').select('holder_id, share_classes!inner(entity_id)').gt('shares', 0).in('share_classes.entity_id', scope.ids).limit(100_000),
  supabase.from('holder_members').select('user_id, holders!inner(holdings!inner(shares, share_classes!inner(entity_id)))').gt('holders.holdings.shares', 0).in('holders.holdings.share_classes.entity_id', scope.ids).limit(100_000),
  supabase.from('queries').select('id', { count: 'exact', head: true }).eq('status', 'open').in('entity_id', scope.ids),
  supabase.from('queries').select('id', { count: 'exact', head: true }).eq('status', 'open').lt('due_at', now).in('entity_id', scope.ids),
  supabase.from('documents').select('id', { count: 'exact', head: true }).lte('published_at', now).in('entity_id', scope.ids),
  supabase.from('queries').select('id, subject, due_at, profiles!queries_user_id_fkey(first_name, last_name, email)').eq('status', 'open').in('entity_id', scope.ids).order('due_at').limit(8),
  supabase.from('audit_log').select('action, created_at, user_id').order('created_at', { ascending: false }).limit(15),
  supabase.from('document_reads').select('last_read_at, documents(title), profiles(first_name, last_name, email)').order('last_read_at', { ascending: false }).limit(8),
]);

const userIds = [...new Set((events ?? []).map((e) => e.user_id).filter(Boolean))];
const { data: actors } = userIds.length ? await supabase.from('profiles').select('id, email').in('id', userIds) : { data: [] };
const emailOf = new Map((actors ?? []).map((a) => [a.id, a.email]));

// To do: what waits for this person, from their roles, for the companies in view.
const svc = serviceClient();
const access = Astro.locals.access;
const ids = scope.ids.length ? scope.ids : ['00000000-0000-0000-0000-000000000000'];
const soon = new Date(Date.now() + 7 * 86_400_000).toISOString();
const count = async (q: PromiseLike<{ count: number | null }>) => (await q).count ?? 0;
const todo = (await Promise.all([
  (async () => ({ n: (await waitingFor(svc, access, Astro.locals.user!.id)).length, label: 'approvals waiting for you', href: '/admin/approvals' }))(),
  access.canAny('inbox.view') ? (async () => ({ n: await count(svc.from('shareholder_emails').select('id', { count: 'exact', head: true }).in('status', ['needs_person', 'draft_ready', 'error']).in('entity_id', ids)), label: 'shareholder emails need a person or have a reply ready', href: '/admin/emails' }))() : null,
  access.canAny('inbox.view') ? (async () => ({ n: overdue.count ?? 0, label: 'Board Q&A questions past their reply date', href: '/admin/queries', alert: true }))() : null,
  access.can('press.approve', null) ? (async () => ({ n: await count(svc.from('press_releases').select('id', { count: 'exact', head: true }).eq('status', 'in_review')), label: 'press releases waiting for approval', href: '/admin/press' }))() : null,
  access.can('press.view', null) ? (async () => ({ n: await count(svc.from('press_coverage').select('id', { count: 'exact', head: true }).eq('status', 'new')), label: 'new press coverage to review', href: '/admin/press/coverage' }))() : null,
  access.canAny('capital.do') ? (async () => ({ n: await count(svc.from('trade_interests').select('id', { count: 'exact', head: true }).eq('status', 'open').in('entity_id', ids)), label: 'open trading interests to pair', href: '/admin/trading' }))() : null,
  access.canAny('meetings.view') ? (async () => ({ n: await count(svc.from('meetings').select('id', { count: 'exact', head: true }).in('status', ['upcoming', 'open']).gt('proxy_deadline', now).lt('proxy_deadline', soon).in('entity_id', ids)), label: 'meetings whose proxy voting closes this week', href: '/admin/agm' }))() : null,
])).filter((x): x is { n: number; label: string; href: string; alert?: boolean } => Boolean(x && x.n > 0));

// Getting started: what's left to run each venture (group Admins: every venture), unless hidden for now.
const { data: mine } = await svc.from('profiles').select('getting_started_hidden_until').eq('id', Astro.locals.user!.id).maybeSingle();
const gsHidden = Boolean(mine?.getting_started_hidden_until && mine.getting_started_hidden_until > now);
const [gsCards, gsVentures] = gsHidden ? [[], []] : await Promise.all([gettingStarted(svc, access), access.groupAdmin ? venturesGettingStarted(svc) : Promise.resolve([])]);

// Live announcements for staff whose roles cover them (Admin → Announcements).
const banners = await staffBanners(access);
const bannerTone: Record<string, string> = { info: 'border-lk-blue/30 bg-lk-blue/10', success: 'border-lk-green/30 bg-lk-green/10', warning: 'border-lk-orange/30 bg-lk-orange/10' };
const stats = [
  { label: 'Investor accounts', value: new Set((members ?? []).map((m) => m.user_id)).size },
  { label: 'Holding entities', value: new Set((held ?? []).map((h) => h.holder_id)).size },
  { label: 'Open queries', value: open.count ?? 0 },
  { label: 'Overdue queries', value: overdue.count ?? 0, alert: (overdue.count ?? 0) > 0 },
  { label: 'Published documents', value: published.count ?? 0 },
];
---

<Admin filter={{ scope }} title="Overview">
  <PageHeader title="Portal administration" subtitle={scope.isGroupAdmin ? 'Investors, holdings, documents and shareholder questions.' : `Administration for ${scope.companies.map((c) => c.display_name).join(', ')}.`} />
  {banners.map((a) => (
    <div class:list={['mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border px-5 py-3.5 text-sm', bannerTone[a.tone] ?? bannerTone.info]}>
      <p><span class="font-semibold text-white">{a.title}</span>{a.body && <span class="text-white/65"> · {a.body}</span>}</p>
      {a.link_url && <a href={a.link_url} class="font-semibold text-white underline-offset-4 hover:underline">{a.link_label ?? 'Open'} →</a>}
    </div>
  ))}
  <GettingStarted cards={gsCards} ventures={gsVentures} />

  <section class="card mb-4" aria-labelledby="todo-title" data-tour="admin-todo">
    <h2 id="todo-title" class="font-display text-lg font-bold">To do</h2>
    {todo.length ? (
      <ul class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
        {todo.map((x) => (
          <li><a href={x.href} class="flex items-center gap-3 rounded-xl border border-white/10 px-4 py-3 text-sm transition hover:bg-white/5">
            <span class:list={['grid min-w-8 place-items-center rounded-full px-2 py-0.5 text-sm font-bold', x.alert ? 'bg-lk-orange/20 text-lk-orange' : 'bg-lk-blue/15 text-lk-blue']}>{x.n}</span>
            <span class="text-white/80">{x.label}</span>
          </a></li>
        ))}
      </ul>
    ) : <p class="mt-2 text-sm text-white/50">Nothing is waiting for you.</p>}
  </section>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    {stats.map((s) => (
      <div class="card !p-5">
        <p class="text-xs uppercase tracking-widest text-white/40">{s.label}</p>
        <p class:list={['mt-2 font-display text-3xl font-bold', s.alert ? 'text-lk-orange' : 'text-white']}>{s.value}</p>
      </div>
    ))}
  </div>

  <div class="mt-4 grid gap-4 xl:grid-cols-2 [&>*]:min-w-0">
    <section class="card">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">Open questions</h2>
        <a href="/admin/queries" class="text-sm text-lk-blue hover:underline">All questions</a>
      </div>
      {queue?.length ? (
        <ul class="mt-4 divide-y divide-white/5 text-sm">
          {queue.map((q) => {
            const late = q.due_at < now;
            return (
              <li class="flex items-center justify-between gap-4 py-3">
                <a href={`/admin/queries/${q.id}`} class="min-w-0 hover:text-white">
                  <span class="block truncate font-medium text-white/85">{q.subject}</span>
                  <span class="text-xs text-white/40">{displayName(q.profiles as never)}</span>
                </a>
                <span class:list={['shrink-0 rounded-full px-2.5 py-0.5 text-xs', late ? 'bg-lk-orange/15 text-lk-orange' : 'bg-white/5 text-white/55']}>
                  {late ? 'Overdue' : 'Due'} {shortDate.format(new Date(q.due_at))}
                </span>
              </li>
            );
          })}
        </ul>
      ) : <p class="mt-4 text-sm text-white/45">No open questions.</p>}
    </section>

    <section class="card">
      <h2 class="text-lg font-bold">Recently opened documents</h2>
      {reads?.length ? (
        <ul class="mt-4 divide-y divide-white/5 text-sm">
          {reads.map((r) => (
            <li class="flex justify-between gap-4 py-3">
              <span class="min-w-0"><span class="block truncate text-white/85">{(r.documents as { title: string } | null)?.title}</span><span class="text-xs text-white/40">{displayName(r.profiles as never)}</span></span>
              <span class="shrink-0 text-xs text-white/40">{dateTime.format(new Date(r.last_read_at))}</span>
            </li>
          ))}
        </ul>
      ) : <p class="mt-4 text-sm text-white/45">No documents opened yet.</p>}
    </section>
  </div>

  {scope.isGroupAdmin && (
  <section class="card mt-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold">Recent activity</h2>
      <a href="/admin/audit" class="text-sm text-lk-blue hover:underline">Audit log</a>
    </div>
    {events?.length ? (
      <ul class="mt-4 divide-y divide-white/5 text-sm">
        {events.map((e) => (
          <li class="flex justify-between gap-4 py-2.5">
            <span class="min-w-0 truncate"><span class="text-white/85" title={e.action}>{actionLabel(e.action)}</span> <span class="text-white/40">{e.user_id ? emailOf.get(e.user_id) : 'system'}</span></span>
            <span class="shrink-0 text-white/40">{dateTime.format(new Date(e.created_at))}</span>
          </li>
        ))}
      </ul>
    ) : <Empty title="No activity yet">Sign-ins and changes will appear here.</Empty>}
  </section>
  )}
</Admin>
