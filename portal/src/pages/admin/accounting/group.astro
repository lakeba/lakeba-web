---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Empty from '../../../components/Empty.astro';
import AccountingNav from '../../../components/AccountingNav.astro';
import { serviceClient } from '../../../lib/admin';
import { BS_LINES, PL_LINES, monthEnd, periodLabel, todayIn, totals, type BsLine, type PlLine } from '../../../lib/reporting';
import { consolidate, consolidatedItems, groupItems, matchPairs } from '../../../lib/reporting-group';

// Admin → Accounting → Consolidated: Lakeba and its controlled ventures added
// up for a period, with what they report between each other removed, the
// pair-by-pair matching of those amounts, and the Excel export.
const svc = serviceClient();
const { data: periodRows } = await svc.from('reporting_packs').select('period_end').in('status', ['submitted', 'accepted']).order('period_end', { ascending: false });
const periods = [...new Set((periodRows ?? []).map((r) => r.period_end as string))];
const asked = Astro.url.searchParams.get('period');
const period = asked && periods.includes(asked) ? asked : periods[0] ?? monthEnd(todayIn(), -1);
const items = await groupItems(svc, period);
const inside = consolidatedItems(items);
const c = consolidate(inside);
const pairs = matchPairs(items);
const outside = items.filter((i) => !inside.includes(i));
const money = (v: number | null | undefined) => (v == null ? '—' : new Intl.NumberFormat('en-AU', { maximumFractionDigits: 0 }).format(v));
const sumOf = (fn: (i: (typeof inside)[number]) => number) => inside.reduce((t, i) => t + fn(i), 0);
---

<Admin title="Accounting · Consolidated">
  <PageHeader title="Accounting" subtitle="Each venture's profit and loss and balance sheet, from the reporting packs they send." />
  <AccountingNav />
  {periods.length ? (
    <>
      <form method="get" class="mb-4 flex flex-wrap items-end gap-3 text-sm">
        <div><label class="label" for="period">Period</label><select class="field !py-2" id="period" name="period">{periods.map((p) => <option value={p} selected={p === period}>{periodLabel(p, 'monthly')}</option>)}</select></div>
        <button class="btn-ghost !py-2">Show</button>
        <a class="btn-ghost !py-2" href={`/admin/accounting/export?period=${period}`}>Download Excel</a>
      </form>
      <section class="card mb-6 overflow-x-auto p-0">
        <h2 class="px-5 pt-5 font-display text-lg font-bold">Lakeba and its controlled ventures, AUD</h2>
        <p class="px-5 pt-1 text-sm text-white/55">{inside.map((i) => i.name).join(', ') || 'No packs yet'}. An approximation from what each company reports, not an audited consolidation.</p>
        <table class="mt-3 w-full text-sm">
          <thead class="border-b border-white/5 text-xs uppercase tracking-wider text-white/40"><tr><th class="px-5 py-2 text-left">Profit and loss</th><th class="px-5 py-2 text-right">Added up</th><th class="px-5 py-2 text-right">Between them</th><th class="px-5 py-2 text-right">Consolidated</th><th class="px-5 py-2 text-right">Year to date (added up)</th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {(Object.entries(PL_LINES) as [PlLine, string][]).map(([k, l]) => {
              const added = sumOf((i) => i.figures!.pl?.[k]?.period ?? 0);
              const after = c.figures.pl![k]!.period ?? 0;
              return <tr class:list={[k === 'net_profit' && 'font-semibold']}><td class="px-5 py-1.5 text-white/75">{l}</td><td class="px-5 py-1.5 text-right tabular-nums">{money(added)}</td><td class="px-5 py-1.5 text-right tabular-nums text-white/45">{after !== added ? money(after - added) : ''}</td><td class="px-5 py-1.5 text-right tabular-nums">{money(after)}</td><td class="px-5 py-1.5 text-right tabular-nums text-white/60">{money(c.figures.pl![k]!.ytd)}</td></tr>;
            })}
          </tbody>
          <thead class="border-y border-white/5 text-xs uppercase tracking-wider text-white/40"><tr><th class="px-5 py-2 text-left">Balance sheet</th><th class="px-5 py-2 text-right">Added up</th><th class="px-5 py-2 text-right">Between them</th><th class="px-5 py-2 text-right">Consolidated</th><th></th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {(Object.entries(BS_LINES) as [BsLine, string][]).map(([k, l]) => {
              const added = sumOf((i) => i.figures!.bs?.[k] ?? 0);
              const after = c.figures.bs![k] ?? 0;
              return <tr><td class="px-5 py-1.5 text-white/75">{l}</td><td class="px-5 py-1.5 text-right tabular-nums">{money(added)}</td><td class="px-5 py-1.5 text-right tabular-nums text-white/45">{after !== added ? money(after - added) : ''}</td><td class="px-5 py-1.5 text-right tabular-nums">{money(after)}</td><td></td></tr>;
            })}
            <tr class="font-semibold"><td class="px-5 py-1.5">Net assets</td><td class="px-5 py-1.5 text-right tabular-nums">{money(sumOf((i) => totals(i.figures!).netAssets))}</td><td></td><td class="px-5 py-1.5 text-right tabular-nums">{money(c.netAssets)}</td><td></td></tr>
          </tbody>
        </table>
        <p class="px-5 pb-5 pt-3 text-xs text-white/40">Charges between them come off revenue and other operating expenses ({money(c.removed.income)} and {money(c.removed.expense)}); balances come off receivables and payables ({money(c.removed.receivable)} and {money(c.removed.payable)}), as each company reports them. Each line uses the company's latest pack sent up to {periodLabel(period, 'monthly')}.</p>
      </section>

      <section class="card mb-6 overflow-x-auto p-0">
        <h2 class="px-5 pt-5 font-display text-lg font-bold">Between the companies</h2>
        {pairs.length ? (
          <table class="mt-3 w-full text-sm">
            <thead class="border-b border-white/5 text-xs uppercase tracking-wider text-white/40"><tr><th class="px-5 py-2 text-left"></th><th class="px-5 py-2 text-left">First says</th><th class="px-5 py-2 text-right"></th><th class="px-5 py-2 text-left">Second says</th><th class="px-5 py-2 text-right"></th><th class="px-5 py-2 text-right">Difference</th></tr></thead>
            <tbody class="divide-y divide-white/5">
              {pairs.map((p) => (
                <tr><td class="px-5 py-1.5 text-white/75">{p.what}</td><td class="px-5 py-1.5 text-white/50">{p.a}</td><td class="px-5 py-1.5 text-right tabular-nums">{money(p.aSays)}</td><td class="px-5 py-1.5 text-white/50">{p.b}</td><td class="px-5 py-1.5 text-right tabular-nums">{money(p.bSays)}</td>
                  <td class:list={['px-5 py-1.5 text-right tabular-nums', Math.abs(p.difference) >= 1 ? 'text-lk-orange' : 'text-lk-green']}>{Math.abs(p.difference) >= 1 ? money(p.difference) : 'Matches'}</td></tr>
              ))}
            </tbody>
          </table>
        ) : <p class="px-5 pb-5 pt-2 text-sm text-white/55">No company reported balances or charges with another group company for this period.</p>}
      </section>

      {outside.length > 0 && (
        <section class="card p-0">
          <h2 class="px-5 pt-5 font-display text-lg font-bold">Not consolidated</h2>
          <p class="px-5 pt-1 text-sm text-white/55">Non-controlling investments, companies reporting in another currency, and those without a pack yet.</p>
          <ul class="mt-2 divide-y divide-white/5 text-sm">{outside.map((i) => <li class="flex justify-between gap-3 px-5 py-2"><span class="text-white">{i.name}</span><span class="text-white/50">{!i.figures ? 'No pack sent' : i.currency !== 'AUD' ? i.currency : 'Non-controlling'}{i.figures && ` · net profit ${money(i.figures.pl?.net_profit?.period)}`}</span></li>)}</ul>
        </section>
      )}
    </>
  ) : <Empty title="No packs yet">The consolidated view appears once the ventures have sent reporting packs.</Empty>}
</Admin>
