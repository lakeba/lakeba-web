---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Empty from '../../../components/Empty.astro';
import AccountingNav from '../../../components/AccountingNav.astro';
import { serviceClient } from '../../../lib/admin';
import { PACK_STATES, ensurePacks, monthEnd, periodLabel, todayIn, totals, type Figures, type Pack, type Schedule } from '../../../lib/reporting';

// Admin → Accounting: every venture side by side for a month (a quarterly
// venture shows its latest quarter up to that month), with the trend over the
// last 12 packs. Figures from packs that have been sent; accepted ones in full
// colour, sent-but-not-reviewed ones marked.
const svc = serviceClient();
await ensurePacks(svc);
const [{ data: schedRows }, { data: entities }] = await Promise.all([
  svc.from('reporting_schedules').select('entity_id, cadence, due_days, first_period, currency, year_end_month, active'),
  svc.from('entities').select('id, code, display_name, sort').order('sort'),
]);
const schedules = (schedRows ?? []) as Schedule[];
const companies = (entities ?? []).filter((e) => schedules.some((s) => s.entity_id === e.id));
const today = todayIn();
const { data: packRows } = await svc.from('reporting_packs').select('id, entity_id, period_end, cadence, due_on, status, figures').in('entity_id', companies.map((c) => c.id).concat('00000000-0000-0000-0000-000000000000')).order('period_end');
const packs = (packRows ?? []) as Pick<Pack, 'id' | 'entity_id' | 'period_end' | 'cadence' | 'due_on' | 'status' | 'figures'>[];
const sent = packs.filter((p) => p.status === 'submitted' || p.status === 'accepted');
const periods = [...new Set(packs.map((p) => p.period_end))].sort().reverse();
const asked = Astro.url.searchParams.get('period');
const period = asked && periods.includes(asked) ? asked : (sent.at(-1)?.period_end ?? periods[0] ?? monthEnd(today, -1));
const rows = companies.map((c) => {
  const s = schedules.find((x) => x.entity_id === c.id)!;
  const mine = packs.filter((p) => p.entity_id === c.id && p.period_end <= period);
  const pack = mine.at(-1) ?? null;
  const trend = sent.filter((p) => p.entity_id === c.id && p.period_end <= period).slice(-12).map((p) => p.figures.pl?.revenue?.period ?? null);
  return { c, s, pack, trend };
});
const money = (v: number | null | undefined) => (v == null ? '—' : new Intl.NumberFormat('en-AU', { maximumFractionDigits: 0 }).format(v));
const k = (v: number | null | undefined) => (v == null ? '—' : Math.abs(v) >= 1_000_000 ? `${(v / 1_000_000).toFixed(1)}m` : Math.abs(v) >= 1000 ? `${Math.round(v / 1000)}k` : money(v));
const shown = (p: (typeof rows)[number]['pack']) => (p && (p.status === 'submitted' || p.status === 'accepted') ? p.figures : null) as Figures | null;
const pl = (f: Figures | null, line: 'revenue' | 'net_profit', w: 'period' | 'ytd') => f?.pl?.[line]?.[w] ?? null;
// Totals for the AUD companies with a pack sent for the period.
const aud = rows.filter((r) => r.s.currency === 'AUD' && shown(r.pack));
const sum = (fn: (f: Figures) => number | null) => aud.reduce((t, r) => t + (fn(shown(r.pack)!) ?? 0), 0);
const spark = (vals: (number | null)[]) => {
  const v = vals.map((x) => x ?? 0);
  if (v.length < 2) return '';
  const min = Math.min(...v, 0), max = Math.max(...v, 1), w = 90, h = 24;
  return v.map((x, i) => `${i ? 'L' : 'M'}${((i * w) / (v.length - 1)).toFixed(1)},${(h - ((x - min) / (max - min || 1)) * h).toFixed(1)}`).join(' ');
};
const stateOf = (r: (typeof rows)[number]) => !r.pack ? { t: 'No pack yet', c: 'text-white/35' } : r.pack.status === 'accepted' ? { t: 'Accepted', c: 'text-lk-green' } : r.pack.status === 'submitted' ? { t: 'To review', c: 'text-lk-blue' } : r.pack.due_on < today ? { t: 'Overdue', c: 'text-lk-red' } : { t: PACK_STATES[r.pack.status], c: 'text-white/50' };
---

<Admin title="Accounting">
  <PageHeader title="Accounting" subtitle="Each venture's profit and loss and balance sheet, from the reporting packs they send." />
  <AccountingNav />
  {companies.length ? (
    <>
      <form method="get" class="mb-4 flex flex-wrap items-end gap-3 text-sm">
        <div><label class="label" for="period">Period</label><select class="field !py-2" id="period" name="period">{periods.map((p) => <option value={p} selected={p === period}>{periodLabel(p, 'monthly')}</option>)}</select></div>
        <button class="btn-ghost !py-2">Show</button>
      </form>
      <section class="card overflow-x-auto p-0">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/5 text-xs uppercase tracking-wider text-white/40">
            <tr><th class="px-4 py-3">Company</th><th class="px-4 py-3">Pack</th><th class="px-4 py-3 text-right">Revenue</th><th class="px-4 py-3 text-right">Net profit</th><th class="px-4 py-3 text-right">Revenue YTD</th><th class="px-4 py-3 text-right">Net profit YTD</th><th class="px-4 py-3 text-right">Cash</th><th class="px-4 py-3 text-right">Net assets</th><th class="px-4 py-3">Revenue, last 12</th></tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {rows.map((r) => { const f = shown(r.pack); const st = stateOf(r); return (
              <tr>
                <td class="px-4 py-3"><span class="font-medium text-white">{r.c.display_name}</span><span class="block text-xs text-white/40">{r.s.cadence === 'quarterly' ? 'Quarterly' : 'Monthly'}{r.s.currency !== 'AUD' && ` · ${r.s.currency}`}{r.pack && r.pack.period_end !== period && ` · ${periodLabel(r.pack.period_end, r.pack.cadence)}`}</span></td>
                <td class="px-4 py-3">{r.pack ? <a class:list={['hover:underline', st.c]} href={`/admin/accounting/packs/${r.pack.id}`}>{st.t}</a> : <span class={st.c}>{st.t}</span>}</td>
                <td class="px-4 py-3 text-right tabular-nums">{k(pl(f, 'revenue', 'period'))}</td>
                <td class:list={['px-4 py-3 text-right tabular-nums', (pl(f, 'net_profit', 'period') ?? 0) < 0 && 'text-lk-red']}>{k(pl(f, 'net_profit', 'period'))}</td>
                <td class="px-4 py-3 text-right tabular-nums">{k(pl(f, 'revenue', 'ytd'))}</td>
                <td class:list={['px-4 py-3 text-right tabular-nums', (pl(f, 'net_profit', 'ytd') ?? 0) < 0 && 'text-lk-red']}>{k(pl(f, 'net_profit', 'ytd'))}</td>
                <td class="px-4 py-3 text-right tabular-nums">{k(f?.bs?.cash)}</td>
                <td class="px-4 py-3 text-right tabular-nums">{f ? k(totals(f).netAssets) : '—'}</td>
                <td class="px-4 py-3">{spark(r.trend) && <svg viewBox="-2 -2 94 28" class="h-6 w-24" role="img" aria-label={`Revenue over the last ${r.trend.length} packs`}><path d={spark(r.trend)} fill="none" stroke="currentColor" stroke-width="1.5" class="text-lk-blue" /></svg>}</td>
              </tr>
            ); })}
          </tbody>
          {aud.length > 1 && (
            <tfoot class="border-t border-white/10 font-semibold"><tr>
              <td class="px-4 py-3">Total (AUD, {aud.length} packs)</td><td></td>
              <td class="px-4 py-3 text-right tabular-nums">{k(sum((f) => pl(f, 'revenue', 'period')))}</td><td class="px-4 py-3 text-right tabular-nums">{k(sum((f) => pl(f, 'net_profit', 'period')))}</td>
              <td class="px-4 py-3 text-right tabular-nums">{k(sum((f) => pl(f, 'revenue', 'ytd')))}</td><td class="px-4 py-3 text-right tabular-nums">{k(sum((f) => pl(f, 'net_profit', 'ytd')))}</td>
              <td class="px-4 py-3 text-right tabular-nums">{k(sum((f) => f.bs?.cash ?? null))}</td><td class="px-4 py-3 text-right tabular-nums">{k(sum((f) => totals(f).netAssets))}</td><td></td>
            </tr></tfoot>
          )}
        </table>
      </section>
      <p class="mt-3 text-xs text-white/40">Totals add the ventures up as they are; they are not consolidated (intercompany balances aren't removed). Figures from packs sent but not yet reviewed are included.</p>
    </>
  ) : <Empty title="No schedules yet">Set each venture's reporting schedule under Schedules; packs open as each period ends.</Empty>}
</Admin>
