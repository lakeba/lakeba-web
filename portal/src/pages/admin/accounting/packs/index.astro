---
import Admin from '../../../../layouts/Admin.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Empty from '../../../../components/Empty.astro';
import AccountingNav from '../../../../components/AccountingNav.astro';
import { serviceClient } from '../../../../lib/admin';
import { shortDate } from '../../../../lib/format';
import { PACK_STATES, ensurePacks, periodLabel, todayIn, type Pack } from '../../../../lib/reporting';

// Admin → Accounting → Reporting packs: to review first, then overdue, then
// the rest; filter by company and state.
const svc = serviceClient();
await ensurePacks(svc);
const q = Astro.url.searchParams;
const show = ['review', 'late', 'open', 'accepted', 'all'].includes(q.get('show') ?? '') ? q.get('show')! : 'review';
const today = todayIn();
let query = svc.from('reporting_packs').select('id, entity_id, period_end, cadence, due_on, status, submitted_at, entities(display_name)').order('period_end', { ascending: false }).limit(400);
if (show === 'review') query = query.eq('status', 'submitted');
else if (show === 'late') query = query.in('status', ['open', 'returned']).lt('due_on', today);
else if (show === 'open') query = query.in('status', ['open', 'returned']);
else if (show === 'accepted') query = query.eq('status', 'accepted');
const { data } = await query;
const rows = (data ?? []) as unknown as (Pick<Pack, 'id' | 'entity_id' | 'period_end' | 'cadence' | 'due_on' | 'status' | 'submitted_at'> & { entities: { display_name: string } | null })[];
const { count: toReview } = await svc.from('reporting_packs').select('id', { count: 'exact', head: true }).eq('status', 'submitted');
const { count: late } = await svc.from('reporting_packs').select('id', { count: 'exact', head: true }).in('status', ['open', 'returned']).lt('due_on', today);
const day = (d: string) => shortDate.format(new Date(`${d.slice(0, 10)}T12:00:00+10:00`));
---

<Admin title="Accounting · Reporting packs">
  <AccountingNav />
  <PageHeader title="Reporting packs" subtitle="Each venture's profit and loss and balance sheet, from the reporting packs they send." />
  <nav class="mb-4 flex flex-wrap gap-2 text-sm" aria-label="Which packs">
    {[['review', `To review${toReview ? ` (${toReview})` : ''}`], ['late', `Overdue${late ? ` (${late})` : ''}`], ['open', 'Waiting for the venture'], ['accepted', 'Accepted'], ['all', 'All']].map(([k, l]) => <a href={`?show=${k}`} aria-current={show === k ? 'page' : undefined} class:list={['rounded-full px-3 py-1', show === k ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white', k === 'late' && late && show !== k && 'text-lk-red']}>{l}</a>)}
  </nav>
  {rows.length ? (
    <section class="card overflow-x-auto p-0">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/5 text-xs uppercase tracking-wider text-white/40"><tr><th class="px-5 py-3">Company</th><th class="px-5 py-3">Period</th><th class="px-5 py-3">Due</th><th class="px-5 py-3">State</th></tr></thead>
        <tbody class="divide-y divide-white/5">
          {rows.map((r) => (
            <tr>
              <td class="px-5 py-3"><a class="font-medium text-white hover:text-lk-blue" href={`/admin/accounting/packs/${r.id}`}>{r.entities?.display_name}</a></td>
              <td class="px-5 py-3 text-white/70">{periodLabel(r.period_end, r.cadence)}</td>
              <td class:list={['px-5 py-3', ['open', 'returned'].includes(r.status) && r.due_on < today ? 'text-lk-red' : 'text-white/60']}>{day(r.due_on)}</td>
              <td class="px-5 py-3 text-white/70">{r.status === 'submitted' ? `Sent ${day(r.submitted_at!)}` : r.status === 'returned' ? 'Question sent' : PACK_STATES[r.status]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ) : <Empty title="Nothing here">{show === 'review' ? 'No packs are waiting for review.' : 'No packs match.'}</Empty>}
</Admin>
