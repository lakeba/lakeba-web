---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import Markdown from '../../../components/Markdown.astro';
import { serviceClient } from '../../../lib/admin';
import { field } from '../../../lib/forms';
import { runImport } from '../../../lib/investor-import.mjs';
import { createHash } from 'node:crypto';
import { notifyMembers } from '../../../lib/notify';
import { importScope } from '../../../lib/import-scope';

/*
 * Import the investor data workbook. Upload → check: a preview of every change
 * (new, updated, and what the portal has that the file doesn't) → confirm,
 * choosing whether to also remove what isn't in the file → apply. The upload
 * is kept in private storage between the two steps (imports/<id>.xlsx) and
 * removed after it is applied. If the portal changes between the check and the
 * confirmation, nothing is applied and the new preview is shown instead.
 * Group Admins work on the whole platform (or one company, ?company=CODE); a
 * venture's own admins on their company only (lib/import-scope.ts).
 */
const supabase = Astro.locals.supabase;
const svc = serviceClient();
const MAX_BYTES = 10 * 1024 * 1024;
let error = '';
let report = '';
let uploadId = '';
let fileName = '';
let canApply = false;
let applied = false;
let removed = false;
type Change = { sheet: string; action: 'add' | 'update' | 'remove' | 'keep'; item: string; details: string[] };
let changes: Change[] = [];
let problems: string[] = [];
let warnings: string[] = [];
let fingerprint = '';
const me = Astro.locals.user!.id;
const fingerprintOf = (list: Change[]) => createHash('sha256').update(JSON.stringify(list)).digest('hex');
let changedHolders: string[] = [];
let latestAsAt: string | null = null;
let notice = '';
const { scope, company, choices, error: scopeError } = importScope(Astro);
const q = company ? `?company=${company.code}` : '';
const log = (action: string, detail: Record<string, unknown>) => supabase.rpc('log_event', { event_action: action, event_detail: { ...(company ? { company: company.code } : {}), ...detail } });

if (scopeError) error = scopeError;
else if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  if (intent === 'check') {
    const file = form.get('file');
    if (!(file instanceof File) || !file.size) error = 'Choose the workbook to check.';
    else if (file.size > MAX_BYTES) error = 'That file is larger than 10 MB.';
    else if (!/\.xlsx$/i.test(file.name)) error = 'Upload the .xlsx workbook.';
    else {
      const data = new Uint8Array(await file.arrayBuffer());
      try {
        const result = await runImport({ data, name: file.name, svc, apply: false, target: company ? company.display_name : 'this portal', actorId: me, scope });
        report = result.lines.join('\n');
        fileName = file.name;
        ({ changes, problems, warnings } = result);
        fingerprint = fingerprintOf(changes);
        canApply = !result.problems.length;
        if (canApply) {
          uploadId = crypto.randomUUID();
          await svc.storage.from('documents').upload(`imports/${uploadId}.xlsx`, data, { contentType: file.type || 'application/octet-stream' });
        }
        await log('admin_checked_import', { file: file.name, problems: result.problems.length });
      } catch (e) {
        error = `This file could not be read: ${e instanceof Error ? e.message : String(e)}`;
      }
    }
  } else if (intent === 'apply') {
    uploadId = field(form, 'upload_id');
    fileName = field(form, 'file_name');
    if (!/^[0-9a-f-]{36}$/.test(uploadId)) error = 'Upload the file again.';
    else {
      const { data: blob } = await svc.storage.from('documents').download(`imports/${uploadId}.xlsx`);
      if (!blob) error = 'That upload has expired. Upload the file again.';
      else {
        const data = new Uint8Array(await blob.arrayBuffer());
        const wantRemove = field(form, 'mode') === 'match';
        // The preview must still be what will happen: if the portal changed since the check, show the new preview instead.
        const fresh = await runImport({ data, name: fileName, svc, apply: false, target: company ? company.display_name : 'this portal', actorId: me, scope });
        if (!form.get('reviewed')) {
          error = 'Tick that you’ve reviewed the changes.';
          ({ changes, problems, warnings } = fresh); report = fresh.lines.join('\n'); fingerprint = fingerprintOf(changes); canApply = !problems.length;
        } else if (fingerprintOf(fresh.changes) !== field(form, 'fingerprint')) {
          error = 'The portal changed since you checked this file, so nothing was imported. Here are the changes as they are now: review them and confirm again.';
          ({ changes, problems, warnings } = fresh); report = fresh.lines.join('\n'); fingerprint = fingerprintOf(changes); canApply = !problems.length;
        } else {
          const result = await runImport({ data, name: fileName, svc, apply: true, remove: wantRemove, target: company ? company.display_name : 'this portal', actorId: me, scope });
          report = result.lines.join('\n');
          ({ changes, problems, warnings } = result);
          applied = result.applied; removed = wantRemove;
          if (applied) { changedHolders = result.changedHolders; latestAsAt = result.latestAsAt; }
          if (!applied) error = 'Nothing was imported: the file has problems (see below).';
          await svc.storage.from('documents').remove([`imports/${uploadId}.xlsx`]);
          await log('admin_applied_import', { file: fileName, applied, removals: wantRemove });
          uploadId = '';
        }
      }
    }
  } else if (intent === 'notify-statements') {
    // "Your holding statement is ready" for the people linked to holders whose holdings changed.
    const refs = (JSON.parse(field(form, 'refs') || '[]') as string[]).slice(0, 5000);
    const asAt = field(form, 'as_at');
    let { data: hs } = refs.length ? await svc.from('holders').select('id, registry_ref').in('registry_ref', refs) : { data: [] };
    // One company: only holders with shares in it.
    if (scope && hs?.length) {
      const { data: inCo } = await svc.from('holdings').select('holder_id, share_classes!inner(entity_id)').in('holder_id', hs.map((h) => h.id)).eq('share_classes.entity_id', scope.entityId);
      const ok = new Set((inCo ?? []).map((h) => h.holder_id));
      hs = hs.filter((h) => ok.has(h.id));
    }
    const { data: members } = hs?.length ? await svc.from('holder_members').select('user_id, holder_id').in('holder_id', hs.map((h) => h.id)) : { data: [] };
    const byUser = Map.groupBy(members ?? [], (m) => m.user_id);
    const when = asAt ? new Date(`${asAt}T00:00:00`).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
    for (const [userId, rows] of byUser) {
      const one = rows.length === 1;
      await notifyMembers({
        kind: 'statement_ready', userIds: [userId], origin: Astro.url.origin,
        link: one ? `/statement/${rows[0].holder_id}` : '/',
        title: 'Your holding statement is ready',
        body: `Your holdings${when ? ` as at ${when}` : ''} have been updated in the Lakeba investor portal. ${one ? 'Your holding statement is ready to open.' : `Statements for your ${rows.length} holdings are on your dashboard.`}`,
      });
    }
    await log('admin_notified_statements', { holders: hs?.length ?? 0, people: byUser.size, as_at: asAt || null });
    notice = `Told ${byUser.size} ${byUser.size === 1 ? 'person' : 'people'} their holding statement is ready (${hs?.length ?? 0} holders).`;
  }
}
// The preview: per sheet, what's new, updated, removed (if chosen) and kept.
const SHEETS = ['Companies', 'Share classes', 'Holders', 'People', 'Access', 'Holdings', 'Boards', 'Prices', 'Holding notes'];
const ACTIONS = [
  { key: 'add', label: 'New', tone: 'text-lk-green' },
  { key: 'update', label: 'Updated', tone: 'text-lk-blue' },
  { key: 'remove', label: applied ? (removed ? 'Removed' : 'Not in the file (kept: you chose not to remove)') : 'Not in the file: removed if you choose to', tone: 'text-lk-red' },
  { key: 'keep', label: 'Not in the file, kept', tone: 'text-white/50' },
] as const;
const countOf = (sheet: string, action: string) => changes.filter((c) => c.sheet === sheet && c.action === action).length;
const total = (action: string) => changes.filter((c) => c.action === action).length;
// A big removal usually means an incomplete file: say so loudly.
const portalRows: Record<string, number> = {};
if (report && total('remove') && !scope) {
  const [{ count: h }, { count: p }, { count: hd }] = await Promise.all([
    svc.from('holders').select('id', { count: 'exact', head: true }), svc.from('profiles').select('id', { count: 'exact', head: true }), svc.from('holdings').select('id', { count: 'exact', head: true }),
  ]);
  Object.assign(portalRows, { Holders: h ?? 0, People: p ?? 0, Holdings: hd ?? 0 });
}
const bigRemoval = Object.entries(portalRows).filter(([sheet, n]) => n && countOf(sheet, 'remove') / n >= 0.2).map(([sheet, n]) => `${countOf(sheet, 'remove')} of ${n} ${sheet.toLowerCase()}`);

---

<Admin title="Import data">
  <PageHeader title={company ? `Import data: ${company.display_name}` : 'Import data'} subtitle={company ? `Load ${company.display_name}’s share classes, holders, people, access, holdings, board, prices and holding notes from its investor data workbook. Only ${company.display_name}’s data changes.` : 'Load companies, share classes, holders, people and their roles, access, holdings, boards, prices and holding notes from the investor data workbook.'} />
  {choices.length > 1 && (
    <form method="get" class="mb-6 flex flex-wrap items-end gap-2 text-sm">
      <div><label class="label" for="company">Company</label><select id="company" name="company" class="field">
        {Astro.locals.access.groupAdmin && <option value="" selected={!company}>All companies (the whole platform)</option>}
        {choices.map((c) => <option value={c.code} selected={company?.code === c.code}>{c.display_name}</option>)}
      </select></div>
      <button class="btn-ghost text-sm">Open</button>
    </form>
  )}
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {applied && <div class="mb-6"><Alert tone="success">Imported {fileName}. Check Admin → Holders &amp; holdings and Investors. No invitations were sent.</Alert></div>}
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}
  {applied && changedHolders.length > 0 && (
    <form method="post" class="card mb-6 flex flex-wrap items-center justify-between gap-4">
      <input type="hidden" name="refs" value={JSON.stringify(changedHolders)} />
      <input type="hidden" name="as_at" value={latestAsAt ?? ''} />
      <p class="text-sm text-white/75"><span class="font-semibold text-white">{changedHolders.length} holder{changedHolders.length === 1 ? '' : 's'}</span> have new or changed holdings. Tell their people that their holding statement is ready? (Inbox, plus email and browser notification by their choices; the email has a one-time button that opens the statement.)</p>
      <button name="intent" value="notify-statements" class="btn-primary" onclick="return confirm('Send “your holding statement is ready” now?')">Tell them</button>
    </form>
  )}

  <a href={`/admin/import/register${q}`} class="card mb-6 flex flex-wrap items-center justify-between gap-3 hover:border-lk-blue/50">
    <span><span class="font-semibold text-white">Got the company secretary’s register of members?</span><span class="block text-sm text-white/55">Import the PDF to bring {company ? `${company.display_name}’s` : 'a company’s'} holdings up to its figures. People, access and boards stay as they are.</span></span>
    <span class="text-sm text-lk-blue">Import a register →</span>
  </a>

  <section class="card mb-6">
    <h2 class="text-lg font-bold">1. Check a workbook</h2>
    <p class="mt-1 text-sm text-white/55">Nothing changes at this step. You get a preview of every change: what’s new, what’s updated (old → new), and what the portal has that the file doesn’t. Then you confirm.</p>
    <form method="post" enctype="multipart/form-data" class="mt-4 flex flex-wrap items-end gap-3">
      <div class="grow"><label class="label" for="file">Workbook (.xlsx)</label><input class="field" id="file" name="file" type="file" accept=".xlsx" required /></div>
      <button name="intent" value="check" class="btn-primary">Check</button>
    </form>
    <p class="mt-3 text-xs text-white/40">Need the file? <a href={`/admin/import/data.xlsx${q}`} class="text-lk-blue hover:underline">{company ? `Download it with ${company.display_name}’s data` : 'Download it with all the data in the portal'}</a> (to edit and import back) or <a href="/admin/import/template.xlsx" class="text-lk-blue hover:underline">the blank template</a>. Nothing is removed unless you choose to when confirming, and no emails are sent.{company && ` Relationship, portal access and Lakeba’s stake stay as Lakeba set them, and holders or people who also belong to another company are kept as they are.`}</p>
  </section>

  {report && (
    <section class="card mb-6 space-y-5">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-bold">{applied ? `What the import did: ${fileName}` : `2. Preview of the changes: ${fileName}`}</h2>
        {!applied && <p class="text-sm text-white/50">Nothing has changed yet.</p>}
      </div>
      {problems.length > 0 && (
        <Alert tone="error"><strong>{problems.length} problem{problems.length === 1 ? '' : 's'} to fix in the file.</strong> Nothing can be imported until they’re fixed.
          <ul class="mt-2 list-disc pl-5 text-sm">{problems.slice(0, 50).map((p) => <li>{p}</li>)}</ul>{problems.length > 50 && <p class="mt-1 text-sm">…and {problems.length - 50} more.</p>}</Alert>
      )}
      {warnings.length > 0 && <Alert tone="info"><ul class="list-disc pl-5 text-sm">{warnings.map((w) => <li>{w}</li>)}</ul></Alert>}

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-wider text-white/40"><tr><th class="py-2 pr-4">Sheet</th>{ACTIONS.map((a) => <th class="px-3 py-2 text-right">{a.key === 'remove' ? 'Not in file' : a.key === 'keep' ? 'Kept' : a.label}</th>)}</tr></thead>
          <tbody class="divide-y divide-white/5">
            {SHEETS.map((sheet) => <tr><td class="py-2 pr-4 text-white/80">{sheet}</td>{ACTIONS.map((a) => <td class:list={['px-3 py-2 text-right tabular-nums', countOf(sheet, a.key) ? a.tone : 'text-white/25']}>{countOf(sheet, a.key)}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      {!changes.some((c) => c.action !== 'keep') && !problems.length && <p class="text-sm text-white/60">The file matches the portal: nothing would change.</p>}

      {ACTIONS.map((a) => total(a.key) > 0 && (
        <details class="rounded-xl border border-white/10" open={a.key !== 'keep' && total(a.key) <= 40}>
          <summary class="cursor-pointer px-4 py-3 text-sm"><span class:list={['font-semibold', a.tone]}>{a.label}</span> <span class="text-white/45">· {total(a.key)}</span></summary>
          <div class="max-h-[28rem] overflow-y-auto border-t border-white/5 px-4 py-2">
            {SHEETS.filter((sheet) => countOf(sheet, a.key)).map((sheet) => (
              <div class="py-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-white/40">{sheet}</p>
                <ul class="mt-1 space-y-1 text-sm">{changes.filter((c) => c.sheet === sheet && c.action === a.key).map((c) => (
                  <li><span class="text-white/85">{c.item}</span>{c.details.length > 0 && <span class="block text-xs text-white/50">{c.details.join(' · ')}</span>}</li>
                ))}</ul>
              </div>
            ))}
          </div>
        </details>
      ))}

      {canApply && uploadId && (
        <form method="post" class="space-y-4 rounded-2xl border border-lk-green/30 bg-lk-green/[0.06] p-5" onsubmit="return confirm(this.mode.value === 'match' ? 'Import, and remove what is not in the file? Removals cannot be undone.' : 'Import the new and updated records?')">
          <p class="font-semibold text-white">3. Confirm</p>
          <input type="hidden" name="upload_id" value={uploadId} /><input type="hidden" name="file_name" value={fileName} /><input type="hidden" name="fingerprint" value={fingerprint} />
          <label class="flex items-start gap-3 text-sm"><input type="radio" name="mode" value="add" checked class="mt-1 accent-lk-blue" />
            <span><span class="text-white">Add and update only</span><span class="block text-white/55">{total('add')} new and {total('update')} updated. Records the file doesn’t have stay in the portal.</span></span></label>
          {total('remove') > 0 && (
            <label class="flex items-start gap-3 text-sm"><input type="radio" name="mode" value="match" class="mt-1 accent-lk-red" />
              <span><span class="text-white">Make the portal match the file</span><span class="block text-white/55">As above, and also remove the {total('remove')} record{total('remove') === 1 ? '' : 's'} listed under “Not in the file”. This can’t be undone (a backup is taken every night).</span></span></label>
          )}
          {bigRemoval.length > 0 && <Alert tone="error">Removing would delete {bigRemoval.join(' and ')}. That usually means the file is incomplete (for example the blank template, or one company only). Only choose “match” if this file is the complete register.</Alert>}
          <label class="flex items-center gap-3 text-sm text-white/80"><input type="checkbox" name="reviewed" required class="size-4 accent-lk-blue" /> I’ve reviewed the changes above.</label>
          <button name="intent" value="apply" class="btn-primary">Import</button>
        </form>
      )}

      <details class="rounded-xl border border-white/10">
        <summary class="cursor-pointer px-4 py-3 text-sm text-white/70">Full report, with ownership by class</summary>
        <div class="border-t border-white/5 px-4 py-3"><Markdown source={report} /></div>
      </details>
    </section>
  )}
</Admin>
