---
import Admin from '../../layouts/Admin.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import { field } from '../../lib/forms';
import { dateTime } from '../../lib/format';
import { serviceClient } from '../../lib/admin';
import { graph, graphConfigured } from '../../lib/graph';
import { adminScope } from '../../lib/admin-company';
import { AUTO_CONFIDENCE, AUTO_DELAY_MS, AUTO_PER_DAY, CATEGORIES, FLAGS, type Flag, SELF_SERVICE, STATUS_LABELS, cancelAutoReply, pollMailboxes, prepare, sendReplyFor, shareholderContext, toBoardQa, type Category } from '../../lib/shareholder-email';

// Group admins see every company; company admins only their own company's emails (no mailbox settings).
const svc = serviceClient();
const me = Astro.locals.user!.id;
const scope = await adminScope(Astro.locals, Astro.url);
const isGroupAdmin = scope.isGroupAdmin;
const allowed = new Set(scope.companies.map((c) => c.id));
const allowedIds = [...allowed].length ? [...allowed] : ['00000000-0000-0000-0000-000000000000'];
const id = Astro.url.searchParams.get('id');
const filterStatus = Astro.url.searchParams.get('status') ?? 'open';
const filterCompany = allowed.has(Astro.url.searchParams.get('company') ?? '') ? Astro.url.searchParams.get('company')! : '';
let notice = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const emailId = field(form, 'email_id');
  const log = (action: string, detail: Record<string, unknown> = {}) => Astro.locals.supabase.rpc('log_event', { event_action: action, event_detail: detail });
  if (['settings', 'test-connection', 'poll'].includes(intent) && !isGroupAdmin) return new Response('Forbidden', { status: 403 });
  if (emailId) {
    const { data: owner } = await svc.from('shareholder_emails').select('entity_id').eq('id', emailId).maybeSingle();
    if (!owner || !allowed.has(owner.entity_id)) return new Response('Forbidden', { status: 403 });
  }
  try {
    if (intent === 'settings') {
      const mailbox = field(form, 'mailbox').toLowerCase() || null;
      const mode = ['off', 'review', 'auto'].includes(field(form, 'mode')) ? field(form, 'mode') : 'off';
      const autoCategories = form.getAll('auto_category').map(String).filter((c) => SELF_SERVICE.includes(c as Category));
      const { error: e } = await svc.from('entities').update({ shareholder_mailbox: mailbox, email_mode: mode, email_auto_categories: autoCategories, email_signature: String(form.get('signature') ?? '').trim().slice(0, 500) }).eq('id', field(form, 'entity_id'));
      if (e) error = e.message.includes('check') ? 'That doesn’t look like an email address.' : e.message;
      else { await log('admin_saved_mailbox_settings', { entity_id: field(form, 'entity_id'), mailbox, mode, auto_categories: autoCategories }); notice = mode === 'auto' ? `Mailbox settings saved. Automatic replies are on for: ${autoCategories.map((c) => CATEGORIES[c as Category]).join('; ') || 'nothing yet (choose request types)'}.` : 'Mailbox settings saved.'; }
    } else if (intent === 'test-connection') {
      // Checks the saved mailbox: can the portal open its Inbox? (Name and count only; no emails are read.)
      const { data: c } = await svc.from('entities').select('display_name, shareholder_mailbox').eq('id', field(form, 'entity_id')).single();
      if (!c?.shareholder_mailbox) error = 'Save a mailbox address first.';
      else {
        try {
          const inbox = await graph<{ totalItemCount: number }>(`/users/${encodeURIComponent(c.shareholder_mailbox)}/mailFolders/inbox?$select=totalItemCount`);
          notice = `${c.display_name}: connected to ${c.shareholder_mailbox} (Inbox has ${inbox.totalItemCount} emails). You can set it to Review.`;
        } catch (e) {
          error = `${c.display_name}: can’t open ${c.shareholder_mailbox}. ${/403|denied/i.test(String((e as Error).message)) ? 'In Exchange, mark this mailbox for the portal app (CustomAttribute15 LakebaPortal) and allow up to an hour.' : (e as Error).message}`;
        }
      }
    } else if (intent === 'poll') {
      const r = await pollMailboxes(Astro.url.origin);
      notice = `Checked ${r.checked} mailbox${r.checked === 1 ? '' : 'es'}: ${r.emails} new email${r.emails === 1 ? '' : 's'}.`;
    } else if (intent === 'cancel-auto') {
      notice = (await cancelAutoReply(svc, emailId, me)) ? 'Automatic reply cancelled. The draft is kept for you to send.' : 'Too late: it was already sent or changed.';
    } else if (intent === 'send') {
      await cancelAutoReply(svc, emailId, me); // a person sending takes over from a scheduled automatic reply
      const links = form.getAll('link').map((l) => JSON.parse(String(l)) as { label: string; path: string });
      const to = await sendReplyFor(svc, { emailId, body: String(form.get('body') ?? '').trim(), links, sentBy: me, origin: Astro.url.origin });
      notice = `Reply sent to ${to}.`;
    } else if (intent === 'redraft') {
      await prepare(svc, emailId, Astro.url.origin);
      notice = 'Draft prepared again.';
    } else if (intent === 'board') {
      const q = await toBoardQa(svc, emailId, me);
      return Astro.redirect(`/admin/queries/${q}`, 303);
    } else if (intent === 'handled' || intent === 'ignore') {
      await svc.from('shareholder_emails').update({ status: intent === 'handled' ? 'handled' : 'ignored', handled_by: me, handled_at: new Date().toISOString() }).eq('id', emailId);
      await log(intent === 'handled' ? 'shareholder_email_handled' : 'shareholder_email_ignored', { email_id: emailId });
      notice = intent === 'handled' ? 'Marked as handled.' : 'Ignored.';
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

const { data: companies } = await svc.from('entities').select('id, code, display_name, shareholder_mailbox, email_mode, email_signature, email_auto_categories').neq('portal', 'portfolio').in('id', allowedIds).order('sort');
const { data: sync } = await svc.from('email_sync_state').select('mailbox, last_checked_at, last_error');
const syncOf = new Map((sync ?? []).map((s) => [s.mailbox, s]));
const nameOf = new Map((companies ?? []).map((c) => [c.id, c.display_name]));

let list = svc.from('shareholder_emails').select('id, entity_id, from_address, from_name, subject, received_at, category, status, sender_verified, user_id, summary').order('received_at', { ascending: false }).limit(100);
if (filterStatus === 'open') list = list.in('status', ['new', 'needs_person', 'draft_ready', 'auto_scheduled', 'error']);
else if (filterStatus !== 'all') list = list.eq('status', filterStatus);
list = filterCompany ? list.eq('entity_id', filterCompany) : list.in('entity_id', allowedIds);
const { data: emails } = await list;

const { data: found } = id ? await svc.from('shareholder_emails').select('*').eq('id', id).maybeSingle() : { data: null };
const current = found && allowed.has(found.entity_id) ? found : null;
const [{ data: replies }, { data: person }] = current ? await Promise.all([
  svc.from('shareholder_email_replies').select('*').eq('email_id', current.id).order('created_at'),
  current.user_id ? svc.from('profiles').select('id, email, first_name, last_name').eq('id', current.user_id).single() : Promise.resolve({ data: null }),
]) : [{ data: [] }, { data: null }];
const draft = replies?.find((r) => r.kind === 'draft');
const trusted = Boolean(current?.sender_verified && current?.user_id);
const ctx = current && trusted ? await shareholderContext(svc, current.entity_id, current.user_id) : null;
const options = ctx ? [...ctx.statements.map((s) => ({ label: `Holding statement: ${s.name}`, path: `/statement/${s.holderId}` })), ...ctx.docs.map((d) => ({ label: d.title, path: `/documents/${d.id}` }))] : [];
const draftLinks = (draft?.links ?? []) as { label: string; path: string }[];
// Draft accuracy, last 30 days: how often the draft went out unchanged (the measure for switching on automatic replies).
const since30 = new Date(Date.now() - 30 * 86400_000).toISOString();
const { data: recent30 } = await svc.from('shareholder_emails').select('id, entity_id, received_at, category, status, auto_send_at, shareholder_email_replies(kind, body, links, automatic, sent_at)').gte('received_at', since30).neq('status', 'ignored').in('entity_id', allowedIds);
const norm = (t: string) => t.replace(/\r/g, '').replace(/\s+/g, ' ').trim();
const accuracy = new Map<string, { emails: number; sent: number; unchanged: number; auto: number }>();
for (const r of recent30 ?? []) {
  const cat = r.category ?? 'other';
  const a = accuracy.get(cat) ?? { emails: 0, sent: 0, unchanged: 0, auto: 0 };
  a.emails++;
  const reps = (r.shareholder_email_replies ?? []) as { kind: string; body: string; links: { path: string }[]; automatic: boolean }[];
  const d = reps.find((x) => x.kind === 'draft'), sent = reps.find((x) => x.kind === 'sent');
  if (sent) {
    if (sent.automatic) a.auto++;
    else {
      a.sent++;
      if (d && norm(d.body) === norm(sent.body) && JSON.stringify(d.links.map((l) => l.path).sort()) === JSON.stringify(sent.links.map((l) => l.path).sort())) a.unchanged++;
    }
  }
  accuracy.set(cat, a);
}
// Response times per company, last 30 days: from arrival to the first reply.
const median = (xs: number[]) => { if (!xs.length) return null; const v = [...xs].sort((a, b) => a - b); const m = Math.floor(v.length / 2); return v.length % 2 ? v[m] : (v[m - 1] + v[m]) / 2; };
const duration = (min: number | null) => min == null ? '—' : min < 60 ? `${Math.round(min)} min` : min < 48 * 60 ? `${(min / 60).toFixed(1)} h` : `${Math.round(min / 1440)} days`;
const responseTimes = [...Map.groupBy(recent30 ?? [], (r) => r.entity_id)].map(([entityId, rows]) => {
  const person: number[] = [], auto: number[] = [];
  let open = 0, oldestOpen = 0;
  for (const r of rows) {
    const sent = ((r.shareholder_email_replies ?? []) as { kind: string; automatic: boolean; sent_at: string | null }[]).filter((x) => x.kind === 'sent' && x.sent_at).sort((a, b) => a.sent_at!.localeCompare(b.sent_at!))[0];
    const wait = (t: string) => (new Date(t).getTime() - new Date(r.received_at).getTime()) / 60000;
    if (sent) (sent.automatic ? auto : person).push(wait(sent.sent_at!));
    else if (['new', 'needs_person', 'draft_ready', 'auto_scheduled', 'error'].includes(r.status)) { open++; oldestOpen = Math.max(oldestOpen, wait(new Date().toISOString())); }
  }
  return { company: nameOf.get(entityId) ?? '—', received: rows.length, person: person.length, personMedian: median(person), auto: auto.length, autoMedian: median(auto), open, oldestOpen: open ? oldestOpen : null };
});
const badge = (s: string) => s === 'auto_scheduled' ? 'bg-lk-green/15 text-lk-green' : s === 'needs_person' ? 'bg-lk-orange/15 text-lk-orange' : s === 'draft_ready' ? 'bg-lk-blue/15 text-lk-blue' : s === 'replied' || s === 'handled' || s === 'board_qa' ? 'bg-lk-green/15 text-lk-green' : s === 'error' ? 'bg-lk-red/15 text-lk-red' : 'bg-white/10 text-white/50';
const q = (o: Record<string, string>) => `?${new URLSearchParams({ status: filterStatus, ...(filterCompany ? { company: filterCompany } : {}), ...o })}`;
---

<Admin title="Shareholder emails">
  <PageHeader title="Shareholder emails" subtitle="Emails to each company’s shareholder mailbox, sorted, matched to the shareholder and with a draft reply. A person sends every reply for now." />
  {!graphConfigured() && <div class="mb-6"><Alert tone="error">Microsoft 365 isn’t connected on this server yet, so no mailbox is read.</Alert></div>}
  {notice && <div class="mb-6"><Alert tone="success">{notice}</Alert></div>}
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}

  {current ? (
    <div class="grid gap-4 xl:grid-cols-[1fr_1fr]">
      <section class="card">
        <a href={`/admin/emails${q({})}`} class="text-sm text-white/50 hover:text-white">← All emails</a>
        <h2 class="mt-3 text-lg font-bold">{current.subject || '(no subject)'}</h2>
        <p class="mt-1 text-sm text-white/60">{current.from_name ? `${current.from_name} · ` : ''}{current.from_address} → {current.mailbox} · {dateTime.format(new Date(current.received_at))}</p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
          <span class:list={['rounded-full px-2.5 py-1 font-semibold', badge(current.status)]}>{STATUS_LABELS[current.status]}</span>
          <span class:list={['rounded-full px-2.5 py-1', current.sender_verified ? 'bg-lk-green/15 text-lk-green' : 'bg-lk-red/15 text-lk-red']} title={`SPF ${current.auth_spf ?? '—'} · DKIM ${current.auth_dkim ?? '—'} · DMARC ${current.auth_dmarc ?? '—'}`}>{current.sender_verified ? 'Sender verified' : 'Sender not verified'}</span>
          {person ? <a href={`/admin/investors/${person.id}`} class="rounded-full bg-white/10 px-2.5 py-1 text-white/70 hover:text-white">Shareholder: {[person.first_name, person.last_name].filter(Boolean).join(' ') || person.email}</a> : <span class="rounded-full bg-white/10 px-2.5 py-1 text-white/50">No portal account with this address</span>}
          {current.category && <span class="rounded-full bg-white/10 px-2.5 py-1 text-white/70">{CATEGORIES[current.category as Category] ?? current.category}{current.confidence != null ? ` · ${Math.round(Number(current.confidence) * 100)}%` : ''}</span>}
        </div>
        {current.summary && <p class="mt-4 rounded-xl bg-white/[0.04] px-4 py-3 text-sm text-white/75">{current.summary}</p>}
        {current.status !== 'auto_scheduled' && (current.requested as { auto?: string | null })?.auto && <p class="mt-2 text-xs text-white/45">Not automatic: {(current.requested as { auto: string }).auto}</p>}
        {((current.requested as { flags?: string[] })?.flags ?? []).length > 0 && <div class="mt-2 flex flex-wrap gap-1.5">{(current.requested as { flags: string[] }).flags.map((f) => <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-semibold', ['threat', 'distress'].includes(f) ? 'bg-lk-red/15 text-lk-red' : 'bg-lk-orange/15 text-lk-orange']}>{FLAGS[f as Flag] ?? f}</span>)}</div>}
        {current.error && <p class="mt-4 text-sm text-lk-red">{current.error}</p>}
        <pre class="mt-4 max-h-[32rem] overflow-auto whitespace-pre-wrap rounded-xl border border-white/5 bg-black/20 p-4 font-sans text-sm text-white/80">{current.body_text}</pre>
      </section>

      <section class="card">
        {['replied', 'handled', 'board_qa', 'ignored'].includes(current.status) && <p class="mb-4 text-sm text-white/55">{STATUS_LABELS[current.status]}{current.handled_at ? ` · ${dateTime.format(new Date(current.handled_at))}` : ''}{current.query_id ? <> · <a href={`/admin/queries/${current.query_id}`} class="text-lk-blue hover:underline">open in Board Q&amp;A</a></> : ''}</p>}
        {current.status === 'auto_scheduled' && current.auto_send_at && (
          <form method="post" class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-lk-green/30 bg-lk-green/10 px-4 py-3 text-sm">
            <span class="text-white/85">This reply goes automatically at <strong>{new Date(current.auto_send_at).toLocaleTimeString('en-AU', { timeZone: 'Australia/Sydney', hour: '2-digit', minute: '2-digit' })}</strong> (Sydney) unless you cancel it.</span>
            <input type="hidden" name="email_id" value={current.id} />
            <button name="intent" value="cancel-auto" class="btn-ghost !py-1.5 text-sm">Cancel automatic reply</button>
          </form>
        )}
        {(replies ?? []).filter((r) => r.kind === 'sent').map((r) => (
          <div class="mb-4 rounded-xl border border-white/5 p-4 text-sm">
            <p class="text-xs text-white/40">Sent to {r.sent_to} · {dateTime.format(new Date(r.sent_at))}{r.automatic ? ' · automatic' : ''}</p>
            <p class="mt-2 whitespace-pre-wrap text-white/80">{r.body}</p>
            {(r.links as { label: string }[]).length > 0 && <ul class="mt-2 list-disc pl-5 text-white/60">{(r.links as { label: string }[]).map((l) => <li>{l.label}</li>)}</ul>}
          </div>
        ))}
        {current.status !== 'ignored' && (
          <form method="post">
            <input type="hidden" name="email_id" value={current.id} />
            <h3 class="font-display font-bold text-white">Reply</h3>
            <p class="mt-1 text-xs text-white/45">Goes to {trusted && person ? `${person.email} (their registered address)` : current.from_address}, in the same Outlook thread.</p>
            <textarea name="body" rows="9" class="field mt-3 text-sm" required>{draft?.body ?? ''}</textarea>
            {trusted ? (
              <div class="mt-4">
                <p class="label">Portal links (the first becomes a one-time sign-in button)</p>
                <div class="max-h-56 space-y-1.5 overflow-auto rounded-xl border border-white/5 p-3 text-sm">
                  {options.map((o) => (
                    <label class="flex items-center gap-2 text-white/75"><input type="checkbox" name="link" value={JSON.stringify(o)} checked={draftLinks.some((l) => l.path === o.path)} class="size-4 accent-lk-blue" />{o.label}</label>
                  ))}
                  {!options.length && <p class="text-white/45">Nothing in the portal for this shareholder in this company.</p>}
                </div>
              </div>
            ) : <p class="mt-3 text-xs text-lk-orange">No portal links: the sender isn’t a verified, registered shareholder.</p>}
            <div class="mt-5 flex flex-wrap gap-2">
              <button name="intent" value="send" class="btn-primary" onclick="return confirm('Send this reply now?')">Send reply</button>
              <button name="intent" value="redraft" formnovalidate class="btn-ghost">Draft again</button>
              {trusted && !current.query_id && <button name="intent" value="board" formnovalidate class="btn-ghost">Turn into Board Q&amp;A</button>}
              <button name="intent" value="handled" formnovalidate class="btn-ghost">Mark handled</button>
              <button name="intent" value="ignore" formnovalidate class="btn-ghost">Ignore</button>
            </div>
          </form>
        )}
      </section>
    </div>
  ) : (
    <>
      <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
        {[['open', 'Open'], ['auto_scheduled', 'Automatic'], ['draft_ready', 'Draft ready'], ['needs_person', 'Needs a person'], ['replied', 'Replied'], ['ignored', 'Ignored'], ['all', 'All']].map(([k, label]) => (
          <a href={`?${new URLSearchParams({ status: k, ...(filterCompany ? { company: filterCompany } : {}) })}`} class:list={['rounded-full px-3 py-1.5', filterStatus === k ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>{label}</a>
        ))}
        <form class="ml-auto flex items-center gap-2">
          <input type="hidden" name="status" value={filterStatus} />
          {(companies ?? []).length > 1 && <select name="company" class="field !w-auto !py-1.5 text-sm" onchange="this.form.submit()"><option value="">All companies</option>{(companies ?? []).map((c) => <option value={c.id} selected={c.id === filterCompany}>{c.display_name}</option>)}</select>}
        </form>
        {isGroupAdmin && <form method="post"><button name="intent" value="poll" class="btn-ghost !py-1.5 text-sm">Check mailboxes now</button></form>}
      </div>
      <section class="card overflow-x-auto !p-0">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/5 text-xs uppercase tracking-widest text-white/40"><tr><th class="px-5 py-3 font-medium">Received</th><th class="px-5 py-3 font-medium">From</th><th class="px-5 py-3 font-medium">Email</th><th class="px-5 py-3 font-medium">Status</th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {(emails ?? []).map((e) => (
              <tr class="align-top">
                <td class="whitespace-nowrap px-5 py-3 text-white/60">{dateTime.format(new Date(e.received_at))}<span class="block text-xs text-white/40">{nameOf.get(e.entity_id)}</span></td>
                <td class="px-5 py-3"><span class="text-white/85">{e.from_name || e.from_address}</span><span class="block text-xs text-white/40">{e.from_address}{e.user_id ? ' · shareholder' : ''}{e.sender_verified ? '' : ' · not verified'}</span></td>
                <td class="px-5 py-3"><a href={`/admin/emails${q({ id: e.id })}`} class="text-white/85 hover:underline">{e.subject || '(no subject)'}</a>{e.summary && <span class="block text-xs text-white/45">{e.summary}</span>}</td>
                <td class="whitespace-nowrap px-5 py-3"><span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', badge(e.status)]}>{STATUS_LABELS[e.status]}</span></td>
              </tr>
            ))}
            {!emails?.length && <tr><td colspan="4" class="px-5 py-8 text-center text-white/45">No emails here.</td></tr>}
          </tbody>
        </table>
      </section>

      <section class="card mt-6 overflow-x-auto">
        <h2 class="text-lg font-bold">Response times, last 30 days</h2>
        <p class="mt-1 text-sm text-white/55">From arrival to the first reply (middle value). “Waiting” counts emails not yet answered, with the longest wait.</p>
        <table class="mt-4 w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-widest text-white/40"><tr><th class="py-2 pr-4 font-medium">Company</th><th class="py-2 pr-4 text-right font-medium">Emails</th><th class="py-2 pr-4 text-right font-medium">By a person</th><th class="py-2 pr-4 text-right font-medium">Automatic</th><th class="py-2 text-right font-medium">Waiting</th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {responseTimes.map((t) => (
              <tr><td class="py-2 pr-4 text-white/80">{t.company}</td><td class="py-2 pr-4 text-right">{t.received}</td>
                <td class="py-2 pr-4 text-right">{t.person ? `${t.person} · ${duration(t.personMedian)}` : '—'}</td>
                <td class="py-2 pr-4 text-right">{t.auto ? `${t.auto} · ${duration(t.autoMedian)}` : '—'}</td>
                <td class:list={['py-2 text-right', t.oldestOpen != null && t.oldestOpen > 24 * 60 ? 'font-semibold text-lk-orange' : '']}>{t.open ? `${t.open} · longest ${duration(t.oldestOpen)}` : '—'}</td></tr>
            ))}
            {!responseTimes.length && <tr><td colspan="5" class="py-4 text-center text-white/45">No emails yet.</td></tr>}
          </tbody>
        </table>
      </section>

      <section class="card mt-6 overflow-x-auto">
        <h2 class="text-lg font-bold">Draft accuracy, last 30 days</h2>
        <p class="mt-1 text-sm text-white/55">How often a person sent the draft unchanged. Switch on automatic replies for a request type when this is consistently high (for example 9 in 10).</p>
        <table class="mt-4 w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-widest text-white/40"><tr><th class="py-2 pr-4 font-medium">Request</th><th class="py-2 pr-4 text-right font-medium">Emails</th><th class="py-2 pr-4 text-right font-medium">Sent by a person</th><th class="py-2 pr-4 text-right font-medium">Draft unchanged</th><th class="py-2 text-right font-medium">Automatic</th></tr></thead>
          <tbody class="divide-y divide-white/5">
            {[...accuracy].sort((a, b) => b[1].emails - a[1].emails).map(([cat, a]) => (
              <tr><td class="py-2 pr-4 text-white/80">{CATEGORIES[cat as Category] ?? cat}</td><td class="py-2 pr-4 text-right">{a.emails}</td><td class="py-2 pr-4 text-right">{a.sent}</td>
                <td class:list={['py-2 pr-4 text-right font-semibold', a.sent && a.unchanged / a.sent >= 0.9 ? 'text-lk-green' : 'text-white/80']}>{a.sent ? `${Math.round((a.unchanged / a.sent) * 100)}% (${a.unchanged})` : '—'}</td><td class="py-2 text-right">{a.auto}</td></tr>
            ))}
            {!accuracy.size && <tr><td colspan="5" class="py-4 text-center text-white/45">No emails yet.</td></tr>}
          </tbody>
        </table>
      </section>

      {isGroupAdmin && <details class="card mt-6">
        <summary class="cursor-pointer text-lg font-bold">Mailbox settings</summary>
        <p class="mt-2 text-sm text-white/55">Each company’s shareholder mailbox. <strong>Review</strong>: read and prepare drafts; a person sends. <strong>Automatic</strong>: the chosen request types are answered by themselves, {AUTO_DELAY_MS / 60000} minutes after arrival (cancel in that time), only for verified, registered shareholders (colleagues too), never for forwarded emails, when Claude is at least {Math.round(AUTO_CONFIDENCE * 100)}% sure, at most {AUTO_PER_DAY} a day per shareholder and not twice for the same request. Everything else stays for a person.</p>
        <div class="mt-4 space-y-4">
          {(companies ?? []).map((c) => {
            const s = c.shareholder_mailbox ? syncOf.get(c.shareholder_mailbox) : undefined;
            return (
              <form method="post" class="grid gap-3 rounded-xl border border-white/5 p-4 sm:grid-cols-[10rem_1fr_9rem_auto] sm:items-end">
                <input type="hidden" name="entity_id" value={c.id} />
                <p class="font-semibold text-white">{c.display_name}<span class="block text-xs font-normal text-white/40">{s?.last_error ? <span class="text-lk-red">Error: {s.last_error}</span> : s?.last_checked_at ? `Checked ${dateTime.format(new Date(s.last_checked_at))}` : 'Not checked yet'}</span></p>
                <div><label class="label" for={`mb-${c.id}`}>Mailbox</label><input class="field" id={`mb-${c.id}`} name="mailbox" type="email" value={c.shareholder_mailbox ?? ''} placeholder="shareholders@…" /></div>
                <div><label class="label" for={`mode-${c.id}`}>Mode</label><select class="field" id={`mode-${c.id}`} name="mode"><option value="off" selected={c.email_mode === 'off'}>Off</option><option value="review" selected={c.email_mode === 'review'}>Review</option><option value="auto" selected={c.email_mode === 'auto'}>Automatic</option></select></div>
                <div class="flex gap-2"><button name="intent" value="settings" class="btn-ghost">Save</button><button name="intent" value="test-connection" formnovalidate class="btn-ghost">Test connection</button></div>
                <fieldset class="sm:col-span-4"><legend class="label">Answered automatically (in Automatic mode)</legend>
                  <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/75">{SELF_SERVICE.map((cat) => <label class="flex items-center gap-2"><input type="checkbox" name="auto_category" value={cat} checked={(c.email_auto_categories ?? []).includes(cat)} class="size-4 accent-lk-blue" />{CATEGORIES[cat]}</label>)}</div>
                </fieldset>
                <div class="sm:col-span-4"><label class="label" for={`sig-${c.id}`}>Signature (blank: “{c.display_name === 'Lakeba Group' ? 'Lakeba' : c.display_name} Investor Relations”)</label><textarea class="field text-sm" id={`sig-${c.id}`} name="signature" rows="2">{c.email_signature}</textarea></div>
              </form>
            );
          })}
        </div>
      </details>}
    </>
  )}
</Admin>
