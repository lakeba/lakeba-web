---
import Admin from '../../../../layouts/Admin.astro';
import Alert from '../../../../components/Alert.astro';
import { serviceClient } from '../../../../lib/admin';
import { field } from '../../../../lib/forms';
import { fileSize, shortDate } from '../../../../lib/format';
import { ITEM_COLUMNS, ITEM_STATES, REQUEST_COLUMNS, storeItemFiles, tellFinance, type AuditItem, type AuditRequest } from '../../../../lib/audit-requests';
import { senderCompanies } from '../../../../lib/reporting';

// A venture's year-end request: each item the auditor needs, provided with
// its files and a note; Lakeba accepts it or asks again.
const svc = serviceClient();
const companies = await senderCompanies(svc, Astro.locals.access);
const { data: row } = await svc.from('audit_requests').select(REQUEST_COLUMNS).eq('id', Astro.params.id ?? '').maybeSingle();
const r = row as AuditRequest | null;
const company = r ? companies.find((c) => c.id === r.entity_id) : null;
if (!r || !company) return Astro.redirect('/admin/reporting');
const mayDo = Astro.locals.access.can('reporting.do', company.id) && r.status === 'open';
let error = '', ok = '';

if (Astro.request.method === 'POST' && mayDo) {
  const form = await Astro.request.formData();
  try {
    const { data: it } = await svc.from('audit_items').select(ITEM_COLUMNS).eq('id', field(form, 'item_id')).eq('request_id', r.id).single();
    const item = it as AuditItem;
    if (item.status === 'accepted') throw new Error('Lakeba already accepted this one.');
    const added = await storeItemFiles(svc, company.id, r.id, form.getAll('files').filter((f): f is File => f instanceof File && f.size > 0));
    const note = field(form, 'note').slice(0, 2000);
    if (!added.length && !note && !item.files.length) throw new Error('Add the file(s), or a note saying why there is nothing.');
    await svc.from('audit_items').update({ files: [...item.files, ...added], note: note || item.note, status: 'provided', updated_by: Astro.locals.user!.id, updated_at: new Date().toISOString() }).eq('id', item.id).throwOnError();
    await tellFinance(svc, r, Astro.url.origin, `${company.display_name} provided “${item.title}”`, `For ${r.title}: ${added.length} file${added.length === 1 ? '' : 's'}${note ? ` and a note: ${note}` : ''}.`);
    await Astro.locals.supabase.rpc('log_event', { event_action: 'provided_audit_item', event_detail: { entity_id: company.id, request_id: r.id, item_id: item.id } });
    ok = `Provided “${item.title}”.`;
  } catch (e) {
    error = (e as Error).message;
  }
}
const { data: itemRows } = await svc.from('audit_items').select(ITEM_COLUMNS).eq('request_id', r.id).order('sort');
const items = (itemRows ?? []) as AuditItem[];
const left = items.filter((i) => i.status === 'requested').length;
const tone = { requested: 'text-lk-orange', provided: 'text-lk-blue', accepted: 'text-lk-green', not_applicable: 'text-white/40' };
---

<Admin title={r.title}>
  <div class="mb-6">
    <p class="text-sm text-white/45"><a href="/admin/reporting" class="hover:text-white">Reporting packs</a></p>
    <h1 class="mt-2 font-display text-3xl font-bold">{r.title}</h1>
    <p class="mt-1 text-sm text-white/55">Due {shortDate.format(new Date(`${r.due_on}T12:00:00+10:00`))}{r.auditor && ` · auditor ${r.auditor}`} · {left ? `${left} still to provide` : 'all provided'}{r.status === 'done' && ' · closed'}</p>
  </div>
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {ok && <div class="mb-6"><Alert tone="success">{ok}</Alert></div>}
  <ul class="grid max-w-3xl gap-3">
    {items.map((it) => (
      <li class="card !p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2"><span class="font-medium text-white">{it.title}</span><span class:list={['text-sm', tone[it.status]]}>{ITEM_STATES[it.status]}</span></div>
        {it.detail && <p class="mt-1 text-sm text-white/50">{it.detail}</p>}
        {it.review_note && it.status === 'requested' && <p class="mt-2 text-sm text-lk-orange">Lakeba asks: {it.review_note}</p>}
        {it.files.length > 0 && <ul class="mt-2 grid gap-1 text-sm">{it.files.map((f) => <li><a class="text-lk-blue hover:underline" href={`/admin/reporting/file?path=${encodeURIComponent(f.path)}`}>{f.name}</a> <span class="text-white/40">{fileSize(f.size)}</span></li>)}</ul>}
        {it.note && <p class="mt-2 text-sm text-white/65">Your note: {it.note}</p>}
        {mayDo && it.status !== 'accepted' && it.status !== 'not_applicable' && (
          <form method="post" enctype="multipart/form-data" class="mt-3 flex flex-wrap items-end gap-2">
            <input type="hidden" name="item_id" value={it.id} />
            <input class="field !w-auto !py-1.5 text-sm" type="file" name="files" multiple aria-label="Files" />
            <input class="field !w-auto grow !py-1.5 text-sm" name="note" placeholder="Note (optional)" aria-label="Note" />
            <button class="btn-primary !py-1.5 text-sm">{it.status === 'provided' ? 'Add more' : 'Provide'}</button>
          </form>
        )}
      </li>
    ))}
  </ul>
</Admin>
