---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import BoardAskNav from '../../../components/BoardAskNav.astro';
import { serviceClient } from '../../../lib/admin';
import { askEnabled } from '../../../lib/ask';
import { field } from '../../../lib/forms';
import { dateTime } from '../../../lib/format';
import { answerHtml } from '../../../lib/board-ask';
import { COST_PER_TEST, runTests, VERDICTS, type TestResult } from '../../../lib/board-ask-tests';

// Admin → Board Ask → Tests: questions with what a good answer must say, run
// on demand (each run costs money) and graded by Lakeba AI, to check Board Ask
// before and after changes. For people with Board Ask "do".
if (!Astro.locals.access.canAny('boardask.do')) return new Response('Forbidden', { status: 403 });
const svc = serviceClient();
const TOPICS = { law: 'Law', accounting: 'Accounting', portal: 'Portal records', xero: 'Xero', scope: 'What it must decline' } as const;
let error = '';
let ok = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const id = field(form, 'id');
  try {
    if (intent === 'save') {
      const row = { question: field(form, 'question').slice(0, 2000), expected: field(form, 'expected').slice(0, 4000), topic: field(form, 'topic') in TOPICS ? field(form, 'topic') : 'law' };
      if (row.question.length < 5 || row.expected.length < 5) throw new Error('Give the question and what a good answer must say.');
      if (id) await svc.from('board_ask_tests').update(row).eq('id', id).throwOnError();
      else await svc.from('board_ask_tests').insert({ ...row, created_by: Astro.locals.user!.id }).throwOnError();
      await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_saved_board_ask_test', event_detail: { question: row.question.slice(0, 200) } });
      ok = 'Saved.';
    } else if (intent === 'toggle') {
      const { data } = await svc.from('board_ask_tests').select('active').eq('id', id).single();
      await svc.from('board_ask_tests').update({ active: !data?.active }).eq('id', id);
    } else if (intent === 'delete') {
      await svc.from('board_ask_tests').delete().eq('id', id);
      await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_deleted_board_ask_test', event_detail: { test_id: id } });
      ok = 'Deleted.';
    } else if (intent === 'run') {
      if (!askEnabled) throw new Error('Lakeba AI isn’t configured on this server.');
      const { data: running } = await svc.from('board_ask_test_runs').select('id').eq('status', 'running').gte('started_at', new Date(Date.now() - 3600_000).toISOString()).limit(1);
      if (running?.length) throw new Error('A run is going already.');
      const { data: run } = await svc.from('board_ask_test_runs').insert({ started_by: Astro.locals.user!.id }).select('id').single().throwOnError();
      void runTests(svc, Astro.locals.access, Astro.locals.site?.central ?? Astro.url.origin, run!.id).catch((e) => console.error('board ask tests', e));
      await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_ran_board_ask_tests', event_detail: { run_id: run!.id } });
      return Astro.redirect(`/admin/board-ask/tests?run=${run!.id}`);
    }
  } catch (e) { error = (e as Error).message; }
}

const { data: tests } = await svc.from('board_ask_tests').select('id, question, expected, topic, active').order('topic').order('created_at');
const { data: runs } = await svc.from('board_ask_test_runs').select('id, status, results, cost_usd, started_at, finished_at').order('started_at', { ascending: false }).limit(10);
const shown = (runs ?? []).find((r) => r.id === Astro.url.searchParams.get('run')) ?? runs?.[0] ?? null;
const results = (shown?.results ?? []) as TestResult[];
const active = (tests ?? []).filter((t) => t.active).length;
const tally = (rs: TestResult[]) => Object.entries(VERDICTS).map(([k, l]) => `${rs.filter((r) => r.verdict === k).length} ${l.toLowerCase()}`).join(', ');
const editing = (tests ?? []).find((t) => t.id === Astro.url.searchParams.get('edit'));
const tone: Record<string, string> = { pass: 'text-lk-green', partial: 'text-lk-orange', fail: 'text-lk-red', error: 'text-lk-red' };
---

<Admin title="Board Ask · Tests">
  <PageHeader title="Board Ask" subtitle="Questions with what a good answer must say. Run them before and after changing the law library or Board Ask, and compare." />
  <BoardAskNav />
  {error && <Alert tone="error">{error}</Alert>}
  {ok && <Alert tone="success">{ok}</Alert>}

  <section class="card mb-6 !p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="font-display text-lg font-bold">Runs</h2>
        <p class="text-sm text-white/55">A run asks the {active} active questions as you would (with the companies your Board Ask covers) and grades each answer. About ${(active * COST_PER_TEST).toFixed(2)} a run; a few minutes.</p>
      </div>
      <form method="post" onsubmit={`return confirm('Run the ${active} tests? It costs about $${(active * COST_PER_TEST).toFixed(2)}.')`}><button class="btn-primary" name="intent" value="run" disabled={!active || !askEnabled}>Run the tests</button></form>
    </div>
    {(runs ?? []).length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2 text-xs">
        {(runs ?? []).map((r) => <li><a href={`/admin/board-ask/tests?run=${r.id}`} class:list={['rounded-full px-2.5 py-1', r.id === shown?.id ? 'bg-white/15 text-white' : 'bg-white/5 text-white/60 hover:text-white']}>{dateTime.format(new Date(r.started_at))} · {r.status === 'running' ? 'running' : tally(r.results as TestResult[])} · ${Number(r.cost_usd).toFixed(2)}</a></li>)}
      </ul>
    )}
    {shown && (
      <div class="mt-4 grid gap-3">
        {shown.status === 'running' && <p class="text-sm text-white/55">Running: {results.length} of {active} done. <a class="text-lk-blue hover:underline" href={`/admin/board-ask/tests?run=${shown.id}`}>Refresh</a></p>}
        {results.map((r) => (
          <details class="rounded-xl bg-white/5 px-4 py-3">
            <summary class="cursor-pointer text-sm"><span class:list={['mr-2 font-semibold', tone[r.verdict]]}>{VERDICTS[r.verdict]}</span><span class="text-white/80">{r.question}</span></summary>
            <p class="mt-2 text-xs text-white/55">{r.reason} · ${r.cost_usd.toFixed(3)}</p>
            {r.answer && <div class="mt-2 whitespace-pre-line text-sm leading-relaxed text-white/75" set:html={answerHtml(r.answer, r.sources)} />}
            {r.sources.length > 0 && <p class="mt-2 text-xs text-white/45">{r.sources.map((s) => `${s.ref} ${s.title}`).join(' · ')}</p>}
          </details>
        ))}
      </div>
    )}
  </section>

  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <section class="card overflow-x-auto p-0">
      <h2 class="px-5 pt-5 font-display text-lg font-bold">Questions</h2>
      <ul class="mt-2 divide-y divide-white/5 text-sm">
        {(tests ?? []).map((t) => (
          <li class:list={['px-5 py-3', !t.active && 'opacity-50']}>
            <p class="text-white"><span class="mr-2 rounded bg-white/10 px-1.5 py-0.5 text-xs text-white/60">{TOPICS[t.topic as keyof typeof TOPICS]}</span>{t.question}</p>
            <p class="mt-1 text-xs text-white/50">{t.expected}</p>
            <form method="post" class="mt-2 flex gap-3 text-xs">
              <input type="hidden" name="id" value={t.id} />
              <a class="text-white/50 hover:text-white" href={`/admin/board-ask/tests?edit=${t.id}#edit`}>Change</a>
              <button class="text-white/50 hover:text-white" name="intent" value="toggle">{t.active ? 'Leave out of runs' : 'Include in runs'}</button>
              <button class="text-white/50 hover:text-lk-orange" name="intent" value="delete" onclick="return confirm('Delete this test?')">Delete</button>
            </form>
          </li>
        ))}
      </ul>
    </section>
    <form method="post" class="card grid content-start gap-3" id="edit">
      <h2 class="font-display text-lg font-bold">{editing ? 'Change the test' : 'Add a test'}</h2>
      {editing && <input type="hidden" name="id" value={editing.id} />}
      <div><label class="label" for="question">Question</label><textarea class="field min-h-20" id="question" name="question" required maxlength="2000">{editing?.question}</textarea></div>
      <div><label class="label" for="expected">A good answer must</label><textarea class="field min-h-28" id="expected" name="expected" required maxlength="4000" placeholder="The points, sections and figures it must give, and anything it must not say.">{editing?.expected}</textarea></div>
      <div><label class="label" for="topic">Topic</label><select class="field" id="topic" name="topic">{Object.entries(TOPICS).map(([k, l]) => <option value={k} selected={editing?.topic === k}>{l}</option>)}</select></div>
      <div class="flex gap-3"><button class="btn-primary" name="intent" value="save">Save</button>{editing && <a class="btn-ghost" href="/admin/board-ask/tests">Cancel</a>}</div>
    </form>
  </div>
</Admin>
