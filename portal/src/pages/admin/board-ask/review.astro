---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BoardAskNav from '../../../components/BoardAskNav.astro';
import BoardNav from '../../../components/BoardNav.astro';
import { serviceClient } from '../../../lib/admin';
import { dateTime } from '../../../lib/format';
import { answerHtml, type Source } from '../../../lib/board-ask';

// Admin → Board Ask → Questions asked: everyone's questions and answers, with
// their ratings and cost, for Lakeba's group Admins to check the answers.
if (!Astro.locals.access.groupAdmin) return new Response('Forbidden', { status: 403 });
const svc = serviceClient();
const only = Astro.url.searchParams.get('only');
let q = svc.from('board_ask_messages').select('id, user_id, question, answer, sources, scope, status, error, cost_usd, rating, feedback, created_at').order('created_at', { ascending: false }).limit(100);
if (only === 'wrong') q = q.eq('rating', 'wrong');
const { data: rows } = await q;
const messages = (rows ?? []) as { id: string; user_id: string; question: string; answer: string; sources: Source[]; scope: string[]; status: string; error: string | null; cost_usd: number; rating: string | null; feedback: string; created_at: string }[];
const { data: people } = await svc.from('profiles').select('id, first_name, last_name, email').in('id', [...new Set(messages.map((m) => m.user_id))]);
const who = (id: string) => { const p = (people ?? []).find((x) => x.id === id); return p ? [p.first_name, p.last_name].filter(Boolean).join(' ') || p.email : 'Someone'; };
const monthStart = new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString();
const { data: month } = await svc.from('board_ask_messages').select('cost_usd').gte('created_at', monthStart);
const spent = (month ?? []).reduce((n, m) => n + Number(m.cost_usd), 0);
---

<Admin title="Board Ask · Questions asked">
  <BoardNav />
  <PageHeader title="Board Ask" subtitle="Everyone’s questions and answers, to check how it is doing. Answers marked wrong come first to look at." />
  <BoardAskNav />
  <div class="mb-4 flex flex-wrap items-center gap-3 text-sm">
    <span class="text-white/55">This month: {(month ?? []).length} questions, ${spent.toFixed(2)}.</span>
    <a class:list={['rounded-full px-3 py-1', only !== 'wrong' ? 'bg-white/15 text-white' : 'bg-white/5 text-white/60']} href="/admin/board-ask/review">All</a>
    <a class:list={['rounded-full px-3 py-1', only === 'wrong' ? 'bg-white/15 text-white' : 'bg-white/5 text-white/60']} href="/admin/board-ask/review?only=wrong">Marked wrong</a>
  </div>
  <div class="grid max-w-4xl gap-3">
    {messages.map((m) => (
      <details class="card !p-4">
        <summary class="cursor-pointer text-sm">
          <span class="text-white">{m.question}</span>
          <span class="block text-xs text-white/45">{who(m.user_id)} · {dateTime.format(new Date(m.created_at))} · {m.scope.join(', ')} · ${Number(m.cost_usd).toFixed(3)}{m.rating && ` · ${m.rating === 'good' ? 'helpful' : 'marked wrong'}`}{m.status !== 'done' && ` · ${m.status}`}</span>
        </summary>
        {m.feedback && <p class="mt-2 text-sm text-lk-orange">“{m.feedback}”</p>}
        {m.status === 'done' ? <div class="mt-3 whitespace-pre-line text-sm leading-relaxed text-white/80" set:html={answerHtml(m.answer, m.sources)} /> : <p class="mt-3 text-sm text-white/50">{m.error}</p>}
        {m.sources.length > 0 && <p class="mt-2 text-xs text-white/45">{m.sources.map((s) => `${s.ref} ${s.title}`).join(' · ')}</p>}
      </details>
    ))}
    {!messages.length && <p class="text-sm text-white/55">No questions yet.</p>}
  </div>
</Admin>
