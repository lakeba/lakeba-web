---
import Admin from '../../../layouts/Admin.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import LegalNav from '../../../components/LegalNav.astro';
import { serviceClient } from '../../../lib/admin';
import { field } from '../../../lib/forms';
import { dateTime } from '../../../lib/format';
import { answerHtml, askLegal, sourceHref, type Source } from '../../../lib/legal-ask';

// Admin → Legal → Legal Ask: questions about the companies' legal records,
// answered by Lakeba AI with links to its sources. Each person sees their own
// questions; a question within half an hour of the last one follows on from it.
const svc = serviceClient();
const userId = Astro.locals.user!.id;
let error = '';
let asked = '';
const FOLLOW_ON_MS = 30 * 60_000;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const question = field(form, 'question').slice(0, 2000);
  asked = question;
  try {
    if (question.length < 5) throw new Error('Ask a question.');
    const { data: recent } = form.get('fresh') === '1' ? { data: [] } : await svc.from('legal_ask_log').select('question, answer, created_at').eq('user_id', userId).gte('created_at', new Date(Date.now() - FOLLOW_ON_MS).toISOString()).order('created_at').limit(3);
    const { answer, sources, costUsd } = await askLegal(svc, Astro.locals.access, question, (recent ?? []).map((h) => ({ q: h.question, a: h.answer })));
    await svc.from('legal_ask_log').insert({ user_id: userId, question, answer, sources, cost_usd: costUsd }).throwOnError();
    await Astro.locals.supabase.rpc('log_event', { event_action: 'admin_asked_legal_ask', event_detail: { question: question.slice(0, 200) } });
    return Astro.redirect('/admin/legal/ask#latest');
  } catch (e) {
    error = (e as Error).message;
  }
}

const { data: rows } = await svc.from('legal_ask_log').select('id, question, answer, sources, created_at').eq('user_id', userId).order('created_at', { ascending: false }).limit(10);
const history = (rows ?? []).reverse() as { id: string; question: string; answer: string; sources: Source[]; created_at: string }[];
const followsOn = history.length > 0 && Date.now() - new Date(history.at(-1)!.created_at).getTime() < FOLLOW_ON_MS;
---

<Admin title="Legal · Legal Ask">
  <LegalNav />
  <PageHeader title="Legal" subtitle="Company records, officers and what is due, for every company in the group." />
  <div class="grid max-w-3xl gap-4">
    <p class="text-sm text-white/55">Ask about the companies' contracts, records, officers, deadlines, signed resolutions, minutes and governance documents. Lakeba AI answers from what is in the portal, with links to its sources; it finds and summarises, it doesn't give legal advice. A few cents a question.</p>
    {history.map((h, i) => (
      <article class="card !p-5" id={i === history.length - 1 ? 'latest' : undefined}>
        <p class="text-xs text-white/45">{dateTime.format(new Date(h.created_at))}</p>
        <p class="mt-1 font-medium text-white">{h.question}</p>
        <div class="mt-3 whitespace-pre-line text-sm leading-relaxed text-white/80" set:html={answerHtml(h.answer, h.sources)} />
        {h.sources.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2 text-xs">{h.sources.map((s) => <li><a class="rounded-full bg-white/10 px-2.5 py-1 text-white/70 hover:text-white" href={sourceHref(s)}>{s.ref} · {s.title}{s.company && ` · ${s.company}`}</a></li>)}</ul>
        )}
      </article>
    ))}
    {error && <Alert tone="error">{error}</Alert>}
    <form method="post" class="card grid gap-3" data-busy>
      <label class="label" for="question">{followsOn ? 'Ask a follow-up' : 'Ask'}</label>
      <textarea class="field min-h-24" id="question" name="question" required placeholder="e.g. Which contracts renew before March and have a change-of-control clause?">{asked}</textarea>
      <div class="flex flex-wrap gap-3">
        <button class="btn-primary" data-busy-label="Reading…">Ask</button>
        {followsOn && <button class="btn-ghost" name="fresh" value="1" data-busy-label="Reading…">Ask as a new topic</button>}
      </div>
    </form>
  </div>
</Admin>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-busy]').forEach((f) => f.addEventListener('submit', (e) => { const b = (e as SubmitEvent).submitter as HTMLButtonElement | null; if (b?.dataset.busyLabel) { b.textContent = b.dataset.busyLabel; setTimeout(() => (b.disabled = true)); } }));
</script>
