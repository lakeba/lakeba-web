---
import { assistantOn, mayMeeting, meetingCompanies } from '../../../../lib/boardroom';
import Admin from '../../../../layouts/Admin.astro';
import Alert from '../../../../components/Alert.astro';
import BoardNav from '../../../../components/BoardNav.astro';
import { serviceClient } from '../../../../lib/admin';
import { field } from '../../../../lib/forms';
import { addDays, fromSydney, legalCompanies, toSydney } from '../../../../lib/legal';
import { fileOf, storeLegalFile } from '../../../../lib/legal-actions';
import { RECORDING_COLUMNS, SOURCE_LABEL, removeAudio, segmentsOf, speakersOf, transcribeMeeting, useTranscript, type RecordingMeeting } from '../../../../lib/observer';
import { PROVIDERS, readyProviders, type Provider } from '../../../../lib/transcription';
import { answerHtml, type Source as BoardSource } from '../../../../lib/board-ask';
import { DECK_COLUMNS, MAX_DECK_FILE, ROLES, draftDeck, readUploadedDeck, type Deck, type Role } from '../../../../lib/decks';
import { connectTablet, releaseTablet, tabletsOf } from '../../../../lib/tablets';
import { BOT_STATES, botActive, leaveLex, platformOf, recallReady, sendLex } from '../../../../lib/recall';
import { consentWording } from '../../../../lib/observer';
import { MEETING_COLUMNS, PAPER_COLUMNS, TRANSCRIPT_CHARS, draftMinutes, reference, transcriptText, type Attendee, type Meeting, type Paper } from '../../../../lib/legal-board';

// Admin → Legal → a company → Board → a meeting: who was there, the agenda,
// notes and transcript; Lakeba AI drafts the minutes from them, and the
// minutes go to the chair to sign.
const svc = serviceClient();
const access = Astro.locals.access;
const { data: row } = await svc.from('board_meetings').select(`${MEETING_COLUMNS}, ${RECORDING_COLUMNS}`).eq('id', Astro.params.id ?? '').maybeSingle();
const companies = await meetingCompanies(svc, access);
const company = row ? companies.find((c) => c.id === row.entity_id) : null;
if (!row || !company) return Astro.redirect('/admin/legal/companies');
let meeting = row as unknown as RecordingMeeting;
const mayDo = mayMeeting(access, company.id, 'do');
const legalView = access.can('legal.view', company.id);
const back = legalView ? `/admin/legal/companies/${company.code}?tab=board` : '/admin/board';
const assistant = await assistantOn(svc, company.id);
const log = (action: string, detail: Record<string, unknown> = {}) => Astro.locals.supabase.rpc('log_event', { event_action: action, event_detail: { entity_id: company.id, meeting_id: meeting.id, ...detail } });
const minutesQuery = () => svc.from('board_papers').select(PAPER_COLUMNS).eq('meeting_id', meeting.id).neq('status', 'withdrawn').maybeSingle();
let minutes = (await minutesQuery()).data as Paper | null;
let error = '', ok = '';

if (Astro.request.method === 'POST' && mayDo) {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  try {
    if (intent === 'save' || intent === 'draft') {
      const held = fromSydney(field(form, 'held_at'));
      if (!held || field(form, 'title').length < 3) throw new Error('Give the meeting a title and when it was held.');
      const attendees: Attendee[] = meeting.attendees.filter((a) => a.officer_id).map((a) => ({ ...a, present: form.get(`present-${a.officer_id}`) === 'on' }));
      for (const g of String(form.get('guests') ?? '').split('\n').map((l) => l.trim()).filter(Boolean).slice(0, 30)) attendees.push({ name: g.slice(0, 200), role: 'guest', present: true });
      let transcript = String(form.get('transcript') ?? '').slice(0, TRANSCRIPT_CHARS);
      let transcriptPath = meeting.transcript_path;
      const file = fileOf(form, 'transcript_file');
      if (file) {
        if (!/\.(txt|vtt|srt|md)$/i.test(file.name)) throw new Error('The transcript must be a text file (.txt, .vtt or .srt). From Word, save it as plain text first.');
        transcript = transcriptText(file.name, await file.text()).slice(0, TRANSCRIPT_CHARS);
        transcriptPath = await storeLegalFile(svc, company.id, `meetings/${meeting.id}`, file);
      }
      const patch = {
        title: field(form, 'title').slice(0, 200), held_at: held.toISOString(), location: field(form, 'location').slice(0, 200), attendees,
        chair_officer_id: field(form, 'chair') || null, agenda: field(form, 'agenda').slice(0, 20000), notes: field(form, 'notes').slice(0, 50000),
        transcript, transcript_path: transcriptPath, updated_at: new Date().toISOString(),
      };
      await svc.from('board_meetings').update(patch).eq('id', meeting.id).throwOnError();
      meeting = { ...meeting, ...patch };
      // The minutes reminder follows the meeting's date.
      await svc.from('legal_obligations').update({ due_on: addDays(toSydney(patch.held_at).slice(0, 10), 30), title: `Minutes of “${patch.title}” signed by the chair` }).eq('source_key', `minutes:${meeting.id}`).eq('status', 'open').eq('date_kept', false);
      await log('admin_saved_board_meeting');
      ok = 'Saved the meeting.';
      if (intent === 'draft') {
        if (minutes && minutes.status !== 'draft') throw new Error('The minutes were already sent for signing; take them back to a draft first.');
        const { data: lex } = await svc.from('board_meeting_assistant').select('question, spoken, answer').eq('meeting_id', meeting.id).eq('status', 'done').order('created_at');
        const { data: shown } = await svc.from('board_decks').select('title, role, approved_by').eq('meeting_id', meeting.id).not('presented_at', 'is', null).order('presented_at');
        const ids = [...new Set((shown ?? []).map((d) => d.approved_by).filter(Boolean))] as string[];
        const { data: approvers } = ids.length ? await svc.from('profiles').select('id, first_name, last_name, email').in('id', ids) : { data: [] };
        const nameOf = (id: string | null) => { const p = (approvers ?? []).find((x) => x.id === id); return p ? [p.first_name, p.last_name].filter(Boolean).join(' ') || p.email : ''; };
        const presented = (shown ?? []).map((d) => ({ title: d.title as string, on: ROLES[d.role as Role].on, approvedBy: nameOf(d.approved_by as string | null) }));
        if (!meeting.agenda && !meeting.notes && !meeting.transcript && !lex?.length && !presented.length) throw new Error('Add the agenda, notes or a transcript for Lakeba AI to draft from.');
        const { body, costUsd } = await draftMinutes(meeting, company.legal_name ?? company.display_name, lex ?? [], presented);
        const title = `Minutes – ${meeting.title}`.slice(0, 300);
        if (minutes) await svc.from('board_papers').update({ body, title, ai_cost_usd: costUsd, updated_at: new Date().toISOString() }).eq('id', minutes.id).throwOnError();
        else {
          const { data: ob } = await svc.from('legal_obligations').select('id').eq('source_key', `minutes:${meeting.id}`).maybeSingle();
          const { data } = await svc.from('board_papers').insert({ entity_id: company.id, kind: 'minutes', meeting_id: meeting.id, title, body, obligation_id: ob?.id ?? null, ai_cost_usd: costUsd, created_by: Astro.locals.user!.id }).select('id').single().throwOnError();
          minutes = { id: data!.id } as Paper;
        }
        await log('admin_drafted_minutes', { paper_id: minutes.id, cost_usd: costUsd });
        return Astro.redirect(`/admin/board/papers/${minutes.id}`);
      }
    } else if (intent === 'use-transcript' || intent === 'name-speakers') {
      const source = field(form, 'source');
      if (!/^(live|batch):(deepgram|assemblyai)$/.test(source)) throw new Error('Choose a transcript.');
      if (intent === 'name-speakers') {
        const names: Record<string, string> = {};
        for (const [k, v] of form.entries()) if (k.startsWith('speaker:') && String(v).trim()) names[k.slice(8)] = String(v).trim().slice(0, 200);
        await svc.from('board_meetings').update({ speaker_names: { ...meeting.speaker_names, [source]: names } }).eq('id', meeting.id).throwOnError();
      }
      await useTranscript(svc, meeting.id, source);
      await log(intent === 'use-transcript' ? 'admin_chose_meeting_transcript' : 'admin_named_meeting_speakers', { source });
      return Astro.redirect(`/admin/board/meetings/${meeting.id}#observer`);
    } else if (intent === 'draft-deck' || intent === 'upload-deck') {
      const role = field(form, 'role') as Role;
      if (!(role in ROLES)) throw new Error('Choose whose deck it is.');
      const { data: other } = await svc.from('board_decks').select('id').eq('meeting_id', meeting.id).eq('status', 'preparing').limit(1);
      if (other?.length) throw new Error('Another deck is being prepared; wait for it to finish.');
      const base = { meeting_id: meeting.id, entity_id: company.id, role, created_by: Astro.locals.user!.id, status: 'preparing' };
      if (intent === 'draft-deck') {
        if (role === 'other') throw new Error('Lex drafts CFO and Chief Risk Officer decks.');
        const { data: d } = await svc.from('board_decks').insert({ ...base, source: 'drafted', title: `${ROLES[role].name} report – ${meeting.title}`.slice(0, 200) }).select('id').single().throwOnError();
        void draftDeck(svc, Astro.locals.access, Astro.locals.site?.central ?? Astro.url.origin, d!.id).catch((e) => console.error('deck draft', e));
        await log('admin_drafted_board_deck', { deck_id: d!.id, role });
      } else {
        const file = fileOf(form, 'deck');
        if (!file || !/\.pdf$/i.test(file.name)) throw new Error('Choose the deck as a PDF (from PowerPoint or Keynote: Export or Save as PDF).');
        if (file.size > MAX_DECK_FILE) throw new Error('The deck is larger than 30 MB.');
        const title = field(form, 'title') || file.name.replace(/\.pdf$/i, '');
        const path = await storeLegalFile(svc, company.id, `meetings/${meeting.id}/decks`, file);
        const { data: d } = await svc.from('board_decks').insert({ ...base, source: 'uploaded', title: title.slice(0, 200), file_path: path }).select('id').single().throwOnError();
        void readUploadedDeck(svc, d!.id).catch((e) => console.error('deck upload', e));
        await log('admin_uploaded_board_deck', { deck_id: d!.id, role });
      }
      return Astro.redirect(`/admin/board/meetings/${meeting.id}#decks`);
    } else if (intent === 'tablet-connect') {
      // The boardroom tablet shows a code (/tablet); entering it here connects the tablet to this meeting.
      if (!assistant) throw new Error('The board assistant isn’t switched on for this company.');
      if (['processing', 'done'].includes(meeting.recording_status) || meeting.audio_deleted_at) throw new Error('This meeting’s recording is finished.');
      const t = await connectTablet(svc, field(form, 'code'), meeting, Astro.locals.user!.id);
      await log('admin_connected_board_tablet', { tablet_id: t.id, device: t.device_name });
      ok = `Connected${t.device_name ? ` “${t.device_name}”` : ' the tablet'}: it opens this meeting’s Observer now.`;
    } else if (intent === 'online-send') {
      // Lex joins the online meeting (lib/recall.ts). Everyone attending agreed to the recording, as the chair confirms on the tablet.
      if (!assistant) throw new Error('The board assistant isn’t switched on for this company.');
      if (['processing', 'done'].includes(meeting.recording_status) || meeting.audio_deleted_at) throw new Error('This meeting’s recording is finished.');
      const present = meeting.attendees.filter((a) => a.present).map((a) => a.name);
      if (!present.length) throw new Error('Tick who is at the meeting first (above), then send Lex.');
      if (!platformOf(field(form, 'meeting_url'))) throw new Error('Paste the meeting’s link from Teams, Zoom, Google Meet or Webex (https://…).');
      if (!meeting.recording_consent) {
        if (form.get('agreed') !== 'on') throw new Error('Confirm that everyone attending agreed to the recording.');
        const chairName = meeting.attendees.find((a) => a.officer_id && a.officer_id === meeting.chair_officer_id)?.name ?? '';
        const profile = Astro.locals.profile;
        const consent = { at: new Date().toISOString(), by: Astro.locals.user!.id, by_name: [profile?.first_name, profile?.last_name].filter(Boolean).join(' ') || profile?.email || '', chair: chairName, wording: consentWording(company.legal_name ?? company.display_name), present, agreed: present, online: true };
        await svc.from('board_meetings').update({ recording_consent: consent }).eq('id', meeting.id).throwOnError();
        meeting = { ...meeting, recording_consent: consent };
        await log('admin_recorded_meeting_consent', { agreed: present.length, online: true });
      }
      const sent = await sendLex(svc, meeting, field(form, 'meeting_url'), Astro.locals.user!.id, Astro.locals.site?.central ?? Astro.url.origin, company.legal_name ?? company.display_name);
      meeting = { ...meeting, online_bot: sent };
      await log('admin_sent_lex_online', { platform: sent.platform, bot_id: sent.bot_id });
      ok = `Lex is on its way to the ${sent.platform} meeting. In Teams and Google Meet, admit “Lex (Lakeba)” from the lobby.`;
    } else if (intent === 'online-leave') {
      await leaveLex(svc, meeting);
      await log('admin_asked_lex_to_leave', { bot_id: meeting.online_bot?.bot_id });
      ok = 'Lex is leaving the meeting. The full transcript follows here.';
    } else if (intent === 'tablet-release') {
      const t = (await tabletsOf(svc, meeting.id)).find((x) => x.id === field(form, 'tablet_id'));
      if (!t) throw new Error('That tablet isn’t connected to this meeting.');
      await releaseTablet(svc, t.id, 'Disconnected from the meeting’s page.');
      await log('admin_disconnected_board_tablet', { tablet_id: t.id });
      ok = 'Disconnected the tablet. It shows a new code to connect again.';
    } else if (intent === 'full-pass') {
      const provider = field(form, 'provider') as Provider;
      if (!readyProviders().includes(provider)) throw new Error('That transcription service isn’t set up.');
      if (meeting.audio_deleted_at) throw new Error('The recording was deleted when the minutes were signed.');
      await svc.from('board_meetings').update({ recording_status: 'processing', recording_error: null }).eq('id', meeting.id);
      void transcribeMeeting(svc, meeting.id, provider, Astro.locals.site?.central ?? Astro.url.origin).catch((e) => console.error('observer transcription', e));
      await log('admin_transcribed_meeting_recording', { provider });
      return Astro.redirect(`/admin/board/meetings/${meeting.id}#observer`);
    } else if (intent === 'delete') {
      if (minutes && minutes.status === 'signed') throw new Error('Signed minutes stay in the minute book, with their meeting.');
      await svc.from('legal_obligations').delete().eq('source_key', `minutes:${meeting.id}`).eq('status', 'open');
      await removeAudio(svc, meeting);
      const { data: decksOf } = await svc.from('board_decks').select('file_path').eq('meeting_id', meeting.id);
      const deckFiles = (decksOf ?? []).map((d) => d.file_path).filter(Boolean) as string[];
      if (deckFiles.length) await svc.storage.from('legal').remove(deckFiles);
      await svc.from('board_meetings').delete().eq('id', meeting.id).throwOnError();
      await log('admin_deleted_board_meeting', { title: meeting.title });
      return Astro.redirect(back);
    }
  } catch (e) {
    error = (e as Error).message;
  }
  minutes = (await minutesQuery()).data as Paper | null;
}
const officersPresent = meeting.attendees.filter((a) => a.officer_id);
// The Observer: recording, transcripts found, the speakers of the one in use.
const { data: sourceRows } = await svc.from('board_meeting_segments').select('source').eq('meeting_id', meeting.id).limit(5000);
const sources = [...new Set((sourceRows ?? []).map((r) => r.source as string))].sort((a, b) => (a.startsWith('batch') === b.startsWith('batch') ? a.localeCompare(b) : a.startsWith('batch') ? -1 : 1));
const current = meeting.transcript_source && sources.includes(meeting.transcript_source) ? meeting.transcript_source : null;
const speakers = current ? speakersOf(await segmentsOf(svc, meeting.id, current)) : [];
const names = current ? meeting.speaker_names[current] ?? {} : {};
const people = meeting.attendees.filter((a) => a.present).map((a) => a.name);
const ready = readyProviders();
const { data: deckRows } = await svc.from('board_decks').select(DECK_COLUMNS).eq('meeting_id', meeting.id).order('created_at');
const decks = (deckRows ?? []) as unknown as Deck[];
const { data: lexRows } = await svc.from('board_meeting_assistant').select('id, how, offset_ms, question, spoken, answer, sources, status, error, created_at').eq('meeting_id', meeting.id).order('created_at');
const lexAnswers = (lexRows ?? []) as { id: string; how: string; offset_ms: number | null; question: string; spoken: string; answer: string; sources: BoardSource[]; status: string; error: string | null; created_at: string }[];
const tablets = assistant ? (await tabletsOf(svc, meeting.id)).filter((t) => t.kind !== 'bot') : [];
const online = meeting.online_bot;
const onlineReady = recallReady();
const tabletNames = new Map<string, string>();
if (tablets.length) {
  const { data: by } = await svc.from('profiles').select('id, first_name, last_name, email').in('id', [...new Set(tablets.map((t) => t.paired_by!))]);
  for (const p of by ?? []) tabletNames.set(p.id, [p.first_name, p.last_name].filter(Boolean).join(' ') || p.email);
}
const recordedMinutes = Math.round(meeting.recording_takes.reduce((n, t) => n + (t.ended_at ? Date.parse(t.ended_at) - Date.parse(t.started_at) : 0), 0) / 60000);
const STATUS: Record<string, string> = { none: 'Not recorded', recording: 'Recording now', paused: 'Paused', processing: 'Preparing the full transcript…', done: 'Recorded and transcribed', failed: 'The transcription failed' };
const guests = meeting.attendees.filter((a) => !a.officer_id).map((a) => a.name).join('\n');
const roleWord = { director: 'Director', secretary: 'Company secretary', guest: 'Guest' };
---

<Admin title={meeting.title}>
  {legalView && <BoardNav />}
  <div class="mb-6">
    <p class="text-sm text-white/45"><a href="/admin/board" class="hover:text-white">Board meetings</a> · <a href={`/admin/board#company-${company.code}`} class="hover:text-white">{company.display_name}</a></p>
    <h1 class="mt-2 font-display text-3xl font-bold">{meeting.title}</h1>
    <p class="mt-1 text-sm text-white/55">Directors’ meeting · {minutes ? <a class="text-lk-blue hover:underline" href={`/admin/board/papers/${minutes.id}`}>minutes {reference(minutes)}: {minutes.status === 'draft' ? 'draft' : minutes.status === 'signing' ? 'waiting for the chair' : 'signed'}</a> : 'no minutes yet'}</p>
  </div>
  {error && <div class="mb-6"><Alert tone="error">{error}</Alert></div>}
  {ok && <div class="mb-6"><Alert tone="success">{ok}</Alert></div>}

  <form method="post" enctype="multipart/form-data" class="grid gap-6 xl:grid-cols-[1fr_22rem]" data-busy>
    <fieldset disabled={!mayDo} class="contents">
      <div class="card grid content-start gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="label" for="title">Title</label><input class="field" id="title" name="title" value={meeting.title} required /></div>
        <div><label class="label" for="held_at">Held (Sydney time)</label><input class="field" type="datetime-local" id="held_at" name="held_at" value={toSydney(meeting.held_at)} required /></div>
        <div><label class="label" for="location">Where</label><input class="field" id="location" name="location" value={meeting.location} /></div>
        <div class="sm:col-span-2" data-tour="meet-agenda"><label class="label" for="agenda">Agenda</label><textarea class="field min-h-28" id="agenda" name="agenda" placeholder="1. Apologies and declarations of interest&#10;2. Minutes of the last meeting&#10;3. CEO report&#10;…">{meeting.agenda}</textarea></div>
        <div class="sm:col-span-2"><label class="label" for="notes">Notes</label><textarea class="field min-h-48" id="notes" name="notes" placeholder="What was discussed and decided, in any form: Lakeba AI turns it into minutes.">{meeting.notes}</textarea></div>
        <div class="sm:col-span-2" data-tour="meet-transcript">
          <label class="label" for="transcript_file">Transcript (optional)</label>
          <input class="field" type="file" id="transcript_file" name="transcript_file" accept=".txt,.vtt,.srt,.md,text/plain,text/vtt" />
          <p class="mt-1 text-xs text-white/40">The transcript Teams, Zoom or Google Meet makes (.vtt or .txt). For a meeting in the room, record it with the Observer below.</p>
          {meeting.transcript && <details class="mt-2"><summary class="cursor-pointer text-xs text-white/55">Transcript on file ({Math.round(meeting.transcript.length / 1000)}k characters) · show or change</summary><textarea class="field mt-2 min-h-40" name="transcript">{meeting.transcript}</textarea></details>}
          {!meeting.transcript && <input type="hidden" name="transcript" value="" />}
        </div>
      </div>
      <aside class="grid content-start gap-6">
        <div class="card grid gap-3 text-sm" data-tour="meet-attendees">
          <h2 class="font-display text-lg font-bold">Who was there</h2>
          {officersPresent.length ? officersPresent.map((a) => (
            <label class="flex items-start gap-3"><input type="checkbox" name={`present-${a.officer_id}`} checked={a.present} class="mt-0.5 size-4 accent-lk-blue" /><span><span class="text-white">{a.name}</span><span class="block text-xs text-white/45">{roleWord[a.role]} · unticked = apology</span></span></label>
          )) : <p class="text-white/55">No officers were in office on the day.</p>}
          <div><label class="label" for="chair">Chair</label><select class="field" id="chair" name="chair"><option value="">Choose…</option>{officersPresent.filter((a) => a.role === 'director').map((a) => <option value={a.officer_id} selected={a.officer_id === meeting.chair_officer_id}>{a.name}</option>)}</select></div>
          <div><label class="label" for="guests">Also attending</label><textarea class="field min-h-20" id="guests" name="guests" placeholder="One per line, e.g. Jane Smith (CFO)">{guests}</textarea></div>
        </div>
        {mayDo && (
          <div class="card grid gap-3" data-tour="meet-minutes">
            <button class="btn-ghost" name="intent" value="save">Save</button>
            <button class="btn-primary" name="intent" value="draft" data-busy-label="Drafting…">{minutes ? 'Draft the minutes again' : 'Draft the minutes'}</button>
            <p class="text-xs text-white/45">Lakeba AI writes the minutes from the agenda, notes and transcript (a few cents); you check and change them before they go to the chair.{minutes?.status === 'draft' && ' Drafting again replaces the current draft.'}</p>
            {!(minutes && minutes.status === 'signed') && <button class="btn-ghost text-lk-red" name="intent" value="delete" formnovalidate data-confirm="Delete this meeting and any draft minutes?">Delete the meeting</button>}
          </div>
        )}
      </aside>
    </fieldset>
  </form>

  {!assistant && (
    <section class="card mt-6 text-sm text-white/55" id="observer">The board assistant (the Observer, Lex and the decks it presents) isn’t switched on for {company.display_name} yet. Lakeba’s Admins switch it on in Admin → Companies.</section>
  )}
  {assistant && <>
  <section class="card mt-6 grid gap-4" id="decks">
    <div>
      <h2 class="font-display text-lg font-bold">Decks Lex presents</h2>
      <p class="text-sm text-white/55">Lex presents an approved deck at the meeting, slide by slide, in its own voice, on behalf of the CFO or the Chief Risk Officer, with the slides on the room screen. Directors can interrupt with “Lex, …”.</p>
    </div>
    {decks.length > 0 && (
      <ul class="grid gap-2 text-sm">
        {decks.map((d) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-white/[0.03] px-4 py-3">
            <span>
              <a class="text-white hover:underline" href={`/admin/board/meetings/${meeting.id}/decks/${d.id}`}>{d.title}</a>
              <span class="block text-xs text-white/45">{ROLES[d.role].name} · {d.source === 'drafted' ? 'drafted by Lex' : 'uploaded'} · {d.status === 'preparing' ? (d.source === 'drafted' ? 'Lex is drafting it…' : 'Lex is reading it…') : d.status === 'failed' ? `failed: ${d.error}` : `${d.slides.length} slides · ${d.status === 'approved' ? 'approved' : 'draft, to check and approve'}`}{d.presented_at && ' · presented'}</span>
            </span>
            {d.status === 'preparing' && <a class="text-xs text-lk-blue hover:underline" href={`/admin/board/meetings/${meeting.id}#decks`}>Refresh</a>}
          </li>
        ))}
      </ul>
    )}
    {mayDo && (
      <div class="grid gap-4 md:grid-cols-2">
        <form method="post" class="grid content-start gap-2 rounded-xl bg-white/[0.03] p-4" data-busy>
          <p class="text-sm text-white">Lex drafts a deck</p>
          <p class="text-xs text-white/45">From the reporting packs, the group view, legal records, contracts and deadlines, with what to say for each slide. A few cents; a minute or so. You check and approve it.</p>
          <div class="flex flex-wrap gap-2">
            <button class="btn-ghost !py-2 text-sm" name="role" value="cfo" data-busy-label="Starting…">CFO report</button>
            <button class="btn-ghost !py-2 text-sm" name="role" value="cro" data-busy-label="Starting…">Risk report</button>
          </div>
          <input type="hidden" name="intent" value="draft-deck" />
        </form>
        <form method="post" enctype="multipart/form-data" class="grid content-start gap-2 rounded-xl bg-white/[0.03] p-4" data-busy>
          <p class="text-sm text-white">Present your own deck</p>
          <input class="field" name="title" placeholder="Title (optional)" maxlength="200" />
          <div class="flex flex-wrap gap-2"><select class="field !w-auto" name="role">{Object.entries(ROLES).map(([k, r]) => <option value={k}>{k === 'other' ? 'Another presenter' : `On behalf of the ${r.name}`}</option>)}</select><input class="field" type="file" name="deck" accept=".pdf,application/pdf" required /></div>
          <p class="text-xs text-white/45">A PDF (export it from PowerPoint or Keynote). Lex writes what to say for each page; you check and approve it.</p>
          <div><button class="btn-ghost !py-2 text-sm" name="intent" value="upload-deck" data-busy-label="Uploading…">Upload</button></div>
        </form>
      </div>
    )}
  </section>

  <section class="card mt-6 grid gap-4" id="observer" data-tour="meet-observer">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="font-display text-lg font-bold">Observer</h2>
        <p class="text-sm text-white/55">{STATUS[meeting.recording_status] ?? meeting.recording_status}{recordedMinutes > 0 && ` · ${recordedMinutes} minutes recorded in ${meeting.recording_takes.length} ${meeting.recording_takes.length === 1 ? 'part' : 'parts'}`}{meeting.audio_deleted_at && ' · audio deleted when the minutes were signed'}</p>
        {meeting.recording_error && <p class="mt-1 text-sm text-lk-orange">{meeting.recording_error}</p>}
        {meeting.recording_consent && <p class="mt-1 text-xs text-white/45">Everyone present agreed ({meeting.recording_consent.agreed.join(', ')}), confirmed by {meeting.recording_consent.by_name || 'the secretary'}{meeting.recording_consent.chair && ` with ${meeting.recording_consent.chair} as chair`}, {new Date(meeting.recording_consent.at).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', dateStyle: 'medium', timeStyle: 'short' })}.</p>}
      </div>
      {mayDo && !meeting.audio_deleted_at && meeting.recording_status !== 'processing' && meeting.recording_status !== 'done' && (
        <a class="btn-primary" href={`/admin/board/meetings/${meeting.id}/observe`}>{meeting.recording_takes.length ? 'Open the Observer' : 'Record this meeting'}</a>
      )}
    </div>
    {!ready.length && <p class="text-sm text-white/55">Recording needs a transcription service: a Deepgram or AssemblyAI key on the server.</p>}
    {mayDo && ready.length > 0 && !meeting.audio_deleted_at && meeting.recording_status !== 'processing' && meeting.recording_status !== 'done' && (
      <div class="grid gap-3 rounded-xl bg-white/[0.03] p-4" id="tablet">
        <form method="post" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="tablet-connect" />
          <div class="grow">
            <label class="label" for="tablet-code">Connect a tablet</label>
            <input class="field font-display text-xl tracking-[0.3em]" id="tablet-code" name="code" inputmode="numeric" autocomplete="off" pattern="[0-9 ]{6,7}" maxlength="7" placeholder="000 000" required />
          </div>
          <button class="btn-primary">Connect</button>
          <p class="basis-full text-xs text-white/45">Open the Lex app on the boardroom tablet (or <span class="font-mono">{Astro.url.origin}/tablet</span> in its browser) and enter the six-digit code it shows. The tablet then opens this meeting’s Observer, acting for you, and nothing else; it lets go when the meeting is finished.</p>
        </form>
        {tablets.length > 0 && (
          <ul class="grid gap-2 text-sm">
            {tablets.map((t) => (
              <li class="flex flex-wrap items-center justify-between gap-3">
                <span><span class="mr-2 inline-block size-2 rounded-full bg-lk-green"></span>{t.device_name || 'Boardroom tablet'} · connected by {tabletNames.get(t.paired_by!) ?? 'someone'}{t.last_seen_at && <span class="text-white/45"> · seen {new Date(t.last_seen_at).toLocaleTimeString('en-AU', { timeZone: 'Australia/Sydney', hour: 'numeric', minute: '2-digit' })}</span>}</span>
                <form method="post"><input type="hidden" name="intent" value="tablet-release" /><input type="hidden" name="tablet_id" value={t.id} /><button class="btn-ghost !py-1.5 text-xs">Disconnect</button></form>
              </li>
            ))}
          </ul>
        )}
      </div>
    )}
    {mayDo && onlineReady && ready.length > 0 && (botActive(online) || (!meeting.audio_deleted_at && meeting.recording_status !== 'processing' && meeting.recording_status !== 'done')) && (
      <div class="grid gap-3 rounded-xl bg-white/[0.03] p-4" id="online" data-live={botActive(online) ? '1' : ''} data-tour="meet-online">
        {botActive(online) ? (
          <form method="post" class="flex flex-wrap items-center justify-between gap-3">
            <input type="hidden" name="intent" value="online-leave" />
            <div>
              <p class="font-semibold text-white">Lex in the {online!.platform} meeting: {BOT_STATES[online!.status] ?? online!.status}</p>
              <p class="text-xs text-white/45">Sent {new Date(online!.sent_at).toLocaleTimeString('en-AU', { timeZone: 'Australia/Sydney', hour: 'numeric', minute: '2-digit' })}. Its camera shows Lex; the live text and Lex’s answers appear here as on the tablet.</p>
            </div>
            <button class="btn-ghost !py-1.5 text-sm">Ask Lex to leave</button>
          </form>
        ) : (
          <form method="post" class="grid gap-3">
            <input type="hidden" name="intent" value="online-send" />
            <div class="flex flex-wrap items-end gap-3">
              <div class="grow">
                <label class="label" for="meeting-url">Lex in an online meeting</label>
                <input class="field" id="meeting-url" name="meeting_url" type="url" required placeholder="https://teams.microsoft.com/l/meetup-join/…" />
              </div>
              <button class="btn-primary">Send Lex</button>
            </div>
            {!meeting.recording_consent && <label class="flex items-start gap-2 text-sm text-white/70"><input type="checkbox" name="agreed" class="mt-1 size-4 accent-lk-blue" /><span>Everyone attending (in the room and online) agreed to the recording. Lex reads the consent statement aloud and posts it in the meeting’s chat as it joins.</span></label>}
            <p class="text-xs text-white/45">Teams, Zoom, Google Meet or Webex. “Lex (Lakeba)” joins with Lex’s face as its camera, hears everyone, answers “Lex, …” questions aloud and records the meeting here; it leaves when everyone has gone. In Teams and Google Meet, admit it from the lobby.</p>
            {online && !botActive(online) && online.error && <p class="text-xs text-lk-orange">Last time: {online.error}</p>}
          </form>
        )}
      </div>
    )}
    {meeting.recording_status === 'none' && ready.length > 0 && <p class="text-sm text-white/55">Open the Observer on the boardroom tablet (connect it above, or sign in on it as the company secretary). The chair confirms everyone agreed, the tablet records and shows the text live, and after the meeting the full transcript, with speakers, comes here for the minutes. The audio is deleted once the minutes are signed.</p>}

    {meeting.recording_takes.some((t) => t.path) && !meeting.audio_deleted_at && (
      <div class="grid gap-2">
        {meeting.recording_takes.filter((t) => t.path).map((t) => (
          <div class="flex flex-wrap items-center gap-3 text-sm"><span class="text-white/55">Part {t.take}</span><audio controls preload="none" data-recording src={`/admin/legal/file?path=${encodeURIComponent(t.path!)}`} class="h-9"></audio></div>
        ))}
      </div>
    )}

    {lexAnswers.length > 0 && (
      <div class="grid gap-3 border-t border-white/5 pt-4">
        <h3 class="text-sm font-semibold text-white">Asked of Lex during the meeting</h3>
        <p class="text-xs text-white/45">The board assistant's answers go to the minutes labelled as the assistant's.</p>
        {lexAnswers.map((a) => (
          <details class="rounded-xl bg-white/[0.03] px-4 py-3 text-sm">
            <summary class="cursor-pointer"><span class="text-white">“{a.question}”</span><span class="ml-2 text-xs text-white/40">{a.how === 'voice' ? 'asked aloud' : a.how === 'tap' ? 'asked after tapping Ask' : 'typed'}{a.offset_ms != null && ` · ${new Date(a.offset_ms).toISOString().slice(11, 19)} into the recording`}</span></summary>
            {a.status === 'done' ? (<>
              <p class="mt-2 text-white/85">{a.spoken}</p>
              <div class="mt-2 whitespace-pre-line text-white/65" set:html={answerHtml(a.answer, a.sources)} />
            </>) : <p class="mt-2 text-lk-orange">{a.error ?? a.status}</p>}
          </details>
        ))}
      </div>
    )}

    {sources.length > 0 && (
      <div class="grid gap-3 border-t border-white/5 pt-4">
        <h3 class="text-sm font-semibold text-white">Transcripts</h3>
        <ul class="grid gap-2 text-sm">
          {sources.map((src) => (
            <li class="flex flex-wrap items-center gap-3">
              <span class:list={[src === current ? 'text-white' : 'text-white/60']}>{SOURCE_LABEL(src)}{src === current && ' · used for the minutes'}</span>
              {mayDo && src !== current && <form method="post"><input type="hidden" name="source" value={src} /><button class="text-xs text-lk-blue hover:underline" name="intent" value="use-transcript">Use this one</button></form>}
            </li>
          ))}
        </ul>
        {mayDo && !meeting.audio_deleted_at && meeting.recording_takes.length > 0 && meeting.recording_status !== 'recording' && meeting.recording_status !== 'processing' && (
          <form method="post" class="flex flex-wrap items-center gap-2 text-sm">
            <span class="text-white/55">Full pass on the recording with</span>
            {ready.map((p) => <button class="btn-ghost !py-1.5 text-xs" name="provider" value={p}>{PROVIDERS[p].name}{sources.includes(`batch:${p}`) && ' (again)'}</button>)}
            <input type="hidden" name="intent" value="full-pass" />
            <span class="text-xs text-white/40">To compare the two services on the same meeting.</span>
          </form>
        )}
        {current && speakers.length > 0 && mayDo && (
          <form method="post" class="grid gap-3 rounded-xl bg-white/[0.03] p-4">
            <input type="hidden" name="source" value={current} />
            <p class="text-sm text-white">Who is who</p>
            <p class="text-xs text-white/45">Name each speaker so the transcript and minutes show names. This rebuilds the transcript above from {SOURCE_LABEL(current)}, replacing any changes typed into it.</p>
            {speakers.map((sp) => (
              <div class="grid gap-1 sm:grid-cols-[10rem_1fr] sm:items-center">
                <label class="text-sm text-white/70" for={`sp-${sp.label}`}>{sp.label} <span class="text-xs text-white/40">({sp.words} words)</span></label>
                <div>
                  <input class="field" id={`sp-${sp.label}`} name={`speaker:${sp.label}`} list="people" value={names[sp.label] ?? ''} placeholder="Name" />
                  {sp.sample && <p class="mt-1 text-xs text-white/40">“{sp.sample}…”</p>}
                </div>
              </div>
            ))}
            <datalist id="people">{people.map((p) => <option value={p} />)}</datalist>
            <div><button class="btn-primary !py-2" name="intent" value="name-speakers">Save the names</button></div>
          </form>
        )}
      </div>
    )}
  </section>
  </>}
  <script>
    // A recording kept without its length (made before the portal added it): the player works it out by
    // jumping to the end once, so it shows the time and can skip.
    for (const a of document.querySelectorAll<HTMLAudioElement>('audio[data-recording]')) {
      a.addEventListener('loadedmetadata', () => {
        if (a.duration !== Infinity) return;
        const playing = !a.paused;
        const back = () => { a.removeEventListener('timeupdate', back); a.currentTime = 0; if (playing) void a.play(); };
        a.addEventListener('timeupdate', back);
        a.currentTime = 1e101;
      });
    }
    // While Lex is on its way to (or in) an online meeting, the page follows its status.
    if (document.getElementById('online')?.dataset.live) window.setInterval(() => { if (!document.activeElement?.matches('input, textarea, select')) location.reload(); }, 15_000);
  </script>
</Admin>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-confirm]').forEach((b) => b.addEventListener('click', (e) => { if (!confirm(b.dataset.confirm!)) e.preventDefault(); }));
  // "Draft the minutes" takes a little while: say so.
  document.querySelectorAll<HTMLFormElement>('form[data-busy]').forEach((f) => f.addEventListener('submit', (e) => { const b = (e as SubmitEvent).submitter as HTMLButtonElement | null; if (b?.dataset.busyLabel) { b.textContent = b.dataset.busyLabel; setTimeout(() => (b.disabled = true)); } }));
</script>
