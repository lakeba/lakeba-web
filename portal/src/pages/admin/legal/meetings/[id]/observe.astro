      const setFull = (on: boolean) => {
        if (on) stage.dataset.full = ''; else delete stage.dataset.full;
        lexCard.style.backdropFilter = on ? 'none' : '';
        lexCard.style.setProperty('-webkit-backdrop-filter', on ? 'none' : '');
      };
      const leaveFull = () => { setFull(false); if (document.fullscreenElement) void document.exitFullscreen().catch(() => undefined); };
      $('stage-open')?.addEventListener('click', async () => {
        ensureOut();
        setFull(true);
        await document.documentElement.requestFullscreen?.().catch(() => undefined);
        void $<HTMLVideoElement>('face')?.play().catch(() => undefined);
      });
      $('stage-exit')?.addEventListener('click', (e) => { e.stopPropagation(); leaveFull(); });
      document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) setFull(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && 'full' in stage.dataset) leaveFull(); });
      stage.addEventListener('click', () => { if ('full' in stage.dataset) $<HTMLButtonElement>('lex-ask')?.click(); });

      // The orb: breathes when idle, follows the room when listening, shimmers while thinking, moves with Lex's voice.
      const orb = $<HTMLCanvasElement>('orb');
      const g = orb?.getContext('2d');
      const levelOf = (a: AnalyserNode | null) => { if (!a) return 0; const d = new Uint8Array(a.fftSize); a.getByteTimeDomainData(d); let sum = 0; for (const v of d) sum += ((v - 128) / 128) ** 2; return Math.min(1, Math.sqrt(sum / d.length) * 4); };
      let smooth = 0;
      const draw = (t: number) => {
        if (g && orb) {
          const W = orb.width, c = W / 2;
          const live = lexState === 'speaking' ? levelOf(outLevel) : lexState === 'listening' || lexState === 'following' ? levelOf(micLevel) : 0;
          smooth += (live - smooth) * 0.25;
          const breathe = Math.sin(t / 900) * 0.03;
          const r = W * (0.27 + breathe + smooth * 0.12);
          g.clearRect(0, 0, W, W);
          const hue = lexState === 'listening' || lexState === 'following' ? 150 : lexState === 'thinking' ? 265 : 212;
          const glow = g.createRadialGradient(c, c, r * 0.2, c, c, r * 1.6);
          glow.addColorStop(0, `hsla(${hue}, 90%, 65%, 0.35)`); glow.addColorStop(1, `hsla(${hue}, 90%, 55%, 0)`);
          g.fillStyle = glow; g.beginPath(); g.arc(c, c, r * 1.6, 0, Math.PI * 2); g.fill();
          const spin = lexState === 'thinking' ? t / 400 : t / 3000;
          const body = g.createRadialGradient(c + Math.cos(spin) * r * 0.35, c + Math.sin(spin) * r * 0.35, r * 0.1, c, c, r);
          body.addColorStop(0, `hsla(${hue + 30}, 95%, 80%, 1)`); body.addColorStop(0.6, `hsla(${hue}, 85%, 55%, 1)`); body.addColorStop(1, `hsla(${hue - 20}, 80%, 35%, 1)`);
          g.fillStyle = body; g.beginPath(); g.arc(c, c, r, 0, Math.PI * 2); g.fill();
        }
        requestAnimationFrame(draw);
      };
      requestAnimationFrame(draw);
    </script>
  </body>
</html>
