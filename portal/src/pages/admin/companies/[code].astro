---
import { termOf } from '../../../lib/heard-as';
import Admin from '../../../layouts/Admin.astro';
import Alert from '../../../components/Alert.astro';
import ReviewChange from '../../../components/ReviewChange.astro';
import { serviceClient } from '../../../lib/admin';
import { isCompanyAdmin } from '../../../lib/integrations/admin';
import CompanyTabs from '../../../components/CompanyTabs.astro';
import { field } from '../../../lib/forms';
import { displayName } from '../../../lib/admin-forms';
import { shortDate } from '../../../lib/format';
import { brandOf } from '../../../lib/brand';
import { spendThisMonth } from '../../../lib/ask-limits';
import { RESERVED_SLUGS, forgetVentureSites } from '../../../lib/sites';
import { CLASS_KINDS, PORTAL_ACCESS, POSITIONS, RELATIONSHIPS, amount, changes, classBlocker, fmt, isDate, wholeShares } from '../../../lib/register';
import { ownership, pctText } from '../../../lib/ownership';

// One company: its details, its share classes (add, edit, remove when
// nothing uses them) and its board positions. Changes are checked first
// (old → new), then saved and recorded in the audit log. The relationship and
// portal access are for people who manage the whole register.
const svc = serviceClient();
const access = Astro.locals.access;
const code = (Astro.params.code ?? '').toUpperCase();
const load = async () => (await svc.from('entities').select('*').eq('code', code).maybeSingle()).data;
let company = await load();
if (!company || !access.can('investors.view', company.id)) return new Response('Not found', { status: 404 });
const mayEdit = access.can('investors.do', company.id);
const mayGroup = access.can('investors.do', null);
const log = (action: string, detail: Record<string, unknown>) => Astro.locals.supabase.rpc('log_event', { event_action: action, event_detail: { company: code, ...detail } });

let error = '', notice = Astro.url.searchParams.get('added') ? 'Company added. Add its share classes below.' : '';
let review: { title: string; lines: string[]; fields: [string, string][]; danger?: boolean } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  const op = field(form, 'op');
  const fields = [...form.entries()].filter(([k]) => k !== 'intent').map(([k, v]) => [k, String(v)] as [string, string]);
  const plan = async (): Promise<{ title: string; lines: string[]; danger?: boolean; apply: () => Promise<string> } | string> => {
    if (!mayEdit) return 'You can’t change this company.';
    const c = company!;
    if (op === 'details') {
      const stake = amount(field(form, 'lakeba_stake'));
      const next: Record<string, unknown> = {
        display_name: field(form, 'display_name').slice(0, 80), legal_name: field(form, 'legal_name').slice(0, 160) || null,
        company_number: field(form, 'company_number').slice(0, 40) || null, country: field(form, 'country').slice(0, 60) || null,
        website: field(form, 'website').slice(0, 200) || null, lakeba_stake: stake, stake_as_at: field(form, 'stake_as_at') || null,
      };
      if (mayGroup && c.relationship !== 'group') Object.assign(next, { relationship: field(form, 'relationship'), portal: field(form, 'portal') });
      if (!next.display_name) return 'Enter the name shown in the portal.';
      if (Number.isNaN(stake) || (stake != null && (stake < 0 || stake > 100))) return 'Lakeba’s stake is a percentage between 0 and 100.';
      if (next.stake_as_at && !isDate(String(next.stake_as_at))) return 'The stake date must be a date.';
      if (next.website && !/^https?:\/\//.test(String(next.website))) return 'The website must start with https://';
      if ('relationship' in next && (!(String(next.relationship) in RELATIONSHIPS) || next.relationship === 'group' || !(String(next.portal) in PORTAL_ACCESS))) return 'Choose the relationship and portal access.';
      const lines = changes(c, next, { display_name: 'Name shown', legal_name: 'Legal name', company_number: 'ACN / ABN', country: 'Country', website: 'Website', lakeba_stake: 'Lakeba stake %', stake_as_at: 'Stake as at', relationship: 'Relationship', portal: 'Portal access' },
        (k, v) => (k === 'relationship' ? RELATIONSHIPS[v as keyof typeof RELATIONSHIPS] ?? fmt(v) : k === 'portal' ? PORTAL_ACCESS[v as keyof typeof PORTAL_ACCESS] ?? fmt(v) : fmt(v)));
      if (!lines.length) return 'Nothing changed.';
      return { title: 'Save these details?', lines, apply: async () => {
        await svc.from('entities').update(next).eq('id', c.id).throwOnError();
        forgetVentureSites();
        await log('register_company_updated', { changes: lines });
        return 'Details saved.';
      } };
    }
    if (op === 'board-assistant') {
      // The board assistant is rolled out board by board, by Lakeba.
      if (!mayGroup) return 'Only Lakeba switches the board assistant on or off.';
      const want = form.get('board_assistant') === 'on';
      // One per line (or separated by commas); a line "Lakeba = Kiwa, La Kiva" also says how a name is misheard (lib/heard-as.ts).
      const entries = field(form, 'speech_terms').split('\n').flatMap((l) => (l.includes('=') ? [l] : l.split(',')));
      const terms = [...new Map(entries.map((t) => t.replace(/\s+/g, ' ').replace(/\s*=\s*/, ' = ').trim().slice(0, t.includes('=') ? 300 : 50)).filter((t) => termOf(t).length >= 2).map((t) => [termOf(t).toLowerCase(), t])).values()].slice(0, 50);
      const had: string[] = c.speech_terms ?? [];
      const termsChanged = terms.join('\n') !== had.join('\n');
      if (want === Boolean(c.board_assistant) && !termsChanged) return 'Nothing changed.';
      const lines = [
        ...(want !== Boolean(c.board_assistant) ? [`Board assistant: ${want ? 'Off → On' : 'On → Off'}`, want ? 'Its board can record meetings with the Observer, ask Lex and have Lex present decks (Admin → Boardroom).' : 'Recording, Lex and decks stop for its board; existing transcripts and minutes stay.'] : []),
        ...(termsChanged ? [`Words to listen for: ${terms.length ? terms.join(', ') : '(none)'}`] : []),
      ];
      return { title: `Save the board assistant for ${c.display_name}?`, lines, apply: async () => {
        await svc.from('entities').update({ board_assistant: want, speech_terms: terms }).eq('id', c.id).throwOnError();
        if (want !== Boolean(c.board_assistant)) await log('company_board_assistant_switched', { on: want });
        if (termsChanged) await log('company_speech_terms_changed', { terms });
        return want === Boolean(c.board_assistant) ? 'Words saved.' : want ? 'The board assistant is on for this board.' : 'The board assistant is off for this board.';
      } };
    }
    if (op === 'venture') {
      const text = (k: string, max: number) => field(form, k).trim().slice(0, max) || null;
      const email = (k: string) => field(form, k).trim().toLowerCase() || null;
      const next: Record<string, unknown> = {
        sender_name: text('sender_name', 80), reply_to: email('reply_to'), contact_email: email('contact_email'),
        ask_name: text('ask_name', 40), email_footer: text('email_footer', 500), document_footer: text('document_footer', 300),
        ask_enabled: form.get('ask_enabled') === 'on', board_qa_enabled: form.get('board_qa_enabled') === 'on',
        brand_color: field(form, 'brand_color').trim().toLowerCase() || null, tagline: field(form, 'tagline').trim().slice(0, 120),
      };
      if (next.brand_color != null && !/^#[0-9a-f]{6}$/.test(String(next.brand_color))) return 'The colour is a hex code, e.g. #0d9488.';
      // The addresses decide where the venture's portal is reached, so they stay with people who manage the whole register.
      // Lakeba pays for Ask: its monthly cap per company is set by people who manage the whole register.
      if (mayGroup) { const b = field(form, 'ask_monthly_budget_usd').trim(); Object.assign(next, { ask_monthly_budget_usd: b === '' ? null : Number(b) }); }
      if (next.ask_monthly_budget_usd != null && !(Number(next.ask_monthly_budget_usd) >= 0 && Number(next.ask_monthly_budget_usd) <= 100000)) return 'The Ask budget is an amount in USD, e.g. 100.';
      if (mayGroup && c.relationship !== 'group') Object.assign(next, { slug: field(form, 'slug').trim().toLowerCase() || null, custom_domain: field(form, 'custom_domain').trim().toLowerCase().replace(/^https?:\/\//, '').replace(/\/.*$/, '') || null });
      const isEmail = (v: unknown) => v == null || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(v));
      if (!isEmail(next.reply_to) || !isEmail(next.contact_email)) return 'Enter the email addresses in full, e.g. investors@mist.com.';
      if (next.slug != null && !/^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$/.test(String(next.slug))) return 'The short name is up to 40 lowercase letters, digits or hyphens, e.g. mist.';
      if (next.custom_domain != null && !/^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$/.test(String(next.custom_domain))) return 'Enter the domain only, e.g. investors.mist.com.';
      if (next.slug && RESERVED_SLUGS.includes(String(next.slug))) return `${next.slug} is a word the portal uses; choose another short name.`;
      if (next.slug && next.slug !== c.slug && (await svc.from('entities').select('id').eq('slug', next.slug).neq('id', c.id).maybeSingle()).data) return `${next.slug} is already used by another company.`;
      if (next.custom_domain && next.custom_domain !== c.custom_domain && (await svc.from('entities').select('id').eq('custom_domain', next.custom_domain).neq('id', c.id).maybeSingle()).data) return `${next.custom_domain} is already used by another company.`;
      const yesNo = (v: unknown) => (v ? 'On' : 'Off');
      const lines = changes(c, next, { slug: 'Short name', custom_domain: 'Own domain', sender_name: 'Sender name', reply_to: 'Replies go to', contact_email: 'Contact email', ask_name: 'Name of Ask', email_footer: 'Email footer', document_footer: 'Document footer', ask_enabled: 'Ask', board_qa_enabled: 'Board Q&A', ask_monthly_budget_usd: 'Ask budget a month (USD)', brand_color: 'Colour', tagline: 'Short description' },
        (k, v) => (k === 'ask_enabled' || k === 'board_qa_enabled' ? yesNo(v) : fmt(v)));
      if (!lines.length) return 'Nothing changed.';
      return { title: 'Save these venture settings?', lines, apply: async () => {
        await svc.from('entities').update(next).eq('id', c.id).throwOnError();
        if ('custom_domain' in next && next.custom_domain !== c.custom_domain) await svc.from('entities').update({ custom_domain_verified_at: null }).eq('id', c.id);
        forgetVentureSites();
        await log('company_venture_settings_saved', { changes: lines });
        return 'Venture settings saved.';
      } };
    }
    if (op === 'add-class' || op === 'edit-class') {
      const old = op === 'edit-class' ? (await svc.from('share_classes').select('*').eq('id', field(form, 'class_id')).eq('entity_id', c.id).maybeSingle()).data : null;
      if (op === 'edit-class' && !old) return 'That share class was not found.';
      const official = field(form, 'official_on_issue') === '' ? null : wholeShares(field(form, 'official_on_issue'));
      const next = {
        code: old?.code ?? field(form, 'code').toUpperCase(), name: field(form, 'name').slice(0, 80), kind: field(form, 'kind'),
        voting: field(form, 'voting') === 'yes', counts_toward_pct: field(form, 'counts') === 'yes', currency: (field(form, 'currency') || 'AUD').toUpperCase().slice(0, 3),
        official_on_issue: official, official_as_at: field(form, 'official_as_at') || null,
      };
      if (!/^[A-Z0-9]{1,12}$/.test(next.code)) return 'The class code is up to 12 capital letters or digits, e.g. ORD.';
      if (!next.name) return 'Enter the class name, e.g. Ordinary shares.';
      if (!(next.kind in CLASS_KINDS)) return 'Choose the type.';
      if (field(form, 'official_on_issue') !== '' && official == null) return 'The official number on issue is a whole number.';
      if ((next.official_on_issue == null) !== (next.official_as_at == null)) return 'The official number on issue and its date go together.';
      if (old && c.holdings_from_register && (Number(next.official_on_issue ?? -1) !== Number(old.official_on_issue ?? -1) || next.official_as_at !== old.official_as_at)) return `${c.display_name}’s shares on issue come from its register of members: import a newer register to change them (Import data → Register of members).`;
      if (!old && (await svc.from('share_classes').select('id').eq('entity_id', c.id).eq('code', next.code).maybeSingle()).data) return `${c.code}-${next.code} already exists.`;
      const labels = { name: 'Name', kind: 'Type', voting: 'Voting', counts_toward_pct: 'Counts toward %', currency: 'Currency', official_on_issue: 'Official on issue', official_as_at: 'Official as at' };
      const lines = old ? changes(old, next, labels, (k, v) => (k === 'kind' ? CLASS_KINDS[v as keyof typeof CLASS_KINDS] ?? fmt(v) : fmt(v)))
        : [`${c.code}-${next.code} ${next.name}`, `${CLASS_KINDS[next.kind as keyof typeof CLASS_KINDS]}, ${next.voting ? 'voting' : 'non-voting'}, ${next.counts_toward_pct ? 'counts toward %' : 'not in percentages'}, ${next.currency}`];
      if (!lines.length) return 'Nothing changed.';
      return { title: old ? `Change ${c.code}-${old.code}?` : 'Add this share class?', lines, apply: async () => {
        if (old) await svc.from('share_classes').update(next).eq('id', old.id).throwOnError();
        else await svc.from('share_classes').insert({ ...next, entity_id: c.id }).throwOnError();
        await log(old ? 'register_class_updated' : 'register_class_added', { class: `${c.code}-${next.code}`, changes: lines });
        return old ? 'Share class saved.' : 'Share class added.';
      } };
    }
    if (op === 'delete-class') {
      const old = (await svc.from('share_classes').select('*').eq('id', field(form, 'class_id')).eq('entity_id', c.id).maybeSingle()).data;
      if (!old) return 'That share class was not found.';
      const why = await classBlocker(svc, old.id);
      if (why) return `${c.code}-${old.code} can’t be removed: ${why}.`;
      return { title: `Remove ${c.code}-${old.code}?`, danger: true, lines: [`${old.name}: nothing uses it. Its holding notes go too.`], apply: async () => {
        await svc.from('share_classes').delete().eq('id', old.id).throwOnError();
        await log('register_class_deleted', { class: `${c.code}-${old.code}` });
        return 'Share class removed.';
      } };
    }
    if (op === 'add-board' || op === 'edit-board' || op === 'remove-board') {
      const position = field(form, 'position');
      if (!(position in POSITIONS)) return 'Choose the position.';
      const next = { starts_on: field(form, 'starts_on') || null, ends_on: field(form, 'ends_on') || null };
      if ((next.starts_on && !isDate(next.starts_on)) || (next.ends_on && !isDate(next.ends_on))) return 'The dates must be dates.';
      if (op === 'add-board') {
        const email = field(form, 'email').toLowerCase();
        const { data: p } = await svc.from('profiles').select('id, email, first_name, last_name').ilike('email', email).maybeSingle();
        if (!p) return `Nobody with ${email || 'that address'} has an account. Add them first (System → Users → Add person).`;
        if ((await svc.from('entity_board').select('user_id').eq('entity_id', c.id).eq('user_id', p.id).eq('position', position).maybeSingle()).data) return `${p.email} is already ${POSITIONS[position as keyof typeof POSITIONS]}.`;
        return { title: 'Add this board position?', lines: [`${displayName(p)} (${p.email}): ${POSITIONS[position as keyof typeof POSITIONS]}${next.starts_on ? ` from ${next.starts_on}` : ''}${next.ends_on ? ` to ${next.ends_on}` : ''}`, `They see ${c.display_name}’s board documents.`], apply: async () => {
          await svc.from('entity_board').insert({ entity_id: c.id, user_id: p.id, position, ...next }).throwOnError();
          await log('register_board_added', { email: p.email, position });
          return 'Board position added.';
        } };
      }
      const userId = field(form, 'user_id');
      const { data: old } = await svc.from('entity_board').select('*, profiles(email)').eq('entity_id', c.id).eq('user_id', userId).eq('position', position).maybeSingle();
      if (!old) return 'That board position was not found.';
      const who = (old.profiles as unknown as { email: string }).email;
      if (op === 'remove-board') return { title: 'Remove this board position?', danger: true, lines: [`${who}: ${POSITIONS[position as keyof typeof POSITIONS]}`, 'To keep the history, set an end date instead.'], apply: async () => {
        await svc.from('entity_board').delete().eq('entity_id', c.id).eq('user_id', userId).eq('position', position).throwOnError();
        await log('register_board_removed', { email: who, position });
        return 'Board position removed.';
      } };
      const lines = changes(old, next, { starts_on: 'From', ends_on: 'To' }).map((l) => `${who}: ${l}`);
      if (!lines.length) return 'Nothing changed.';
      return { title: 'Save these dates?', lines, apply: async () => {
        await svc.from('entity_board').update(next).eq('entity_id', c.id).eq('user_id', userId).eq('position', position).throwOnError();
        await log('register_board_updated', { email: who, position, changes: lines });
        return 'Board position saved.';
      } };
    }
    return 'Unknown action.';
  };
  if (op === 'logo' || op === 'logo-remove') {
    // The logo, straight away (a file can't go through check-and-save); the old file is removed.
    const c = company!;
    const old = c.logo_url?.startsWith('/company-logo/') ? c.logo_url.slice('/company-logo/'.length) : null;
    const file = form.get('logo');
    const ext = file instanceof File ? ({ 'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp', 'image/svg+xml': 'svg' } as Record<string, string>)[file.type] : undefined;
    if (!mayEdit) error = 'You can’t change this company.';
    else if (op === 'logo' && (!(file instanceof File) || !file.size)) error = 'Choose a logo file.';
    else if (op === 'logo' && !ext) error = 'Use a PNG, JPEG, WebP or SVG image.';
    else if (op === 'logo' && (file as File).size > 2 * 1024 * 1024) error = 'The logo must be 2 MB or smaller.';
    else {
      let logo: string | null = null;
      if (op === 'logo') {
        const path = `${c.code}-${Date.now()}.${ext}`;
        const { error: up } = await svc.storage.from('logos').upload(path, new Uint8Array(await (file as File).arrayBuffer()), { contentType: (file as File).type });
        if (up) error = up.message; else logo = `/company-logo/${path}`;
      }
      if (!error) {
        await svc.from('entities').update({ logo_url: logo }).eq('id', c.id).throwOnError();
        if (old) await svc.storage.from('logos').remove([old]);
        forgetVentureSites();
        await log(logo ? 'admin_uploaded_logo' : 'admin_removed_logo', {});
        notice = logo ? 'Logo saved.' : 'Logo removed.';
        company = await load();
      }
    }
  } else {
  const p = await plan();
  if (typeof p === 'string') error = p;
  else if (intent === 'review') review = { title: p.title, lines: p.lines, fields, danger: p.danger };
  else if (intent === 'apply') { notice = await p.apply(); company = await load(); }
  }
}

const c = company!;
const [{ data: classes }, { data: board }, { data: admins }, { data: holdings }] = await Promise.all([
  svc.from('share_classes').select('*').eq('entity_id', c.id).order('code'),
  svc.from('entity_board').select('user_id, position, starts_on, ends_on, profiles(id, email, first_name, last_name)').eq('entity_id', c.id),
  svc.from('user_roles').select('user_id, expires_at, profiles(id, email, first_name, last_name)').eq('role_key', 'admin').eq('entity_id', c.id),
  svc.from('holdings').select('holder_id, share_class_id, shares, as_at').in('share_class_id', [...new Set(((await svc.from('share_classes').select('id').eq('entity_id', c.id)).data ?? []).map((x) => x.id)), '00000000-0000-0000-0000-000000000000']).range(0, 199999),
]);
// Current shares per class (each holder's latest row), against the official number.
const latest = new Map<string, { as_at: string; shares: number; cls: string }>();
for (const h of holdings ?? []) { const k = `${h.holder_id}|${h.share_class_id}`; if (!latest.has(k) || latest.get(k)!.as_at < h.as_at) latest.set(k, { as_at: h.as_at, shares: Number(h.shares), cls: h.share_class_id }); }
const heldIn = (cid: string) => [...latest.values()].filter((x) => x.cls === cid).reduce((a, x) => a + x.shares, 0);
const self = Astro.url.pathname;
const askUsed = (await spendThisMonth(svc, c.id)).get(c.id) ?? { cost: 0, questions: 0 };
// Who owns whom among the portal's companies (holders that are a company in the portal), and Lakeba's share through them.
const own = await ownership(svc);
const ownedBy = own.ownersOf(c.id), owns = own.holdingsOf(c.id);
const lakebaShare = c.relationship === 'group' ? null : own.lakeba(c.id);
const throughOwners = ownedBy.filter((s) => s.owner !== own.group?.id && (own.lakeba(s.owner).effective > 0 || own.companies.get(s.owner)?.lakeba_stake != null));
const myGroup = own.groupOf(c.id);
const coName = (id: string) => own.companies.get(id)?.display_name ?? '?';
const coLink = (id: string) => (access.can('investors.view', id) ? `/admin/companies/${own.companies.get(id)?.code}` : null);
const stakeText = (s: { pct: number; classes: { code: string; shares: number }[] }) => `${pctText(s.pct)} (${s.classes.map((k) => `${fmt(k.shares)} ${k.code}`).join(', ')})`;
const sel = 'field';
---

<Admin title={c.display_name}>
  <a href="/admin/companies" class="text-sm text-white/50 hover:text-white">← Companies</a>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-3xl font-bold">{c.display_name}</h1>
  </div>
  <p class="mt-1 text-sm text-white/50">{c.code} · {RELATIONSHIPS[c.relationship as keyof typeof RELATIONSHIPS]} · {PORTAL_ACCESS[c.portal as keyof typeof PORTAL_ACCESS]}{!mayEdit && ' · read only'}</p>
  <div class="mt-5"><CompanyTabs company={c} /></div>
  <div class="mt-5 space-y-3">{notice && <Alert tone="success">{notice}</Alert>}{error && <Alert tone="error">{error}</Alert>}</div>
  {review && <div class="mt-5"><ReviewChange {...review} cancel={self} /></div>}

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_24rem]">
    <section class="space-y-6">
      {(ownedBy.length > 0 || owns.length > 0 || (lakebaShare && lakebaShare.effective > 0)) && (
        <div class="card">
          <h2 class="font-display text-lg font-bold">Ownership</h2>
          <p class="mt-1 text-xs text-white/45">From the share register: holders that are a company in the portal (set on the holder’s page), with each holder’s latest balance in the classes that count toward %. Over half makes it controlled.</p>
          <ul class="mt-3 space-y-1.5 text-sm">
            {ownedBy.map((s) => <li><span class="text-white/45">Owned by</span> {coLink(s.owner) ? <a href={coLink(s.owner)} class="text-white/85 hover:text-lk-blue">{coName(s.owner)}</a> : coName(s.owner)}: {stakeText(s)}{s.pct > 0.5 && <span class="ml-1 text-xs text-lk-green">controls it</span>}</li>)}
            {owns.map((s) => <li><span class="text-white/45">Owns</span> {coLink(s.company) ? <a href={coLink(s.company)} class="text-white/85 hover:text-lk-blue">{coName(s.company)}</a> : coName(s.company)}: {stakeText(s)}{s.pct > 0.5 && <span class="ml-1 text-xs text-lk-green">controlled</span>}</li>)}
            {lakebaShare && lakebaShare.effective > 0 && (
              <li><span class="text-white/45">Lakeba’s share</span> {pctText(lakebaShare.effective)}{lakebaShare.through > 0 ? ` (${[lakebaShare.direct > 0 && `${pctText(lakebaShare.direct)} directly`, `${pctText(lakebaShare.through)} through ${throughOwners.map((s) => coName(s.owner)).join(', ')}`].filter(Boolean).join(', ')})` : ' (held directly)'}{lakebaShare.stated != null && Math.abs(lakebaShare.stated - lakebaShare.effective) >= 0.0005 && <span class="block text-xs text-white/45">The Lakeba stake typed in Details is {pctText(lakebaShare.stated)}{c.stake_as_at && ` as at ${shortDate.format(new Date(c.stake_as_at))}`}.</span>}</li>
            )}
          </ul>
          {myGroup.length > 1 && c.relationship !== 'group' && <p class="mt-3 text-xs text-white/45">{c.display_name}’s group: {myGroup.map(coName).join(' + ')}. {access.can('accounting.view', null) ? <a href={`/admin/accounting/group?group=${c.code}`} class="text-lk-blue hover:underline">Added up in Finance → Consolidated</a> : 'Added up in Finance → Consolidated'}; one line on the board summary.</p>}
        </div>
      )}
      <div class="card @container p-0">
        <h2 class="px-5 pt-4 font-display text-lg font-bold">Share classes</h2>
        <p class="px-5 text-xs text-white/45">Held = the sum of each holder’s latest balance. Official on issue comes from the share register; percentages use it when set.</p>
        <div class="mt-2 divide-y divide-white/5">
          {(classes ?? []).map((k) => (
            <form method="post" class="space-y-2 px-5 py-4">
              <input type="hidden" name="intent" value="review" /><input type="hidden" name="class_id" value={k.id} />
              <div class="grid items-end gap-2 @xl:grid-cols-[7rem_1fr_10rem]">
                <div><span class="label">Code</span><p class="py-1.5 font-mono text-sm text-white/80">{c.code}-{k.code}</p></div>
                <div><label class="label">Name</label><input name="name" value={k.name} class={sel} disabled={!mayEdit} /></div>
                <div><label class="label">Type</label><select name="kind" class={sel} disabled={!mayEdit}>{Object.entries(CLASS_KINDS).map(([v, l]) => <option value={v} selected={v === k.kind}>{l}</option>)}</select></div>
              </div>
              <div class="grid grid-cols-2 items-end gap-2 @lg:grid-cols-3 @4xl:grid-cols-[5.5rem_6.5rem_5rem_minmax(7rem,1fr)_minmax(8.5rem,9.5rem)]">
                <div><label class="label">Voting</label><select name="voting" class={sel} disabled={!mayEdit}><option value="yes" selected={k.voting}>Yes</option><option value="no" selected={!k.voting}>No</option></select></div>
                <div><label class="label">Counts to %</label><select name="counts" class={sel} disabled={!mayEdit}><option value="yes" selected={k.counts_toward_pct}>Yes</option><option value="no" selected={!k.counts_toward_pct}>No</option></select></div>
                <div><label class="label">Currency</label><input name="currency" value={k.currency} maxlength="3" class={sel} disabled={!mayEdit} /></div>
                <div><label class="label">Official on issue</label><input name="official_on_issue" value={k.official_on_issue == null ? '' : Number(k.official_on_issue).toLocaleString('en-AU')} inputmode="numeric" class={`${sel} text-right`} disabled={!mayEdit} /></div>
                <div><label class="label">Official as at</label><input type="date" name="official_as_at" value={k.official_as_at ?? ''} class={sel} disabled={!mayEdit} /></div>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
                <span class="text-white/45">Held now: {fmt(heldIn(k.id))}{k.official_on_issue != null && heldIn(k.id) !== Number(k.official_on_issue) && ` (official ${fmt(Number(k.official_on_issue))})`}</span>
                {mayEdit && <span class="flex gap-4"><button name="op" value="edit-class" class="btn-ghost !px-3 !py-1 text-xs">Check and save</button><button name="op" value="delete-class" class="text-white/40 hover:text-lk-red">Remove</button></span>}
              </div>
            </form>
          ))}
          {!classes?.length && <p class="px-5 py-4 text-sm text-white/45">No share classes yet.</p>}
        </div>
        {mayEdit && (
          <form method="post" class="space-y-2 border-t border-white/10 px-5 py-4">
            <input type="hidden" name="op" value="add-class" />
            <p class="text-sm font-semibold">Add a share class</p>
            <div class="grid items-end gap-2 @xl:grid-cols-[7rem_1fr_10rem]">
              <div><label class="label" for="nc-code">Class code</label><input id="nc-code" name="code" required maxlength="12" placeholder="ORD" class="field uppercase" /></div>
              <div><label class="label" for="nc-name">Name</label><input id="nc-name" name="name" required placeholder="Ordinary shares" class="field" /></div>
              <div><label class="label" for="nc-kind">Type</label><select id="nc-kind" name="kind" class="field">{Object.entries(CLASS_KINDS).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
            </div>
            <div class="grid grid-cols-2 items-end gap-2 @xl:grid-cols-[6rem_7rem_5.5rem_auto]">
              <div><label class="label" for="nc-voting">Voting</label><select id="nc-voting" name="voting" class="field"><option value="yes">Yes</option><option value="no">No</option></select></div>
              <div><label class="label" for="nc-counts">Counts to %</label><select id="nc-counts" name="counts" class="field"><option value="yes">Yes</option><option value="no">No</option></select></div>
              <div><label class="label" for="nc-cur">Currency</label><input id="nc-cur" name="currency" value="AUD" maxlength="3" class="field" /></div>
              <div><button name="intent" value="review" class="btn-ghost">Check and add</button></div>
            </div>
          </form>
        )}
      </div>

      <div class="card @container">
        <h2 class="font-display text-lg font-bold">Board</h2>
        <p class="mt-1 text-xs text-white/45">Directors and officers see {c.display_name}’s board documents. To end a position and keep the history, set the “To” date.</p>
        <div class="mt-3 divide-y divide-white/5">
          {(board ?? []).map((b) => { const p = b.profiles as unknown as { id: string; email: string; first_name: string | null; last_name: string | null }; return (
            <form method="post" class="grid grid-cols-2 items-end gap-2 py-3 @3xl:grid-cols-[1fr_9.5rem_9.5rem_auto]">
              <input type="hidden" name="intent" value="review" /><input type="hidden" name="user_id" value={b.user_id} /><input type="hidden" name="position" value={b.position} />
              <div class="col-span-2 @3xl:col-span-1"><a href={`/admin/system/users/${p.id}`} class="text-sm text-white/85 hover:text-lk-blue">{displayName(p)}</a><span class="block text-xs text-white/45">{POSITIONS[b.position as keyof typeof POSITIONS]} · {p.email}</span></div>
              <div><label class="label">From</label><input type="date" name="starts_on" value={b.starts_on ?? ''} class={sel} disabled={!mayEdit} /></div>
              <div><label class="label">To</label><input type="date" name="ends_on" value={b.ends_on ?? ''} class={sel} disabled={!mayEdit} /></div>
              {mayEdit && <div class="col-span-2 flex gap-4 pb-2 text-xs @3xl:col-span-1"><button name="op" value="edit-board" class="text-white/60 hover:text-white">Save</button><button name="op" value="remove-board" class="text-white/40 hover:text-lk-red">Remove</button></div>}
            </form>); })}
          {!board?.length && <p class="py-3 text-sm text-white/45">No board positions recorded.</p>}
        </div>
        {mayEdit && (
          <form method="post" class="mt-3 space-y-2 border-t border-white/10 pt-3">
            <input type="hidden" name="op" value="add-board" />
            <p class="text-sm font-semibold">Add a board position</p>
            <div class="grid items-end gap-2 @xl:grid-cols-[1fr_10rem]">
              <div><label class="label" for="nb-email">Person (their portal email)</label><input id="nb-email" name="email" type="email" required class="field" /></div>
              <div><label class="label" for="nb-pos">Position</label><select id="nb-pos" name="position" class="field">{Object.entries(POSITIONS).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
            </div>
            <div class="grid grid-cols-2 items-end gap-2 @xl:grid-cols-[9.5rem_9.5rem_auto]">
              <div><label class="label" for="nb-from">From</label><input id="nb-from" type="date" name="starts_on" class="field" /></div>
              <div><label class="label" for="nb-to">To</label><input id="nb-to" type="date" name="ends_on" class="field" /></div>
              <div><button name="intent" value="review" class="btn-ghost">Check and add</button></div>
            </div>
          </form>
        )}
        <p class="mt-4 text-xs text-white/45">Company admins (they manage {c.display_name} in the portal): {(admins ?? []).length ? (admins ?? []).map((a) => (a.profiles as unknown as { email: string }).email).join(', ') : 'none'}. Give or remove them in <a href="/admin/system/users" class="text-lk-blue hover:underline">System → Users</a>.</p>
      </div>
    </section>

    <aside>
      <form method="post" class="card space-y-3">
        <h2 class="font-display text-lg font-bold">Details</h2>
        <input type="hidden" name="op" value="details" />
        <div><label class="label" for="display_name">Name shown in the portal</label><input id="display_name" name="display_name" value={c.display_name} required class="field" disabled={!mayEdit} /></div>
        <div><label class="label" for="legal_name">Legal name</label><input id="legal_name" name="legal_name" value={c.legal_name ?? ''} class="field" disabled={!mayEdit} /><p class="mt-1 text-xs text-white/40">On holding statements, tax packs and the dashboard.</p></div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="label" for="company_number">ACN / ABN</label><input id="company_number" name="company_number" value={c.company_number ?? ''} class="field" disabled={!mayEdit} /></div>
          <div><label class="label" for="country">Country</label><input id="country" name="country" value={c.country ?? ''} class="field" disabled={!mayEdit} /></div>
        </div>
        <div><label class="label" for="website">Website</label><input id="website" name="website" value={c.website ?? ''} placeholder="https://" class="field" disabled={!mayEdit} /></div>
        {c.relationship !== 'group' && (
          <div class="grid grid-cols-2 gap-2">
            <div><label class="label" for="lakeba_stake">Lakeba stake %</label><input id="lakeba_stake" name="lakeba_stake" value={c.lakeba_stake ?? ''} inputmode="decimal" class="field" disabled={!mayEdit} /></div>
            <div><label class="label" for="stake_as_at">Stake as at</label><input id="stake_as_at" name="stake_as_at" type="date" value={c.stake_as_at ?? ''} class="field" disabled={!mayEdit} /></div>
          </div>
        )}
        {c.relationship !== 'group' && mayGroup && (
          <div class="grid grid-cols-2 gap-2">
            <div><label class="label" for="relationship">Relationship</label><select id="relationship" name="relationship" class="field"><option value="controlled" selected={c.relationship === 'controlled'}>Controlled venture</option><option value="portfolio" selected={c.relationship === 'portfolio'}>Non-controlling</option></select></div>
            <div><label class="label" for="portal">Portal access</label><select id="portal" name="portal" class="field">{Object.entries(PORTAL_ACCESS).map(([k, l]) => <option value={k} selected={k === c.portal}>{l}</option>)}</select></div>
          </div>
        )}
        {mayEdit && <button name="intent" value="review" class="btn-ghost w-full">Check and save</button>}
        <p class="text-xs text-white/40">Logo, colour, tagline and portfolio entry: <a href="/admin/ventures" class="text-lk-blue hover:underline">Ventures &amp; prices</a>.</p>
      </form>

      <div class="card mt-6 space-y-3">
        <h2 class="font-display text-lg font-bold">Logo</h2>
        <div class="flex items-center gap-4">
          <div class="grid h-16 w-32 shrink-0 place-items-center rounded-xl bg-[#fff] p-2">{c.logo_url ? <img src={c.logo_url} alt={`${c.display_name} logo`} class="max-h-12 max-w-28 object-contain" /> : <span class="text-xs text-[#6b7a90]">No logo</span>}</div>
          <p class="text-xs text-white/45">In {c.display_name}’s portal header, on its sign-in page and in Lakeba’s portfolio. PNG, SVG, JPEG or WebP, up to 2 MB; a wide logo on a transparent background works best.</p>
        </div>
        {mayEdit && (
          <div class="flex flex-wrap items-center gap-2">
            <form method="post" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2"><input type="hidden" name="op" value="logo" /><input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/svg+xml" required class="max-w-56 text-xs text-white/60" /><button class="btn-ghost text-sm">Upload</button></form>
            {c.logo_url && <form method="post"><input type="hidden" name="op" value="logo-remove" /><button class="text-xs text-white/45 hover:text-lk-red">Remove</button></form>}
          </div>
        )}
      </div>

      <form method="post" class="card mt-6 space-y-3">
        <h2 class="font-display text-lg font-bold">Venture settings</h2>
        <p class="text-xs text-white/45">How {c.display_name} appears to its investors. Leave a field empty to use Lakeba’s.</p>
        <input type="hidden" name="op" value="venture" />
        <div class="grid grid-cols-[auto_1fr] items-end gap-2">
          <div><label class="label" for="brand_color">Colour</label><input id="brand_color" name="brand_color" type="color" value={c.brand_color ?? '#276ae7'} class="h-11 w-14 cursor-pointer rounded-xl border border-white/10 bg-transparent p-1" disabled={!mayEdit} /></div>
          <p class="pb-2 text-xs text-white/45">Buttons, links and highlights in {c.display_name}’s portal, and its emails. A very light colour is kept for details only, so text stays readable.</p>
        </div>
        <div><label class="label" for="tagline">Short description</label><input id="tagline" name="tagline" value={c.tagline ?? ''} maxlength="120" placeholder="e.g. Climate data for property" class="field" disabled={!mayEdit} /></div>
        {c.relationship !== 'group' && (
          <>
            <div><label class="label" for="slug">Short name</label><input id="slug" name="slug" value={c.slug ?? ''} placeholder={c.code.toLowerCase()} class="field" disabled={!mayEdit || !mayGroup} /><p class="mt-1 text-xs text-white/40">For its branded sign-in link (…/login?venture={c.slug ?? c.code.toLowerCase()}).</p></div>
            <div><label class="label" for="custom_domain">Own domain (optional)</label><input id="custom_domain" name="custom_domain" value={c.custom_domain ?? ''} placeholder="investors.example.com" class="field" disabled={!mayEdit || !mayGroup} /><p class="mt-1 text-xs text-white/40">Used once its DNS points to the portal: see Domain and mail.</p></div>
          </>
        )}
        <div><label class="label" for="sender_name">Emails come from</label><input id="sender_name" name="sender_name" value={c.sender_name ?? ''} maxlength="80" placeholder="Lakeba’s usual sender" class="field" disabled={!mayEdit} /></div>
        <div><label class="label" for="reply_to">Replies go to</label><input id="reply_to" name="reply_to" type="email" value={c.reply_to ?? ''} placeholder="No reply-to address" class="field" disabled={!mayEdit} /></div>
        <div><label class="label" for="contact_email">Contact email</label><input id="contact_email" name="contact_email" type="email" value={c.contact_email ?? ''} placeholder={brandOf(null).contactEmail} class="field" disabled={!mayEdit} /><p class="mt-1 text-xs text-white/40">In the portal footer and on holding statements.</p></div>
        <div><label class="label" for="ask_name">Name of Ask</label><input id="ask_name" name="ask_name" value={c.ask_name ?? ''} maxlength="40" placeholder={`Ask ${brandOf(c).name}`} class="field" disabled={!mayEdit} /></div>
        <div><label class="label" for="email_footer">Email footer</label><textarea id="email_footer" name="email_footer" rows="2" maxlength="500" placeholder={`You receive this as a ${brandOf(c).name} shareholder…`} class="field" disabled={!mayEdit}>{c.email_footer ?? ''}</textarea></div>
        <div><label class="label" for="document_footer">Holding statement footer</label><textarea id="document_footer" name="document_footer" rows="2" maxlength="300" placeholder="Nothing extra" class="field" disabled={!mayEdit}>{c.document_footer ?? ''}</textarea></div>
        <div><label class="label" for="ask_monthly_budget_usd">Ask budget a month (USD)</label><input id="ask_monthly_budget_usd" name="ask_monthly_budget_usd" inputmode="decimal" value={c.ask_monthly_budget_usd ?? ''} placeholder="No limit of its own" class="field" disabled={!mayEdit || !mayGroup} /><p class="mt-1 text-xs text-white/40">Used this month: USD {askUsed.cost.toFixed(2)} for {askUsed.questions} question{askUsed.questions === 1 ? '' : 's'}. When the budget is reached, Ask shows matching passages until the 1st.</p></div>
        <div class="space-y-2 text-sm">
          <label class="flex items-center gap-3"><input type="checkbox" name="ask_enabled" checked={c.ask_enabled} class="size-4 accent-lk-blue" disabled={!mayEdit} /> Ask is on for {c.display_name}’s investors</label>
          <label class="flex items-center gap-3"><input type="checkbox" name="board_qa_enabled" checked={c.board_qa_enabled} class="size-4 accent-lk-blue" disabled={!mayEdit} /> Board Q&amp;A is on for {c.display_name}’s investors</label>
        </div>
        {mayEdit && <button name="intent" value="review" class="btn-ghost w-full">Check and save</button>}
      </form>
      {mayGroup && (
        <form method="post" class="card mt-6 space-y-3">
          <h2 class="font-display text-lg font-bold">Board assistant</h2>
          <input type="hidden" name="op" value="board-assistant" />
          <label class="flex items-start gap-3 text-sm"><input type="checkbox" name="board_assistant" checked={c.board_assistant} class="mt-0.5 size-4 accent-lk-blue" /><span>On for {c.display_name}’s board<span class="block text-xs text-white/40">The Observer, Lex and the decks it presents, in Admin → Boardroom. Switched on by Lakeba, board by board; its company secretary needs the Company secretary role for {c.display_name}.</span></span></label>
          <div>
            <label class="label" for="speech_terms">Words to listen for</label>
            <textarea class="field min-h-20" id="speech_terms" name="speech_terms" maxlength="2500" placeholder="One per line: product names, people's names, jargon. To fix a name that’s misheard: Lakeba = Kiwa, La Kiva">{(c.speech_terms ?? []).join('\n')}</textarea>
            <p class="mt-1 text-xs text-white/40">The Observer's speech to text listens for these at {c.display_name}'s meetings, so they're written correctly. The group's company names, Lex and the people at the meeting are always included. If a name is still misheard, add how it comes out after “=”, e.g. <span class="font-mono">Lakeba = Kiwa, La Kiva</span>: the live text, Lex and the transcript then say Lakeba.</p>
          </div>
          <button name="intent" value="review" class="btn-ghost w-full">Check and save</button>
        </form>
      )}
    </aside>
  </div>
</Admin>
