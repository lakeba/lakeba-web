---
import CompanyTabs from '../../../../components/CompanyTabs.astro';
import Admin from '../../../../layouts/Admin.astro';
import Alert from '../../../../components/Alert.astro';
import { serviceClient } from '../../../../lib/admin';
import { field } from '../../../../lib/forms';
import { dateTime } from '../../../../lib/format';
import { newKey, originOf, type ApiKey } from '../../../../lib/news-api';

// Website news for one company: keys for the news API and the website
// component (made and revoked here; a key is shown once), the snippets to paste,
// and the RSS feed. Its editors (news) manage them.
const svc = serviceClient();
const access = Astro.locals.access;
const code = (Astro.params.code ?? '').toUpperCase();
const { data: company } = await svc.from('entities').select('id, code, display_name, relationship, website, portal').eq('code', code).maybeSingle();
if (!company || !access.can('news.view', company.id)) return new Response('Not found', { status: 404 });
const mayEdit = access.can('news.do', company.id);
const log = (action: string, detail: Record<string, unknown>) => Astro.locals.supabase.rpc('log_event', { event_action: action, event_detail: { company: code, ...detail } });
let error = '', notice = '', made: { key: string; kind: string } | null = null;

if (Astro.request.method === 'POST' && mayEdit) {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  if (intent === 'create') {
    const kind = field(form, 'kind') === 'secret' ? 'secret' : 'publishable';
    const name = field(form, 'name').slice(0, 80);
    const lines = field(form, 'origins').split(/[\s,]+/).filter(Boolean);
    const origins = [...new Set(lines.map(originOf))];
    if (!name) error = 'Give the key a name, e.g. “Live website”.';
    else if (kind === 'publishable' && (!origins.length || origins.includes(null))) error = 'List the website’s addresses, e.g. https://www.mist.com (one per line).';
    else {
      const k = newKey(kind);
      await svc.from('news_api_keys').insert({ entity_id: company.id, name, kind, key_hash: k.hash, prefix: k.prefix, allowed_origins: kind === 'publishable' ? origins : [], created_by: Astro.locals.user!.id }).throwOnError();
      await log('admin_created_news_key', { name, kind, origins });
      made = { key: k.key, kind };
    }
  } else if (intent === 'origins') {
    const lines = field(form, 'origins').split(/[\s,]+/).filter(Boolean);
    const origins = [...new Set(lines.map(originOf))];
    if (!origins.length || origins.includes(null)) error = 'List the website’s addresses, e.g. https://www.mist.com (one per line).';
    else {
      const { data: changed } = await svc.from('news_api_keys').update({ allowed_origins: origins }).eq('id', field(form, 'id')).eq('entity_id', company.id).eq('kind', 'publishable').is('revoked_at', null).select('name');
      if (changed?.length) {
        await log('admin_changed_news_key_websites', { id: field(form, 'id'), name: changed[0].name, origins });
        notice = `“${changed[0].name}” now works from ${origins.join(', ')}.`;
      }
    }
  } else if (intent === 'revoke') {
    await svc.from('news_api_keys').update({ revoked_at: new Date().toISOString() }).eq('id', field(form, 'id')).eq('entity_id', company.id).is('revoked_at', null);
    await log('admin_revoked_news_key', { id: field(form, 'id') });
    notice = 'Key revoked. Websites using it stop showing news straight away.';
  }
}

const { data: rows } = await svc.from('news_api_keys').select('id, entity_id, name, kind, prefix, allowed_origins, last_used_at, created_at, revoked_at').eq('entity_id', company.id).order('created_at', { ascending: false });
const keys = (rows ?? []) as ApiKey[];
const base = Astro.locals.site?.central ?? Astro.url.origin;
const { count: posts } = await (company.relationship === 'group'
  ? svc.from('posts').select('id', { count: 'exact', head: true }).eq('visibility', 'public').eq('on_lakeba_site', true).not('published_at', 'is', null)
  : svc.from('posts').select('id', { count: 'exact', head: true }).eq('entity_id', company.id).eq('visibility', 'public').eq('on_venture_site', true).not('published_at', 'is', null));
---

<Admin title={`${company.display_name} website news`}>
  <a href="/admin/companies" class="text-sm text-white/50 hover:text-white">← Companies</a>
  <h1 class="mt-2 font-display text-3xl font-bold">{company.display_name}</h1>
  <div class="mt-4"><CompanyTabs company={company} /></div>
  <p class="mt-1 max-w-3xl text-sm text-white/55">Public news written in the portal for {company.display_name} ({posts ?? 0} published, marked for its website) shows on its own website through the website component, the news API or RSS. Each website reads it with a key.</p>
  <div class="mt-5 space-y-3">{notice && <Alert tone="success">{notice}</Alert>}{error && <Alert tone="error">{error}</Alert>}</div>

  {made && (
    <section class="card mt-6 border border-lk-green/30">
      <h2 class="font-display text-lg font-bold">Your new {made.kind} key</h2>
      <p class="mt-1 text-sm text-white/60">Copy it now: it isn’t shown again. {made.kind === 'secret' ? 'Keep it on the website’s server; never put it in a web page.' : 'It only works from the addresses you listed.'}</p>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-black/40 p-3 font-mono text-sm text-white">{made.key}</pre>
    </section>
  )}

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_24rem]">
    <section class="space-y-6">
      <div class="card">
        <h2 class="font-display text-lg font-bold">On a website, in one line</h2>
        <p class="mt-1 text-sm text-white/55">Paste where the news should appear (WordPress, Wix, Squarespace or any page). It uses {company.display_name}’s colour and the page’s font; articles open on the same page.</p>
        <pre class="mt-3 overflow-x-auto rounded-xl bg-black/40 p-3 font-mono text-xs text-white/85">{`<script src="${base}/embed/news.js" data-key="${made?.kind === 'publishable' ? made.key : 'pk_live_…'}" async></script>\n<lakeba-news limit="6"></lakeba-news>`}</pre>
        <p class="mt-2 text-xs text-white/40">Options: limit, category, view="list" (links don’t open in place). Search engines index news loaded this way less reliably: sites that care about search can use the API from their server or the RSS feed.</p>
      </div>
      <div class="card">
        <h2 class="font-display text-lg font-bold">From a website’s server: the news API</h2>
        <pre class="mt-3 overflow-x-auto rounded-xl bg-black/40 p-3 font-mono text-xs text-white/85">{`curl -H "Authorization: Bearer ${made?.kind === 'secret' ? made.key : 'sk_live_…'}" "${base}/api/v1/news?limit=10"\ncurl -H "Authorization: Bearer sk_live_…" "${base}/api/v1/news?slug=a-post-address"`}</pre>
        <p class="mt-2 text-xs text-white/40">Newest first. limit (up to 50), offset, since (changed since a date), category, full=1 for the text; slug for one post. Up to 120 requests a minute per key.</p>
      </div>
      <div class="card">
        <h2 class="font-display text-lg font-bold">RSS feed</h2>
        <p class="mt-1 text-sm text-white/55">For newsletter tools and news readers; no key needed.</p>
        <pre class="mt-3 overflow-x-auto rounded-xl bg-black/40 p-3 font-mono text-xs text-white/85">{`${base}/api/public/news/${code}.rss`}</pre>
      </div>
    </section>

    <aside class="space-y-6">
      <div class="card">
        <h2 class="font-display text-lg font-bold">Keys</h2>
        <ul class="mt-3 divide-y divide-white/5 text-sm">
          {keys.map((k) => (
            <li class="py-3">
              <div class="flex items-start justify-between gap-3">
                <span><span class="text-white/85">{k.name}</span> <span class="rounded-full bg-white/10 px-2 py-0.5 text-xs text-white/60">{k.kind}</span>
                  <span class="block font-mono text-xs text-white/45">{k.prefix}…</span>
                  {k.allowed_origins.length > 0 && <span class="block text-xs text-white/45">{k.allowed_origins.join(', ')}</span>}
                  {mayEdit && k.kind === 'publishable' && !k.revoked_at && (
                    <details class="mt-1">
                      <summary class="cursor-pointer text-xs text-lk-blue hover:underline">Change its website addresses</summary>
                      <form method="post" class="mt-2 space-y-2">
                        <input type="hidden" name="intent" value="origins" /><input type="hidden" name="id" value={k.id} />
                        <textarea name="origins" rows="3" required class="field text-sm" aria-label={`Website addresses for ${k.name}`}>{k.allowed_origins.join('\n')}</textarea>
                        <p class="text-xs text-white/40">One per line, with http:// or https:// and any port, e.g. http://localhost:4321 for testing. The key keeps working; the change applies straight away.</p>
                        <button class="btn-ghost px-3 py-1.5 text-xs">Save addresses</button>
                      </form>
                    </details>
                  )}
                  <span class="block text-xs text-white/40">{k.revoked_at ? `Revoked ${dateTime.format(new Date(k.revoked_at))}` : k.last_used_at ? `Last used ${dateTime.format(new Date(k.last_used_at))}` : 'Not used yet'}</span></span>
                {mayEdit && !k.revoked_at && <form method="post"><input type="hidden" name="id" value={k.id} /><button name="intent" value="revoke" class="text-xs text-white/45 hover:text-lk-red" onclick="return confirm('Revoke this key? Websites using it stop showing news.')">Revoke</button></form>}
              </div>
            </li>
          ))}
          {!keys.length && <li class="py-3 text-white/45">No keys yet.</li>}
        </ul>
        {mayEdit && (
          <form method="post" class="mt-4 space-y-3 border-t border-white/10 pt-4">
            <input type="hidden" name="intent" value="create" />
            <p class="text-sm font-semibold">Make a key</p>
            <div><label class="label" for="name">Name</label><input id="name" name="name" required maxlength="80" placeholder="Live website" class="field" /></div>
            <div><label class="label" for="kind">Kind</label><select id="kind" name="kind" class="field"><option value="publishable">Publishable: for the website component</option><option value="secret">Secret: for a website’s server</option></select></div>
            <div><label class="label" for="origins">Website addresses (publishable keys)</label><textarea id="origins" name="origins" rows="2" placeholder={company.website ?? 'https://www.example.com'} class="field text-sm">{originOf(company.website ?? '') ?? ''}</textarea><p class="mt-1 text-xs text-white/40">One per line, e.g. https://www.mist.com and https://mist.com. You can change them later.</p></div>
            <button class="btn-ghost w-full">Make the key</button>
          </form>
        )}
      </div>
    </aside>
  </div>
</Admin>
