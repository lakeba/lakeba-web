---
import Admin from '../../../../layouts/Admin.astro';
import Alert from '../../../../components/Alert.astro';
import DomainGuide from '../../../../components/setup/DomainGuide.astro';
import EmailGuides from '../../../../components/setup/EmailGuides.astro';
import SetupScript from '../../../../components/setup/SetupScript.astro';
import { MS_CLIENT_ID, PORTAL_DOMAIN, PORTAL_SERVER_IP } from 'astro:env/server';
import { dateTime } from '../../../../lib/format';
import { brandOf } from '../../../../lib/brand';
import { detect, domainStatus, placeOf } from '../../../../lib/domains';
import { graphConfigured } from '../../../../lib/graph';
import { GMAIL_SCOPE, gmailClientId, gmailConfigured } from '../../../../lib/gmail';
import { siteOriginFor } from '../../../../lib/sites';
import { HANDOFF_DAYS, loadHandoffs, loadSetupCompany, runSetupAction, setupStamp, type Who } from '../../../../lib/setup';

// A venture's own web address and email, as a guided set-up for people who
// aren't technical: the page works out who runs its email (Microsoft 365 or
// Google) and where its domain is managed, shows only the steps that apply,
// with everything to copy, and checks the work every minute. The venture's
// admins can send the steps to whoever looks after their domain or email (a
// link that needs no portal account, /setup/<token>) and ask Lakeba for help.
// The steps themselves are in lib/setup.ts, shared with that page.
const access = Astro.locals.access;
const code = (Astro.params.code ?? '').toUpperCase();
let c = await loadSetupCompany({ code });
if (!c || c.relationship === 'group' || !access.can('investors.view', c.id)) return new Response('Not found', { status: 404 });
const group = access.can('investors.do', null);
const manage = access.can('investors.do', c.id);
const me = Astro.locals.user!;
const profile = Astro.locals.profile;
const myName = [profile?.first_name, profile?.last_name].filter(Boolean).join(' ');
const who: Who = { userId: me.id, email: me.email, label: myName ? `${myName} (${me.email})` : me.email, manage, group };
const central = Astro.locals.site?.central ?? Astro.url.origin;
let error = '', notice = '', consentUrl = '';

if (Astro.request.method === 'POST' && manage) {
  const r = await runSetupAction(c, who, await Astro.request.formData(), central);
  ({ notice = '', error = '', consentUrl = '' } = r);
  c = (await loadSetupCompany({ code }))!;
}

const portalDomain = PORTAL_DOMAIN ?? 'investors.lakeba.com';
const brand = brandOf(c);
const [det, place, check, handoffs] = await Promise.all([
  detect(c),
  c.custom_domain ? placeOf(c.custom_domain) : Promise.resolve(null),
  c.custom_domain && !c.custom_domain_verified_at ? domainStatus(c.custom_domain) : Promise.resolve(null),
  loadHandoffs(c.id),
]);
const lakebaAddress = siteOriginFor(Astro.url, { ...c, custom_domain_verified_at: null }).replace(/^https?:\/\//, '');
const suggestedAddress = `investors@${det.emailDomain ?? 'yourcompany.com'}`;
const providerName = { microsoft: 'Microsoft 365 (Outlook)', google: 'Google Workspace (Gmail)', other: 'another provider', none: '' }[det.mail];
const now = Date.now();
const poll = Boolean(c.custom_domain && !c.custom_domain_verified_at) || Boolean(consentUrl) || handoffs.some((h) => !h.revoked_at && new Date(h.expires_at).getTime() > now);
---

<Admin title={`${c.display_name} domain and mail`}>
  <a href={`/admin/companies/${code}`} class="text-sm text-white/50 hover:text-white">← {c.display_name}</a>
  <h1 class="mt-2 font-display text-3xl font-bold">Domain and mail</h1>
  <div class="mt-5 space-y-3">{notice && <Alert tone="success">{notice}</Alert>}{error && <Alert tone="error">{error}</Alert>}</div>

  <section class="card mt-6 space-y-3">
    <h2 class="font-display text-lg font-bold">Where things stand</h2>
    <ul class="space-y-1.5 text-sm">
      <li><span class="text-white/50">Investors open the portal at</span> <span class="font-mono text-white/85">{siteOriginFor(Astro.url, c).replace(/^https?:\/\//, '')}</span>{c.custom_domain && !c.custom_domain_verified_at && <span class="text-lk-orange"> · {c.custom_domain} is waiting for its DNS record</span>}</li>
      <li><span class="text-white/50">Emails to investors come from</span> <span class="text-white/85">{brand.sendFrom ?? `Lakeba’s address, in ${c.display_name}’s name`}</span></li>
      <li><span class="text-white/50">Shareholder mailbox</span> <span class="text-white/85">{c.shareholder_mailbox ? `${c.shareholder_mailbox}${c.google_mailbox_verified_at ? ' (Gmail, connected)' : c.ms_tenant_id ? ' (Microsoft 365)' : ''}` : 'not set'}</span></li>
    </ul>
    {det.emailDomain && (
      <p class="rounded-xl bg-white/[0.04] p-3 text-sm text-white/65">
        {det.mail === 'none' ? `We couldn’t find who runs ${det.emailDomain}’s email.` : <>{det.emailDomain}’s email runs on <strong class="text-white/85">{providerName}</strong>.</>}
        {det.dns && <> Its domain is managed at <strong class="text-white/85">{det.dns.name}</strong>.</>} The steps below are for that. Both parts are optional: the portal works as it is.
      </p>
    )}
  </section>

  {manage && (
    <section class="card mt-6 space-y-4">
      <div>
        <h2 class="font-display text-lg font-bold">Who does this?</h2>
        <p class="mt-1 text-sm text-white/60">Whoever looks after {c.display_name}’s domain and email. If that isn’t you, send them the steps: they get a private link (no portal account needed, works for {HANDOFF_DAYS} days) with buttons for everything, and you see here as each part is done.</p>
      </div>
      <form method="post" class="grid gap-2 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
        <input type="hidden" name="intent" value="handoff-send" />
        <div><label class="label" for="handoff_name">Their name</label><input id="handoff_name" name="handoff_name" class="field" placeholder="Jo Smith" /></div>
        <div><label class="label" for="handoff_email">Their email</label><input id="handoff_email" name="handoff_email" type="email" required class="field" placeholder="jo@itcompany.com" /></div>
        <button class="btn-primary text-sm">Send the steps</button>
        <div class="sm:col-span-3"><label class="label" for="handoff_note">A note for them (optional)</label><input id="handoff_note" name="handoff_note" class="field" maxlength="1000" placeholder="Hi Jo, could you set this up this week?" /></div>
      </form>
      {handoffs.length > 0 && (
        <ul class="divide-y divide-white/5 text-sm">
          {handoffs.map((h) => {
            const live = !h.revoked_at && new Date(h.expires_at).getTime() > now;
            return (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                <span><span class="text-white/85">{h.recipient_name ? `${h.recipient_name} (${h.recipient_email})` : h.recipient_email}</span> <span class="text-white/45">· sent {dateTime.format(new Date(h.created_at))} · {h.opened_at ? `last opened ${dateTime.format(new Date(h.last_seen_at ?? h.opened_at))}` : 'not opened yet'}{!live && ' · link stopped'}</span></span>
                {live && <form method="post"><input type="hidden" name="handoff" value={h.id} /><button name="intent" value="handoff-stop" class="text-xs text-white/45 hover:text-lk-red">Stop this link</button></form>}
              </li>
            );
          })}
        </ul>
      )}
      <details class="text-sm">
        <summary class="cursor-pointer text-white/75 hover:text-white">Stuck, or want Lakeba to do it with you? Ask Lakeba for help</summary>
        <form method="post" class="mt-2 space-y-2">
          <input type="hidden" name="intent" value="help" />
          <textarea name="help_message" rows="3" maxlength="2000" class="field" placeholder={c.custom_domain ? 'What’s happening, and a good time to call.' : `For example: we’d like our portal at investors.${det.emailDomain ?? 'ourcompany.com'}.`}></textarea>
          <button class="btn-ghost text-sm">Send to Lakeba</button>
        </form>
      </details>
    </section>
  )}

  <div class="mt-6 space-y-6">
    <DomainGuide c={c} place={place} check={check} portalDomain={portalDomain} lakebaAddress={lakebaAddress} suggested={det.emailDomain ? `investors.${det.emailDomain}` : null} admin={true} group={group} />
    <EmailGuides c={c} det={det} admin={true} manage={manage} testTo={me.email} suggested={suggestedAddress}
      consentUrl={consentUrl} msReady={graphConfigured()} msClientId={MS_CLIENT_ID ?? null}
      serverIp={PORTAL_SERVER_IP} gmailReady={gmailConfigured()} gmailClientId={gmailClientId()} gmailScope={GMAIL_SCOPE} />
  </div>
  <SetupScript statusUrl={`/admin/companies/${code}/domain-status`} stamp={setupStamp(c)} poll={poll} />
</Admin>
