---
import Auth from '../layouts/Auth.astro';
import Alert from '../components/Alert.astro';
import Turnstile from '../components/Turnstile.astro';
import { captchaToken, field } from '../lib/forms';

const { t } = Astro.locals;

let sent = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  await Astro.locals.supabase.auth.resetPasswordForEmail(field(form, 'email'), {
    redirectTo: `${Astro.url.origin}/auth/confirm?next=/account/password`,
    captchaToken: captchaToken(form),
  });
  sent = true;
}
---

<Auth title={t('Reset your password')} subtitle={t('We’ll email you a link to choose a new password.')}>
  {sent ? (
    <Alert tone="success">{t('If an account exists for that email, a reset link is on its way. It expires in 1 hour.')}</Alert>
  ) : (
    <form method="post" class="space-y-4">
      <div>
        <label for="email" class="label">{t('Email')}</label>
        <input id="email" name="email" type="email" autocomplete="username" required class="field" />
      </div>
      <Turnstile />
      <button class="btn-primary w-full">{t('Send reset link')}</button>
    </form>
  )}
  <p class="mt-5 text-center text-sm"><a href="/login" class="text-white/60 hover:text-white">{t('Back to sign in')}</a></p>
</Auth>
