---
import Portal from '../../layouts/Portal.astro';
import PageHeader from '../../components/PageHeader.astro';
import Empty from '../../components/Empty.astro';
import { longDate } from '../../lib/format';

const { data: posts } = await Astro.locals.supabase.from('posts').select('slug, title, excerpt, cover_url, published_at').order('published_at', { ascending: false });
const [lead, ...rest] = posts ?? [];
---

<Portal title="News">
  <PageHeader eyebrow="News" title="News for shareholders" subtitle="Company and portfolio news, in one place." />
  {lead ? (
    <>
      <a href={`/news/${lead.slug}`} class="card group block bg-gradient-to-br from-lk-blue/15 to-transparent sm:p-10">
        <p class="text-xs text-white/45">{longDate.format(new Date(lead.published_at!))}</p>
        <h2 class="mt-2 max-w-3xl text-3xl font-extrabold group-hover:underline">{lead.title}</h2>
        <p class="mt-3 max-w-2xl text-white/60">{lead.excerpt}</p>
        <p class="mt-6 text-sm font-semibold text-lk-blue">Read →</p>
      </a>
      <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <a href={`/news/${p.slug}`} class="card group block">
            <p class="text-xs text-white/45">{longDate.format(new Date(p.published_at!))}</p>
            <h2 class="mt-2 text-lg font-bold group-hover:underline">{p.title}</h2>
            <p class="mt-2 line-clamp-3 text-sm text-white/55">{p.excerpt}</p>
          </a>
        ))}
      </div>
    </>
  ) : <Empty title="No news yet">News will appear here when it is published.</Empty>}
</Portal>
