---
import Portal from '../../layouts/Portal.astro';
import PageHeader from '../../components/PageHeader.astro';
import Empty from '../../components/Empty.astro';
import LinkedInCard from '../../components/LinkedInCard.astro';
import { loadNews } from '../../lib/news';

const { company, t, fmt } = Astro.locals;
const all = await loadNews(Astro.locals.supabase, undefined, company);
// Filters (who it's from, year, words in the title) and paging, all in the address so a view can be shared.
const sp = Astro.url.searchParams;
const PAGE = 24;
const f = { from: sp.get('from') ?? '', year: sp.get('year') ?? '', q: (sp.get('q') ?? '').trim().toLowerCase() };
const shown = Math.max(1, Number(sp.get('pages') ?? 1)) * PAGE;
const news = all.filter((p) => (!f.from || p.label === f.from) && (!f.year || String(p.date.getFullYear()) === f.year) && (!f.q || `${p.title} ${p.excerpt}`.toLowerCase().includes(f.q)));
const filtered = Boolean(f.from || f.year || f.q);
// Who it's from: each venture's public news, and the shareholder updates (shown with their translated label).
const sources = [...new Map(all.map((p) => [p.label, p])).values()];
const years = [...new Set(all.map((p) => p.date.getFullYear()))].sort((a, b) => b - a);
const withParams = (o: Record<string, string>) => { const u = new URLSearchParams(sp); for (const [k, v] of Object.entries(o)) v ? u.set(k, v) : u.delete(k); u.delete('pages'); const q = u.toString(); return q ? `/news?${q}` : '/news'; };
const [lead, ...restAll] = news;
const rest = restAll.slice(0, shown - 1);
// Shareholder posts get a translated label; public news keeps its venture name.
const label = (p: { public: boolean; label: string }) =>
  p.public ? p.label : company && company.relationship !== 'group' ? t('{company} shareholders', { company: company.display_name }) : t('Shareholders');
const target = (external: boolean) => (external ? { target: '_blank', rel: 'noopener' } : {});
---

<Portal title={t('News')}>
  <PageHeader eyebrow={t('News')} title={t('News for shareholders')} subtitle={company && company.relationship !== 'group' ? t('{company} shareholder updates, plus Lakeba’s public News & Media.', { company: company.display_name }) : t('Shareholder updates and Lakeba’s public News & Media, in one place.')} />
  <p class="-mt-4 mb-6 text-sm"><a href="/newsletters" class="text-lk-blue hover:underline">{t('Past newsletters')} →</a></p>
  {company?.relationship === 'group' && <LinkedInCard src="news" compact />}
  {all.length > PAGE && (
    <form method="get" action="/news" class="mb-6 space-y-3" role="search">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <a href={withParams({ from: '' })} class:list={['rounded-full border px-3 py-1', !f.from ? 'border-lk-blue/50 text-white' : 'border-white/10 text-white/55 hover:text-white']}>{t('All')}</a>
        {sources.map((x) => <a href={withParams({ from: x.label })} class:list={['rounded-full border px-3 py-1', f.from === x.label ? 'border-lk-blue/50 text-white' : 'border-white/10 text-white/55 hover:text-white']}>{label(x)}</a>)}
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {f.from && <input type="hidden" name="from" value={f.from} />}
        <select name="year" class="field !w-auto" aria-label={t('Year')} onchange="this.form.submit()"><option value="">{t('Any year')}</option>{years.map((y) => <option value={y} selected={String(y) === f.year}>{y}</option>)}</select>
        <input name="q" value={sp.get('q') ?? ''} placeholder={t('Search news')} class="field !w-64" />
        <button class="btn-ghost !py-1.5 text-sm">{t('Search')}</button>
        {filtered && <a href="/news" class="text-sm text-white/55 hover:text-white">{t('Clear')}</a>}
        <span class="ml-auto text-xs text-white/40">{news.length} / {all.length}</span>
      </div>
    </form>
  )}
  {lead ? (
    <>
      <a href={lead.href} {...target(lead.external)} class="card group block bg-gradient-to-br from-lk-blue/15 to-transparent sm:p-10">
        <p class="text-xs text-white/45"><span class="font-semibold text-lk-blue">{label(lead)}</span> · {fmt.longDate.format(lead.date)}</p>
        <h2 class="mt-2 max-w-3xl text-3xl font-extrabold group-hover:underline">{lead.title}</h2>
        <p class="mt-3 max-w-2xl text-white/60">{lead.excerpt}</p>
        <p class="mt-6 text-sm font-semibold text-lk-blue">{lead.external ? `${t('Read the story')} ↗` : `${t('Read')} →`}</p>
      </a>
      <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <a href={p.href} {...target(p.external)} class="card group block">
            <p class="text-xs text-white/45"><span class="font-semibold text-lk-blue">{label(p)}</span> · {fmt.longDate.format(p.date)}</p>
            <h2 class="mt-2 text-lg font-bold group-hover:underline">{p.title}</h2>
            <p class="mt-2 line-clamp-3 text-sm text-white/55">{p.excerpt}</p>
          </a>
        ))}
      </div>
      {news.length > shown && <div class="mt-6 text-center"><a href={`${withParams({})}${withParams({}).includes('?') ? '&' : '?'}pages=${shown / PAGE + 1}`} class="btn-ghost">{t('Show more')}</a></div>}
    </>
  ) : filtered ? <Empty title={t('No news matches')}><a href="/news" class="text-lk-blue hover:underline">{t('Clear')}</a></Empty> : <Empty title={t('No news yet')}>{t('News will appear here when it is published.')}</Empty>}
</Portal>
