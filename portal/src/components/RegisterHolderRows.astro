---
// Names on a register of members and the portal holder each one is (Admin →
// Import data → Register of members). Each list starts with its current choice
// and "New holder"; the page fills in the other holders when it's opened.
type Row = { key: string; register_name: string; name: string; newName: string; trust: string | null; acn: string | null; kind: string; classes: { code: string; shares: number }[]; how: string; why: string; holderId: string | null; holderName: string | null };
interface Props { rows: Row[] }
const { rows } = Astro.props;
const HOW: Record<string, string> = { register: 'Same holder', name: 'Same name', saved: 'Matched before', chosen: 'Your choice', 'chosen-new': 'Your choice', suggested: 'Suggested', new: 'No match' };
const TONE: Record<string, string> = { suggested: 'text-lk-orange', new: 'text-white/55', 'chosen-new': 'text-white/55' };
const KIND: Record<string, string> = { individual: 'individual', company: 'company', trust: 'trust', super_fund: 'super fund' };
---
<div class="overflow-x-auto">
  <table class="mt-2 w-full text-left text-sm">
    <thead class="text-xs uppercase tracking-wider text-white/40"><tr><th class="py-2 pr-4">On the register</th><th class="px-3 py-2 text-right">Shares</th><th class="py-2 pl-3">Holder in the portal</th></tr></thead>
    <tbody class="divide-y divide-white/5">
      {rows.map((m) => (
        <tr class="align-top">
          <td class="py-2 pr-4"><span class="text-white/85">{m.name}</span>{m.trust && <span class="block text-xs text-white/50">for {m.trust}</span>}{m.acn && <span class="block text-xs text-white/40">ACN {m.acn}</span>}</td>
          <td class="whitespace-nowrap px-3 py-2 text-right tabular-nums text-white/75">{m.classes.map((c) => <span class="block">{c.shares.toLocaleString('en-AU')} <span class="text-white/45">{c.code}</span></span>)}</td>
          <td class="py-2 pl-3">
            <select name={`h:${m.key}`} data-holders class="field w-full max-w-md" aria-label={`Portal holder for ${m.register_name}`}>
              {m.holderId && <option value={m.holderId} selected>{m.holderName}</option>}
              <option value="new" selected={!m.holderId}>New holder: {m.newName} ({KIND[m.kind] ?? m.kind})</option>
            </select>
            <span class:list={['mt-1 block text-xs', TONE[m.how] ?? 'text-white/40']}>{HOW[m.how] ?? m.how}{m.why && m.how === 'suggested' ? `: ${m.why}. Check it’s the same holder.` : m.how === 'register' ? `: ${m.why}` : ''}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
