---
import SectionTabs from './SectionTabs.astro';
// Tabs across Admin → Legal. Companies' records are under Companies; board work under Board & governance.
const access = Astro.locals.access;
---
<SectionTabs label="Legal" tabs={[
  { href: '/admin/legal', label: 'Overview', exact: true, also: ['/admin/legal/extract'] },
  { href: '/admin/legal/contracts', label: 'Contracts' },
  { href: access.canAny('legal.view') ? '/admin/legal/requests' : '/admin/legal-requests', label: 'Requests', also: ['/admin/legal/requests', '/admin/legal-requests'] },
  { href: '/admin/legal/ask', label: 'Legal Ask' },
]} />
