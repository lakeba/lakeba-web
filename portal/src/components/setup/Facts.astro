---
// The short answers a non-technical reader needs before starting: what changes, who, how long.
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<dl class="grid gap-x-4 gap-y-2 rounded-xl bg-white/[0.04] p-3 text-sm sm:grid-cols-[9rem_1fr]">
  {items.map(([k, v]) => (<><dt class="font-medium text-white/80">{k}</dt><dd class="text-white/60">{v}</dd></>))}
</dl>
