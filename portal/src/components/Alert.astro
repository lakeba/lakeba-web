---
interface Props { tone?: 'error' | 'success' | 'info' }
const { tone = 'info' } = Astro.props;
const styles = {
  error: 'border-lk-red/40 bg-lk-red/10 text-white/90',
  success: 'border-lk-green/40 bg-lk-green/10 text-white/90',
  info: 'border-lk-blue/40 bg-lk-blue/10 text-white/90',
};
---

<p role={tone === 'error' ? 'alert' : 'status'} class:list={['rounded-xl border px-4 py-3 text-sm', styles[tone]]}>
  <slot />
</p>
