---
import type { Card, VentureLine } from '../lib/getting-started';
import { unfinished } from '../lib/getting-started';

// Admin → Overview: what is left to run a venture's portal (lib/getting-started.ts). The next required step is
// highlighted; finished steps fold away; the card goes once every required step is done or is hidden for now.
interface Props { cards: Card[]; ventures: VentureLine[] }
const { cards, ventures } = Astro.props;
const pending = ventures.filter((v) => v.done < v.of);
---

{cards.filter((c) => unfinished(c.steps)).map((c) => {
  const required = c.steps.filter((s) => !s.optional);
  const doneRequired = required.filter((s) => s.done).length;
  const next = c.steps.find((s) => !s.done && !s.optional);
  const todo = c.steps.filter((s) => !s.done);
  const done = c.steps.filter((s) => s.done);
  const row = (s: (typeof c.steps)[number]) => (
    <li class:list={['grid grid-cols-[auto_1fr] items-center gap-x-3.5 gap-y-2 rounded-2xl border px-4 py-3 sm:grid-cols-[auto_1fr_auto]', s === next ? 'border-lk-blue/45 bg-lk-blue/[0.07]' : 'border-white/10 bg-white/[0.02]']}>
      <span class:list={['grid size-6 place-items-center rounded-full border-[1.5px] text-xs font-bold', s.done ? 'border-lk-green bg-lk-green text-[#fff]' : s === next ? 'border-lk-blue' : 'border-white/25']} aria-label={s.done ? 'Done' : 'To do'}>{s.done ? '✓' : ''}</span>
      <span class="min-w-0">
        <span class:list={['text-sm font-semibold', s.done ? 'text-white/60' : 'text-white']}>{s.title}</span>
        {s.optional && <span class="ml-1.5 rounded-md bg-white/10 px-1.5 py-0.5 align-[1px] text-[10px] font-semibold uppercase tracking-wider text-white/55">Optional</span>}
        <span class="mt-0.5 block break-words text-[13px] text-white/55">{s.detail}</span>
      </span>
      {!s.done && <a href={s.href} class:list={['col-start-2 justify-self-start !px-3 !py-1.5 text-xs sm:col-start-3', s === next ? 'btn-primary' : 'btn-ghost']}>{s.action} →</a>}
    </li>
  );
  return (
    <section class="card mb-4" aria-label={`Getting started with ${c.company.name}`}>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div><h2 class="font-display text-xl font-bold">{c.role === 'admin' ? `Getting started with ${c.company.name}` : `Getting started: ${c.company.name}`}</h2>
          <p class="mt-1 text-sm text-white/55">{c.role === 'admin' ? `What’s left to run ${c.company.name}’s investor portal. Each step ticks itself once it’s done in the portal.` : `Your part in ${c.company.name}’s investor portal: documents and news.`}</p></div>
        <form method="post" action="/api/getting-started"><button class="btn-ghost !px-3 !py-1.5 text-xs">Hide for now</button></form>
      </div>
      <div class="mt-4 flex items-center gap-3 text-xs text-white/55">
        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-white/10"><div class="h-full rounded-full bg-gradient-to-r from-lk-blue to-lk-green" style={`width:${(doneRequired / required.length) * 100}%`} /></div>
        {doneRequired} of {required.length} done
      </div>
      <ul class="mt-4 grid gap-2">{todo.map(row)}</ul>
      {done.length > 0 && (
        <details class="group/done mt-2">
          <summary class="cursor-pointer list-none text-[13px] font-medium text-lk-blue hover:underline"><span class="group-open/done:hidden">Show {done.length} done</span><span class="hidden group-open/done:inline">Hide {done.length} done</span></summary>
          <ul class="mt-2 grid gap-2">{done.map(row)}</ul>
        </details>
      )}
      <p class="mt-4 text-xs text-white/40">The card goes away once every step is done.</p>
    </section>
  );
})}

{pending.length > 0 && (
  <section class="card mb-4" aria-labelledby="ventures-gs">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><h2 id="ventures-gs" class="font-display text-xl font-bold">Ventures getting started</h2>
        <p class="mt-1 text-sm text-white/55">Where each venture’s set-up stands. Its own Admins see the same steps on their Overview.</p></div>
      <form method="post" action="/api/getting-started"><button class="btn-ghost !px-3 !py-1.5 text-xs">Hide for now</button></form>
    </div>
    <ul class="mt-4 grid gap-2">
      {ventures.map((v) => (
        <li class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 rounded-2xl border border-white/10 px-4 py-3 text-sm sm:grid-cols-[11rem_1fr_6.5rem_auto]">
          <span class="min-w-0"><span class="font-semibold text-white">{v.name}</span><span class="block truncate text-xs text-white/55" title={v.left}>{v.left}</span></span>
          <div class="col-span-2 row-start-2 h-1.5 overflow-hidden rounded-full bg-white/10 sm:col-span-1 sm:row-start-auto"><div class="h-full rounded-full bg-gradient-to-r from-lk-blue to-lk-green" style={`width:${(v.done / v.of) * 100}%`} /></div>
          <span class="hidden text-right text-xs text-white/45 sm:block">{v.done} of {v.of} done</span>
          <a href={`/admin/companies/${v.code}/setup`} class="btn-ghost !px-3 !py-1.5 text-xs">{v.done === v.of ? 'View' : 'Open'} →</a>
        </li>
      ))}
    </ul>
  </section>
)}
