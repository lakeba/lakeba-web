---
// The Account pages (the profile menu's) share one header: tabs, then the title, a short description and any
// buttons on the right (as the admin's pages).
interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
const { t } = Astro.locals;
const path = Astro.url.pathname;
const tabs = [
  { href: '/profile', label: t('Profile') },
  { href: '/account/security', label: t('Security') },
  { href: '/account/notifications', label: t('Notifications') },
  { href: '/inbox', label: t('Inbox') },
];
---
<div class="mb-6">
  <nav class="mb-6 flex gap-1 overflow-x-auto border-b border-white/10 text-sm [scrollbar-width:none]" aria-label={t('Your account')}>
    {tabs.map((x) => <a href={x.href} aria-current={path.startsWith(x.href) ? 'page' : undefined} class:list={['-mb-px shrink-0 border-b-2 px-3 py-2', path.startsWith(x.href) ? 'border-lk-blue text-white' : 'border-transparent text-white/55 hover:text-white']}>{x.label}</a>)}
  </nav>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl font-bold">{title}</h1>
      {subtitle && <p class="mt-1 max-w-3xl text-sm text-white/55">{subtitle}</p>}
    </div>
    <slot />
  </div>
</div>
