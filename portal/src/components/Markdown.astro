---
import { Marked } from 'marked';
interface Props { source: string }
// Raw HTML in the source is shown as text, never rendered.
const marked = new Marked({ renderer: { html: ({ text }) => text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`) } });
const html = await marked.parse(Astro.props.source);
---

<div class="prose-portal" set:html={html} />

<style>
  .prose-portal :global(p) { margin: 0 0 1rem; line-height: 1.75; color: color-mix(in oklab, var(--color-white) 75%, transparent); }
  .prose-portal :global(h2), .prose-portal :global(h3) { margin: 2rem 0 0.75rem; font-family: var(--font-display); font-weight: 700; color: var(--color-white); }
  .prose-portal :global(ul) { margin: 0 0 1rem 1.25rem; list-style: disc; color: color-mix(in oklab, var(--color-white) 75%, transparent); }
  .prose-portal :global(li) { margin: 0.25rem 0; }
  .prose-portal :global(a) { color: #5b8ff0; text-decoration: underline; }
  .prose-portal :global(strong) { color: var(--color-white); }
  .prose-portal :global(table) { width: 100%; margin: 0 0 1.25rem; border-collapse: collapse; font-size: 0.875rem; }
  .prose-portal :global(th), .prose-portal :global(td) { border-bottom: 1px solid color-mix(in oklab, var(--color-white) 8%, transparent); padding: 0.4rem 0.6rem; text-align: left; color: color-mix(in oklab, var(--color-white) 75%, transparent); }
  .prose-portal :global(th) { color: var(--color-white); font-weight: 600; }
  .prose-portal :global(td[align="right"]), .prose-portal :global(th[align="right"]) { text-align: right; font-variant-numeric: tabular-nums; }
</style>
