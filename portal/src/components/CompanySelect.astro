---
import type { AdminScope } from '../lib/admin-company';
interface Props { scope: AdminScope; id?: string; name?: string; value?: string | null }
const { scope, id = 'entity_id', name = 'entity_id', value } = Astro.props;
const current = value ?? scope.defaultCompany?.id;
---

{scope.companies.length > 1 ? (
  <div><label class="label" for={id}>Company</label>
    <select class="field" id={id} name={name}>{scope.companies.map((c) => <option value={c.id} selected={c.id === current}>{c.display_name}</option>)}</select></div>
) : <input type="hidden" name={name} value={current ?? ''} />}
