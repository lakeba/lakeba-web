---
import '../styles/portal.css';
import Mark from '../../../src/components/Mark.astro';
import ThemeInit from '../../../src/components/ThemeInit.astro';
import ThemeToggle from '../../../src/components/ThemeToggle.astro';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { brandName } from '../lib/companies';
import { accentOf, brandOf } from '../lib/brand';
import NoteBanner from '../components/NoteBanner.astro';
import { serviceClient } from '../lib/admin';
import { HTML_LANG } from '../lib/i18n';
import { ADMIN_KINDS, workHome } from '../lib/view-mode';
import Tour from '../components/Tour.astro';
import type { AdminScope } from '../lib/admin-company';
interface Props {
  title: string;
  /** Admin pages that work by company (Admin layout): the header's company switcher becomes their filter. */
  adminFilter?: { scope: AdminScope; allowAll?: boolean; path: string };
}
const { title, adminFilter } = Astro.props;
const { profile, supabase, user, company, companies, adminOf, features, t, locale } = Astro.locals;
const path = Astro.url.pathname;
const isGroup = company?.relationship === 'group';
const brand = brandName(company);
const contact = brandOf(company).contactEmail;
// On a venture's own address (sites.ts) the header carries its name; the switcher still reaches the others.
const onVenture = Astro.locals.site?.kind === 'venture';
// A venture's colour as the accent while its investors look at it (Lakeba's blue otherwise).
const accent = accentOf(company);
// All, admin or investor view (view-mode.ts): all shows every menu, the others their own. The work ones: the admin, directors'
// resolutions and minutes to sign (pages/sign), My HR for an employee of a group company.
const view = Astro.locals.viewMode;
const { work } = view;
const adminMode = view.mode === 'admin';
const workNav: { href: string; label: string; tag?: string }[] = [
  ...(work.admin && Astro.locals.access.mayOpen('/admin') ? [{ href: '/admin', label: t('Admin') }] : []),
  ...(work.toSign ? [{ href: '/sign', label: t('To sign'), ...(work.waiting ? { tag: String(work.waiting) } : {}) }] : []),
  ...(work.hr ? [{ href: '/my-hr', label: t('My HR') }] : []),
];
const introductions = user && !adminMode ? ((await serviceClient().from('entities').select('id', { count: 'exact', head: true }).eq('crm_enabled', true).eq('crm_accepts_introductions', true)).count ?? 0) > 0 : false;
const nav: { href: string; label: string; tag?: string }[] = adminMode ? workNav : [
  { href: '/', label: t('Dashboard') },
  { href: '/documents', label: t('Documents') },
  ...(isGroup ? [{ href: '/portfolio', label: t('Portfolio') }] : []),
  { href: '/agm', label: t('Meetings') },
  { href: '/news', label: t('News') },
  ...(company && features.ask ? [{ href: '/ask', label: company.ask_name?.trim() || t('Ask {brand}', { brand }), tag: 'AI' }] : []),
  ...(features.boardQa ? [{ href: '/board', label: t('Ask the board') }] : []),
  ...(features.trading ? [{ href: '/trading', label: t('Trading') }] : []),
  // Introduce a business to a Lakeba company (when one takes shareholders' introductions).
  ...(introductions ? [{ href: '/introduce', label: t('Introduce') }] : []),
  // Not in the investor view of someone who works here (a venture's own domain keeps them).
  ...(view.on ? [] : workNav),
];
const home = adminMode ? workHome(work) : '/';
// Guided tours (lib/tours.ts): elements are marked data-tour; "Take the tour" replays the one for this view.
const tourOf = (href: string) => `nav-${href === '/' ? 'home' : href.slice(1).replace(/\//g, '-')}`;
const tourHref = adminMode || (view.offered && view.mode === 'all' && !view.investor)
  ? (work.admin ? '/admin?tour=staff' : work.toSign ? '/sign?tour=director' : null)
  : '/?tour=investor';
// Phones: four main sections in the bottom bar; everything else under More.
const PRIMARY = adminMode ? workNav.map((n) => n.href) : ['/', '/documents', '/agm', '/news'];
const primary = nav.filter((n) => PRIMARY.includes(n.href));
const more = nav.filter((n) => !PRIMARY.includes(n.href));
const ICONS: Record<string, string> = {
  '/': 'M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10',
  '/documents': 'M7 3.5h7l4.5 4.5v12.5H7zM14 3.5V8h4.5M9.5 13h6M9.5 16.5h6',
  '/agm': 'M4 6.5h16v13H4zM8 4v5M16 4v5M4 11h16',
  '/news': 'M5 5.5h11v14H6.5A1.5 1.5 0 0 1 5 18zM16 9h3v9a1.5 1.5 0 0 1-3 0M8 9h5M8 12.5h5M8 16h3',
  '/admin': 'M4 5h16v14H4zM9 5v14M12 9h5M12 12.5h5',
  '/sign': 'M4 19.5h16M6 16l9.5-9.5 2.5 2.5L8.5 18.5H6z',
  '/my-hr': 'M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M5 20c.8-3.5 3.6-5.5 7-5.5s6.2 2 7 5.5',
  more: 'M5 12h.01M12 12h.01M19 12h.01',
};
// On admin pages the investor's company switcher gives way to the admin's company filter (or nothing).
const onAdmin = path === '/admin' || path.startsWith('/admin/');
const filterActive = adminFilter && (adminFilter.scope.selected ?? (adminFilter.allowAll === false ? adminFilter.scope.defaultCompany : null));
const filterHref = (code: string) => `${adminFilter?.path ?? path}?company=${code}`;
const switchHref = (code: string) => `/company/${code}?next=${encodeURIComponent(path)}`;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const initials = `${profile?.first_name?.[0] ?? ''}${profile?.last_name?.[0] ?? ''}`.toUpperCase() || '·';

// Investor mode for someone who also works here: admin notifications stay out of sight too.
const unreadQuery = supabase.from('notifications').select('id', { count: 'exact', head: true }).is('read_at', null);
const { count: unread } = user ? await (view.on ? unreadQuery.not('kind', 'in', ADMIN_KINDS) : unreadQuery) : { count: 0 };
const here = `${path}${Astro.url.search}`;
---

<!doctype html>
<html lang={HTML_LANG[locale]} style={accent ? `--color-lk-blue:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={`${brand} Investors`} />
    <meta name="theme-color" content="#050b16" />
    <ThemeInit />
    <title>{title} · {adminMode ? brand : t('{brand} Investor Portal', { brand })}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="overflow-x-clip">
    <div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[30rem] overflow-hidden">
      <div class="absolute -top-48 left-1/4 h-[30rem] w-[30rem] rounded-full bg-lk-blue/15 blur-[120px]"></div>
    </div>
    <header class="sticky top-0 z-40 border-b border-white/5 bg-ink/80 backdrop-blur-xl">
      <div class="container-portal flex h-16 items-center justify-between gap-4">
        {onVenture && company ? (
        <a href="/" class="flex min-w-0 shrink items-center gap-2.5">
          {company.logo_url
            ? <span class="grid h-9 shrink-0 place-items-center rounded-lg bg-[#fff] px-2"><img src={company.logo_url} alt={company.display_name} class="max-h-7 max-w-32 object-contain" /></span>
            : <><span class="size-3 shrink-0 rounded-full" style={`background:${company.brand_color ?? '#2563EB'}`}></span><span class="truncate font-display text-lg font-bold text-white">{company.display_name}</span></>}
          <span class="hidden rounded-md bg-white/10 px-1.5 py-0.5 text-[11px] font-medium text-white/70 sm:inline">{t('Investors')}</span>
        </a>
        ) : (
        <a href={home} class="flex shrink-0 items-center gap-2.5">
          <Mark class="size-7" />
          <span class:list={["font-display text-lg font-bold text-white", company && (companies.length > 1 || !isGroup) && "hidden sm:inline"]}>lakeba</span>
          <span class:list={['hidden rounded-md px-1.5 py-0.5 text-[11px] font-medium sm:inline', adminMode ? 'bg-lk-orange/15 text-lk-orange' : 'bg-white/10 text-white/70']}>{adminMode ? t('Admin') : t('Investors')}</span>
        </a>
        )}
        {onAdmin ? (adminFilter && (adminFilter.scope.companies.length > 1 ? (
          <details data-menu class="relative mr-auto">
            <summary data-tour="admin-company" class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-white/10 px-3 py-1.5 text-sm text-white/85 hover:bg-white/5" aria-label="Company">
              {filterActive ? <><span class="size-2.5 rounded-full" style={`background:${filterActive.brand_color ?? '#2563EB'}`}></span><span class="max-w-[10rem] truncate font-medium">{filterActive.display_name}</span></> : <span class="font-medium">All companies</span>}
              <svg viewBox="0 0 20 20" class="size-4 text-white/45" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </summary>
            <div class="absolute border border-white/10 bg-ink left-0 mt-2 w-64 rounded-2xl p-2 text-sm shadow-2xl shadow-black/50">
              <p class="px-3 py-2 text-xs text-white/45">Show</p>
              {adminFilter.allowAll !== false && (
                <a href={filterHref('all')} aria-current={!filterActive ? 'true' : undefined} class:list={['flex items-center gap-2.5 rounded-lg px-3 py-2 hover:bg-white/5', !filterActive && 'bg-white/5 text-white']}>
                  <span class="size-2.5 shrink-0 rounded-full border border-white/30"></span><span>All companies</span>
                </a>
              )}
              {adminFilter.scope.companies.map((c) => (
                <a href={filterHref(c.code)} aria-current={c.id === filterActive?.id ? 'true' : undefined} class:list={['flex items-center gap-2.5 rounded-lg px-3 py-2 hover:bg-white/5', c.id === filterActive?.id && 'bg-white/5 text-white']}>
                  <span class="size-2.5 shrink-0 rounded-full" style={`background:${c.brand_color ?? '#2563EB'}`}></span>
                  <span class="truncate">{c.display_name}</span>
                </a>
              ))}
            </div>
          </details>
        ) : adminFilter.scope.companies[0] && (
          <span data-tour="admin-company" class="mr-auto flex items-center gap-2 rounded-full border border-white/10 px-3 py-1.5 text-sm font-medium text-white/85">
            <span class="size-2.5 rounded-full" style={`background:${adminFilter.scope.companies[0].brand_color ?? '#2563EB'}`}></span>{adminFilter.scope.companies[0].display_name}
          </span>
        ))) : company && (companies.length > 1 ? (
          <details data-menu class="relative mr-auto">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-white/10 px-3 py-1.5 text-sm text-white/85 hover:bg-white/5" aria-label={t('Switch company')}>
              {onVenture ? <span class="hidden font-medium sm:inline">{t('Your companies')}</span>
                : <><span class="size-2.5 rounded-full" style={`background:${company.brand_color ?? '#2563EB'}`}></span><span class="max-w-[10rem] truncate font-medium">{company.display_name}</span></>}
              <svg viewBox="0 0 20 20" class="size-4 text-white/45" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </summary>
            <div class="absolute border border-white/10 bg-ink left-0 mt-2 w-64 rounded-2xl p-2 text-sm shadow-2xl shadow-black/50">
              <p class="px-3 py-2 text-xs text-white/45">{t('Your companies')}</p>
              {companies.map((c) => (
                <a href={switchHref(c.code)} aria-current={c.id === company.id ? 'true' : undefined} class:list={['flex items-center gap-2.5 rounded-lg px-3 py-2 hover:bg-white/5', c.id === company.id && 'bg-white/5 text-white']}>
                  <span class="size-2.5 shrink-0 rounded-full" style={`background:${c.brand_color ?? '#2563EB'}`}></span>
                  <span class="truncate">{c.display_name}</span>
                  {c.id === company.id && <span class="ml-auto text-xs text-white/40">{t('Viewing')}</span>}
                </a>
              ))}
            </div>
          </details>
        ) : !isGroup && !onVenture && (
          <span class="mr-auto flex items-center gap-2 rounded-full border border-white/10 px-3 py-1.5 text-sm font-medium text-white/85">
            <span class="size-2.5 rounded-full" style={`background:${company.brand_color ?? '#2563EB'}`}></span>{company.display_name}
          </span>
        ))}
        <div class="flex items-center gap-2">
          <ThemeToggle />
          <a href="/inbox" data-tour="inbox" class="relative grid size-9 place-items-center rounded-full text-white/60 transition hover:bg-white/5 hover:text-white" aria-label={unread ? t('Inbox, {n} unread', { n: unread }) : t('Inbox')}>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 1112 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 003.4 0" /></svg>
            {unread ? <span class="absolute -top-0.5 -right-0.5 grid min-w-4 place-items-center rounded-full bg-lk-orange px-1 text-[10px] font-bold text-ink">{unread > 9 ? '9+' : unread}</span> : null}
          </a>
          <details data-menu class="relative">
            <summary data-tour="account-menu" class="grid size-9 cursor-pointer list-none place-items-center overflow-hidden rounded-full bg-gradient-to-br from-lk-blue to-lk-green font-display text-sm font-bold text-white" title={profile?.email}>{profile?.avatar_path ? <img src={`/avatar/${profile.avatar_path}`} alt="" class="size-full object-cover" /> : initials}</summary>
            <div class="absolute border border-white/10 bg-ink right-0 mt-2 w-56 rounded-2xl p-2 text-sm shadow-2xl shadow-black/50">
              <p class="truncate px-3 py-2 text-xs text-white/45">{profile?.email}</p>
              <a href="/profile" class="block rounded-lg px-3 py-2 hover:bg-white/5">{t('Profile')}</a>
              <a href="/account/security" class="block rounded-lg px-3 py-2 hover:bg-white/5">{t('Security')}</a>
              <a href="/account/notifications" class="block rounded-lg px-3 py-2 hover:bg-white/5">{t('Notifications')}</a>
              <a href="/inbox" class="block rounded-lg px-3 py-2 hover:bg-white/5">{t('Inbox')}</a>
              {tourHref && <a href={tourHref} class="block rounded-lg px-3 py-2 hover:bg-white/5">{t('Take the tour')}</a>}
              {view.offered && (
                <form method="post" action="/account/view" class="border-t border-white/5 mt-1 pt-1">
                  <input type="hidden" name="next" value={here} />
                  {([['all', t('View all')], ['admin', t('View as admin')], ...(view.investor ? [['investor', t('View as investor')]] : [])] as [string, string][]).map(([value, label]) => (
                    <button name="view" value={value} aria-current={view.mode === value ? 'true' : undefined}
                      class:list={['flex w-full items-center justify-between rounded-lg px-3 py-2 text-left hover:bg-white/5', view.mode === value && 'text-white']}>{label}{view.mode === value && <span class="text-lk-blue" aria-hidden="true">✓</span>}</button>
                  ))}
                </form>
              )}
              <form method="post" action="/logout"><button class="w-full rounded-lg px-3 py-2 text-left text-white/70 hover:bg-white/5 hover:text-white">{t('Sign out')}</button></form>
            </div>
          </details>
        </div>
      </div>
      <nav class="container-portal -mb-px hidden gap-1 overflow-x-auto pb-px text-sm [scrollbar-width:none] sm:flex" aria-label={t('Portal')}>
        {nav.map((n) => (
          <a href={n.href} data-tour={tourOf(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}
            class:list={['shrink-0 border-b-2 px-3 py-3 transition', isActive(n.href) ? 'border-lk-blue text-white' : 'border-transparent text-white/55 hover:text-white']}>{n.label}{n.tag && <span class="ml-1.5 rounded bg-lk-blue/15 px-1 py-px text-[10px] font-semibold text-lk-blue">{n.tag}</span>}</a>
        ))}
      </nav>
    </header>
    {/* Phones: the main sections in a bar at the bottom, the rest under More. */}
    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink/95 pb-[env(safe-area-inset-bottom)] backdrop-blur sm:hidden" aria-label={t('Portal')} data-bottom-nav>
      <div class="grid grid-cols-5 text-[11px]">
        {primary.map((n) => (
          <a href={n.href} data-tour={tourOf(n.href)} aria-current={isActive(n.href) ? 'page' : undefined} class:list={['flex flex-col items-center gap-1 px-1 py-2.5', isActive(n.href) ? 'text-lk-blue' : 'text-white/55']}>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS[n.href] ?? ICONS.more} /></svg>
            <span class="truncate">{n.label}</span>
          </a>
        ))}
        <details data-menu class="group/more relative">
          <summary class:list={['flex cursor-pointer list-none flex-col items-center gap-1 px-1 py-2.5', more.some((n) => isActive(n.href)) ? 'text-lk-blue' : 'text-white/55']}>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d={ICONS.more} /></svg>
            <span>{t('More')}</span>
          </summary>
          <div class="absolute bottom-full right-2 mb-2 w-56 rounded-2xl border border-white/10 bg-ink p-2 text-sm shadow-2xl">
            {more.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class:list={['flex items-center justify-between rounded-lg px-3 py-2.5', isActive(n.href) ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5']}>{n.label}{n.tag && <span class="rounded bg-lk-blue/15 px-1 py-px text-[10px] font-semibold text-lk-blue">{n.tag}</span>}</a>)}
            <a href="/profile" class="mt-1 block rounded-lg border-t border-white/5 px-3 py-2.5 text-white/70 hover:bg-white/5">{t('Your account')}</a>
          </div>
        </details>
      </div>
    </nav>
    <main class="container-portal py-10 pb-28 sm:pb-10">
      <NoteBanner />
      <slot />
    </main>
    <Tour />
    <footer class="container-portal flex flex-col justify-between gap-2 border-t border-white/5 py-8 pb-28 text-xs text-white/35 sm:flex-row sm:pb-8">
      <p>{isGroup || !company ? `© ${new Date().getFullYear()} Lakeba Group Limited` : t('{company} Investor Portal, powered by Lakeba', { company: company.display_name })}</p>
      <p>{t('Questions:')} {features.boardQa && !adminMode && <><a href="/board" class="hover:text-white">{t('Board Q&A')}</a> · </>}<a href={`mailto:${contact}`} class="hover:text-white">{contact}</a> · <a href="/go/linkedin?src=footer" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-white"><LinkedInIcon class="size-3.5" /> LinkedIn</a></p>
    </footer>
    <script>
      // Header menus (details[data-menu]) close when the page is clicked elsewhere, on Escape, and when another opens.
      const menus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]');
      document.addEventListener('click', (e) => { for (const m of menus()) if (!m.contains(e.target as Node)) m.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') for (const m of menus()) { m.open = false; m.querySelector('summary')?.focus(); } });
      for (const m of document.querySelectorAll<HTMLDetailsElement>('details[data-menu]')) {
        m.addEventListener('toggle', () => { if (m.open) for (const other of menus()) if (other !== m) other.open = false; });
      }
    </script>
  </body>
</html>
