---
import Portal from './Portal.astro';
import { mayOpenItem } from '../lib/access';
import { toPage, toShown } from '../lib/admin-paths';
import { serviceClient } from '../lib/admin';
import { waitingFor } from '../lib/approvals';
import { WHATS_NEW } from '../lib/whats-new';
import type { AdminScope } from '../lib/admin-company';
interface Props {
  title: string;
  /** Pages that work by company (adminScope(…, true)): the company filter in the header. `allowAll: false` on pages that work on one company at a time. */
  filter?: { scope: AdminScope; allowAll?: boolean };
}
const { title, filter } = Astro.props;
// The address shown (a rewritten page's own path maps back to it).
const path = toShown(Astro.url.pathname);
const access = Astro.locals.access;
// The admin by what people are doing (addresses: lib/admin-paths.ts). "also": other pages that belong to an
// item; "exact": a section's first page, which doesn't own everything under it.
type Item = { href: string; label: string; exact?: boolean; also?: string[] };
const groups: { label: string; items: Item[] }[] = [
  { label: 'Investors', items: [
    { href: '/admin/investors', label: 'Investors' },
    { href: '/admin/holdings', label: 'Register', also: ['/admin/holders'] },
    { href: '/admin/engagement', label: 'Engagement' },
    { href: '/admin/import', label: 'Import data' },
  ] },
  { label: 'Communications', items: [
    { href: '/admin/news', label: 'News' },
    { href: '/admin/content', label: 'Announcements' },
    { href: '/admin/newsletters', label: 'Newsletters' },
    { href: '/admin/press', label: 'Press releases' },
    { href: '/admin/linkedin', label: 'LinkedIn campaign' },
    { href: '/admin/emails', label: 'Shareholder emails' },
    { href: '/admin/queries', label: 'Investor questions' },
    { href: '/admin/guides/marketing.pdf', label: 'Guide (PDF)' },
  ] },
  { label: 'Documents', items: [
    { href: '/admin/documents', label: 'Documents' },
    { href: '/admin/data-rooms', label: 'Data rooms' },
  ] },
  { label: 'Board & governance', items: [
    { href: '/admin/board', label: 'Board meetings', exact: true, also: ['/admin/board/meetings', '/admin/board/papers'] },
    { href: '/admin/board/shareholder-meetings', label: 'Shareholder meetings' },
    { href: '/admin/board/ask', label: 'Board Ask' },
    { href: '/admin/board/minute-book', label: 'Minute book' },
    { href: '/admin/board/deadlines', label: 'Deadlines' },
  ] },
  { label: 'Legal', items: [
    { href: '/admin/legal', label: 'Overview', exact: true, also: ['/admin/legal/extract'] },
    { href: '/admin/legal/contracts', label: 'Contracts' },
    // One place for requests: Lakeba's Legal team sees every company's, everyone else their own.
    { href: access.canAny('legal.view') ? '/admin/legal/requests' : '/admin/legal-requests', label: 'Requests', also: ['/admin/legal/requests', '/admin/legal-requests'] },
    { href: '/admin/legal/ask', label: 'Legal Ask' },
    { href: '/admin/guides/legal.pdf', label: 'Guide (PDF)' },
  ] },
  { label: 'Finance', items: [
    { href: '/admin/accounting', label: 'Group view', exact: true, also: ['/admin/accounting/group', '/admin/accounting/schedules'] },
    // One place for reporting packs: Lakeba's finance team reviews every company's, a company sends its own.
    { href: access.can('accounting.view', null) ? '/admin/accounting/packs' : '/admin/reporting', label: 'Reporting packs', also: ['/admin/accounting/packs', '/admin/reporting'] },
    { href: '/admin/accounting/board', label: 'Board summary' },
    { href: '/admin/accounting/year-end', label: 'Year-end' },
    { href: '/admin/accounting/commissions', label: 'Commissions' },
    { href: '/admin/ventures', label: 'Ventures & prices' },
    { href: '/admin/trading', label: 'Secondary trading' },
    { href: '/admin/guides/finance.pdf', label: 'Guide (PDF)' },
  ] },
  { label: 'People', items: [
    { href: '/admin/hr', label: 'People', exact: true, also: ['/admin/hr/people'] },
    { href: '/admin/hr/equity', label: 'Equity plans' },
    { href: '/admin/hr/policies', label: 'Policies' },
    { href: '/admin/hr/performance', label: 'Performance' },
    { href: '/admin/guides/hr.pdf', label: 'Guide (PDF)' },
  ] },
  // The CRM opens in its own frame (layouts/Crm.astro), also at a venture's CRM address.
  { label: 'Sales', items: [
    { href: '/admin/crm', label: 'CRM' },
    { href: '/admin/guides/sales.pdf', label: 'Guide (PDF)' },
  ] },
  // Companies: each company's set-up (details, share classes, legal record, website, domain and mail), so with the settings.
  { label: 'Settings', items: [
    { href: '/admin/companies', label: 'Companies' },
    { href: '/admin/system/users', label: 'Users' },
    { href: '/admin/system/roles', label: 'Roles' },
    { href: '/admin/audit', label: 'Audit log' },
    { href: '/admin/integrations', label: 'Integrations' },
    { href: '/admin/notifications', label: 'Notifications' },
    { href: '/admin/ask-review', label: 'AI assistants', also: ['/admin/ask-knowledge', '/admin/ask-tests'] },
    { href: '/admin/guides/compliance.pdf', label: 'Guide (PDF)' },
  ] },
];
// Approvals: for anyone who prepares or approves; the count is what waits for them.
const approvalsOpen = mayOpenItem(access, '/admin/approvals');
// What's new: marked for two weeks after its newest entry.
const recentNews = Date.now() - Date.parse(`${WHATS_NEW[0]?.date ?? '2000-01-01'}T00:00:00`) < 14 * 86_400_000;
const waitingCount = approvalsOpen ? (await waitingFor(serviceClient(), access, Astro.locals.user!.id)).length : 0;
const under = (p: string) => path === p || path.startsWith(`${p}/`);
const active = (href: string, item?: Item) => (href === '/admin' ? path === '/admin' : (item?.exact ? path === href : under(href)) || Boolean(item?.also?.some(under)));
// Only the sections this person's roles open; empty groups are left out.
const visible = groups
  .map((g) => ({ ...g, items: g.items.filter((i) => mayOpenItem(access, toPage(i.href))) }))
  .filter((g) => g.items.length);
const current = visible.flatMap((g) => g.items).find((i) => active(i.href, i))?.label ?? (path === '/admin' ? 'Overview' : active('/admin/approvals') ? 'Approvals' : active('/admin/whats-new') ? 'What\'s new' : title);
---

<Portal title={`${title} · Admin`} adminFilter={filter && { ...filter, path }}>
  <div class="grid gap-6 lg:grid-cols-[12rem_1fr] xl:gap-8">
    <aside class="lg:sticky lg:top-32 lg:max-h-[calc(100vh-9rem)] lg:self-start lg:overflow-y-auto">
      <!-- On phones the whole menu folds away under the current page's name. -->
      <details class="group/menu lg:hidden" data-admin-menu>
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl border border-white/10 px-4 py-3 text-sm">
          <span><span class="text-white/45">Admin ·</span> <span class="font-medium text-white">{current}</span></span>
          <svg viewBox="0 0 20 20" class="size-4 text-white/45 transition group-open/menu:rotate-180" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <div class="mt-2" data-admin-menu-slot></div>
      </details>
      <p class="eyebrow hidden lg:block" data-admin-eyebrow>Admin</p>
      <nav class="mt-2 hidden text-sm lg:mt-4 lg:block" aria-label="Admin" data-admin-nav data-tour="admin-menu">
        {mayOpenItem(access, '/admin') && <a href="/admin" aria-current={active('/admin') ? 'page' : undefined}
          class:list={['block rounded-lg px-3 py-2 transition', active('/admin') ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>Overview</a>}
        {approvalsOpen && <a href="/admin/approvals" data-tour="admin-approvals" aria-current={active('/admin/approvals') ? 'page' : undefined}
          class:list={['flex items-center justify-between rounded-lg px-3 py-2 transition', active('/admin/approvals') ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>Approvals{waitingCount > 0 && <span class="rounded-full bg-lk-orange/20 px-2 text-xs text-lk-orange" aria-label={`${waitingCount} waiting`}>{waitingCount}</span>}</a>}
        <a href="/admin/whats-new" data-tour="admin-whats-new" aria-current={active('/admin/whats-new') ? 'page' : undefined}
          class:list={['flex items-center justify-between rounded-lg px-3 py-2 transition', active('/admin/whats-new') ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>What's new{recentNews && <span class="rounded bg-lk-blue/15 px-1.5 text-[10px] font-semibold text-lk-blue">NEW</span>}</a>
        {visible.map((g) => {
          const open = g.items.some((i) => active(i.href, i));
          // A section with one page is a plain link.
          if (g.items.length === 1) return (
            <a href={g.items[0].href} aria-current={open ? 'page' : undefined}
              class:list={['mt-1 block rounded-lg px-3 py-2 transition', open ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>{g.items[0].label}</a>
          );
          return (
            <details class="group/sec mt-1" open={open} data-admin-group={g.label} data-current={open ? '' : undefined}>
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-[11px] font-semibold uppercase tracking-widest text-white/40 hover:text-white/70">
                {g.label}
                <svg viewBox="0 0 20 20" class="size-3.5 transition group-open/sec:rotate-180" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="mb-1 ml-2 border-l border-white/10 pl-2">
                {g.items.map((s) => (
                  <a href={s.href} aria-current={active(s.href, s) ? 'page' : undefined}
                    class:list={['block rounded-lg px-3 py-1.5 transition', active(s.href, s) ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>{s.label}</a>
                ))}
              </div>
            </details>
          );
        })}
      </nav>
    </aside>
    <div class="min-w-0"><slot /></div>
  </div>
</Portal>

<script>
  // One menu for both sizes: on phones it moves inside the fold-away panel.
  const nav = document.querySelector<HTMLElement>('[data-admin-nav]');
  const slot = document.querySelector<HTMLElement>('[data-admin-menu-slot]');
  const wide = window.matchMedia('(min-width: 1024px)');
  const place = () => {
    if (!nav || !slot) return;
    if (wide.matches) { document.querySelector('[data-admin-eyebrow]')?.after(nav); nav.classList.add('hidden', 'lg:block'); }
    else { slot.append(nav); nav.classList.remove('hidden'); }
  };
  place();
  wide.addEventListener('change', place);

  // Remember which sections were left open (the current page's section always opens).
  const KEY = 'lakeba.adminMenu';
  let saved: string[] = [];
  try { saved = JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch {}
  for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-admin-group]')) {
    if (saved.includes(d.dataset.adminGroup!)) d.open = true;
    d.addEventListener('toggle', () => {
      const open = [...document.querySelectorAll<HTMLDetailsElement>('[data-admin-group]')].filter((x) => x.open && x.dataset.current === undefined).map((x) => x.dataset.adminGroup!);
      try { localStorage.setItem(KEY, JSON.stringify(open)); } catch {}
    });
  }
</script>
