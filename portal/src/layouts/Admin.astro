---
import Portal from './Portal.astro';
interface Props { title: string }
const { title } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { href: '/admin', label: 'Overview' },
  { href: '/admin/investors', label: 'Investors' },
  { href: '/admin/holdings', label: 'Holders & holdings' },
  { href: '/admin/documents', label: 'Documents' },
  { href: '/admin/ask-review', label: 'Ask review' },
  { href: '/admin/ask-knowledge', label: 'Ask knowledge' },
  { href: '/admin/queries', label: 'Board Q&A' },
  { href: '/admin/content', label: 'News & announcements' },
  { href: '/admin/agm', label: 'Meetings' },
  { href: '/admin/ventures', label: 'Ventures & prices' },
  { href: '/admin/audit', label: 'Audit log' },
];
const active = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---

<Portal title={`${title} · Admin`}>
  <div class="grid gap-8 lg:grid-cols-[13rem_1fr]">
    <aside class="lg:sticky lg:top-32 lg:self-start">
      <p class="eyebrow">Admin</p>
      <nav class="mt-4 flex gap-1 overflow-x-auto text-sm lg:flex-col" aria-label="Admin">
        {sections.map((s) => (
          <a href={s.href} aria-current={active(s.href) ? 'page' : undefined}
            class:list={['shrink-0 rounded-lg px-3 py-2 transition', active(s.href) ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white']}>{s.label}</a>
        ))}
      </nav>
    </aside>
    <div class="min-w-0"><slot /></div>
  </div>
</Portal>
