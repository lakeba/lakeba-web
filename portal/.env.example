# Copy to .env. For local development, take the values from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Optional: Cloudflare Turnstile on sign-in forms (also enable captcha in Supabase Auth).
TURNSTILE_SITE_KEY=
# Only for scripts/seed-dev.mjs and scripts/check-rls.mjs. Never used by the web app.
SUPABASE_SECRET_KEY=
# Outgoing email. Locally: smtp://127.0.0.1:54325 (caught by the test inbox).
SMTP_URL=
MAIL_FROM=Lakeba Investor Relations <investors@lakeba.com>
# Optional: enables "Ask Lakeba" answers. Without it, Ask shows matching passages only.
ANTHROPIC_API_KEY=
