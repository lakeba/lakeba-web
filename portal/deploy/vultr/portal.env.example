# /etc/lakeba-portal/portal.env (owner root, group portal, mode 0640)
# Values from the Supabase project (Settings → API keys) and your email service.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
SUPABASE_SECRET_KEY=sb_secret_…

# Outgoing email, e.g. smtp://user:password@smtp.example.com:587
SMTP_URL=
# Leave empty to keep Ask answers off until the spend limit is set in the Anthropic Console.
ANTHROPIC_API_KEY=
