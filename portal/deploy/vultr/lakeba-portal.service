[Unit]
Description=Lakeba Investor Portal
After=network-online.target
Wants=network-online.target

[Service]
User=portal
Group=portal
WorkingDirectory=/srv/lakeba-portal/current
EnvironmentFile=/etc/lakeba-portal/portal.env
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=4321
# Writable state (ProtectSystem=strict makes everything else read-only):
# /var/lib/lakeba-portal, e.g. the Ask retrieval embedding model.
StateDirectory=lakeba-portal
Environment=MODEL_CACHE_DIR=/var/lib/lakeba-portal/models
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=3
# Hardening: the service can only read its files and talk to the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
