---
const names = ['Microsoft', 'IBM', 'ANZ', 'Macquarie', 'Mirvac', 'News Corp', 'Stockland', 'UNSW', 'Siemens Healthineers', 'Perpetual', 'Allstate', 'Pepper Money', 'NSW Government', 'Wisr'];
---

<section class="border-y border-white/5 bg-white/[0.015] py-8">
  <p class="container-x mb-5 text-center text-xs uppercase tracking-[0.25em] text-white/40">Ventures trusted by 5,000+ customers and partners</p>
  <div class="relative overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_15%,black_85%,transparent)]">
    <div class="flex w-max animate-marquee gap-14 pr-14">
      {[...names, ...names].map((n) => (
        <span class="font-display text-xl font-semibold whitespace-nowrap text-white/30">{n}</span>
      ))}
    </div>
  </div>
</section>
