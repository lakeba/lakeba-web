---
const log = [
  { who: 'you', c: 'text-white', t: 'Online booking for solo barbers, over WhatsApp.' },
  { who: 'scout', c: 'text-lk-green', t: 'Studied 20 pages of the app you like → inspiration brief' },
  { who: 'atlas', c: 'text-lk-blue', t: 'Plan ready · 4 milestones · 11 issues' },
  { who: 'probe', c: 'text-lk-green', t: 'Wrote 31 tests before a line of code' },
  { who: 'forge', c: 'text-lk-orange', t: 'Built booking flow, reminders, payments' },
  { who: 'sentinel', c: 'text-lk-green', t: 'Security review · signed off' },
  { who: 'atlas', c: 'text-lk-blue', t: 'APPROVED after 1 round' },
  { who: 'spark', c: 'text-lk-red', t: 'Website + pitch deck generated' },
  { who: 'harbor', c: 'text-lk-blue', t: 'v0.1.0 released 🚀' },
];
const points = [
  { k: 'Members with jobs', v: 'Not one chatbot — a lead, builder, QA, security, DevOps and marketing.' },
  { k: 'Rules in code', v: 'Spend limits, sandboxed tests and approvals you click.' },
  { k: 'Any model', v: 'Claude, local models, your own hardware.' },
];
---

<section id="os" class="relative py-28">
  <div aria-hidden="true" class="absolute inset-x-0 top-1/3 -z-10 mx-auto h-96 max-w-4xl rounded-full bg-lk-blue/10 blur-[140px]"></div>
  <div class="container-x grid items-center gap-16 lg:grid-cols-2">
    <div class="reveal">
      <span class="eyebrow">LakebaOS · open source</span>
      <h2 class="mt-5 text-4xl font-extrabold sm:text-5xl">A whole startup team.<br /><span class="text-gradient">Running on AI.</span></h2>
      <p class="mt-5 max-w-lg text-lg text-white/60">The studio playbook behind 17 ventures, packaged as an operating system. You bring the vision — the agents do the work.</p>
      <dl class="mt-10 space-y-5">
        {points.map((p) => (
          <div class="flex gap-4">
            <span class="mt-2 size-2 shrink-0 rounded-full bg-gradient-to-br from-lk-blue to-lk-green"></span>
            <div><dt class="font-semibold text-white">{p.k}</dt><dd class="text-sm text-white/55">{p.v}</dd></div>
          </div>
        ))}
      </dl>
    </div>

    <!-- live run mockup -->
    <div class="reveal relative">
      <div class="absolute -inset-px rounded-[1.6rem] bg-gradient-to-br from-lk-blue/50 via-white/5 to-lk-orange/40"></div>
      <div class="relative overflow-hidden rounded-3xl bg-[#08111f] shadow-2xl shadow-black/60">
        <div class="flex items-center gap-2 border-b border-white/5 px-5 py-3.5">
          <span class="size-3 rounded-full bg-lk-red/80"></span><span class="size-3 rounded-full bg-lk-orange/80"></span><span class="size-3 rounded-full bg-lk-green/80"></span>
          <span class="ml-3 font-mono text-xs text-white/40">lakeba-os · chairtime</span>
          <span class="ml-auto flex items-center gap-1.5 rounded-full bg-lk-green/15 px-2.5 py-0.5 font-mono text-[10px] text-lk-green"><span class="size-1.5 animate-pulse rounded-full bg-lk-green"></span>live</span>
        </div>
        <ol data-run class="space-y-2.5 p-5 font-mono text-[13px] leading-relaxed">
          {log.map((l, i) => (
            <li class="log-line flex gap-3" style={`animation-delay:${0.4 + i * 0.55}s`}>
              <span class={`w-16 shrink-0 text-right ${l.c}`}>{l.who}</span>
              <span class="text-white/75">{l.t}</span>
            </li>
          ))}
          <li class="log-line flex gap-3" style={`animation-delay:${0.4 + log.length * 0.55}s`}>
            <span class="w-16"></span><span class="h-4 w-2 animate-[blink_1s_steps(1)_infinite] bg-white/70"></span>
          </li>
        </ol>
        <div class="grid grid-cols-3 border-t border-white/5 text-center">
          <div class="p-4"><p class="font-display text-xl font-bold text-white">6 min</p><p class="text-[11px] text-white/40">build time</p></div>
          <div class="border-x border-white/5 p-4"><p class="font-display text-xl font-bold text-white">31 ✓</p><p class="text-[11px] text-white/40">tests passed</p></div>
          <div class="p-4"><p class="font-display text-xl font-bold text-white">$0.31</p><p class="text-[11px] text-white/40">model spend</p></div>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-white/35">Illustrative run from the LakebaOS demo.</p>
    </div>
  </div>
</section>

<style>
  .log-line { opacity: 0; animation: typein 0.5s ease-out forwards; animation-play-state: paused; }
  [data-run].is-in .log-line { animation-play-state: running; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const run = document.querySelector('[data-run]');
    if (!run) return;
    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) { run.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.4 }).observe(run);
  });
</script>
