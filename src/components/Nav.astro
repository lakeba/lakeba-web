---
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
const links = [
  { href: '#os', label: 'LakebaOS' },
  { href: '#program', label: 'Program' },
  { href: '#team', label: 'AI Team' },
  { href: '#fund', label: 'Fund' },
  { href: '#track', label: 'Track record' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="container-x pt-3">
    <nav class="glass flex items-center justify-between rounded-2xl px-4 py-2.5 shadow-2xl shadow-black/30">
      <a href="#top" class="flex items-center gap-2.5" aria-label="Lakeba home">
        <Mark class="size-7" />
        <span class="font-display text-lg font-bold tracking-tight text-white">lakeba</span>
        <span class="hidden rounded-md bg-white/10 px-1.5 py-0.5 font-mono text-[10px] text-white/70 sm:inline">OS</span>
      </a>
      <ul class="hidden items-center gap-1 md:flex">
        {links.map((l) => (
          <li><a href={l.href} class="rounded-lg px-3 py-2 text-sm text-white/65 transition hover:bg-white/5 hover:text-white">{l.label}</a></li>
        ))}
      </ul>
      <div class="flex items-center gap-1">
        <ThemeToggle />
        <a href="https://lakeba.com/os/apply" class="rounded-xl bg-white px-4 py-2 text-sm font-semibold text-ink transition hover:bg-white/85">
          Apply <span class="hidden sm:inline">for funding</span> →
        </a>
      </div>
    </nav>
  </div>
</header>
