---
import Mark from './Mark.astro';
const orbit = [
  { name: 'Atlas', role: 'Lead', color: 'bg-lk-blue' },
  { name: 'Forge', role: 'Builder', color: 'bg-lk-orange' },
  { name: 'Probe', role: 'QA', color: 'bg-lk-green' },
  { name: 'Spark', role: 'Marketing', color: 'bg-lk-red' },
  { name: 'Harbor', role: 'DevOps', color: 'bg-lk-blue' },
  { name: 'Sentinel', role: 'Security', color: 'bg-lk-green' },
];
---

<section id="top" class="relative isolate overflow-hidden pt-32 pb-20 sm:pt-40">
  <!-- ambient colour fields -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-[85%] rounded-full bg-lk-blue/25 blur-[120px]"></div>
    <div class="absolute top-20 left-1/2 h-[30rem] w-[30rem] translate-x-[10%] rounded-full bg-lk-orange/15 blur-[120px]"></div>
    <div class="absolute top-[28rem] left-1/2 h-[26rem] w-[26rem] -translate-x-[30%] rounded-full bg-lk-green/15 blur-[120px]"></div>
    <div class="absolute bottom-0 h-40 w-full bg-gradient-to-b from-transparent to-ink"></div>
  </div>

  <div class="container-x grid items-center gap-16 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <span class="eyebrow"><span class="size-1.5 rounded-full bg-lk-green shadow-[0_0_10px] shadow-lk-green"></span> Introducing LakebaOS</span>
      <h1 class="mt-6 text-5xl font-extrabold leading-[1.02] sm:text-6xl lg:text-7xl">
        Your idea.<br />
        An <span class="text-gradient">AI team</span>.<br />
        A funded company.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/65">
        After 17 ventures, Lakeba has turned its venture studio into an operating system. Describe your idea — AI agents build the MVP — and Lakeba co-founds and funds the best.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#program" class="group relative inline-flex items-center gap-2 rounded-2xl bg-lk-blue px-6 py-3.5 font-semibold text-white shadow-lg shadow-lk-blue/30 transition hover:shadow-lk-blue/50">
          Start building
          <span class="transition group-hover:translate-x-1">→</span>
        </a>
        <a href="#fund" class="inline-flex items-center gap-2 rounded-2xl border border-white/15 px-6 py-3.5 font-semibold text-white transition hover:bg-white/5">
          See the fund offer
        </a>
      </div>
      <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-6">
        <div><dt class="text-xs uppercase tracking-widest text-white/45">You keep</dt><dd class="font-display text-3xl font-bold text-white">51%</dd></div>
        <div><dt class="text-xs uppercase tracking-widest text-white/45">CEO salary</dt><dd class="font-display text-3xl font-bold text-white">12 mo</dd></div>
        <div><dt class="text-xs uppercase tracking-widest text-white/45">Code needed</dt><dd class="font-display text-3xl font-bold text-white">0</dd></div>
      </dl>
    </div>

    <!-- orbiting AI team around the mark -->
    <div class="relative mx-auto aspect-square w-full max-w-[34rem]" aria-hidden="true">
      <div class="absolute inset-[6%] rounded-full border border-white/10"></div>
      <div class="absolute inset-[22%] rounded-full border border-dashed border-white/10"></div>
      <div class="absolute inset-[34%] rounded-full bg-white/[0.03] shadow-[0_0_120px_30px] shadow-lk-blue/20"></div>
      <div class="absolute inset-[36%] grid place-items-center">
        <Mark class="size-full drop-shadow-[0_0_40px_rgba(39,106,231,0.45)]" animated />
      </div>
      <div class="absolute inset-[14%] animate-spin-slow sm:inset-[6%]">
        {orbit.map((a, i) => {
          const angle = (i / orbit.length) * Math.PI * 2;
          const x = 50 + 50 * Math.cos(angle);
          const y = 50 + 50 * Math.sin(angle);
          return (
            <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${x}%;top:${y}%`}>
              <div class="animate-spin-rev">
                <div class="glass flex scale-[0.8] items-center gap-2 rounded-full py-1.5 pr-3.5 pl-1.5 shadow-xl shadow-black/40 sm:scale-100">
                  <span class={`grid size-7 place-items-center rounded-full ${a.color} font-display text-xs font-bold text-white`}>{a.name[0]}</span>
                  <span class="text-sm leading-tight"><span class="block font-semibold text-white">{a.name}</span><span class="block text-[11px] text-white/55">{a.role}</span></span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
