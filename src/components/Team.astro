---
const team = [
  { name: 'Atlas', role: 'Lead', text: 'Plans the work and reviews every change.', grad: 'from-lk-blue/30', dot: 'bg-lk-blue', span: 'row-span-2 md:col-span-2', big: true },
  { name: 'Forge', role: 'Builder', text: 'Writes the code, in small reviewed edits.', grad: 'from-lk-orange/30', dot: 'bg-lk-orange', span: '' },
  { name: 'Probe', role: 'QA', text: 'Writes tests before anyone builds.', grad: 'from-lk-green/30', dot: 'bg-lk-green', span: '' },
  { name: 'Spark', role: 'Marketing', text: 'Brief, website and pitch deck.', grad: 'from-lk-red/30', dot: 'bg-lk-red', span: '' },
  { name: 'Harbor', role: 'DevOps', text: 'Triage, merges and releases.', grad: 'from-lk-blue/30', dot: 'bg-lk-blue', span: '' },
  { name: 'Sentinel', role: 'Security', text: 'Signs off every approved build.', grad: 'from-lk-green/30', dot: 'bg-lk-green', span: '' },
  { name: 'Scout', role: 'Research', text: 'Studies the apps you admire.', grad: 'from-lk-orange/30', dot: 'bg-lk-orange', span: '' },
  { name: 'Quill', role: 'Docs', text: 'README, docs and changelog.', grad: 'from-lk-red/30', dot: 'bg-lk-red', span: '' },
  { name: 'Yours', role: 'Any role', text: 'Add a member with its own skills and model.', grad: 'from-white/15', dot: 'bg-white', span: '' },
];
const stats = [
  { v: '26', k: 'specialists' },
  { v: '46', k: 'skills' },
  { v: '21', k: 'playbooks' },
  { v: '12', k: 'languages' },
];
---

<section id="team" class="relative py-28">
  <div class="container-x">
    <div class="reveal flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <span class="eyebrow">Your AI team</span>
        <h2 class="mt-5 text-4xl font-extrabold sm:text-5xl">Meet your co-workers.</h2>
      </div>
      <div class="grid w-full grid-cols-4 gap-4 sm:gap-8 md:w-auto">
        {stats.map((s) => (
          <div><p class="font-display text-2xl font-bold text-white sm:text-3xl">{s.v}</p><p class="text-[10px] uppercase tracking-widest text-white/40 sm:text-xs">{s.k}</p></div>
        ))}
      </div>
    </div>

    <div class="mt-14 grid auto-rows-[11rem] gap-4 sm:grid-cols-2 md:grid-cols-4">
      {team.map((m) => (
        <article class:list={['reveal group relative overflow-hidden rounded-3xl border border-white/8 bg-white/[0.025] p-6 transition duration-500 hover:-translate-y-1 hover:border-white/20', m.span]}>
          <div class:list={['absolute inset-0 bg-gradient-to-br to-transparent opacity-40 transition duration-500 group-hover:opacity-100', m.grad]}></div>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span class:list={['grid place-items-center rounded-2xl font-display font-bold text-ink', m.dot, m.big ? 'size-14 text-2xl' : 'size-10 text-base']}>{m.name[0]}</span>
              <span class="rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] uppercase tracking-widest text-white/55">{m.role}</span>
            </div>
            <h3 class:list={['mt-auto font-bold', m.big ? 'text-4xl md:text-5xl' : 'text-xl']}>{m.name}</h3>
            <p class:list={['mt-1 text-white/55', m.big ? 'max-w-sm text-lg' : 'text-sm']}>{m.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
