---
import { href } from '../lib/paths';
import { newsDate, ventureClass, type NewsEntry } from '../lib/news';
interface Props { entry: NewsEntry; large?: boolean }
const { entry, large = false } = Astro.props;
const { title, date, excerpt, venture, cover, external, source } = entry.data;
---

<a href={href(`/news/${entry.id}/`)} data-venture={venture} data-year={date.getFullYear()}
  class:list={['news-card group glass flex flex-col overflow-hidden rounded-3xl transition duration-300 hover:-translate-y-1 hover:border-white/20', large && 'md:col-span-2 md:flex-row']}>
  {cover ? (
    <img src={cover} alt="" width="1200" height="675" decoding="async" loading={large ? 'eager' : 'lazy'}
      class:list={['w-full object-cover transition duration-500 group-hover:scale-[1.02]', large ? 'aspect-[16/9] md:aspect-auto md:w-3/5' : 'aspect-[16/9]']} />
  ) : (
    <div class:list={['grid aspect-[16/9] place-items-center bg-gradient-to-br from-lk-blue/20 via-transparent to-lk-orange/15', large && 'md:aspect-auto md:w-3/5']}>
      <span class="font-display text-2xl font-bold text-white/30">{venture}</span>
    </div>
  )}
  <div class:list={['flex flex-1 flex-col p-6', large && 'md:p-10']}>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class:list={['rounded-full px-2.5 py-1 font-semibold', ventureClass(venture)]}>{venture}</span>
      <time datetime={date.toISOString()} class="text-white/45">{newsDate.format(date)}</time>
    </div>
    <h3 class:list={['mt-3 font-bold leading-snug group-hover:underline', large ? 'text-2xl sm:text-3xl' : 'text-lg']}>{title}</h3>
    <p class:list={['mt-2 text-sm text-white/55', large ? 'line-clamp-4' : 'line-clamp-3']}>{excerpt}</p>
    <p class="mt-auto pt-4 text-sm font-semibold text-lk-blue">{external ? `Read on ${source?.name ?? 'the original site'} ↗` : 'Read →'}</p>
  </div>
</a>
