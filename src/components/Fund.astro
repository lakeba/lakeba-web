---
const perks = [
  { t: 'Co-founding capital', d: 'Lakeba invests in your company as co-founder.', i: 'M12 2v20M17 6H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6', c: 'text-lk-blue' },
  { t: '12 months of CEO salary', d: 'Your first year as CEO is funded, so you can go all in.', i: 'M3 7h18v13H3zM8 7V4h8v3', c: 'text-lk-orange' },
  { t: 'Your AI dev team', d: 'LakebaOS keeps building with you after launch.', i: 'M9 3h6v4H9zM5 7h14v13H5zM9 12h.01M15 12h.01M9 16h6', c: 'text-lk-green' },
  { t: 'Shared services', d: 'Finance, legal, people and marketing — handled.', i: 'M4 21V8l8-5 8 5v13M9 21v-6h6v6', c: 'text-lk-red' },
  { t: 'The Lakeba ecosystem', d: 'Portfolio, partners and a network across 7 countries.', i: 'M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18', c: 'text-white' },
];
---

<section id="fund" class="relative overflow-hidden py-28">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-ink via-navy/60 to-ink"></div>
  <div aria-hidden="true" class="absolute top-1/2 left-0 -z-10 h-[36rem] w-[36rem] -translate-x-1/3 -translate-y-1/2 rounded-full bg-lk-orange/10 blur-[140px]"></div>

  <div class="container-x">
    <div class="reveal mx-auto max-w-3xl text-center">
      <span class="eyebrow">The fund opportunity</span>
      <h2 class="mt-5 text-4xl font-extrabold sm:text-6xl">Build the MVP.<br /><span class="text-gradient">We'll build the company with you.</span></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/60">Lakeba reviews every application and co-founds a limited number of ventures each year — as investor and venture studio.</p>
    </div>

    <div class="mt-20 grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- equity ring -->
      <div class="reveal relative mx-auto aspect-square w-full max-w-sm">
        <div class="equity absolute inset-0 rounded-full"></div>
        <div class="absolute inset-[14%] grid place-items-center rounded-full bg-ink text-center shadow-inner shadow-black">
          <div>
            <p class="font-display text-7xl font-extrabold text-white">51<span class="text-4xl">%</span></p>
            <p class="mt-1 text-sm uppercase tracking-[0.2em] text-white/50">is yours</p>
            <div class="mx-auto my-4 h-px w-16 bg-white/15"></div>
            <p class="font-display text-2xl font-bold text-white/70">49% <span class="text-sm font-medium text-white/40">Lakeba</span></p>
          </div>
        </div>
        <span class="absolute -top-2 right-6 rounded-full bg-lk-blue px-3 py-1 text-xs font-semibold text-white shadow-lg shadow-lk-blue/40 animate-float">Founder & CEO</span>
        <span class="absolute bottom-4 -left-2 rounded-full bg-lk-orange px-3 py-1 text-xs font-semibold text-ink shadow-lg shadow-lk-orange/40 animate-float [animation-delay:-3s]">Co-founder & investor</span>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2">
        {perks.map((p, i) => (
          <li class:list={['reveal glass rounded-3xl p-6 transition hover:bg-white/[0.07]', i === 0 && 'sm:col-span-2']}>
            <svg viewBox="0 0 24 24" class={`size-7 ${p.c}`} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={p.i} /></svg>
            <h3 class="mt-4 text-lg font-bold">{p.t}</h3>
            <p class="mt-1 text-sm text-white/55">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>

    <p class="reveal mt-14 text-center text-sm text-white/45">Not selected? <span class="text-white/75">You keep your MVP</span> — keep building and apply again.</p>
  </div>
</section>

<style>
  @property --sweep { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
  .equity {
    background: conic-gradient(from -90deg, #276ae7 0%, #35a954 calc(var(--sweep) * 0.51), color-mix(in oklab, var(--color-white) 8%, transparent) calc(var(--sweep) * 0.51), color-mix(in oklab, var(--color-white) 8%, transparent) calc(var(--sweep) * 0.51 + 0.6%), #eb802b calc(var(--sweep) * 0.51 + 0.6%), #dd3b2d var(--sweep), color-mix(in oklab, var(--color-white) 6%, transparent) var(--sweep));
    --sweep: 100%;
    filter: drop-shadow(0 0 40px rgb(39 106 231 / 0.35));
  }
  @supports (animation-timeline: view()) {
    .equity { animation: sweep linear both; animation-timeline: view(); animation-range: entry 10% cover 45%; }
  }
  @keyframes sweep { from { --sweep: 0%; } to { --sweep: 100%; } }
</style>
