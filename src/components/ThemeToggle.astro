---
// Cycles Auto → Day → Night. The choice is remembered on this device.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---

<button type="button" data-theme-toggle class:list={['theme-toggle grid size-9 shrink-0 place-items-center rounded-full text-white/60 transition hover:bg-white/5 hover:text-white', cls]} aria-label="Theme: automatic" title="Theme: automatic">
  <svg class="icon-auto size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 000 18z" fill="currentColor" /></svg>
  <svg class="icon-light size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="icon-dark size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" /></svg>
</button>

<style is:global>
  .theme-toggle svg { display: none; }
  :root:not([data-theme-choice]) .theme-toggle .icon-auto,
  [data-theme-choice='auto'] .theme-toggle .icon-auto,
  [data-theme-choice='light'] .theme-toggle .icon-light,
  [data-theme-choice='dark'] .theme-toggle .icon-dark { display: block; }
</style>

<script is:inline>
  (() => {
    if (window.__lakebaThemeToggle) return;
    window.__lakebaThemeToggle = true;
    const order = ['auto', 'light', 'dark'];
    const labels = { auto: 'Theme: automatic', light: 'Theme: day', dark: 'Theme: night' };
    const label = () => {
      const choice = document.documentElement.dataset.themeChoice || 'auto';
      document.querySelectorAll('[data-theme-toggle]').forEach((b) => { b.setAttribute('aria-label', labels[choice]); b.title = labels[choice]; });
    };
    document.addEventListener('click', (e) => {
      const button = e.target.closest?.('[data-theme-toggle]');
      if (!button) return;
      const root = document.documentElement;
      const next = order[(order.indexOf(root.dataset.themeChoice || 'auto') + 1) % order.length];
      try { localStorage.setItem('lakeba-theme', next); } catch {}
      if (next === 'auto') delete root.dataset.theme; else root.dataset.theme = next;
      root.dataset.themeChoice = next;
      label();
    });
    document.addEventListener('DOMContentLoaded', label);
    document.addEventListener('astro:page-load', label);
  })();
</script>
