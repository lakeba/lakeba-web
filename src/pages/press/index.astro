---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { allNews, newsDate, ventureClass } from '../../lib/news';
import { href } from '../../lib/paths';

// The press room: Lakeba's press releases (group and ventures), the media
// contact and what journalists can get (PDFs, press kits, RSS).
const releases = (await allNews()).filter((n) => n.data.press);
const contact = releases[0]?.data.press?.contact ?? { name: 'Lakeba Media Relations', email: 'press@lakeba.com', phone: '' };
---

<Layout title="Press room — Lakeba" description="Press releases from Lakeba Group and its ventures, with press kits, PDFs and the media contact.">
  <Nav />
  <main class="pt-32 pb-24">
    <div class="container-x">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lk-blue">Press room</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-6xl">Press releases</h1>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_22rem]">
        <ol class="space-y-4">
          {releases.map((n) => (
            <li class="glass rounded-2xl p-5 sm:p-6">
              <div class="flex flex-wrap items-center gap-2 text-sm">
                <span class:list={['rounded-full px-3 py-1 font-semibold', ventureClass(n.data.venture)]}>{n.data.venture}</span>
                <time datetime={n.data.date.toISOString()} class="text-white/50">{newsDate.format(n.data.date)}</time>
              </div>
              <h2 class="mt-3 text-xl font-bold leading-snug"><a href={href(`/news/${n.id}/`)} class="hover:text-lk-blue">{n.data.title}</a></h2>
              {(n.data.press?.summary || n.data.excerpt) && <p class="mt-2 text-white/60">{n.data.press?.summary || n.data.excerpt}</p>}
              <p class="mt-3 flex flex-wrap gap-4 text-sm"><a href={href(`/news/${n.id}/`)} class="text-lk-blue hover:underline">Read the release</a><a href={n.data.press!.pdf} target="_blank" rel="noopener" class="text-white/60 hover:text-white">PDF ↓</a>{n.data.press!.kit.length > 0 && <span class="text-white/45">Press kit: {n.data.press!.kit.length} image{n.data.press!.kit.length > 1 ? 's' : ''}</span>}</p>
            </li>
          ))}
          {!releases.length && <li class="text-white/50">No press releases yet. See <a href={href('/news/')} class="text-lk-blue">News & Media</a>.</li>}
        </ol>
        <aside class="space-y-4 lg:sticky lg:top-28 lg:self-start">
          <div class="glass rounded-2xl p-5">
            <h2 class="font-bold">Media contact</h2>
            <p class="mt-2 text-sm text-white/65">{contact.name}<br /><a href={`mailto:${contact.email}`} class="text-lk-blue hover:underline">{contact.email}</a>{contact.phone && <><br />{contact.phone}</>}</p>
          </div>
          <div class="glass rounded-2xl p-5 text-sm text-white/65">
            <h2 class="font-bold text-white">For journalists</h2>
            <p class="mt-2">Every release has a PDF and, where available, a press kit of images for editorial use. Follow new releases by RSS:</p>
            <p class="mt-3"><a href={href('/press/rss.xml')} class="text-lk-blue hover:underline">Press releases RSS</a> · <a href={href('/news/rss.xml')} class="text-lk-blue hover:underline">All news RSS</a></p>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
